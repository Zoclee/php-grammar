{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "php-grammar/certification-current/2",
  "title": "Current PHP 8.6 certification dependency assessment; no certification grant",
  "type": "object",
  "required": ["contract", "evidenceKind", "revision", "output", "configuration", "inputs", "runtime", "runtimeUnchanged", "snapshots", "commands", "release85Snapshot", "generatedAt", "inputsUnchanged", "certificationGranted", "grammarComplete", "wholeSourceValidatorComplete", "historicalCertificationRenewed", "checks", "verificationErrors", "blockers", "gates", "prerequisites", "artifacts"],
  "properties": {
    "contract": {"const": "php86-certification-v2"},
    "evidenceKind": {"const": "current-assessment"},
    "revision": {"type": "string"},
    "output": {"type": "string"},
    "configuration": {"type": "object"},
    "inputs": {"type": "object"},
    "runtime": {"type": "object"},
    "runtimeUnchanged": {"const": true},
    "snapshots": {"type": "object"},
    "commands": {"type": "object"},
    "release85Snapshot": {"type": "object"},
    "generatedAt": {"type": "string"},
    "inputsUnchanged": {"const": true},
    "certificationGranted": {"const": false},
    "grammarComplete": {"const": false},
    "wholeSourceValidatorComplete": {"const": false},
    "historicalCertificationRenewed": {"const": false},
    "checks": {"type": "object"},
    "verificationErrors": {"type": "object"},
    "blockers": {"type": "array", "minItems": 7, "maxItems": 7},
    "gates": {"type": "object", "minProperties": 36, "maxProperties": 36},
    "prerequisites": {"type": "object", "minProperties": 2, "maxProperties": 2},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": false,
  "$comment": "The PHP verifier additionally derives exact memberships, commands, obligations, custody, source identities and freshness; schema validation alone is not evidence verification."
}
