s RFC","color":"AD322B","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":16,"created_at":"2023-04-05T10:37:03Z","updated_at":"2026-09-24T00:33:11Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Description\n\nStrings should allow class constants (and `class`) https://3v4l.org/hTnNv\r\n\r\n```php\r\n<?php\r\necho \"{$foo::$Bar}\\n\"; // ok\r\necho \"{$foo::Bar}\\n\"; // parse error\r\necho \"{$foo::class}\\n\"; // parse error\r\n```","reactions":{"url":"https://api.github.com/repos/php/php-src/issues/11018/reactions","total_count":6,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/php/php-src/issues/11018/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/php/php-src/issues/20848","repository_url":"https://api.github.com/repos/php/php-src","labels_url":"https://api.github.com/repos/php/php-src/issues/20848/labels{/name}","comments_url":"https://api.github.com/repos/php/php-src/issues/20848/comments","events_url":"https://api.github.com/repos/php/php-src/issues/20848/events","html_url":"https://github.com/php/php-src/pull/20848","id":3784908512,"node_id":"PR_kwDOAB0Los67ta__","number":20848,"title":"[PFA 2/n] Support PFA functionality","user":{"login":"arnaud-lb","id":365207,"node_id":"MDQ6VXNlcjM2NTIwNw==","avatar_url":"https://avatars.githubusercontent.com/u/365207?v=4","gravatar_id":"","url":"https://api.github.com/users/arnaud-lb","html_url":"https://github.com/arnaud-lb","followers_url":"https://api.github.com/users/arnaud-lb/followers","following_url":"https://api.github.com/users/arnaud-lb/following{/other_user}","gists_url":"https://api.github.com/users/arnaud-lb/gists{/gist_id}","starred_url":"https://api.github.com/users/arnaud-lb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arnaud-lb/subscriptions","organizations_url":"https://api.github.com/users/arnaud-lb/orgs","repos_url":"https://api.github.com/users/arnaud-lb/repos","events_url":"https://api.github.com/users/arnaud-lb/events{/privacy}","received_events_url":"https://api.github.com/users/arnaud-lb/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":148912247,"node_id":"MDU6TGFiZWwxNDg5MTIyNDc=","url":"https://api.github.com/repos/php/php-src/labels/RFC","name":"RFC","color":"c7def8","default":false,"description":null,"archived_at":null,"archived_by":null},{"id":303477056,"node_id":"MDU6TGFiZWwzMDM0NzcwNTY=","url":"https://api.github.com/repos/php/php-src/labels/Category:%20Build%20System","name":"Category: Build System","color":"5319E7","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3045702973,"node_id":"MDU6TGFiZWwzMDQ1NzAyOTcz","url":"https://api.github.com/repos/php/php-src/labels/Category:%20Engine","name":"Category: Engine","color":"5319E7","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3611288125,"node_id":"LA_kwDOAB0Los7XP-I9","url":"https://api.github.com/repos/php/php-src/labels/Extension:%20opcache","name":"Extension: opcache","color":"0052CC","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3611297679,"node_id":"LA_kwDOAB0Los7XQAeP","url":"https://api.github.com/repos/php/php-src/labels/Extension:%20standard","name":"Extension: standard","color":"0052CC","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3685479977,"node_id":"LA_kwDOAB0Los7bq_Yp","url":"https://api.github.com/repos/php/php-src/labels/Category:%20Optimizer","name":"Category: Optimizer","color":"5319E7","default":false,"description":"","archived_at":null,"archived_by":null},{"id":7494444148,"node_id":"LA_kwDOAB0Los8AAAABvrQkdA","url":"https://api.github.com/repos/php/php-src/labels/ABI%20break","name":"ABI break","color":"B60205","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2026-01-06T12:02:28Z","updated_at":"2026-07-20T13:31:26Z","closed_at":"2026-07-17T08:09:23Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/php/php-src/pulls/20848","html_url":"https://github.com/php/php-src/pull/20848","diff_url":"https://github.com/php/php-src/pull/20848.diff","patch_url":"https://github.com/php/php-src/pull/20848.patch","merged_at":"2026-07-17T08:09:23Z"},"body":"RFC: https://wiki.php.net/rfc/partial_function_application_v2\r\n\r\nThis follows https://github.com/php/php-src/pull/20717. This implements most of the RFC, except [PFAs in constant expressions](https://github.com/php/php-src/pull/22785), and [some optimization](https://github.com/php/php-src/pull/22829).\r\n\r\nI wanted to split this PR more, but I didn't find a way to achieve this that makes sense.\r\n\r\n---\r\n\r\nA partial application is compiled to the usual sequence of function call\r\nopcodes (`INIT_FCALL`, `SEND_VAR`, etc), but the sequence ends with a\r\n`CALLABLE_CONVERT_PARTIAL` opcode instead of `DO_FCALL`, similarly to\r\nfirst class callables. Placeholders are compiled to `SEND_PLACEHOLDER` opcodes:\r\n\r\n```\r\n$f = f($a, ?)\r\n```\r\n\r\n```\r\n0001 INIT_FCALL f\r\n0002 SEND_VAR CV($a)\r\n0003 SEND_PLACEHOLDER\r\n0004 CV($f) = CALLABLE_CONVERT_PARTIAL\r\n```\r\n\r\n`SEND_PLACEHOLDER` sets the argument slot type to `_IS_PLACEHOLDER`.\r\n\r\n`CALLABLE_CONVERT_PARTIAL` uses the information available on the stack to\r\ncreate a Closure and return it, consuming the stack frame in the process\r\nlike an internal function call.\r\n\r\nWe create the Closure by generating the relevant AST and compiling it to an\r\nop_array.\r\n\r\nThe op_array is cached in the Opcache SHM and inline caches. The SHM key is prefixed with `pfa://` to avoid any collision with actual files. When Opcache is disabled, we cache PFA op_arrays a global hash table. This is mainly useful for polymorphic PFAs, as the inline cache stores only a single entry.","reactions":{"url":"https://api.github.com/repos/php/php-src/issues/20848/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/php/php-src/issues/20848/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/php/php-src/issues/17213","repository_url":"https://api.github.com/repos/php/php-src","labels_url":"https://api.github.com/repos/php/php-src/issues/17213/labels{/name}","comments_url":"https://api.github.com/repos/php/php-src/issues/17213/comments","events_url":"https://api.github.com/repos/php/php-src/issues/17213/events","html_url":"https://github.com/php/php-src/pull/17213","id":2748118587,"node_id":"PR_kwDOAB0Los6Fqj9u","number":17213,"title":"Support first-class callables in const-expressions","user":{"login":"TimWolla","id":209270,"node_id":"MDQ6VXNlcjIwOTI3MA==","avatar_url":"https://avatars.githubusercontent.com/u/209270?v=4","gravatar_id":"","url":"https://api.github.com/users/TimWolla","html_url":"https://github.com/TimWolla","followers_url":"https://api.github.com/users/TimWolla/followers","following_url":"https://api.github.com/users/TimWolla/following{/other_user}","gists_url":"https://api.github.com/users/TimWolla/gists{/gist_id}","starred_url":"https://api.github.com/users/TimWolla/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TimWolla/subscriptions","organizations_url":"https://api.github.com/users/TimWolla/orgs","repos_url":"https://api.github.com/users/TimWolla/repos","events_url":"https://api.github.com/users/TimWolla/events{/privacy}","received_events_url":"https://api.github.com/users/TimWolla/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":148912247,"node_id":"MDU6TGFiZWwxNDg5MTIyNDc=","url":"https://api.github.com/repos/php/php-src/labels/RFC","name":"RFC","color":"c7def8","default":false,"description":null,"archived_at":null,"archived_by":null},{"id":3045702973,"node_id":"MDU6TGFiZWwzMDQ1NzAyOTcz","url":"https://api.github.com/repos/php/php-src/labels/Category:%20Engine","name":"Category: Engine","color":"5319E7","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3611288125,"node_id":"LA_kwDOAB0Los7XP-I9","url":"https://api.github.com/repos/php/php-src/labels/Extension:%20opcache","name":"Extension: opcache","color":"0052CC","default":false,"description":"","archived_at":null,"archived_by":null},{"id":7494444148,"node_id":"LA_kwDOAB0Los8AAAABvrQkdA","url":"https://api.github.com/repos/php/php-src/labels/ABI%20break","name":"ABI break","color":"B60205","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2024-12-18T15:27:23Z","updated_at":"2025-02-20T17:52:58Z","closed_at":"2025-02-20T17:52:47Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/php/php-src/pulls/17213","html_url":"https://github.com/php/php-src/pull/17213","diff_url":"https://github.com/php/php-src/pull/17213.diff","patch_url":"https://github.com/php/php-src/pull/17213.patch","merged_at":"2025-02-20T17:52:47Z"},"body":"RFC: https://wiki.php.net/rfc/fcc_in_const_expr\r\n","reactions":{"url":"https://api.github.com/repos/php/php-src/issues/17213/reactions","total_count":12,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":5,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/php/php-src/issues/17213/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/php/php-src/issues/8646","repository_url":"https://api.github.com/repos/php/php-src","labels_url":"https://api.github.com/repos/php/php-src/issues/8646/labels{/name}","comments_url":"https://api.github.com/repos/php/php-src/issues/8646/comments","events_url":"https://api.github.com/repos/php/php-src/issues/8646/events","html_url":"https://github.com/php/php-src/issues/8646","id":1250906604,"node_id":"I_kwDOAB0Los5Kj1Hs","number":8646,"title":"Memory leak PHP FPM 8.1 with class entry instances","user":{"login":"davtur19","id":13476215,"node_id":"MDQ6VXNlcjEzNDc2MjE1","avatar_url":"https://avatars.githubusercontent.com/u/13476215?v=4","gravatar_id":"","url":"https://api.github.com/users/davtur19","html_url":"https://github.com/davtur19","followers_url":"https://api.github.com/users/davtur19/followers","following_url":"https://api.github.com/users/davtur19/following{/other_user}","gists_url":"https://api.github.com/users/davtur19/gists{/gist_id}","starred_url":"https://api.github.com/users/davtur19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davtur19/subscriptions","organizations_url":"https://api.github.com/users/davtur19/orgs","repos_url":"https://api.github.com/users/davtur19/repos","events_url":"https://api.github.com/users/davtur19/events{/privacy}","received_events_url":"https://api.github.com/users/davtur19/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":148912283,"node_id":"MDU6TGFiZWwxNDg5MTIyODM=","url":"https://api.github.com/repos/php/php-src/labels/Bug","name":"Bug","color":"E99695","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":106,"created_at":"2022-05-27T15:41:15Z","updated_at":"2023-12-21T12:05:24Z","closed_at":"2023-12-21T12:05:24Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Description\n\n### Description\r\nA few months ago I tried to migrate to php8.1 but it had a memory leak, so I stayed at 8.0, the memory leak is still present today, while on version 8.0 no problem, the memory remains stable.\r\n\r\n### Info\r\nArmbian (Ubuntu 20.04.4 LTS)\r\nLinux roc-rk3399-pc 5.15.25-rockchip64\r\nDocker version 20.10.16, build aa7e414\r\n\r\nDocker image not working: php8.1-fpm\r\nDocker image working fine: php8.0-fpm\r\n\r\n\r\nMy dockerfile:\r\n```Dockerfile\r\nFROM php:8.1-fpm\r\n\r\nRUN pecl install igbinary\r\nRUN pecl bundle redis && cd redis && phpize && ./configure --enable-redis-igbinary && make && make install\r\nRUN docker-php-ext-enable opcache igbinary redis\r\n\r\nRUN mv \"$PHP_INI_DIR/php.ini-production\" \"$PHP_INI_DIR/php.ini\"\r\n\r\nHEALTHCHECK CMD curl -s 172.17.0.1:8080/ping | grep pong\r\n```\r\n\r\nMy php.ini\r\n```ini\r\ndisable_functions = pcntl_alarm,pcntl_fork,pcntl_waitpid,pcntl_wait,pcntl_wifexited,pcntl_wifstopped,pcntl_wifsignaled,pcntl_wifcontinued,pcntl_wexitstatus,pcntl_wtermsig,pcntl_wstopsig,pcntl_signal,pcntl_signal_get_handler,pcntl_signal_dispatch,pcntl_get_last_error,pcntl_strerror,pcntl_sigprocmask,pcntl_sigwaitinfo,pcntl_sigtimedwait,pcntl_exec,pcntl_getpriority,pcntl_setpriority,pcntl_async_signals,pcntl_unshare,exec,passthru,shell_exec,system,popen,curl_multi_exec,parse_ini_file,show_source,\r\nexpose_php = Off\r\nmax_execution_time = 60\r\nmax_input_time = 60\r\nerror_reporting = E_ALL\r\ndisplay_errors = Off\r\npost_max_size = 51M\r\nfile_uploads = On\r\nupload_max_filesize = 50M\r\nallow_url_fopen = On\r\nallow_url_include = Off\r\ndefault_socket_timeout = 60\r\nopen_basedir = \"/code/:/tmp/\"\r\ncgi.force_redirect = 1\r\n\r\n[opcache]\r\n; Determines if Zend OPCache is enabled\r\nopcache.enable=1\r\n; The OPcache shared memory storage size.\r\nopcache.memory_consumption=128\r\n; The amount of memory for interned strings in Mbytes.\r\nopcache.interned_strings_buffer=8\r\n; The maximum number of keys (scripts) in the OPcache hash table.\r\n; Only numbers between 200 and 1000000 are allowed.\r\nopcache.max_accelerated_files=10000\r\n; The maximum percentage of \"wasted\" memory until a restart is scheduled.\r\nopcache.max_wasted_percentage=5\r\n; When disabled, you must reset the OPcache manually or restart the\r\n; webserver for changes to the filesystem to take effect.\r\nopcache.validate_timestamps=1\r\n; Enables or disables file search in include_path optimization\r\nopcache.revalidate_path=1\r\n; If disabled, all PHPDoc comments are dropped from the code to reduce the\r\n; size of the optimized code.\r\nopcache.save_comments=0\r\n; Allow file existence override (file_exists, etc.) performance feature.\r\nopcache.enable_file_override=1\r\n; Check the cache checksum each N requests.\r\n; The default value of \"0\" means that the checks are disabled.\r\nopcache.consistency_checks=100\r\n\r\n#opcache.enable_cli=1\r\n#opcache.jit_buffer_size=100MB\r\n#opcache.jit=1235\r\n```\r\n\r\n\r\nphp8.1-fpm memory usage (purple line):\r\n![image](https://user-images.githubusercontent.com/13476215/170731999-937ae901-e565-4ec4-b855-a13b7279a780.png)\r\nIt had gone up to 800MB in a relatively short time without stopping\r\n\r\nphp8.0-fpm memory usage (purple line):\r\n![image](https://user-images.githubusercontent.com/13476215/170732125-209a8ab8-d7f0-4d40-ac3e-de979fd652d1.png)\r\n\r\n\r\nI don't know what other information to give you because I don't know how to use profiling tools, and I can't test disabling extensions.\r\n\n\n### PHP Version\n\n8.1\n\n### Operating System\n\nArmbian (Ubuntu 20.04.4 LTS)","reactions":{"url":"https://api.github.com/repos/php/php-src/issues/8646/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/php/php-src/issues/8646/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/php/php-src/issues/8159","repository_url":"https://api.github.com/repos/php/php-src","labels_url":"https://api.github.com/repos/php/php-src/issues/8159/labels{/name}","comments_url":"https://api.github.com/repos/php/php-src/issues/8159/comments","events_url":"https://api.github.com/repos/php/php-src/issues/8159/events","html_url":"https://github.com/php/php-src/issues/8159","id":1155091724,"node_id":"I_kwDOAB0Los5E2U0M","number":8159,"title":"Apache / PHP segfaults (PHP 8.0 and 8.1, but also 7.4)","user":{"login":"unix-world","id":8994380,"node_id":"MDQ6VXNlcjg5OTQzODA=","avatar_url":"https://avatars.githubusercontent.com/u/8994380?v=4","gravatar_id":"","url":"https://api.github.com/users/unix-world","html_url":"https://github.com/unix-world","followers_url":"https://api.github.com/users/unix-world/followers","following_url":"https://api.github.com/users/unix-world/following{/other_user}","gists_url":"https://api.github.com/users/unix-world/gists{/gist_id}","starred_url":"https://api.github.com/users/unix-world/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/unix-world/subscriptions","organizations_url":"https://api.github.com/users/unix-world/orgs","repos_url":"https://api.github.com/users/unix-world/repos","events_url":"https://api.github.com/users/unix-world/events{/privacy}","received_events_url":"https://api.github.com/users/unix-world/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":148912283,"node_id":"MDU6TGFiZWwxNDg5MTIyODM=","url":"https://api.github.com/repos/php/php-src/labels/Bug","name":"Bug","color":"E99695","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3611288125,"node_id":"LA_kwDOAB0Los7XP-I9","url":"https://api.github.com/repos/php/php-src/labels/Extension:%20opcache","name":"Extension: opcache","color":"0052CC","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3611398396,"node_id":"LA_kwDOAB0Los7XQZD8","url":"https://api.github.com/repos/php/php-src/labels/SAPI:%20apache2handler","name":"SAPI: apache2handler","color":"1D76DB","default":false,"description":"","archived_at":null,"archived_by":null},{"id":3611416941,"node_id":"LA_kwDOAB0Los7XQdlt","url":"https://api.github.com/repos/php/php-src/labels/Status:%20Needs%20Triage","name":"Status: Needs Triage","color":"D93F0B","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":60,"created_at":"2022-03-01T09:27:25Z","updated_at":"2022-03-14T07:45:19Z","closed_at":"2022-03-11T13:44:43Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Description\r\n\r\nPHP 7.4.27 / 8.0.15 / 8.1.3\r\nApache 2.4.52\r\nOpenBSD 7.0 / amd64\r\n\r\nIf running any of the above PHP versions under Apache (as module), I noticed that every time when apache rotate it's logs it crashes. To be sure of this issue I set the log rotation at a fixed hour (not by size).\r\nIn the last 3 days, each day at the exactly same hour apache crashed and did not crashed in the rest.\r\nFinally I did not loaded the opcache.so and it did not crashed on log rotation.\r\nAfter further investigation I noticed this:\r\n\r\nThe problem is somwehere in opcache.so.\r\nAll the above versions are affected.\r\nThe PHP 7.3.33 works OK, it does not crash.\r\n\r\nHow to reproduce the issue:\r\n1. load the opcache.so PHP extensions\r\n2. apachectl2 graceful OR kill -HUP 12345 (where 12345 is the process ID number)\r\n3. apache crashes\r\n\r\nIf I do not load opcache.so it does not crashes.\r\n\r\n\r\n \r\n\r\n### PHP Version\r\n\r\n8.0.15\r\n\r\n### Operating System\r\n\r\nOpenBSD 7.0","reactions":{"url":"https://api.github.com/repos/php/php-src/issues/8159/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/php/php-src/issues/8159/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/php/php-src/issues/6489","repository_url":"https://api.github.com/repos/php/php-src","labels_url":"https://api.github.com/repos/php/php-src/issues/6489/labels{/name}","comments_url":"https://api.github.com/repos/php/php-src/issues/6489/comments","events_url":"https://api.github.com/repos/php/php-src/issues/6489/events","html_url":"https://github.com/php/php-src/pull/6489","id":757421829,"node_id":"MDExOlB1bGxSZXF1ZXN0NTMyODAyMDY0","number":6489,"title":"Implement enums","user":{"login":"iluuu1994","id":1752683,"node_id":"MDQ6VXNlcjE3NTI2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/1752683?v=4","gravatar_id":"","url":"https://api.github.com/users/iluuu1994","html_url":"https://github.com/iluuu1994","followers_url":"https://api.github.com/users/iluuu1994/followers","following_url":"https://api.github.com/users/iluuu1994/following{/other_user}","gists_url":"https://api.github.com/users/iluuu1994/gists{/gist_id}","starred_url":"https://api.github.com/users/iluuu1994/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iluuu1994/subscriptions","organizations_url":"https://api.github.com/users/iluuu1994/orgs","repos_url":"https://api.github.com/users/iluuu1994/repos","events_url":"https://api.github.com/users/iluuu1994/events{/privacy}","received_event