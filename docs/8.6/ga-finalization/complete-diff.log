diff --git a/Zend/tests/GHSA-8mjj-2r7p-4hg2.phpt b/Zend/tests/GHSA-8mjj-2r7p-4hg2.phpt
new file mode 100644
index 00000000000..1f5f34faf96
--- /dev/null
+++ b/Zend/tests/GHSA-8mjj-2r7p-4hg2.phpt
@@ -0,0 +1,31 @@
+--TEST--
+GHSA-8mjj-2r7p-4hg2
+--INI--
+fatal_error_backtraces=1
+zend.exception_ignore_args=0
+memory_limit=4M
+opcache.jit=disable
+--SKIPIF--
+<?php
+if (getenv("USE_ZEND_ALLOC") === "0") die("skip requires ZendMM");
+?>
+--FILE--
+<?php
+
+class C {
+    static function __callStatic($name, $args)
+    {
+    }
+}
+
+$a = str_repeat('a', 1*1024*1024);
+
+// Soft OOM during CONCAT will be handled by DO_FCALL
+C::test(1, 2, 3, 4, $a.$a);
+
+?>
+--EXPECTF--
+Fatal error: Allowed memory size of %d bytes exhausted %S(tried to allocate %d bytes) in %s on line 12
+Stack trace:
+#0 %s(12): C::test(1, 2, 3, 4, 'aaaaaaaaaaaaaaa...')
+#1 {main}
diff --git a/Zend/zend.c b/Zend/zend.c
index ad08fe1a630..4598fc63d00 100644
--- a/Zend/zend.c
+++ b/Zend/zend.c
@@ -1512,7 +1512,9 @@ ZEND_API ZEND_COLD void zend_error_zstr_at(
 	}
 
 	// Always clear the last backtrace.
-	zval_ptr_dtor(&EG(last_fatal_error_backtrace));
+	if (EG(active)) {
+		zval_ptr_dtor(&EG(last_fatal_error_backtrace));
+	}
 	ZVAL_UNDEF(&EG(last_fatal_error_backtrace));
 
 	/* Report about uncaught exception in case of fatal errors */
@@ -1535,7 +1537,11 @@ ZEND_API ZEND_COLD void zend_error_zstr_at(
 			}
 		}
 	} else if (EG(fatal_error_backtrace_on) && (type & E_FATAL_ERRORS)) {
-		zend_fetch_debug_backtrace(&EG(last_fatal_error_backtrace), 0, EG(exception_ignore_args) ? DEBUG_BACKTRACE_IGNORE_ARGS : 0, 0);
+		// EG(last_fatal_error_backtrace) is useless when the executor is
+		// inactive, and setting it at this point would leak.
+		if (EG(active)) {
+			zend_fetch_debug_backtrace(&EG(last_fatal_error_backtrace), 0, EG(exception_ignore_args) ? DEBUG_BACKTRACE_IGNORE_ARGS : 0, 0);
+		}
 	}
 
 	zend_observer_error_notify(type, error_filename, error_lineno, message);
