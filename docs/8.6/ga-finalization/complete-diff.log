diff --git a/sapi/phpdbg/phpdbg_frame.c b/sapi/phpdbg/phpdbg_frame.c
index b08a877b707..fdab924638e 100644
--- a/sapi/phpdbg/phpdbg_frame.c
+++ b/sapi/phpdbg/phpdbg_frame.c
@@ -50,6 +50,12 @@ zend_string *phpdbg_compile_stackframe(zend_execute_data *ex) {
 	uint32_t i = 0, first_extra_arg = op_array->num_args, num_args = ZEND_CALL_NUM_ARGS(ex);
 	zval *p = ZEND_CALL_ARG(ex, 1);
 
+	if (ex->func->op_array.fn_flags & ZEND_ACC_CALL_VIA_TRAMPOLINE) {
+		/* A __call/__callStatic trampoline doesn't move extra args
+		 * behind the CVs and TMPs (see i_init_func_execute_data()). */
+		first_extra_arg = num_args;
+	}
+
 	if (op_array->scope) {
 		smart_str_append(&s, op_array->scope->name);
 		smart_str_appends(&s, "::");
@@ -80,6 +86,8 @@ zend_string *phpdbg_compile_stackframe(zend_execute_data *ex) {
 		smart_str_appends(&s, " [internal function]");
 	}
 
+	smart_str_0(&s);
+
 	return s.s;
 }
 
diff --git a/sapi/phpdbg/tests/GHSA-8mjj-2r7p-4hg2-001.phpt b/sapi/phpdbg/tests/GHSA-8mjj-2r7p-4hg2-001.phpt
new file mode 100644
index 00000000000..67c95706cf2
--- /dev/null
+++ b/sapi/phpdbg/tests/GHSA-8mjj-2r7p-4hg2-001.phpt
@@ -0,0 +1,34 @@
+--TEST--
+GHSA-8mjj-2r7p-4hg2: phpdbg frame display for __call trampoline
+--INI--
+fatal_error_backtraces=0
+zend.exception_ignore_args=1
+--PHPDBG--
+b ZEND_CALL_TRAMPOLINE
+r
+f 1
+f 0
+q
+--EXPECTF--
+[Successful compilation of %s]
+prompt> [Breakpoint #0 added at ZEND_CALL_TRAMPOLINE]
+prompt> [Breakpoint #0 in ZEND_CALL_TRAMPOLINE at %s:0, hits: 1]
+ 00001: <?php
+ 00002: class C { static function __callStatic($name, $args) {} }
+prompt> [Switched to frame #1: caller() at %s:5]
+>00005:     C::test(1, 2, 3, 4);
+ 00006: }
+ 00007:%w
+prompt> [Switched to frame #0: C::test(1, 2, 3, 4) at %s:0]
+ 00001: <?php
+ 00002: class C { static function __callStatic($name, $args) {} }
+prompt>
+--FILE--
+<?php
+class C { static function __callStatic($name, $args) {} }
+
+function caller() {
+    C::test(1, 2, 3, 4);
+}
+
+caller();
