@@ -0,0 +1,70 @@
+--TEST--
+FPM: late zlib shutdown error does not recreate the fatal error backtrace
+--EXTENSIONS--
+zlib
+--SKIPIF--
+<?php include "skipif.inc"; ?>
+--FILE--
+<?php
+require_once "tester.inc";
+
+$cfg = <<<EOT
+[global]
+error_log = {{FILE:LOG}}
+[unconfined]
+listen = {{ADDR:UDS}}
+pm = static
+pm.max_children = 1
+EOT;
+
+$code = <<<'PHP'
+<?php
+echo getmypid(), "\n", date_default_timezone_get();
+PHP;
+
+$testDir = __DIR__ . '/ghsa-2fjv-p558-g82m-zlib-data';
+mkdir($testDir);
+file_put_contents($testDir . '/producer.php', $code);
+file_put_contents($testDir . '/php.ini', "[PATH=$testDir]\nzlib.output_compression=0\noutput_handler=ob_gzhandler\n");
+
+$tester = new FPM\Tester($cfg, $code);
+$tester->start(extraArgs: ['-c', $testDir . '/php.ini'], extensions: ['zlib'], iniEntries: [
+    'fatal_error_backtraces' => '1',
+    'display_errors' => '0',
+    'log_errors' => '1',
+    'date.timezone' => 'UTC',
+    'zlib.output_compression' => '1',
+]);
+$tester->expectLogStartNotices();
+$body = $tester->request(address: '{{ADDR:UDS}}')->expectError(null)->getBody();
+var_dump(preg_match('/^\d+\nUTC$/D', $body) === 1);
+
+// Restore compression before output_handler to raise a late shutdown error.
+$tester->request(address: '{{ADDR:UDS}}', scriptFilename: $testDir . '/producer.php')
+->expectBody($body)->expectError(
+    'PHP message: PHP Fatal error:  PHP Request Shutdown: '
+        . 'Cannot use both zlib.output_compression and output_handler together!! in Unknown on line 0'
+);
+
+// This diagnostic occurs before the next request's executor initialization.
+$tester->request(address: '{{ADDR:UDS}}', headers: ['PHP_VALUE' => 'date.timezone=invalid'])
+    ->expectBody($body)
+    ->expectError("PHP message: PHP Warning:  PHP Request Shutdown: "
+        . "Invalid date.timezone value 'invalid', using 'UTC' instead in Unknown on line 0");
+$tester->terminate();
+$tester->expectLogTerminatingNotices();
+$tester->close();
+?>
+Done
+--EXPECT--
+bool(true)
+Done
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+$testDir = __DIR__ . '/ghsa-2fjv-p558-g82m-zlib-data';
+@unlink($testDir . '/producer.php');
+@unlink($testDir . '/php.ini');
+@rmdir($testDir);
+?>
diff --git a/sapi/fpm/tests/ghsa-3mg3-cr28-46gc-status-xss.phpt b/sapi/fpm/tests/ghsa-3mg3-cr28-46gc-status-xss.phpt
new file mode 100644
index 00000000000..0a40a5ad4b0
--- /dev/null
+++ b/sapi/fpm/tests/ghsa-3mg3-cr28-46gc-status-xss.phpt
@@ -0,0 +1,70 @@
+--TEST--
+FPM: GHSA-3mg3-cr28-46gc - status xss via request method, auth user and script filename
+--SKIPIF--
+<?php include "skipif.inc"; ?>
+--FILE--
+<?php
+
+require_once "tester.inc";
+
+$cfg = <<<EOT
+[global]
+error_log = {{FILE:LOG}}
+[unconfined]
+listen = {{ADDR}}
+pm = static
+pm.max_children = 3
+pm.status_path = /status
+catch_workers_output = yes
+EOT;
+
+$code = <<<EOT
+<?php
+usleep(300000);
+EOT;
+
+$scriptFilename = __DIR__ . '/ghsa-3mg3-cr28-46gc-<svg>.php';
+file_put_contents($scriptFilename, $code);
+
+$tester = new FPM\Tester($cfg, $code);
+$tester->start();
+$tester->expectLogStartNotices();
+$responses = $tester
+        ->multiRequest([
+                [
+                    'uri' => '/ghsa-3mg3-cr28-46gc-<svg>.php',
+                    'headers' => [
+                        'REQUEST_METHOD' => '<svg>',
+                        'HTTP_AUTHORIZATION' => 'Basic ' . base64_encode('"<svg onload=x>:x'),
+                        'SCRIPT_FILENAME' => $scriptFilename,
+                    ],
+                ],
+                ['uri' => '/status', 'query' => 'full&html', 'delay' => 100000],
+                ['uri' => '/status', 'query' => 'full&json', 'delay' => 100000],
+        ]);
+var_dump(strpos($responses[1]->getBody(), '<svg'));
+var_dump(substr_count($responses[1]->getBody(), '&lt;svg'));
+$status = json_decode($responses[2]->getBody('application/json'), true);
+foreach ($status['processes'] as $proc) {
+    if ($proc['request method'] === '<svg>') {
+        var_dump($proc['user'], $proc['script'] === $scriptFilename);
+    }
+}
+$tester->terminate();
+$tester->expectLogTerminatingNotices();
+$tester->close();
+
+?>
+Done
+--EXPECT--
+bool(false)
+int(4)
+string(15) ""<svg onload=x>"
+bool(true)
+Done
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+@unlink(__DIR__ . '/ghsa-3mg3-cr28-46gc-<svg>.php');
+?>
diff --git a/sapi/fpm/tests/ghsa-g3vh-838c-65v7.phpt b/sapi/fpm/tests/ghsa-g3vh-838c-65v7.phpt
new file mode 100644
index 00000000000..cca31023418
--- /dev/null
+++ b/sapi/fpm/tests/ghsa-g3vh-838c-65v7.phpt
@@ -0,0 +1,94 @@
+--TEST--
+FPM: GHSA-g3vh-838c-65v7 terminates a worker after interrupted session shutdown
+--EXTENSIONS--
+session
+--SKIPIF--
+<?php include "skipif.inc"; ?>
+--FILE--
+<?php
+require_once "tester.inc";
+
+$sessionDir = __DIR__ . '/ghsa-g3vh-838c-65v7.sessions';
+mkdir($sessionDir, 0700);
+
+$cfg = <<<EOT
+[global]
+error_log = {{FILE:LOG}}
+log_level = notice
+[unconfined]
+listen = {{ADDR:UDS}}
+pm = static
+pm.max_children = 1
+php_admin_value[session.save_path] = $sessionDir
+php_admin_flag[opcache.enable] = off
+php_admin_flag[display_errors] = off
+php_admin_flag[log_errors] = off
+EOT;
+
+$code = <<<'PHP'
+<?php
+if ($_SERVER['QUERY_STRING'] !== 'producer') {
+    echo getmypid();
+    return;
+}
+
+class ShutdownStream {
+    public $context;
+    private $fp;
+
+    public function stream_open($path, $mode, $options, &$openedPath) {
+        $this->fp = fopen('/dev/null', 'w');
+        return true;
+    }
+
+    public function stream_write($data) {
+        return strlen($data);
+    }
+
+    public function stream_close() {
+        trigger_error('session shutdown bailout', E_USER_ERROR);
+    }
+}
+
+stream_wrapper_register('shutdown-test', ShutdownStream::class);
+session_id('g3vh' . getmypid());
+session_start();
+$_SESSION['stream'] = fopen('shutdown-test://session', 'w');
+unset($_SESSION);
+
+// Finish the response before the fatal RSHUTDOWN callback runs.
+echo 'producer';
+fastcgi_finish_request();
+PHP;
+
+$tester = new FPM\Tester($cfg, $code);
+$tester->start(extensions: ['session']);
+$tester->expectLogStartNotices();
+$pid = (int) $tester->request(address: '{{ADDR:UDS}}')->getBody();
+$tester->request(query: 'producer', address: '{{ADDR:UDS}}')->expectBody('producer');
+$tester->expectLogWarning(
+    'child ' . $pid . ' exited with code 1 after \\d+\\.\\d+ seconds from start',
+    'unconfined',
+    timeoutSeconds: 5
+);
+$tester->expectLogNotice('child \\d+ started', 'unconfined');
+$replacement = (int) $tester->request(address: '{{ADDR:UDS}}')->getBody();
+var_dump($pid > 0 && $replacement > 0 && $replacement !== $pid);
+$tester->terminate();
+$tester->expectLogTerminatingNotices();
+$tester->close();
+?>
+Done
+--EXPECT--
+bool(true)
+Done
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+$sessionDir = __DIR__ . '/ghsa-g3vh-838c-65v7.sessions';
+foreach (glob($sessionDir . '/sess_*') as $file) {
+    unlink($file);
+}
+@rmdir($sessionDir);
+?>
diff --git a/sapi/fpm/tests/unread-body-keep-conn.phpt b/sapi/fpm/tests/unread-body-keep-conn.phpt
new file mode 100644
index 00000000000..5d818c58c7f
--- /dev/null
+++ b/sapi/fpm/tests/unread-body-keep-conn.phpt
@@ -0,0 +1,125 @@
+--TEST--
+FPM: unread request body cannot become a new request on a kept connection
+--SKIPIF--
+<?php include "skipif.inc"; ?>
+--FILE--
+<?php
+
+require_once "tester.inc";
+
+function record(int $type, string $content, int $id): string
+{
+    return pack('CCnnCC', 1, $type, $id, strlen($content), 0, 0) . $content;
+}
+
+function params(array $params): string
+{
+    $encoded = '';
+    $encodeLength = static fn(int $length): string => $length < 128
+        ? chr($length)
+        : pack('N', $length | 0x80000000);
+    foreach ($params as $name => $value) {
+        $encoded .= $encodeLength(strlen($name)) . $encodeLength(strlen($value)) . $name . $value;
+    }
+    return $encoded;
+}
+
+function request(int $id, bool $keep, array $params, string $stdin): string
+{
+    return record(1, pack('nCxxxxx', 1, $keep), $id)
+        . record(4, params($params), $id)
+        . record(4, '', $id)
+        . record(5, $stdin, $id)
+        . record(5, '', $id);
+}
+
+function transact(string $address, string $request): string
+{
+    [$host, $port] = explode(':', $address);
+    $socket = fsockopen($host, (int) $port);
+    stream_set_timeout($socket, 3);
+    $written = 0;
+    while ($written < strlen($request)) {
+        $written += fwrite($socket, substr($request, $written));
+    }
+    stream_socket_shutdown($socket, STREAM_SHUT_WR);
+    $response = stream_get_contents($socket);
+    fclose($socket);
+    return $response;
+}
+
+$config = <<<CFG
+[global]
+error_log = {{FILE:LOG}}
+[unconfined]
+listen = {{ADDR}}
+pm = static
+pm.max_children = 1
+catch_workers_output = yes
+CFG;
+
+$code = <<<'PHP'
+<?php
+if ($_SERVER['REMOTE_ADDR'] === '203.0.113.1') {
+    echo "smuggled\n";
+} else {
+    $input = fopen('php://input', 'r');
+    echo "outer\n";
+}
+PHP;
+
+$tester = new FPM\Tester($config, $code);
+$script = $tester->makeSourceFile();
+$tester->start();
+$tester->expectLogStartNotices();
+
+$hiddenParams = [
+    'GATEWAY_INTERFACE' => 'FastCGI/1.0',
+    'REQUEST_METHOD' => 'GET',
+    'SCRIPT_FILENAME' => $script,
+    'SCRIPT_NAME' => '/smuggled.php',
+    'REQUEST_URI' => '/smuggled.php',
+    'SERVER_PROTOCOL' => 'HTTP/1.1',
+    'REMOTE_ADDR' => '203.0.113.1',
+    'CONTENT_LENGTH' => '0',
+];
+$hidden = request(2, false, $hiddenParams, '');
+$body = str_pad("--B\r\nContent-Disposition: form-data\r\n\r\n", 12000, 'A');
+$body = substr_replace($body, $hidden, 5120, strlen($hidden));
+
+$outerParams = [
+    'GATEWAY_INTERFACE' => 'FastCGI/1.0',
+    'REQUEST_METHOD' => 'POST',
+    'SCRIPT_FILENAME' => $script,
+    'SCRIPT_NAME' => '/open.php',
+    'REQUEST_URI' => '/open.php',
+    'SERVER_PROTOCOL' => 'HTTP/1.1',
+    'REMOTE_ADDR' => '127.0.0.1',
+    'CONTENT_TYPE' => 'multipart/form-data; boundary=B',
+    'CONTENT_LENGTH' => (string) strlen($body),
+];
+foreach ([false, true] as $keep) {
+    $response = transact($tester->getAddr(), request(1, $keep, $outerParams, $body));
+    echo 'keep ', $keep ? 'on' : 'off', ': ',
+        str_contains($response, 'smuggled') ? 'smuggled' : 'safe', "\n";
+}
+
+$body = 'A' . $hidden;
+$outerParams['CONTENT_TYPE'] = 'application/octet-stream';
+$outerParams['CONTENT_LENGTH'] = '1';
+$response = transact($tester->getAddr(), request(1, true, $outerParams, $body));
+echo 'partial frame: ',
+    str_contains($response, 'smuggled') ? 'smuggled' : 'safe', "\n";
+
+$tester->terminate();
+$tester->close();
+?>
+--EXPECT--
+keep off: safe
+keep on: safe
+partial frame: safe
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+?>
