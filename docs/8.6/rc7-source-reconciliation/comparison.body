,"site_admin":false},"committer":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ad687b622944ea8a840f27d67990e9caf1c8a22a","url":"https://api.github.com/repos/php/php-src/commits/ad687b622944ea8a840f27d67990e9caf1c8a22a","html_url":"https://github.com/php/php-src/commit/ad687b622944ea8a840f27d67990e9caf1c8a22a"},{"sha":"38eabd0452df61e4d871f38e8afe2306490dd3b4","url":"https://api.github.com/repos/php/php-src/commits/38eabd0452df61e4d871f38e8afe2306490dd3b4","html_url":"https://github.com/php/php-src/commit/38eabd0452df61e4d871f38e8afe2306490dd3b4"}]},{"sha":"7dc666cf4f3b7e790a0bb3948b7fac2400f6eb21","node_id":"C_kwDOAB0LotoAKDdkYzY2NmNmNGYzYjdlNzkwYTBiYjM5NDhiN2ZhYzI0MDBmNmViMjE","commit":{"author":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-10-30T09:54:00Z"},"committer":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-10-30T09:54:00Z"},"message":"Merge branch 'PHP-8.5' into PHP-8.6\n\n* PHP-8.5:\n  Fix opcache.interned_strings_buffer being 0 in threads started later (ZTS)","tree":{"sha":"2d44c1f29d3feab0a2