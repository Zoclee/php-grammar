ous|string, null given, called in %s on line %d\n TypeError: class@anonymous::test(): Return value must be of type class@anonymous|string, stdClass returned"},{"sha":"605cb59086d7ac0811f8c808a99fe3632c2d91e6","filename":"Zend/tests/vm_interrupt_rearm.phpt","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fvm_interrupt_rearm.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fvm_interrupt_rearm.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fvm_interrupt_rearm.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,26 @@\n+--TEST--\n+VM interrupt re-armed by the interrupt handler must not stop execution from making progress\n+--DESCRIPTION--\n+zend_test.rearm_vm_interrupt installs a zend_interrupt_function that sets\n+EG(vm_interrupt) again every time it runs, so an interrupt is always pending.\n+After handling an interrupt the VM has to run the next opline before it checks\n+the flag again, otherwise it calls the handler forever (or recurses until the\n+stack overflows).\n+--EXTENSIONS--\n+zend_test\n+--INI--\n+zend_test.rearm_vm_interrupt=1\n+--FILE--\n+<?php\n+function inc(int $x): int {\n+    return $x + 1;\n+}\n+\n+$n = 0;\n+for ($i = 0; $i < 1000; $i++) {\n+    $n = inc($n);\n+}\n+var_dump($n);\n+?>\n+--EXPECT--\n+int(1000)"},{"sha":"b137f25620c595dc66f63dc013dfa17bb930d862","filename":"Zend/tests/zend_mm_chunk_alloc_mmap_failure.phpt","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fzend_mm_chunk_alloc_mmap_failure.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fzend_mm_chunk_alloc_mmap_failure.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fzend_mm_chunk_alloc_mmap_failure.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,32 @@\n+--TEST--\n+Failed retry mmap() in zend_mm_chunk_alloc_int() must not unmap an unrelated range\n+--EXTENSIONS--\n+posix\n+--SKIPIF--\n+<?php\n+if (PHP_OS_FAMILY !== 'Linux') die('skip Linux only');\n+if (PHP_INT_SIZE != 8) die('skip this test is for 64bit platforms only');\n+if (getenv('USE_ZEND_ALLOC') === '0') die('skip Zend MM disabled');\n+$maps = @file_get_contents('/proc/self/maps');\n+if ($maps === false) die('skip /proc/self/maps not available');\n+if (!preg_match('/^([0-9a-f]+)-[0-9a-f]+ r-xp /m', $maps, $m) || hexdec($m[1]) > 0x40000000) {\n+    die('skip only for non-PIE builds');\n+}\n+?>\n+--INI--\n+memory_limit=-1\n+--FILE--\n+<?php\n+// A huge block whose size equals the start of the executable mapping. If the\n+// first mmap() is not 2 MiB aligned and the retry fails under RLIMIT_AS, the\n+// missing NULL check used to unmap [size, size + 2 MiB - 4 KiB), i.e. our text.\n+preg_match('/^([0-9a-f]+)-[0-9a-f]+ r-xp /m', file_get_contents('/proc/self/maps'), $m);\n+$size = hexdec($m[1]);\n+preg_match('/VmSize:\\s+(\\d+)/', file_get_contents('/proc/self/status'), $m);\n+// Room for the first mmap() of $size bytes, not for the aligned retry.\n+var_dump(posix_setrlimit(POSIX_RLIMIT_AS, $m[1] * 1024 + $size + 1024 * 1024, POSIX_RLIMIT_INFINITY));\n+$s = str_repeat('A', $size - 4096);\n+echo \"allocation succeeded\\n\";\n+?>\n+--EXPECTREGEX--\n+bool\\(true\\)\\s+(.*Out of memory|allocation succeeded)\\s*"},{"sha":"ad08fe1a630dbf7b59f5f2ee492a349453932bb4","filename":"Zend/zend.c","status":"modified","additions":16,"deletions":17,"changes":33,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Fzend.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -194,8 +194,8 @@ static ZEND_INI_MH(OnUpdateMaxAllowedStackSize) /* {{{ */\n \tzend_long size = zend_ini_parse_quantity_warn(new_value, entry->name);\n \n \tif (size < ZEND_MAX_ALLOWED_STACK_SIZE_UNCHECKED) {\n-\t\tzend_error(E_WARNING, \"Invalid \\\"%s\\\" setting. Value must be >= %d, but got \" ZEND_LONG_FMT,\n-\t\t\tZSTR_VAL(entry->name), ZEND_MAX_ALLOWED_STACK_SIZE_UNCHECKED, size);\n+\t\tzend_error(E_WARNING, \"Invalid \\\"%pS\\\" setting. Value must be >= %d, but got \" ZEND_LONG_FMT,\n+\t\t\tentry->name, ZEND_MAX_ALLOWED_STACK_SIZE_UNCHECKED, size);\n \t\treturn FAILURE;\n \t}\n \n@@ -228,8 +228,8 @@ static ZEND_INI_MH(OnUpdateReservedStackSize) /* {{{ */\n \tif (size == 0) {\n \t\tsize = min;\n \t} else if (size < min) {\n-\t\tzend_error(E_WARNING, \"Invalid \\\"%s\\\" setting. Value must be >= \" ZEND_ULONG_FMT \", but got \" ZEND_ULONG_FMT \"\\n\",\n-\t\t\tZSTR_VAL(entry->name), min, size);\n+\t\tzend_error(E_WARNING, \"Invalid \\\"%pS\\\" setting. Value must be >= \" ZEND_ULONG_FMT \", but got \" ZEND_ULONG_FMT \"\\n\",\n+\t\t\tentry->name, min, size);\n \t\treturn FAILURE;\n \t}\n \n@@ -1842,7 +1842,7 @@ ZEND_API ZEND_COLD void zend_throw_error(zend_class_entry *exception_ce, const c\n \tif (EG(current_execute_data) && !CG(in_compilation)) {\n \t\tzend_throw_exception_ex(exception_ce, 0, \"%pS\", message);\n \t} else {\n-\t\tzend_error_noreturn(E_ERROR, \"%s\", ZSTR_VAL(message));\n+\t\tzend_error_noreturn(E_ERROR, \"%pS\", message);\n \t}\n \n \tzend_string_release(message);\n@@ -1863,25 +1863,24 @@ ZEND_API ZEND_COLD void zend_illegal_container_offset(const zend_string *contain\n \t\t\tif (zend_string_equals(container, ZSTR_KNOWN(ZEND_STR_STRING))) {\n \t\t\t\tzend_throw_error(NULL, \"Cannot unset string offsets\");\n \t\t\t} else {\n-\t\t\t\tzend_type_error(\"Cannot unset offset of type %s on %s\", zend_zval_type_name(offset), ZSTR_VAL(container));\n+\t\t\t\tzend_type_error(\"Cannot unset offset of type %s on %pS\", zend_zval_type_name(offset), container);\n \t\t\t}\n \t\t\treturn;\n \t\tdefault:\n-\t\t\tzend_type_error(\"Cannot access offset of type %s on %s\",\n-\t\t\t\tzend_zval_type_name(offset), ZSTR_VAL(container));\n+\t\t\tzend_type_error(\"Cannot access offset of type %s on %pS\",\n+\t\t\t\tzend_zval_type_name(offset), container);\n \t\t\treturn;\n \t}\n }\n \n ZEND_API ZEND_COLD void zend_type_error(const char *format, ...) /* {{{ */\n {\n \tva_list va;\n-\tchar *message = NULL;\n \n \tva_start(va, format);\n-\tzend_vspprintf(&message, 0, format, va);\n-\tzend_throw_exception(zend_ce_type_error, message, 0);\n-\tefree(message);\n+\tzend_string *message = zend_vstrpprintf(0, format, va);\n+\tzend_throw_exception_ex(zend_ce_type_error, 0, \"%pS\", message);\n+\tzend_string_release(message);\n \tva_end(va);\n } /* }}} */\n \n@@ -1901,12 +1900,11 @@ ZEND_API ZEND_COLD void zend_argument_count_error(const char *format, ...) /* {{\n ZEND_API ZEND_COLD void zend_value_error(const char *format, ...) /* {{{ */\n {\n \tva_list va;\n-\tchar *message = NULL;\n \n \tva_start(va, format);\n-\tzend_vspprintf(&message, 0, format, va);\n-\tzend_throw_exception(zend_ce_value_error, message, 0);\n-\tefree(message);\n+\tzend_string *message = zend_vstrpprintf(0, format, va);\n+\tzend_throw_exception_ex(zend_ce_value_error, 0, \"%pS\", message);\n+\tzend_string_release(message);\n \tva_end(va);\n } /* }}} */\n \n@@ -2143,6 +2141,7 @@ ZEND_API void zend_alloc_ce_cache(zend_string *type_name)\n \tdo {\n \t\tret = ZEND_MAP_PTR_NEW_OFFSET();\n \t} while (ret <= 2);\n-\tGC_ADD_FLAGS(type_name, IS_STR_CLASS_NAME_MAP_PTR);\n \tGC_SET_REFCOUNT(type_name, ret);\n+\tZEND_ATOMIC_FENCE_RELEASE();\n+\tGC_ADD_FLAGS(type_name, IS_STR_CLASS_NAME_MAP_PTR);\n }"},{"sha":"5fe5ad2bd8a2e1130b55b0c594ada47d676d76d4","filename":"Zend/zend.h","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend.h","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend.h","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Fzend.h?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -19,7 +19,7 @@\n #ifndef ZEND_H\n #define ZEND_H\n \n-#define ZEND_VERSION \"4.6.0-dev\"\n+#define ZEND_VERSION \"4.6.0RC7\"\n \n #define ZEND_ENGINE_3\n "},{"sha":"5d6bd22027d4050163f140905e23f0f6f1551369","filename":"Zend/zend_API.c","status":"modified","additions":97,"deletions":123,"changes":220,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend_API.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend_API.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Fzend_API.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -34,7 +34,6 @@\n #include \"zend_enum.h\"\n #include \"zend_object_handlers.h\"\n #include \"zend_observer.h\"\n-#include \"zend_system_id.h\"\n \n #include <stdarg.h>\n \n@@ -88,7 +87,7 @@ ZEND_API ZEND_COLD void zend_wrong_property_read(const zval *object, zval *prope\n {\n \tzend_string *tmp_property_name;\n \tzend_string *property_name = zval_get_tmp_string(property, &tmp_property_name);\n-\tzend_error(E_WARNING, \"Attempt to read property \\\"%s\\\" on %s\", ZSTR_VAL(property_name), zend_zval_value_name(object));\n+\tzend_error(E_WARNING, \"Attempt to read property \\\"%pS\\\" on %s\", property_name, zend_zval_value_name(object));\n \tzend_tmp_string_release(tmp_property_name);\n }\n \n@@ -200,7 +199,7 @@ ZEND_API ZEND_COLD void ZEND_FASTCALL zend_wrong_parameters_none_error(void) /*\n \tuint32_t num_args = ZEND_CALL_NUM_ARGS(EG(current_execute_data));\n \tzend_string *func_name = get_active_function_or_method_name();\n \n-\tzend_argument_count_error(\"%s() expects exactly 0 arguments, %\" PRIu32 \" given\", ZSTR_VAL(func_name), num_args);\n+\tzend_argument_count_error(\"%pS() expects 