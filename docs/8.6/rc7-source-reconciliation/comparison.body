end_string *name) {\n+\t\tPHP_MD5Update(&context, ZSTR_VAL(name), ZSTR_LEN(name) + 1);\n+\t} ZEND_HASH_FOREACH_END();\n+\tZEND_HASH_MAP_FOREACH_PTR(&module_registry, zend_module_entry *mod) {\n+\t\tPHP_MD5Update(&context, mod->name, strlen(mod->name) + 1);\n+\t\tif (EXPECTED(mod->version != NO_VERSION_YET)) {\n+\t\t\tPHP_MD5Update(&context, mod->version, strlen(mod->version) + 1);\n+\t\t}\n+\t} ZEND_HASH_FOREACH_END();\n+\n \tPHP_MD5Final(digest, &context);\n \tzend_bin2hex(zend_system_id, digest, sizeof digest);\n \tfinalized = 1;"},{"sha":"1c409ec45a04c87cfb45e00c445a2996fa6218c1","filename":"Zend/zend_types.h","status":"modified","additions":8,"deletions":1,"changes":9,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend_types.h","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Fzend_types.h","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Fzend_types.h?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -23,6 +23,7 @@\n \n #include \"zend_portability.h\"\n #include \"zend_long.h\"\n+#include \"zend_atomic.h\"\n #include <stdbool.h>\n #include <stdint.h>\n \n@@ -961,7 +962,13 @@ static zend_always_inline uint32_t zend_gc_delref_ex(zend_refcounted_h *p, uint3\n #define OBJ_EXTRA_FLAGS(obj)\t\t((obj)->extra_flags)\n \n /* Fast class cache */\n-#define ZSTR_HAS_CE_CACHE(s)\t\t(GC_FLAGS(s) & IS_STR_CLASS_NAME_MAP_PTR)\n+static zend_always_inline bool zstr_has_ce_cache(const zend_string *s)\n+{\n+\tuint32_t type_info = ZEND_ATOMIC_LOAD_ACQUIRE_32(&GC_TYPE_INFO(s));\n+\treturn (type_info & (IS_STR_CLASS_NAME_MAP_PTR << GC_FLAGS_SHIFT)) != 0;\n+}\n+\n+#define ZSTR_HAS_CE_CACHE(s)\t\tzstr_has_ce_cache(s)\n #define ZSTR_GET_CE_CACHE(s)\t\tZSTR_GET_CE_CACHE_EX(s, 1)\n #define ZSTR_SET_CE_CACHE(s, ce)\tZSTR_SET_CE_CACHE_EX(s, ce, 1)\n "},{"sha":"351c67f2ab9fb9ad1d00877863acd6cd622601a9","filename":"Zend/zend_vm_def.h","status":"modified","additions":65,"