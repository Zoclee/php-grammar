com/repos/php/php-src/git/trees/832ed4194159a29656a69b048a1cf17e5dc76d45"},"url":"https://api.github.com/repos/php/php-src/git/commits/fbe85c10ae6f61f6e845322b5d9bc13a9023c101","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/php/php-src/commits/fbe85c10ae6f61f6e845322b5d9bc13a9023c101","html_url":"https://github.com/php/php-src/commit/fbe85c10ae6f61f6e845322b5d9bc13a9023c101","comments_url":"https://api.github.com/repos/php/php-src/commits/fbe85c10ae6f61f6e845322b5d9bc13a9023c101/comments","author":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3f06ea000209a95a3d0736c4585aeeeed8a6c052","url":"https://api.github.com/repos/php/php-src/commits/3f06ea000209a95a3d0736c4585aeeeed8a6c052","html_url":"https://github.com/php/php-src/commit/3f06ea000209a95a3d0736c4585aeeeed8a6c052"},{"sha":"b054073410eaad7c335f41311e76793df74f38da","url":"https://api.github.com/repos/php/php-src/commits/b054073410eaad7c335f41311e76793df74f38da","html_url":"https://github.com/php/php-src/commit/b054073410eaad7c335f41311e76793df74f38da"}]},{"sha":"954f79636e4e7f63ab2c0ce47a617b7beef755bf","node_id":"C_kwDOAB0LotoAKDk1NGY3OTYzNmU0ZTdmNjNhYjJjMGNlNDdhNjE3YjdiZWVmNzU1YmY","commit":{"author":{"name":"Jakub Zelenka","email":"bukka@php.net","date":"2026-11-01T20:12:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-01T20:12:57Z"},"message":"Report Io\\Poll level watchers with buffered stream data (#24017)\n\nA stream can hold unread data in its buffer while its descriptor is idle.\nstream_select() treats such a stream as readable but a level watcher\nlooked at the descriptor only, so a loop waiting for readability never\nwoke up (GH-23948).\n\nContext::wait() now checks level watchers with Read interest for buffered\ndata first and reports them with Read triggered. The backend is then asked\nwithout waiting so descriptor events are merged in and a watcher readable\nboth ways is returned once. Edge watchers are not affected. A one-shot\nreported from its buffer is disarmed like one fired by the backend and\nmodifyEvents() re-arms it. The check reads the stream buffer positions\nonly and does no IO.\n\nThe check is a handle operation so other handle types can provide it. It\nis registered separately as php_poll_handle_ext_ops because the handle ops\nstruct cannot grow without an ABI change. This is temporary and the\noperation moves to the ops struct in master.","tree":{"sha":"d522483faba9df5a88796cd44c299ef959860281","url":"https://api.github.com/repos/php/php-src/git/trees/d522483faba9df5a88796cd44c299ef959860281"},"url":"https://api.github.com/repos/php/php-src/git/commits/954f79636e4e7f63ab2c0ce47a617b7beef755bf","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq551JCRC1aQ7uu5UhlAAAqjIQABKjf84r4l6mG61iXrlwHHpN\nCXtd/pe8buoBXumBS1r3q93cCkHsVC5CVBYcWMOr/Z/HXshHp50KxYp2e+IHktuE\nBAVc8Zatw8Bpiw2xdqezyM7XrkKvtuBqMLwtDhr6Lmn45KJJF+D1jOFE0yiBlBdz\nsSjFv07cc8UlCJcUaEB5ndi8nO+EQT/YNr3c/vwOcomXl3U7Zkuw+y7DEQYqF2fs\nj34BzNMUVsZkRhWUS3eqUKS4dGjw4SOiXmyJF5FmP8pUHK9DbX/KbsnGKAUl5GSz\ny4LSrlvpHvMBtaGGFCTRH+UOqosqsqCgwE6uqovxyrtQT5ZN+AWvJJMMn7yOK1Yp\n1GcTwiITKpy57J+dFmAa8Wpo4cokdl5OABoJdSVkz/WYlKwYnyJWcfDuByxZ07H+\nH1wepF8SygVx57Fyn5sV7A3PwTgEg3T0gG96BdCqPEv89j8HAhupgBGWSaI7eRF/\n7d7EyCw/LDhaW9U69RpetMyUWqe7enZH9VYD9STJVz4RVZ/KlgDHW2rnXPAVdjho\npQSGxMeyGVrHle+cMqPojEmsZtVuKToZaVsoO+TzT14LI3ZlSPsgzIcm7FrI4Y4H\nElzNFKK5gmw6Ip/W21Gk1UtqTr5mPq5Nc1VFKDb3rdFauFexCusSTRyzem3edOo9\n2T/721gjzptUkaWDPCfi\n=LIjp\n-----END PGP SIGNATURE-----\n","payload":"tree d522483faba9df5a88796cd44c299ef959860281\nparent fbe85c10ae6f61f6e845322b5d9bc13a9023c101\nauthor Jakub Zelenka <bukka@php.net> 1793563977 +0100\ncommitter GitHub <noreply@github.com> 1793563977 +0100\n\nReport Io\\Poll level watchers with buffered stream data (#24017)\n\nA stream can hold unread data in its buffer while its descriptor is idle.\nstream_select() treats such a stream as readable but a level watcher\nlooked at the descriptor only, so a loop waiting for readability never\nwoke up (GH-23948).\n\nContext::wait() now checks level watchers with Read interest for buffered\ndata first and reports them with Read triggered. The backend is then asked\nwithout waiting so descriptor events are merged in and a watcher readable\nboth ways is returned once. Edge watchers are not affected. A one-shot\nreported from its buffer is disarmed like one fired by the backend and\nmodifyEvents() re-arms it. The check reads the stream buffer positions\nonly and does no IO.\n\nThe check is a handle operation so other handle types can provide it. It\nis registered separately as php_poll_handle_ext_ops because the handle ops\nstruct cannot grow without an ABI change. This is temporary and the\noperation moves to the ops struct in master.","verified_at":"2026-11-01T20:12:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/954f79636e4e7f63ab2c0ce47a617b7beef755bf","html_url":"https://github.com/php/php-src/commit/954f79636e4e7f63ab2c0ce47a617b7beef755bf","comments_url":"https://api.github.com/repos/php/php-src/commits/954f79636e4e7f63ab2c0ce47a617b7beef755bf/comments","author":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users/bukka/following{/other_user}","gists_url":"https://api.github.com/users/bukka/gists{/gist_id}","starred_url":"https://api.github.com/users/bukka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bukka/subscriptions","organizations_url":"https://api.github.com/users/bukka/orgs","repos_url":"https://api.github.com/users/bukka/repos","events_url":"https://api.github.com/users/bukka/events{/privacy}","received_events_url":"https://api.github.com/u