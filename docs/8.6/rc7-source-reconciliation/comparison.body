t\t}\n \n             for (; child_node != NULL; child_node = child_node->prev) {\n-                lexbor_libxml2_bridge_work_list_item_push(\n+                if (UNEXPECTED(!lexbor_libxml2_bridge_work_list_item_push(\n                     &work_list,\n                     child_node,\n                     entering_namespace,\n                     lxml_child_parent,\n                     current_lxml_ns,\n                     child_in_template\n-                );\n+                ))) {\n+                    retval = LEXBOR_LIBXML2_BRIDGE_STATUS_OOM;\n+                    break;\n+                }\n+            }\n+            if (UNEXPECTED(retval != LEXBOR_LIBXML2_BRIDGE_STATUS_OK)) {\n+                break;\n             }\n \n             xmlAttrPtr last_added_attr = NULL;\n@@ -379,6 +394,7 @@ lexbor_libxml2_bridge_status lexbor_libxml2_bridge_convert_document(\n         private_data\n     );\n     if (status != LEXBOR_LIBXML2_BRIDGE_STATUS_OK) {\n+        php_dom_remove_templated_content_in_subtree(private_data, (xmlNodePtr) lxml_doc);\n         xmlFreeDoc(lxml_doc);\n         return status;\n     }\n@@ -410,6 +426,7 @@ lexbor_libxml2_bridge_status lexbor_libxml2_bridge_convert_fragment(\n         private_data\n     );\n     if (status != LEXBOR_LIBXML2_BRIDGE_STATUS_OK) {\n+        php_dom_remove_templated_content_in_subtree(private_data, fragment);\n         xmlFreeNode(fragment);\n         return status;\n     }"},{"sha":"89dbf9f2765f7c395ab132830f0d5e117f5187c8","filename":"ext/dom/html_collection.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fdom%2Fhtml_collection.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fdom%2Fhtml_collection.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fdom%2Fhtml_collection.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -100,7 +