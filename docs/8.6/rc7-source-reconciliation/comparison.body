l":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e2fa0c9f7fef44b70106e33a72235c9dcd8ded26","url":"https://api.github.com/repos/php/php-src/commits/e2fa0c9f7fef44b70106e33a72235c9dcd8ded26","html_url":"https://github.com/php/php-src/commit/e2fa0c9f7fef44b70106e33a72235c9dcd8ded26"},{"sha":"ad687b622944ea8a840f27d67990e9caf1c8a22a","url":"https://api.github.com/repos/php/php-src/commits/ad687b622944ea8a840f27d67990e9caf1c8a22a","html_url":"https://github.com/php/php-src/commit/ad687b622944ea8a840f27d67990e9caf1c8a22a"}]},{"sha":"38eabd0452df61e4d871f38e8afe2306490dd3b4","node_id":"C_kwDOAB0LotoAKDM4ZWFiZDA0NTJkZjYxZTRkODcxZjM4ZThhZmUyMzA2NDkwZGQzYjQ","commit":{"author":{"name":"Pavel Gushcha","email":"pavimus@gmail.com","date":"2026-10-09T17:12:07Z"},"committer":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-10-30T09:53:13Z"},"message":"Fix opcache.interned_strings_buffer being 0 in threads started later (ZTS)\n\nSince GH-23309 OnUpdateInternedStringsBuffer() rejects any change once\nOPcache is set up, to catch diverging php_admin_value settings of FPM\npools. Under ZTS every thread started after OPcache's startup re-applies\nthe INI entries with ZEND_INI_STAGE_STARTUP into its own, zeroed\nzend_accel_globals; the handler rejects that as well, logs a warning\nfor every new thread and leaves ZCG(accel_directives).\ninterned_strings_buffer at 0 in that thread (e.g. opcache_get_configuration()\nreports 0 under FrankenPHP and Apache mod_php with threaded MPMs).\n\nAccept the value at ZEND_INI_STAGE_STARTUP: it is the value the shared\nmemory was set up with. Changes at later stages (FPM pools use\nZEND_INI_STAGE_ACTIVATE) are still rejected.\n\nCloses GH-24275.","tree":{"sha":"66d90f368c32ad54a7a4b7bc1d36598945d8cc34","url":"https://api.github.com/repos/php/php-src/git/trees/66d90f368c32ad54a7a4b7bc1d36598945d8cc34"},"url":"https://api.github.com/repos/php/php-src/git/commits/38eabd0452df61e4d871f38e8afe2306490dd3b4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQ9DfdEemyeZbWie5HRzUrZbcKICAUCauRpEgAKCRDRzUrZbcKI\nCPuOAP9W+ZplAJZr5vZoBLh8BybzpNAZt/lrIErLdSnexT3jAwEA5efUXOmv5plt\n/kiVHZjLoV7dpSchCcDnpR1fNNKoIAE=\n=2od8\n-----END PGP SIGNATURE-----","payload":"tree 66d90f368c32ad54a7a4b7bc1d36598945d8cc34\nparent a077e8a4cdab252413de5788d91aaed7acb1f63c\nauthor Pavel Gushcha <pavimus@gmail.com> 1791565927 +0000\ncommitter ndossche <7771979+ndossche@users.noreply.github.com> 1793353993 +0100\n\nFix opcache.interned_strings_buffer being 0 in threads started later (ZTS)\n\nSince GH-23309 OnUpdateInternedStringsBuffer() rejects any change once\nOPcache is set up, to catch diverging php_admin_value settings of FPM\npools. Under ZTS every thread started after OPcache's startup re-applies\nthe INI entries with ZEND_INI_STAGE_STARTUP into its own, zeroed\nzend_accel_globals; the handler rejects that as well, logs a warning\nfor every new thread and leaves ZCG(accel_directives).\ninterned_strings_buffer at 0 in that thread (e.g. opcache_get_configuration()\nreports 0 under FrankenPHP and Apache mod_php with threaded MPMs).\n\nAccept the value at ZEND_INI_STAGE_STARTUP: it is the value the shared\nmemory was set up with. Changes at later stages (FPM pools use\nZEND_INI_STAGE_ACTIVATE) are still rejected.\n\nCloses GH-24275.\n","verified_at":"2026-10-30T09:54:13Z"}},"url":"https://api.github.com/repos/php/php-src/commits/38eabd0452df61e4d871f38e8afe2306490dd3b4","html_url":"https://github.com/php/php-src/commit/38eabd0452df61e4d871f38e8afe2306490dd3b4","comments_url":"https://api.github.com/repos/php/php-src/commits/38eabd0452df61e4d871f38e8afe2306490dd3b4/comments","author":{"login":"pavimus","id":594233,"node_id":"MDQ6VXNlcjU5NDIzMw==","avatar_url":"https://avatars.githubusercontent.com/u/594233?v=4","gravatar_id":"","url":"https://api.github.com/users/pavimus","html_url":"https://github.com/pavimus","followers_url":"https://api.github.com/users/pavimus/followers","following_url":"https://api.github.com/users/pavimus/following{/other_user}","gists_url":"https://api.github.com/users/pavimus/gists{/gist_id}","starred_url":"https://api.github.com/users/pavimus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pavimus/subscriptions","organizations_url":"https://api.github.com/users/pavimus/orgs","repos_url":"https://api.github.com/users/pavimus/repos","events_url":"https://api.github.com/users/pavimus/events{/privacy}","received_events_url":"https://api.github.com/users/pavimus/received_events","type":"User","user_view_type":"public","site_admin":