ned in WeakMap\", obj_addr->ce->name, obj_addr->handle);\n \t\t\t\treturn NULL;\n \t\t\t}\n \t\t\treturn NULL;"},{"sha":"26d5a5d7444aea3f5064a77fc976c80f45aa2085","filename":"configure.ac","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/configure.ac","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/configure.ac","contents_url":"https://api.github.com/repos/php/php-src/contents/configure.ac?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -23,7 +23,7 @@ dnl Basic autoconf initialization, generation of config.nice.\n dnl ----------------------------------------------------------------------------\n \n AC_PREREQ([2.68])\n-AC_INIT([PHP],[8.6.0-dev],[https://github.com/php/php-src/issues],[php],[https://www.php.net])\n+AC_INIT([PHP],[8.6.0RC7],[https://github.com/php/php-src/issues],[php],[https://www.php.net])\n AC_CONFIG_SRCDIR([main/php_version.h])\n AC_CONFIG_MACRO_DIR([build])\n AC_CONFIG_AUX_DIR([build])"},{"sha":"4d5ea0b85e5fe8e57ae0592602cfca11271f5a31","filename":"ext/com_dotnet/com_typeinfo.c","status":"modified","additions":43,"deletions":2,"changes":45,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcom_dotnet%2Fcom_typeinfo.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcom_dotnet%2Fcom_typeinfo.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fcom_dotnet%2Fcom_typeinfo.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -298,6 +298,39 @@ PHP_COM_DOTNET_API ITypeLib *php_com_load_typelib_via_cache(const char *search_s\n \treturn TL;\n }\n \n+static ITypeInfo *php_com_find_impl_typeinfo(ITypeInfo *coinfo, const GUID *iid)\n+{\n+\tITypeInfo *found = NULL;\n+\tTYPEATTR *coattr;\n+\n+\tif (FAILED(ITypeInfo_GetTypeAttr(coinfo, &coattr))) {\n+\t\treturn NULL;\n+\t}\n+\n+\tfor (unsigned int i = 0; i < coattr->cImplTypes && !found; i++) {\n+\t\tHREFTYPE rt;\n+\t\tITypeInfo *implinfo;\n+\t\tTYPEATTR *implattr;\n+\n+\t\tif (FAILED(ITypeInfo_GetRefTypeOfImplType(coinfo, i, &rt)) ||\n+\t\t\t\tFAILED(ITypeInfo_GetRefTypeInfo(coinfo, rt, &implinfo))) {\n+\t\t\tcontinue;\n+\t\t}\n+\t\tif (SUCCEEDED(ITypeInfo_GetTypeAttr(implinfo, &implattr))) {\n+\t\t\tif (IsEqualGUID(&implattr->guid, iid)) {\n+\t\t\t\tfound = implinfo;\n+\t\t\t}\n+\t\t\tITypeInfo_ReleaseTypeAttr(implinfo, implattr);\n+\t\t}\n+\t\tif (!found) {\n+\t\t\tITypeInfo_Release(implinfo);\n+\t\t}\n+\t}\n+\n+\tITypeInfo_ReleaseTypeAttr(coinfo, coattr);\n+\treturn found;\n+}\n+\n ITypeInfo *php_com_locate_typeinfo(zend_string *type_lib_name, php_com_dotnet_object *obj,\n \tzend_string *dispatch_name, bool sink)\n {\n@@ -314,6 +347,14 @@ ITypeInfo *php_com_locate_typeinfo(zend_string *type_lib_name, php_com_dotnet_ob\n \n \t\t\t\tif (SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(&obj->v), &IID_IProvideClassInfo2, (void**)&pci2))) {\n \t\t\t\t\tgotguid = SUCCEEDED(IProvideClassInfo2_GetGUID(pci2, GUIDKIND_DEFAULT_SOURCE_DISP_IID, &iid));\n+\t\t\t\t\tif (gotguid) {\n+\t\t\t\t\t\tITypeInfo *coinfo;\n+\n+\t\t\t\t\t\tif (SUCCEEDED(IProvideClassInfo2_GetClassInfo(pci2, &coinfo))) {\n+\t\t\t\t\t\t\ttypeinfo = php_com_find_impl_typeinfo(coinfo, &iid);\n+\t\t\t\t\t\t\tITypeInfo_Release(coinfo);\n+\t\t\t\t\t\t}\n+\t\t\t\t\t}\n \t\t\t\t\tIProvideClassInfo2_Release(pci2);\n \t\t\t\t}\n \t\t\t\tif (!gotguid && SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(&obj->v), &IID_IProvideClassInfo, (void**)&pci))) {\n@@ -404,8 +445,6 @@ ITypeInfo *php_com_locate_typeinfo(zend_string *type_lib_name, php_com_dotnet_ob\n \n \n \t\tefree(olename);\n-\t} else if (gotguid) {\n-\t\tITypeLib_GetTypeInfoOfGuid(typelib, &iid, &typeinfo);\n \t}\n \n \tif (typelib) {\n@@ -635,6 +674,8 @@ bool php_com_process_typeinfo(ITypeInfo *typeinfo, HashTable *id_to_name, bool p\n \t\t}\n \t} else {\n \t\tzend_throw_error(NULL, \"Type kind must be dispatchable, %08x given\", attr->typekind);\n+\t\tITypeInfo_ReleaseTypeAttr(typeinfo, attr);\n+\t\treturn false;\n \t}\n \n \tITypeInfo_ReleaseTypeAttr(typeinfo, attr);"},{"sha":"eba601c9d1d07e70ed3348d851906512f079b0ed","filename":"ext/com_dotnet/tests/gh25008.phpt","status":"added","additions":58,"deletions":0,"changes":58,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcom_dotnet%2Ftests%2Fgh25008.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcom_dotnet%2Ftests%2Fgh25008.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fcom_dotnet%2Ftests%2Fgh25008.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,58 @@\n+--TEST--\n+GH-25008 (com_event_sink and com_print_typeinfo crash on a NULL source typelib)\n+--EXTENSIONS--\n+com_dotnet\n+--INI--\n+com.autoregister_typelib=0\n+--SKIPIF--\n+<?php\n+try {\n+    new COM('WinHttp.WinHttpRequest.5.1');\n+    new COM('Scripting.Dictionary');\n+} catch (com_exception $e) {\n+    die('skip WinHttp or Scripting.Dictionary is not available');\n+}\n+?>\n+--FILE--\n+<?php\n+$o = new COM('WinHttp.WinHttpRequest.5.1', null, CP_UTF8);\n+\n+try {\n+    var_dump(com_event_sink($o, new stdClass));\n+    echo \"sink: no error\\n\";\n+} catch (Error $e) {\n+    echo 'sink: ', $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+\n+ob_start();\n+$events = com_print_typeinfo($o, null, true);\n+$events_dump = ob_get_clean();\n+echo 'events: ';\n+var_dump($events);\n+echo (str_contains($events_dump, 'class IWinHttpRequestEvents')\n+    && str_contains($events_dump, '{F97F4E15-B787-4212-80D1-D380CBBF982E}')\n+    && str_contains($events_dump, 'function OnResponseStart'))\n+    ? \"events interface\\n\" : \"events missing\\n\";\n+\n+ob_start();\n+$request = com_print_typeinfo($o, null, false);\n+$request_dump = ob_get_clean();\n+echo 'request: ';\n+var_dump($request);\n+echo (str_contains($request_dump, 'class IWinHttpRequest')\n+    && str_contains($request_dump, '{016FE2EC-B2C8-45F8-B23B-39E53A75396B}'))\n+    ? \"request interface\\n\" : \"request missing\\n\";\n+\n+$d = new COM('Scripting.Dictionary');\n+echo 'dictionary: ';\n+var_dump(com_event_sink($d, new stdClass));\n+?>\n+--EXPECTF--\n+sink: Error: Type kind must be dispatchable, 00000003 given\n+events: bool(true)\n+events interface\n+request: bool(true)\n+request interface\n+dictionary: \n+Warning: com_event_sink(): IProvideClassInfo: this code not yet written! in %s on line %d\n+bool(false)"},{"sha":"f56fcdcea1ba6c1a6e7e0f480475a91e97d50d14","filename":"ext/curl/interface.c","status":"modified","additions":12,"deletions":2,"changes":14,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcurl%2Finterface.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcurl%2Finterface.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fcurl%2Finterface.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -796,6 +796,10 @@ static int curl_ssh_hostkeyfunction(void *clientp, int keytype, const char *key,\n \tphp_curl *ch = (php_curl *)clientp;\n \tint rval = CURLKHMATCH_MISMATCH; /* cancel connection in case of an exception */\n \n+\tif (!ZEND_FCC_INITIALIZED(ch->handlers.sshhostkey)) {\n+\t\treturn rval;\n+\t}\n+\n #if PHP_CURL_DEBUG\n \tfprintf(stderr, \"curl_ssh_hostkeyfunction() called\\n\");\n \tfprintf(stderr, \"clientp = %p, keytype = %d, key = %s, keylen = %zu\\n\", clientp, keytype, key, keylen);\n@@ -1274,8 +1278,11 @@ static void php_curl_copy_fcc_with_option(php_curl *ch, CURLoption option, zend_\n {\n \tif (ZEND_FCC_INITIALIZED(*source_fcc)) {\n \t\tzend_fcc_dup(target_fcc, source_fcc);\n-\t\tcurl_easy_setopt(ch->cp, option, (void *) ch);\n \t}\n+\n+\t/* The callback data (i.e. pointer to the curl handle) stays even if a user callback\n+\t * is reset to NULL. Ensure the data pointer always points to the new handle. */\n+\tcurl_easy_setopt(ch->cp, option, (void *) ch);\n }\n \n void _php_setup_easy_copy_handlers(php_curl *ch, php_curl *source)\n@@ -1295,6 +1302,10 @@ void _php_setup_easy_copy_handlers(php_curl *ch, php_curl *source)\n \t\tZ_ADDREF(source->handlers.write_header->stream);\n \t}\n \tch->handlers.write_header->stream = source->handlers.write_header->stream;\n+\tif (!Z_ISUNDEF(source->handlers.std_err)) {\n+\t\tZ_ADDREF(source->handlers.std_err);\n+\t}\n+\tch->handlers.std_err = source->handlers.std_err;\n \n \tch->handlers.write->fp = source->handlers.write->fp;\n \tch->handlers.write_header->fp = source->handlers.write_header->fp;\n@@ -1315,7 +1326,6 @@ void _php_setup_easy_copy_handlers(php_curl *ch, php_curl *source)\n \tcurl_easy_setopt(ch->cp, CURLOPT_FILE,              (void *) ch);\n \tcurl_easy_setopt(ch->cp, CURLOPT_INFILE,            (void *) ch);\n \tcurl_easy_setopt(ch->cp, CURLOPT_WRITEHEADER,       (void *) ch);\n-\tcurl_easy_setopt(ch->cp, CURLOPT_DEBUGDATA,         (void *) ch);\n \n \tphp_curl_copy_fcc_with_option(ch, CURLOPT_SEEKDATA, &ch->handlers.seek, &source->handlers.seek);\n \tphp_curl_copy_fcc_with_option(ch, CURLOPT_PROGRESSDATA, &ch->handlers.progress, &source->handlers.progress);"},{"sha":"1f362f472f98ba924fce87d94cfae0042066fc5f","filename":"ext/curl/tests/curl_copy_handle_progress_null_uaf.phpt","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcurl%2Ftests%2Fcurl_copy_handle_progress_null_uaf.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcurl%2Ftests%2Fcurl_copy_handle_progress_null_uaf.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fcurl%2Ftests%2Fcurl_copy_handle_progress_null_uaf.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,27 @@\n+--TEST--\n+Cloning a curl handle whose CURLOPT_PROGRESSFUNCTION was reset to null must not reference the source handle\n+--EXTENSIONS--\n+curl\n+--FILE--\n+<?php\n+$srcfile = __DIR__ . '/curl_copy_handle_progress_null_uaf.txt';\n+file_put_contents($srcfile, \"Test.\");\n+\n+$ch1 = curl_init();\n+curl_setopt($ch1, CURLOPT_URL, \"file://\" . $srcfile);\n+curl_setopt($ch1, CURLOPT_RETURNTRANSFER, true);\n+curl_setopt($ch1, CURLOPT_NOPROGRESS, false);\n+curl_setopt($ch1, CURLOPT_PROGRESSFUNCTION, fn() => 0);\n+curl_setopt($ch1, CURLOPT_PROGRESSFUNCTION, null);\n+\n+$ch2 = clone $ch1;\n+unset($ch1);\n+\n+var_dump(curl_exec($ch2));\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/curl_copy_handle_progress_null_uaf.txt');\n+?>\n+--EXPECT--\n+string(5) \"Test.\""},{"sha":"9a46a27dfa0c7ff709f427d33ae4939b1c0e01fe","filename":"ext/curl/tests/curl_copy_handle_stderr_uaf.phpt","status":"added","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcurl%2Ftests%2Fcurl_copy_handle_stderr_uaf.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fcurl%2Ftests%2Fcurl_copy_handle_stderr_uaf.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fcurl%2Ftests%2Fcurl_copy_handle_stderr_uaf.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,38 @@\n+--TEST--\n+Cloning a curl handle keeps CURLOPT_STDERR tracked so a closed stream is detected on the clone too\n+--EXTENSIONS--\n+curl\n+--FILE--\n+<?php\n+$srcfile = __DIR__ . '/curl_copy_handle_stderr_uaf_src.txt';\n+file_put_contents($srcfile, \"Test.\");\n+\n+$stderrfile = __DIR__ . '/curl_copy_handle_stderr_uaf_stderr.txt';\n+$stream = fopen($stderrfile, 'w+');\n+\n+$ch1 = curl_init();\n+curl_setopt($ch1, CURLOPT_URL, \"file://\" . $srcfile);\n+curl_setopt($ch1, CURLOPT_RETURNTRANSFER, 1);\n+curl_setopt($ch1, CURLOPT_VERBOSE, true);\n+curl_setopt($ch1, CURLOPT_STDERR, $stream);\n+\n+$ch2 = clone $ch1;\n+\n+fclose($stream);\n+\n+var_dump(curl_exec($ch1));\n+var_dump(curl_exec($ch2));\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/curl_copy_handle_stderr_uaf_src.txt');\n+@unlink(__DIR__ . '/curl_copy_handle_stderr_uaf_stderr.txt');\n+?>\n+--EXPECTF--\n+Warning: curl_exec(): CURLOPT_STDERR resource has gone away, resetting to stderr in %s on line %d\n+%A\n+string(5) \"Test.\"\n+\n+Warning: curl_exec(): CURLOPT_STDERR resource has gone away, resetting to stderr in %s on line %d\n+%A\n+string(5) \"Test.\""},{"sha":"f317d4aa898454df08bae494f8be22978e2bf135","filename":"ext/date/lib/parse_date.c","status":"modified","additions":150,"deletions":114,"changes":264,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fdate%2Flib%2Fparse_date.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fdate%2Flib%2Fparse_date.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fdate%2Flib%2Fparse_date.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -1,9 +1,9 @@\n-/* Generated by re2c 1.0.3 on Thu Oct  1 17:09:49 2026 */\n+/* Generated by re2c 1.0.3 on Thu Nov  5 15:34:09 2026 */\n #line 1 \"ext/date/lib/parse_date.re\"\n /*\n  * The MIT License (MIT)\n  *\n- * Copyright (c) 2015-2023 Derick Rethans\n+ * Copyright (c) 2015-2026 Derick Rethans\n  * Copyright (c) 2018 MongoDB, Inc.\n  *\n  * Permission is hereby granted, free of charge, to any person obtaining a copy\n@@ -68,7 +68,11 @@\n #define TIMELIB_RELATIVE       310\n \n #define TIMELIB_ERROR          999\n-#define TIMELIB_MAX_ERRORS     1000\n+#define TIMELIB_MAX_ERRORS      16\n+#define TIMELIB_MAX_ERRORS_S  \"16\"\n+\n+#define TIMELIB_WARN_TOO_MANY_WARNINGS_S \"There are more than \" TIMELIB_MAX_ERRORS_S \" warnings, which are not returned\"\n+#define TIMELIB_ERR_TOO_MANY_ERRORS_S \"There are more than \" TIMELIB_MAX_ERRORS_S \" errors, which are not returned\"\n \n /* Some compilers like AIX, defines uchar in sys/types.h */\n #undef uchar\n@@ -363,12 +367,20 @@ static timelib_error_message *alloc_error_message(timelib_error_message **messag\n \n static void add_warning(Scanner *s, int error_code, const char *error)\n {\n+\ttimelib_error_message *message;\n+\n+\tif (s->errors->warning_count == TIMELIB_MAX_ERRORS) {\n+\t\tmessage = alloc_error_message(&s->errors->warning_messages, &s->errors->warning_count);\n+\t\tmessage->error_code = TIMELIB_WARN_TOO_MANY_WARNINGS;\n+\t\tmessage->position = -1;\n+\t\tmessage->character = 0;\n+\t\tmessage->message = timelib_strdup(TIMELIB_WARN_TOO_MANY_WARNINGS_S);\n+\t}\n \tif (s->errors->warning_count >= TIMELIB_MAX_ERRORS) {\n \t\treturn;\n \t}\n \n-\ttimelib_error_message *message = alloc_error_message(&s->errors->warning_messages, &s->errors->warning_count);\n-\n+\tmessage = alloc_error_message(&s->errors->warning_messages, &s->errors->warning_count);\n \tmessage->error_code = error_code;\n \tmessage->position = s->tok ? s->tok - s->str : 0;\n \tmessage->character = s->tok ? *s->tok : 0;\n@@ -377,12 +389,20 @@ static void add_warning(Scanner *s, int error_code, const char *error)\n \n static void add_error(Scanner *s, int error_code, const char *error)\n {\n+\ttimelib_error_message *message;\n+\n+\tif (s->errors->error_count == TIMELIB_MAX_ERRORS) {\n+\t\tmessage = alloc_error_message(&s->errors->error_messages, &s->errors->error_count);\n+\t\tmessage->error_code = TIMELIB_ERR_TOO_MANY_ERRORS;\n+\t\tmessage->position = -1;\n+\t\tmessage->character = 0;\n+\t\tmessage->message = timelib_strdup(TIMELIB_ERR_TOO_MANY_ERRORS_S);\n+\t}\n \tif (s->errors->error_count >= TIMELIB_MAX_ERRORS) {\n \t\treturn;\n \t}\n \n-\ttimelib_error_message *message = alloc_error_message(&s->errors->error_messages, &s->errors->error_count);\n-\n+\tmessage = alloc_error_message(&s->errors->error_messages, &s->errors->error_count);\n \tmessage->error_code = error_code;\n \tmessage->position = s->tok ? s->tok - s->str : 0;\n \tmessage->character = s->tok ? *s->tok : 0;\n@@ -391,12 +411,20 @@ static void add