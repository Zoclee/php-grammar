28f55f6b2","comments_url":"https://api.github.com/repos/php/php-src/commits/bbb21f0336a1b4a50cd57e55c81f0d328f55f6b2/comments","author":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users/bukka/following{/other_user}","gists_url":"https://api.github.com/users/bukka/gists{/gist_id}","starred_url":"https://api.github.com/users/bukka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bukka/subscriptions","organizations_url":"https://api.github.com/users/bukka/orgs","repos_url":"https://api.github.com/users/bukka/repos","events_url":"https://api.github.com/users/bukka/events{/privacy}","received_events_url":"https://api.github.com/users/bukka/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users/bukka/following{/other_user}","gists_url":"https://api.github.com/users/bukka/gists{/gist_id}","starred_url":"https://api.github.com/users/bukka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bukka/subscriptions","organizations_url":"https://api.github.com/users/bukka/orgs","repos_url":"https://api.github.com/users/bukka/repos","events_url":"https://api.github.com/users/bukka/events{/privacy}","received_events_url":"https://api.github.com/users/bukka/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"29d840a1b424fc2ff48f89911270f533b2e9f261","url":"https://api.github.com/repos/php/php-src/commits/29d840a1b424fc2ff48f89911270f533b2e9f261","html_url":"https://github.com/php/php-src/commit/29d840a1b424fc2ff48f89911270f533b2e9f261"},{"sha":"43c2c77a180a095c616654c26600140f1ed3d20e","url":"https://api.github.com/repos/php/php-src/commits/43c2c77a180a095c616654c26600140f1ed3d20e","html_url":"https://github.com/php/php-src/commit/43c2c77a180a095c616654c26600140f1ed3d20e"}]},{"sha":"985b66bb6723a7191ae0bbc5cb94a0eb0654d3af","node_id":"C_kwDOAB0LotoAKDk4NWI2NmJiNjcyM2E3MTkxYWUwYmJjNWNiOTRhMGViMDY1NGQzYWY","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-10-22T11:34:23Z"},"committer":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-01T15:11:35Z"},"message":"Fix GH-24531: Crash when flushing a renamed zip-based phar\n\nWhen phar->fp is not open, phar_zip_flush() reopens the archive by name,\nand if the file was renamed or removed the stream holding the original\ncontents is NULL. phar_zip_changed_apply_int() already skipped the seek on\na NULL stream but still copied unmodified entries from it. Fail the flush\nwith the existing copy error instead, as tar and native phar archives\nalready do. Directories and empty entries need no original data and still\nflush.\n\nFixes GH-24531\nCloses GH-24535","tree":{"sha":"28acfc6f4bdb5bf64a737cadc4e2238a4cbccfa3","url":"https://api.github.com/repos/php/php-src/git/trees/28acfc6f4bdb5bf64a737cadc4e2238a4cbccfa3"},"url":"https://api.github.com/repos/php/php-src/git/commits/985b66bb6723a7191ae0bbc5cb94a0eb0654d3af","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgdYhKZ4kd7+tlpRbDZ0aP7UxDG4\ndIRutl3Ksx2/yts4sAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQK93LjNqD4wDCyQF8Zz1nPhEyxSHYUtY+znjxe0uXVbMF2WEkF3zCnKXEqmf+F6cZx\nvMzUg6egxjc5fh+FrQ1Ac=\n-----END SSH SIGNATURE-----","payload":"tree 28acfc6f4bdb5bf64a737cadc4e2238a4cbccfa3\nparent 0857fdc252af319c8cf139bedaf1d4d935a37aca\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1792668863 -0400\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793545895 -0500\n\nFix GH-24531: Crash when flushing a renamed zip-based phar\n\nWhen phar->fp is not open, phar_zip_flush() reopens the archive by name,\nand if the file was renamed or removed the stream holding the original\ncontents is NULL. phar_zip_changed_apply_int() already skipped the seek on\na NULL stream but still copied unmodified entries from it. Fail the flush\nwith the existing copy error instead, as tar and native phar archives\nalready do. Directories and empty entries need no original data and still\nflush.\n\nFixes GH-24531\nCloses GH-24535\n","verified_at":"2026-11-01T15:19:12Z"}},"url":"https://api.github.com/repos/php/php-src/commits/985b66bb6723a7191ae0bbc5cb94a0eb0654d3af","html_url":"https://github.com/php/php-src/commit/985b66bb6723a7191ae0bbc5cb94a0eb0654d3af","comments_url":"https://api.github.com/repos/php/php-src/commits/985b66bb6723a7191ae0bbc5cb94a0eb0654d3af/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committe