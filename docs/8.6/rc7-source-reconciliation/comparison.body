lEScherzer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DanielEScherzer/subscriptions","organizations_url":"https://api.github.com/users/DanielEScherzer/orgs","repos_url":"https://api.github.com/users/DanielEScherzer/repos","events_url":"https://api.github.com/users/DanielEScherzer/events{/privacy}","received_events_url":"https://api.github.com/users/DanielEScherzer/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"952452704e7fed7b5c7fdac864d9244f059b1fe4","url":"https://api.github.com/repos/php/php-src/commits/952452704e7fed7b5c7fdac864d9244f059b1fe4","html_url":"https://github.com/php/php-src/commit/952452704e7fed7b5c7fdac864d9244f059b1fe4"}]},{"sha":"a077e8a4cdab252413de5788d91aaed7acb1f63c","node_id":"C_kwDOAB0LotoAKGEwNzdlOGE0Y2RhYjI1MjQxM2RlNTc4OGQ5MWFhZWQ3YWNiMWY2M2M","commit":{"author":{"name":"lazerg","email":"lazerg2@gmail.com","date":"2026-10-29T09:47:29Z"},"committer":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-10-30T02:02:04Z"},"message":"Fix GH-25029: Align the fileinfo built-in magic database (#25030)\n\nphp_magic_database is an unsigned char array with only byte alignment,\nbut apprentice_map() accesses it as uint32_t and struct magic. On strict\nalignment CPUs such as ARMv5, an unaligned header can be read incorrectly,\ncausing the built-in database to be rejected and finfo calls to fail.\nCross-compiling for armv5te with -Os can expose the missing alignment.\n\nUse ZEND_SET_ALIGNED(8, ...) in create_data_file.php and the generated\ndata_file.c to guarantee the alignment required by these accesses.\n\nFixes GH-25029\n\nCloses #25030","tree":{"sha":"e4a749927edb1321b7a9355ccd3610566410bbbc","url":"https://api.github.com/repos/php/php-src/git/trees/e4a749927edb1321b7a9355ccd3610566410bbbc"},"url":"https://api.github.com/repos/php/php-src/git/commits/a077e8a4cdab252413de5788d91aaed7acb1f63c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQJPBAABCAA5FiEEaDXx4YiBo+JEKqlm6j2Y1d107h8FAmrj+p0bFIAAAAAABAAO\nbWFudTIsMi41KzEuMTIsMiwxAAoJEOo9mNXddO4fZRoQAKbuaB7v1iRscTC7+ROj\naqP91cMpVe+GtoBZyXtppt2HFCjFxs39YVSfsktxInyGIXlA8M8ZqmYJixMQhZO/\nlrzVthl0Fcr5lbsJG01rJ1BhdHJVbOzw3Sw4R7NRD3656LgN6Hd/DMUZ4AdMbCrL\njQ5gJXNjFUTTaxG6AYYiFfHe0wk2UuhBOJyBzzcAeGfVwcqvyUYats1Urd0bvcVe\nxsLYQfUI5SmAF1sh+n6y6W72PsDHfbXvZmHH0QVXjqoOn7+amRqYK011dy+iCEzN\nkrpkBYNfmYQwRZ46hRzqIi4h7ofc3raxnkCLbInOZI6QzKbJrCKfd+2HJkDrUzk5\nJw8hnh9Cu0vlTiuSQFcecJhH+sI2w2Yi/e8YXCFtWrlfVEAlt6qQvLOGruZOOtJV\nLNkJo0jZGgyCH0ZuAeSDjMPiucgMXVIEI/a27jYhn+kCqhVIGV30v68opTgOK6FV\nYMLWXDpTkaEfTFoENg/hMgNfJVbyLojIStc9Es26myMbp88JrWoMvJR0cVAlQp6x\nQnAuPLVdywR6FgmzEhb+fw3EyqHO3Uh/EyQlItzM/02RbZcRwDVStngulumVUBrj\n1Z7znSkGGQ7EREoFmnTXOp6zQOt8z3t8cAlrAW1kY5jOw8Sjuz5VvAjiuFM5ztGL\n/oHQrbI8V4XS6L69vd+p7qh9\n=Kgrh\n-----END PGP SIGNATURE-----","payload":"tree e4a749927edb1321b7a9355ccd3610566410bbbc\nparent 083e1a6d79d8e913cec95f251c3c830709f5da92\nauthor lazerg <lazerg2@gmail.com> 1793267249 +0000\ncommitter Weilin Du <weilindu@php.net> 1793325724 +0800\n\nFix GH-25029: Align the fileinfo built-in magic database (#25030)\n\nphp_magic_database is an unsigned char array with only byte alignment,\nbut apprentice_map() accesses it as uint32_t and struct magic. On strict\nalignment CPUs such as ARMv5, an unaligned header can be read incorrectly,\ncausing the built-in database to be rejected and finfo calls to fail.\nCross-compiling for armv5te with -Os can expose the missing alignment.\n\nUse ZEND_SET_ALIGNED(8, ...) in create_data_file.php and the generated\ndata_file.c to guarantee the alignment required by these accesses.\n\nFixes GH-25029\n\nCloses #25030\n","verified_at":"2026-10-30T07:29:52Z"}},"url":"https://api.github.com/repos/php/php-src/commits/a077e8a4cdab252413de5788d91aaed7acb1f63c","html_url":"https://github.com/php/php-src/commit/a077e8a4cdab252413de5788d91aaed7acb1f63c","comments_url":"https://api.github.com/repos/php/php-src/commits/a077e8a4cdab252413de5788d91aaed7acb1f63c/comments","author":{"login":"lazerg","id":20501725,"node_id":"MDQ6VXNlcjIwNTAxNzI1","avatar_url":"https://avatars.githubusercontent.com/u/20501725?v=4","gravatar_id":"","url":"https://api.github.com/users/lazerg","html_url":"https://github.com/lazerg","followers_url":"https://api.github.com/users/lazerg/followers","following_url":"https://api.github.com/users/lazerg/following{/other_user}","gists_url":"https://api.github.com/users/lazerg/gists{/gist_id}","starred_url":"https://api.github.com/users/lazerg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazerg/subscriptions","organizations_url":"https://api.github.com/users/lazerg/orgs","repos_url":"https://api.github.com/users/lazerg/repos","events_url":"https://api.github.com/users/lazerg/events{/privacy}","received_events_url":"https://api.github.com/users/lazerg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"083e1a6d79d8e91