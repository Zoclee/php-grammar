c),\n \t\t\t\t\tjit_ZVAL_ADDR(jit, op1_addr),\n-\t\t\t\t\tir_CONST_ADDR(ZSTR_VAL(name)));\n+\t\t\t\t\tir_CONST_ADDR(name));\n \n \t\t\t\tir_IJMP(jit_STUB_ADDR(jit, jit_stub_exception_handler));\n \t\t\t\tir_IF_TRUE(if_obj);\n@@ -16164,7 +16212,7 @@ static int zend_jit_fetch_static_prop(zend_jit_ctx *jit, const zend_op *opline,\n \tzend_class_entry *ce;\n \n \tce = zend_get_known_class(op_array, opline, opline->op2_type, opline->op2);\n-\tif (ce && (opline->op2_type == IS_CONST || !(ce->ce_flags & ZEND_ACC_TRAIT))) {\n+\tif (ce) {\n \t\tzval *zv = RT_CONSTANT(opline, opline->op1);\n \t\tzend_string *prop_name;\n \n@@ -16533,7 +16581,7 @@ static int zend_jit_switch(zend_jit_ctx *jit, const zend_op *opline, const zend_\n \t\t\t\t\tif (fallback_label) {\n \t\t\t\t\t\tjit_guard_Z_TYPE(jit, op1_addr, IS_REFERENCE, fallback_label);\n \t\t\t\t\t} else {\n-\t\t\t\t\t\tir_ref if_ref = jit_if_Z_TYPE(jit, op1_addr, IS_STRING);\n+\t\t\t\t\t\tir_ref if_ref = jit_if_Z_TYPE(jit, op1_addr, IS_REFERENCE);\n \t\t\t\t\t\tir_IF_FALSE_cold(if_ref);\n \t\t\t\t\t\tir_refs_add(slow_inputs, ir_END());\n \t\t\t\t\t\tir_IF_TRUE(if_ref);\n@@ -16543,7 +16591,7 @@ static int zend_jit_switch(zend_jit_ctx *jit, const zend_op *opline, const zend_\n \t\t\t\t\top1_addr = ZEND_ADDR_REF_ZVAL(ref2);\n \n \t\t\t\t\tif (fallback_label) {\n-\t\t\t\t\t\tjit_guard_Z_TYPE(jit, op1_addr, IS_LONG, fallback_label);\n+\t\t\t\t\t\tjit_guard_Z_TYPE(jit, op1_addr, IS_STRING, fallback_label);\n \t\t\t\t\t} else {\n \t\t\t\t\t\tif_string = jit_if_Z_TYPE(jit, op1_addr, IS_STRING);\n \t\t\t\t\t\tir_IF_FALSE_cold(if_string);\n@@ -17238,7 +17286,8 @@ static int zend_jit_trace_handler(zend_jit_ctx *jit, const zend_op_array *op_arr\n \t\t    opline->opcode == ZEND_GENERATOR_CREATE ||\n \t\t    opline->opcode == ZEND_INCLUDE_OR_EVAL ||\n \t\t    /* May enter a simple get hook. */\n-\t\t    opline->opcode == ZEND_FETCH_OBJ_R) {\n+\t\t    opline->opcode == ZEND_FETCH_OBJ_R ||\n+\t\t\topline->opcode == ZEND_FETCH_OBJ_FUNC_ARG) {\n \n \t\t\tjit_STORE_IP(jit, ir_AND_A(ref, ir_CONST_ADDR(~ZEND_VM_ENTER_BIT)));\n \t\t} else {\n@@ -17266,7 +17315,8 @@ static int zend_jit_trace_handler(zend_jit_ctx *jit, const zend_op_array *op_arr\n \t\t    opline->opcode == ZEND_GENERATOR_CREATE ||\n \t\t    opline->opcode == ZEND_INCLUDE_OR_EVAL ||\n \t\t    /* May enter a simple get hook. */\n-\t\t    opline->opcode == ZEND_FETCH_OBJ_R) {\n+\t\t    opline->opcode == ZEND_FETCH_OBJ_R ||\n+\t\t\topline->opcode == ZEND_FETCH_OBJ_FUNC_ARG) {\n \n \t\t\tir_ref addr = jit_EG(current_execute_data);\n "},{"sha":"4927a03ac8ce2983bf00935ff95884ea4f79a763","filename":"ext/opcache/jit/zend_jit_trace.c","status":"modified","additions":25,"deletions":18,"changes":43,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fjit%2Fzend_jit_trace.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fjit%2Fzend_jit_trace.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Fjit%2Fzend_jit_trace.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -348,6 +348,8 @@ static int zend_jit_trace_may_exit(const zend_op_array *op_array, const zend_op\n \t\t\t// TODO: recompilation may change target ???\n \t\t\treturn 0;\n #endif\n+\t\t/* FETCH_OBJ_FUNC_ARG may dispatch into the FETCH_OBJ_R handler (if sent by value). */\n+\t\tcase ZEND_FETCH_OBJ_FUNC_ARG:\n \t\tcase ZEND_FETCH_OBJ_R:\n \t\t\tif (opline->op2_type == IS_CONST) {\n \t\t\t\tconst zend_class_entry *ce = opline->op1_type == IS_UNUSED ? op_array->scope : NULL;\n@@ -1770,7 +1772,7 @@ static zend_ssa *zend_jit_trace_build_tssa(zend_jit_trace_rec *trace_buffer, uin\n \t\t\t\tif (i < op_array->last_var) {\n \t\t\t\t\tssa_var_info[i].type = MAY_BE_UNDEF | MAY_BE_RC1 | MAY_BE_RCN | MAY_BE_REF | MAY_BE_ANY  | MAY_BE_ARRAY_KEY_ANY | MAY_BE_ARRAY_OF_ANY | MAY_BE_ARRAY_OF_REF;\n \t\t\t\t} else {\n-\t\t\t\t\tssa_var_info[i].type = MAY_BE_RC1 | MAY_BE_RCN | MAY_BE_REF | MAY_BE_ANY | MAY_BE_ARRAY_KEY_ANY | MAY_BE_ARRAY_OF_ANY | MAY_BE_ARRAY_OF_REF;\n+\t\t\t\t\tssa_var_info[i].type = MAY_BE_RC1 | MAY_BE_RCN | MAY_BE_REF | MAY_BE_INDIRECT | MAY_BE_ANY | MAY_BE_ARRAY_KEY_ANY | MAY_BE_ARRAY_OF_ANY | MAY_BE_ARRAY_OF_REF;\n \t\t\t\t}\n \t\t\t}\n \t\t\tif (i < parent_vars_count) {\n@@ -3532,6 +3534,20 @@ static int zend_jit_trace_stack_needs_deoptimization(zend_jit_trace_stack *stack\n \treturn 0;\n }\n \n+/* While a trace is being compiled, a register-allocated variable is tracked by\n+ * its IR reference only (STACK_REG() is still ZREG_NONE). */\n+static bool zend_jit_trace_stack_has_unstored_refs(zend_jit_trace_stack *stack, uint32_t stack_size)\n+{\n+\tuint32_t i;\n+\n+\tfor (i = 0; i < stack_size; i++) {\n+\t\tif (STACK_REF(stack, i) && !(STACK_FLAGS(stack, i) & (ZREG_LOAD|ZREG_STORE))) {\n+\t\t\treturn 1;\n+\t\t}\n+\t}\n+\treturn 0;\n+}\n+\n static int zend_jit_trace_exit_needs_deoptimization(uint32_t trace_num, uint32_t exit_num)\n {\n \tconst zend_op *opline = zend_jit_traces[trace_num].exit_info[exit_num].opline;\n@@ -3736,7 +3752,7 @@ static void zend_jit_trace_update_condition_ranges(const zend_op *opline, const\n \tzend_long op1_min, op1_max, op2_min, op2_max;\n \n \tif ((OP1_INFO() & MAY_BE_ANY) != MAY_BE_LONG\n-\t || (OP1_INFO() & MAY_BE_ANY) != MAY_BE_LONG) {\n+\t || (OP2_INFO() & MAY_BE_ANY) != MAY_BE_LONG) {\n \t\treturn;\n \t}\n \n@@ -3811,7 +3827,7 @@ static void zend_jit_trace_update_condition_ranges(const zend_op *opline, const\n \t\t\t\t\tzend_jit_trace_set_var_range(\n \t\t\t\t\t\t&ssa->var_info[ssa_op->op2_use],\n \t\t\t\t\t\top2_min,\n-\t\t\t\t\t\top2_max != ZEND_LONG_MIN ?MIN(op2_max, op1_max - 1) : op1_max);\n+\t\t\t\t\t\top1_max != ZEND_LONG_MIN ? MIN(op2_max, op1_max - 1) : op2_max);\n \t\t\t\t}\n \t\t\t}\n \t\t\tbreak;\n@@ -5184,19 +5200,6 @@ static zend_vm_opcode_handler_t zend_jit_trace(zend_jit_trace_rec *trace_buffer,\n \t\t\t\t\t\t\t\t && ssa->vars[ssa_op->op1_def].alias == NO_ALIAS) {\n \t\t\t\t\t\t\t\t\tssa->var_info[ssa_op->op1_def].guarded_reference = 1;\n \t\t\t\t\t\t\t\t}\n-\t\t\t\t\t\t\t\tif (opline->result_type == IS_UNUSED) {\n-\t\t\t\t\t\t\t\t\tres_addr = 0;\n-\t\t\t\t\t\t\t\t} else {\n-\t\t\t\t\t\t\t\t\tres_addr = RES_REG_ADDR();\n-\t\t\t\t\t\t\t\t\tif (Z_MODE(res_addr) != IS_REG\n-\t\t\t\t\t\t\t\t\t && zend_jit_trace_next_is_send_result(opline, p, frame)) {\n-\t\t\t\t\t\t\t\t\t\tsend_result = 1;\n-\t\t\t\t\t\t\t\t\t\tres_addr = ZEND_ADDR_MEM_ZVAL(ZREG_RX, (opline+1)->result.var);\n-\t\t\t\t\t\t\t\t\t\tif (!zend_jit_reuse_ip(&ctx)) {\n-\t\t\t\t\t\t\t\t\t\t\tgoto jit_failure;\n-\t\t\t\t\t\t\t\t\t\t}\n-\t\t\t\t\t\t\t\t\t}\n-\t\t\t\t\t\t\t\t}\n \t\t\t\t\t\t\t\top1_def_addr = op1_addr;\n \t\t\t\t\t\t\t\top1_def_info &= ~MAY_BE_REF;\n \t\t\t\t\t\t\t} else if (op1_info & MAY_BE_REF) {\n@@ -5214,6 +5217,9 @@ static zend_vm_opcode_handler_t zend_jit_trace(zend_jit_trace_rec *trace_buffer,\n \t\t\t\t\t\t\tres_addr = RES_REG_ADDR();\n \t\t\t\t\t\t\tres_info = RES_INFO();\n \t\t\t\t\t\t\tif (Z_MODE(res_addr) != IS_REG\n+\t\t\t\t\t\t\t /* assignment to typed reference may cause conversion,\n+\t\t\t\t\t\t\t  * so SEND_VAL has to check the type of the result */\n+\t\t\t\t\t\t\t && !ref_addr\n \t\t\t\t\t\t\t && zend_jit_trace_next_is_send_result(opline, p, frame)) {\n \t\t\t\t\t\t\t\tsend_result = 1;\n \t\t\t\t\t\t\t\tres_addr = ZEND_ADDR_MEM_ZVAL(ZREG_RX, (opline+1)->result.var);\n@@ -6982,7 +6988,7 @@ static zend_vm_opcode_handler_t zend_jit_trace(zend_jit_trace_rec *trace_buffer,\n \n \t\t\t\t\t\t\tssa->var_info[j].type &= ~MAY_BE_GUARD;\n \t\t\t\t\t\t\top_type = concrete_type(ssa->var_info[j].type);\n-\t\t\t\t\t\t\tif (!zend_jit_type_guard(&ctx, NULL, EX_NUM_TO_VAR(i), op_type)) {\n+\t\t\t\t\t\t\tif (!zend_jit_type_guard(&ctx, (p+1)->opline, EX_NUM_TO_VAR(i), op_type)) {\n \t\t\t\t\t\t\t\tgoto jit_failure;\n \t\t\t\t\t\t\t}\n \t\t\t\t\t\t\tSET_STACK_TYPE(stack, i, op_type, 1);\n@@ -7265,7 +7271,8 @@ static zend_vm_opcode_handler_t zend_jit_trace(zend_jit_trace_rec *trace_buffer,\n \t\t\tif (trace_buffer->stop != ZEND_JIT_TRACE_STOP_RECURSIVE_RET) {\n \t\t\t\tif (!(t->flags & ZEND_JIT_TRACE_USES_INITIAL_IP)\n \t\t\t\t || (ra\n-\t\t\t\t  && zend_jit_trace_stack_needs_deoptimization(stack, op_array->last_var + op_array->T))) {\n+\t\t\t\t  && (zend_jit_trace_stack_needs_deoptimization(stack, op_array->last_var + op_array->T)\n+\t\t\t\t   || zend_jit_trace_stack_has_unstored_refs(stack, op_array->last_var + op_array->T)))) {\n \t\t\t\t\t/* Deoptimize to the first instruction of the loop */\n \t\t\t\t\tuint32_t exit_point = zend_jit_trace_get_exit_point(trace_buffer[1].opline, ZEND_JIT_EXIT_TO_VM);\n "},{"sha":"64c3beed8aeebf790a8f40bffc63ce23058aff64","filename":"ext/opcache/tests/bug78937_1.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fbug78937_1.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fbug78937_1.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fbug78937_1.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -19,5 +19,5 @@ var_dump(foo());\n ?>\n --EXPECTF--\n Warning: Can't preload unlinked class Bar@anonymous: Unknown parent Bar in %spreload_bug78937.inc on line 3\n-object(Bar@anonymous)#%d (0) {\n+object(Bar@anonymous%0%s)#%d (0) {\n }"},{"sha":"2415582054d10e91a8c2c601ce8cb775710a6344","filename":"ext/opcache/tests/bug78937_2.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fbug78937_2.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fbug78937_2.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fbug78937_2.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -20,5 +20,5 @@ var_dump(foo());\n ?>\n --EXPECTF--\n Warning: Can't preload unlinked class Bar@anonymous: Unknown parent Bar in %spreload_bug78937.inc on line 3\n-object(Bar@anonymous)#%d (0) {\n+object(Bar@anonymous%0%s)#%d (0) {\n }"},{"sha":"89f604597bd60dbca32c5cd81d94eddb6f440b68","filename":"ext/opcache/tests/gh17733.phpt","status":"added","additions":110,"deletions":0,"changes":110,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh17733.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh17733.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fgh17733.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,110 @@\n+--TEST--\n+GH-17733 (System entropy does not take into account function order, resulting in wrong functions possibly called in different configurations)\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+$cache = __DIR__ . '/' . 'gh17733';\n+$script = $cache . '/' . 'call.php';\n+mkdir($cache);\n+\n+function write_script(string $script, int $version): void {\n+    file_put_contents($script, <<<PHP\n+    <?php\n+    echo \"v$version\\n\";\n+    try {\n+        var_dump(str_repeat(\"ab\", 3));\n+    } catch (\\Throwable \\$e) {\n+        echo \\$e::class, \": \", \\$e->getMessage(), \"\\n\";\n+    }\n+    PHP);\n+}\n+\n+function run(string $cache, string $script, string $disable_functions): void {\n+    $ext = ini_get('extension_dir');\n+    $opcache = PHP_OS_FAMILY === 'Windows' ? 'php_opcache.dll' : 'opcache.so';\n+    $cmd = [PHP_BINARY, '-n', '-d', 'extension_dir=\"' . $ext . '\"'];\n+    if (file_exists($ext . '/' . $opcache)) {\n+        array_push($cmd, '-d', 'zend_extension=opcache');\n+    }\n+    array_push($cmd,\n+        '-d', 'opcache.enable_cli=1',\n+        '-d', 'opcache.file_cache=\"' . $cache . '\"',\n+        '-d', 'opcache.file_cache_only=1',\n+        '-d', 'opcache.file_update_protection=0',\n+        '-d', 'opcache.validate_timestamps=0', // Important to tell apart versions\n+        '-d', 'disable_functions=' . $disable_functions,\n+        $script,\n+    );\n+    $proc = proc_open($cmd, [1 => ['pipe', 'w'], 2 => ['redirect', 1]], $pipes);\n+    echo stream_get_contents($pipes[1]);\n+    proc_close($proc);\n+}\n+\n+function system_ids(string $cache): int {\n+    $pattern = PHP_OS_FAMILY === 'Windows' ? '/*/*' : '/*';\n+    return count(glob($cache . $pattern, GLOB_ONLYDIR));\n+}\n+\n+write_script($script, 1);\n+run($cache, $script, '');\n+var_dump(system_ids($cache));\n+\n+write_script($script, 2);\n+echo \"--- Same environment reuses the cache ---\\n\";\n+run($cache, $script, '');\n+var_dump(system_ids($cache));\n+\n+echo \"--- Shifted function table ---\\n\";\n+run($cache, $script, 'zend_version');\n+var_dump(system_ids($cache));\n+\n+echo \"--- Disabled function ---\\n\";\n+run($cache, $script, 'str_repeat');\n+var_dump(system_ids($cache));\n+\n+write_script($script, 3);\n+echo \"--- Each environment reuses its own cache ---\\n\";\n+run($cache, $script, 'zend_version');\n+run($cache, $script, 'str_repeat');\n+run($cache, $script, '');\n+var_dump(system_ids($cache));\n+?>\n+--CLEAN--\n+<?php\n+$cache = __DIR__ . '/' . 'gh17733';\n+if (is_dir($cache)) {\n+    $it = new RecursiveIteratorIterator(\n+        new RecursiveDirectoryIterator($cache, FilesystemIterator::SKIP_DOTS),\n+        RecursiveIteratorIterator::CHILD_FIRST\n+    );\n+    foreach ($it as $file) {\n+        $file->isDir() ? rmdir($file->getPathname()) : unlink($file->getPathname());\n+    }\n+    rmdir($cache);\n+}\n+?>\n+--EXPECT--\n+v1\n+string(6) \"ababab\"\n+int(1)\n+--- Same environment reuses the cache ---\n+v1\n+string(6) \"ababab\"\n+int(1)\n+--- Shifted function table ---\n+v2\n+string(6) \"ababab\"\n+int(2)\n+--- Disabled function ---\n+v2\n+Error: Call to undefined function str_repeat()\n+int(3)\n+--- Each environment reuses its own cache ---\n+v2\n+string(6) \"ababab\"\n+v2\n+Error: Call to undefined function str_repeat()\n+v1\n+string(6) \"ababab\"\n+int(3)"},{"sha":"67e20da9def519475679850898d50daa9c4e3d9a","filename":"ext/opcache/tests/gh23626.phpt","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh23626.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh23626.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fgh23626.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,59 @@\n+--TEST--\n+GH-23626: OPcache: orphaned temporaries cause leaks and assertions\n+--CREDITS--\n+Mrmaxmeier\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.optimization_level=-1\n+--FILE--\n+<?php\n+class D {\n+    public function __construct(public string $name) {}\n+    public function __clone() { $this->name .= '-clone'; }\n+    public function __destruct() { echo \"destruct {$this->name}\\n\"; }\n+}\n+\n+function test_assert($u) {\n+    (function () use ($u) {}) ** match (1) { 2 => 3 };\n+}\n+\n+function one($o) {\n+    (clone $o) ** match (1) { 2 => 3 };\n+}\n+\n+function two($a, $b) {\n+    (clone $a) ** ((clone $b) ** match (1) { 2 => 3 });\n+}\n+\n+function rope($o) {\n+    return \"x{$o->name}y\" . match (1) { 2 => 3 };\n+}\n+\n+$a = new D('a');\n+$b = new D('b');\n+\n+foreach (['test_assert' => [1], 'one' => [$a], 'two' => [$a, $b], 'rope' => [$a]] as $fn => $args) {\n+    try {\n+        $fn(...$args);\n+    } catch (\\UnhandledMatchError $e) {\n+        echo \"$fn: \", $e->getMessage(), \"\\n\";\n+    }\n+}\n+\n+unset($a, $b, $args, $e);\n+echo \"done\\n\";\n+?>\n+--EXPECT--\n+test_assert: Unhandled match case 1\n+destruct a-clone\n+one: Unhandled match case 1\n+destruct a-clone\n+destruct b-clone\n+two: Unhandled match case 1\n+rope: Unhandled match case 1\n+destruct b\n+destruct a\n+done"},{"sha":"99dad3386623e056c2d9cf553423acdea918dad1","filename":"ext/opcache/tests/gh24534.phpt","status":"added","additions":95,"deletions":0,"changes":95,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24534.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24534.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fgh24534.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,95 @@\n+--TEST--\n+GH-24534: Inheritance cache must not record an unlinked child as a dependency\n+--CREDITS--\n+Wim Winterberg\n+--EXTENSIONS--\n+opcache\n+--CONFLICTS--\n+server\n+--FILE--\n+<?php\n+$dir = __DIR__ . '/gh24534';\n+@mkdir($dir . '/src', 0777, true);\n+\n+file_put_contents($dir . '/autoload.php', <<<'PHP'\n+<?php\n+spl_autoload_register(static function (string $class): void {\n+    $file = __DIR__ . '/src/' . $class . '.php';\n+    if (is_file($file)) {\n+        require $file;\n+    }\n+});\n+PHP);\n+\n+file_put_contents($dir . '/src/EntityInterface.php', <<<'PHP'\n+<?php\n+interface EntityInterface\n+{\n+    public static function getById(int $id): ?self;\n+}\n+PHP);\n+\n+file_put_contents($dir . '/src/Entity.php', <<<'PHP'\n+<?php\n+abstract class Entity implements EntityInterface\n+{\n+    protected array $data = [];\n+}\n+PHP);\n+\n+file_put_contents($dir . '/src/UserBase.php', <<<'PHP'\n+<?php\n+abstract class UserBase extends Entity\n+{\n+    public const TABLE = 'user';\n+\n+    protected ?int $userId = null;\n+\n+    public static function getById(int $id): ?User\n+    {\n+        return null;\n+    }\n+}\n+PHP);\n+\n+file_put_contents($dir . '/src/User.php', <<<'PHP'\n+<?php\n+class User extends UserBase\n+{\n+}\n+PHP);\n+\n+file_put_contents($dir . '/base-first.php', <<<'PHP'\n+<?php\n+require __DIR__ . '/autoload.php';\n+echo 'base-first: ', UserBase::TABLE, PHP_EOL;\n+PHP);\n+\n+file_put_contents($dir . '/child-first.php', <<<'PHP'\n+<?php\n+require __DIR__ . '/autoload.php';\n+echo 'child-first: ', User::TABLE, PHP_EOL;\n+PHP);\n+\n+include 'php_cli_server.inc';\n+$ini = trim((string) getenv('TEST_PHP_EXTRA_ARGS'));\n+$ini .= ($ini !== '' ? ' ' : '') . '-d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.file_update_protection=0';\n+php_cli_server_start($ini);\n+\n+foreach (['base-first', 'child-first', 'base-first'] as $page) {\n+    echo file_get_contents('http://' . PHP_CLI_SERVER_ADDRESS . '/gh24534/' . $page . '.php');\n+}\n+?>\n+--CLEAN--\n+<?php\n+$dir = __DIR__ . '/gh24534';\n+foreach (['src/EntityInterface.php', 'src/Entity.php', 'src/UserBase.php', 'src/User.php', 'autoload.php', 'base-first.php', 'child-first.php'] as $file) {\n+    @unlink($dir . '/' . $file);\n+}\n+@rmdir($dir . '/src');\n+@rmdir($dir);\n+?>\n+--EXPECT--\n+base-first: user\n+child-first: user\n+base-first: user"},{"sha":"12374425c85902c23d6febc3c64f439fa9fc347e","filename":"ext/opcache/tests/gh24577.phpt","status":"added","additions":150,"deletions":0,"changes":150,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24577.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24577.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fgh24577.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,150 @@\n+--TEST--\n+Bug GH-24577: CE-cache flag on shared interned class name must not crash with concurrent access\n+--EXTENSIONS--\n+opcache\n+pcntl\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.interned_strings_buffer=8\n+opcache.file_update_protection=0\n+--FILE--\n+<?php\n+$consumerFile = __DIR__ . '/gh24577_consumer.inc';\n+$classesFile = __DIR__ . '/gh24577_classes.inc';\n+$gateFile = __DIR__ . '/gh24577_gate.tmp';\n+$readyPrefix = __DIR__ . '/gh24577_ready_';\n+$numClasses = 64;\n+$numReaders = 6;\n+\n+@unlink($gateFile);\n+\n+// 1. Consumer script: holds class-name string literals in SHM interned strings\n+//    buffer (with refcount = 2 and no CE-cache flag yet).\n+$consumerCode = \"<?php\\nfunction gh24577_names(): array {\\n    return [\\n\";\n+for ($i = 0; $i < $numClasses; $i++) {\n+    $consumerCode .= sprintf(\"        'ColdCacheClass%04d',\\n\", $i);\n+}\n+$consumerCode .= \"    ];\\n}\\n\";\n+$consumerCode .= <<<'PHP'\n+function gh24577_probe(array $names): bool {\n+    foreach ($names as $class) {\n+        if (class_exists($class, false)) {\n+            $obj = new $class();\n+            if (!($obj instanceof $class)) {\n+                return false;\n+            }\n+        }\n+    }\n+    return true;\n+}\n+PHP;\n+file_put_contents($consumerFile, $consumerCode);\n+touch($consumerFile, time() - 3600);\n+\n+// 2. Provider script: declares the classes, triggering CE-cache slot publication\n+//    on the pre-existing shared interned strings when persisted by the writer.\n+$classesCode = \"<?php\\n\";\n+for ($i = 0; $i < $numClasses; $i++) {\n+    $classesCode .= sprintf(\"class ColdCacheClass%04d {}\\n\", $i);\n+}\n+file_put_contents($classesFile, $classesCode);\n+touch($classesFile, time() - 3600);\n+\n+// Step 1: Warm up ONLY the consumer script in OPcache SHM so its class-name\n+// strings are interned in shared memory with refcount = 2.\n+$warmup = pcntl_fork();\n+if ($warmup === -1) {\n+    die(\"pcntl_fork failed\\n\");\n+} elseif ($warmup === 0) {\n+    require $consumerFile;\n+    $status = opcache_get_status();\n+    exit(isset($status['scripts'][$consumerFile]) ? 0 : 2);\n+}\n+pcntl_waitpid($warmup, $wstatus);\n+if (!pcntl_wifexited($wstatus) || pcntl_wexitstatus($wstatus) !== 0) {\n+    die(\"Warmup failed\\n\");\n+}\n+\n+// Step 2: Fork Readers (which load the cached consumer script first, acquiring\n+// the shared interned strings) and the Writer (which persists $classesFile),\n+// synchronized by a start barrier.\n+$children = [];\n+\n+for ($r = 0; $r < $numReaders; $r++) {\n+    $pid = pcntl_fork();\n+    if ($pid === -1) {\n+        die(\"pcntl_fork failed\\n\");\n+    } elseif ($pid === 0) {\n+        require $consumerFile;\n+        $names = gh24577_names();\n+        file_put_contents($readyPrefix . $r, '1');\n+        while (!file_exists($gateFile)) {\n+            usleep(100);\n+        }\n+        // Probe shared interned strings while writer is persisting $classesFile\n+        for ($iter = 0; $iter < 16; $iter++) {\n+            if (!gh24577_probe($names)) {\n+                exit(3);\n+            }\n+        }\n+        require $classesFile;\n+        if (!gh24577_probe($names)) {\n+            exit(4);\n+        }\n+        exit(0);\n+    }\n+    $children[] = $pid;\n+}\n+\n+$writer = pcntl_fork();\n+if ($writer === -1) {\n+    die(\"pcntl_fork failed\\n\");\n+} elseif ($writer === 0) {\n+    file_put_contents($readyPrefix . 'writer', '1');\n+    while (!file_exists($gateFile)) {\n+        usleep(100);\n+    }\n+    require $classesFile;\n+    $status = opcache_get_status();\n+    exit(isset($status['scripts'][$classesFile]) ? 0 : 5);\n+}\n+$children[] = $writer;\n+\n+// Wait until all readers and the writer are ready at the barrier\n+$expectedReady = array_map(fn($r) => $readyPrefix . $r, range(0, $numReaders - 1));\n+$expectedReady[] = $readyPrefix . 'writer';\n+foreach ($expectedReady as $readyFile) {\n+    while (!file_exists($readyFile)) {\n+        usleep(200);\n+    }\n+}\n+\n+// Release barrier so writer persists $classesFile while readers probe $names\n+file_put_contents($gateFile, '1');\n+\n+$failed = false;\n+foreach ($children as $pid) {\n+    pcntl_waitpid($pid, $status);\n+    if (!pcntl_wifexited($status) || pcntl_wexitstatus($status) !== 0) {\n+        $failed = true;\n+    }\n+}\n+\n+foreach ($expectedReady as $readyFile) {\n+    @unlink($readyFile);\n+}\n+@unlink($gateFile);\n+@unlink($consumerFile);\n+@unlink($classesFile);\n+\n+echo $failed ? \"Failed\\n\" : \"Done\\n\";\n+?>\n+--CLEAN--\n+<?php\n+foreach (glob(__DIR__ . '/gh24577_*') ?: [] as $f) {\n+    @unlink($f);\n+}\n+?>\n+--EXPECT--\n+Done"},{"sha":"d51e96835b2b740811cfb2b93e59644c473c3aff","filename":"ext/opcache/tests/gh24745.inc","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24745.inc","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24745.inc","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fgh24745.inc?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,4 @@\n+<?php\n+\n+#[Deprecated(message: 'bar')]\n+const FOO = 1;"},{"sha":"b35b0e45827d7aba5df7fe95639bb282017b1d3a","filename":"ext/opcache/tests/gh24745.phpt","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24745.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fgh24745.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fgh24745.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,20 @@\n+--TEST--\n+GH-24745: File cache loses attributes on constants on 32-bit builds\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_cache=\"{TMP}\"\n+opcache.file_cache_only=1\n+--FILE--\n+<?php\n+require __DIR__ . '/gh24745.inc';\n+\n+var_dump((new ReflectionConstant('FOO'))->getAttributes()[0]->getArguments());\n+?>\n+--EXPECT--\n+array(1) {\n+  [\"message\"]=>\n+  string(3) \"bar\"\n+}"},{"sha":"20fe7636ff087caf7d8ae1965eb5b4d8bcd17db3","filename":"ext/opcache/tests/issue0149.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fissue0149.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fissue0149.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fissue0149.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -22,7 +22,7 @@ unset($p);\n \n include \"php_cli_server.inc\";\n \n-$ini = '-d opcache.enable=1 -d opcache.enable_cli=1';\n+$ini = '-d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.file_update_protection=0';\n if (file_exists(ini_get('extension_dir').'/phar.'.PHP_SHLIB_SUFFIX)) {\n     $ini .= ' -d extension=phar.'.PHP_SHLIB_SUFFIX;\n }"},{"sha":"8a6abbc0e1c3fe558ac693facbfbef58d6ed0702","filename":"ext/opcache/tests/jit/and_003.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fand_003.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fand_003.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fand_003.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT BW_AND: 003 (non-encodable AArch64 logical immediate, wrong result)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+opcache.jit_buffer_size=64M\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip: 64-bit only\"); ?>\n+--FILE--\n+<?php\n+function foo($x) { return $x & 0x5555555555555554; }\n+var_dump(foo(-1));\n+?>\n+--EXPECT--\n+int(6148914691236517204)"},{"sha":"6debc67bf5e49d9d53d0b7a7e467295b68eab9bc","filename":"ext/opcache/tests/jit/and_004.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fand_004.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fand_004.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fand_004.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT BW_AND: 004 (non-encodable AArch64 logical immediate, illegal instruction)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+opcache.jit_buffer_size=64M\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip: 64-bit only\"); ?>\n+--FILE--\n+<?php\n+function foo($x) { return $x & 0x200000003; }\n+var_dump(foo(-1));\n+?>\n+--EXPECT--\n+int(8589934595)"},{"sha":"67179c0b128711a8006017b4007e014ea0cf19ac","filename":"ext/opcache/tests/jit/assign_dim_op_008.phpt","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_008.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_008.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_008.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,21 @@\n+--TEST--\n+JIT ASSIGN_DIM_OP: CONCAT of a temporary string into a null element\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--FILE--\n+<?php\n+function f($n) {\n+    $arr = [5 => null];\n+    $arr[5] .= dechex($n);\n+    return $arr;\n+}\n+var_dump(f(255));\n+?>\n+--EXPECT--\n+array(1) {\n+  [5]=>\n+  string(2) \"ff\"\n+}"},{"sha":"479a4fa079c0e365a7772c798d02e88a2eee45a5","filename":"ext/opcache/tests/jit/assign_dim_op_009.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_009.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_009.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_009.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT ASSIGN_DIM_OP: CONCAT of a temporary string into a referenced null element\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--FILE--\n+<?php\n+function f($n) {\n+    $arr = [5 => null];\n+    $r = &$arr[5];\n+    $arr[5] .= dechex($n);\n+    return $r;\n+}\n+var_dump(f(255));\n+?>\n+--EXPECT--\n+string(2) \"ff\""},{"sha":"2e50bef8577155f65a0f5b05e73a5d4202cb9fbe","filename":"ext/opcache/tests/jit/assign_dim_op_010.phpt","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_010.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_010.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_010.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,26 @@\n+--TEST--\n+JIT ASSIGN_DIM_OP: CONCAT of a temporary string into a typed reference\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--FILE--\n+<?php\n+class C {\n+    public ?string $p = null;\n+}\n+function f($n) {\n+    $c = new C;\n+    $arr = [5 => null];\n+    $arr[5] = &$c->p;\n+    $arr[5] .= dechex($n);\n+    return $c;\n+}\n+var_dump(f(255));\n+?>\n+--EXPECT--\n+object(C)#1 (1) {\n+  [\"p\"]=>\n+  string(2) \"ff\"\n+}"},{"sha":"5f95a9111a96f2a8fd175f142e35f9a669fc2a5b","filename":"ext/opcache/tests/jit/assign_dim_op_011.phpt","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_011.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_011.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_011.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,28 @@\n+--TEST--\n+JIT ASSIGN_DIM_OP: CONCAT of a temporary string into an ArrayAccess offset\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--FILE--\n+<?php\n+class A implements ArrayAccess {\n+    public $d = [];\n+    function offsetGet($o): mixed { return $this->d[$o] ?? null; }\n+    function offsetSet($o, $v): void { $this->d[$o] = $v; }\n+    function offsetExists($o): bool { return isset($this->d[$o]); }\n+    function offsetUnset($o): void {}\n+}\n+function f($n) {\n+    $a = new A;\n+    $a[5] .= dechex($n);\n+    return $a->d;\n+}\n+var_dump(f(255));\n+?>\n+--EXPECT--\n+array(1) {\n+  [5]=>\n+  string(2) \"ff\"\n+}"},{"sha":"e2f168708041b5211b7ca3f96579f62bb087b969","filename":"ext/opcache/tests/jit/assign_dim_op_012.phpt","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_012.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_012.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_op_012.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,26 @@\n+--TEST--\n+JIT ASSIGN_DIM_OP: ADD of a temporary array\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--FILE--\n+<?php\n+function f($n) {\n+    $arr = [5 => []];\n+    $arr[5] += $n ? [1, str_repeat(\"a\", $n)] : 1;\n+    return $arr;\n+}\n+var_dump(f(3));\n+?>\n+--EXPECT--\n+array(1) {\n+  [5]=>\n+  array(2) {\n+    [0]=>\n+    int(1)\n+    [1]=>\n+    string(3) \"aaa\"\n+  }\n+}"},{"sha":"9147f22354dcb8d67391190c433212047294bebe","filename":"ext/opcache/tests/jit/assign_dim_packed_string_key_001.phpt","status":"added","additions":31,"deletions":0,"changes":31,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,31 @@\n+--TEST--\n+JIT: string key write turns a packed array into a hash with integer keys (function JIT)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit_buffer_size=64M\n+opcache.jit=function\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function f() {\n+    $arr = [10, 11];\n+    for ($i = 2; $i >= 0; $i--) {\n+        $arr['b'] = true;\n+        echo $i, \":\\n\";\n+        var_dump($arr[$i]);\n+    }\n+}\n+f();\n+?>\n+--EXPECTF--\n+2:\n+\n+Warning: Undefined array key 2 in %s on line %d\n+NULL\n+1:\n+int(11)\n+0:\n+int(10)"},{"sha":"bbe512d1f475a9b885da4d38b2a381342ba4e6eb","filename":"ext/opcache/tests/jit/assign_dim_packed_string_key_002.phpt","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,22 @@\n+--TEST--\n+JIT: compound string key assignment turns a packed array into a hash with integer keys\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit_buffer_size=64M\n+opcache.jit=function\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function f() {\n+    $arr = [1, 2, 3];\n+    $arr[\"a\"] += 1;\n+    var_dump($arr[1]);\n+}\n+f();\n+?>\n+--EXPECTF--\n+Warning: Undefined array key \"a\" in %s on line %d\n+int(2)"},{"sha":"e28dbb4c8e39dda25a98bfab23d7eca7fca16656","filename":"ext/opcache/tests/jit/assign_dim_packed_string_key_003.phpt","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_003.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_003.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fassign_dim_packed_string_key_003.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,29 @@\n+--TEST--\n+JIT: nested string key write turns a packed array into a hash with integer keys (tracing JIT)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit_buffer_size=64M\n+opcache.jit=tracing\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function f($c) {\n+    $arr = [0 => 'x', 5 => 'y'];\n+    $arr['a'][32] = 1;\n+    $r = 0;\n+    for ($i = 0; $i < 100; $i++) {\n+        $r += isset($arr[0][$c]);\n+    }\n+    var_dump($r);\n+}\n+for ($k = 0; $k < 3; $k++) {\n+    f(0);\n+}\n+?>\n+--EXPECT--\n+int(100)\n+int(100)\n+int(100)"},{"sha":"562e4e1d5d70412e5f0baa50ab620ece8455fa36","filename":"ext/opcache/tests/jit/cmp_010.phpt","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fcmp_010.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fcmp_010.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fcmp_010.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,57 @@\n+--TEST--\n+JIT CMP: 010 Integer range must not be narrowed by a comparison with a non-integer operand\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=tracing\n+opcache.jit_hot_func=1\n+opcache.jit_hot_loop=1\n+opcache.jit_hot_return=1\n+opcache.jit_hot_side_exit=1\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php\n+if (PHP_INT_SIZE != 8) die(\"skip this test is for 64bit platform only\");\n+?>\n+--FILE--\n+<?php\n+function lt_float(int $x) {\n+    if ($x < 1.0e19) {\n+        return $x + 1;\n+    }\n+    return 0;\n+}\n+function lt_string(int $x) {\n+    if ($x < \"1e19\") {\n+        return $x + 1;\n+    }\n+    return 0;\n+}\n+function le_float(int $x) {\n+    if ($x <= -1.0e19) {\n+        return 0;\n+    }\n+    return $x - 1;\n+}\n+foreach ([1, 2, 3, PHP_INT_MAX] as $v) {\n+    $r = lt_float($v);\n+}\n+echo \"int < float: \";\n+var_dump($r);\n+foreach ([1, 2, 3, PHP_INT_MAX] as $v) {\n+    $r = lt_string($v);\n+}\n+echo \"int < numeric string: \";\n+var_dump($r);\n+foreach ([1, 2, 3, PHP_INT_MIN] as $v) {\n+    $r = le_float($v);\n+}\n+echo \"int <= float (false): \";\n+var_dump($r);\n+?>\n+--EXPECT--\n+int < float: float(9.223372036854776E+18)\n+int < numeric string: float(9.223372036854776E+18)\n+int <= float (false): float(-9.223372036854776E+18)"},{"sha":"2651180fde8f8f7907713bd62abaacb50459f54e","filename":"ext/opcache/tests/jit/function_vm_interrupt_enter_001.phpt","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Ffunction_vm_interrupt_enter_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Ffunction_vm_interrupt_enter_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Ffunction_vm_interrupt_enter_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,25 @@\n+--TEST--\n+Function JIT: decode the VM-enter bit after an interrupt callback\n+--EXTENSIONS--\n+opcache\n+zend_test\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=1201\n+opcache.jit_buffer_size=64M\n+zend_test.observer.set_vm_interrupt_on_begin=1\n+--FILE--\n+<?php\n+function compare($left, $right) {\n+    if ($left == $right) {\n+        return 11;\n+    }\n+    return 22;\n+}\n+\n+var_dump(compare(new VmInterruptComparable(1), new VmInterruptComparable(2)));\n+?>\n+--EXPECT--\n+int(22)"},{"sha":"018e29cf1133c180395f464dfe96a493985c7e8d","filename":"ext/opcache/tests/jit/gh23572.phpt","status":"added","additions":85,"deletions":0,"changes":85,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,85 @@\n+--TEST--\n+GH-23572: Tracing JIT calls the wrong self/parent static method from trait clones\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit=tracing\n+opcache.jit_buffer_size=16M\n+opcache.jit_hot_func=2\n+opcache.jit_hot_loop=255\n+opcache.jit_hot_return=255\n+opcache.jit_hot_side_exit=255\n+--FILE--\n+<?php\n+class ParentA {\n+    public static function method() {\n+        return 'parent A';\n+    }\n+}\n+\n+class ParentB {\n+    public static function method() {\n+        return 'parent B';\n+    }\n+}\n+\n+trait T {\n+    public function callParent() {\n+        return parent::method();\n+    }\n+\n+    public function callSelf() {\n+        return self::method();\n+    }\n+}\n+\n+class A extends ParentA {\n+    use T;\n+\n+    public static function method() {\n+        return 'self A';\n+    }\n+}\n+\n+class B extends ParentB {\n+    use T;\n+\n+    public static function method() {\n+        return 'self B';\n+    }\n+}\n+\n+$a = new A;\n+$b = new B;\n+\n+for ($i = 0; $i < 4; $i++) {\n+    var_dump($a->callParent());\n+}\n+var_dump($b->callParent());\n+var_dump($b->callParent());\n+var_dump($a->callParent());\n+\n+for ($i = 0; $i < 4; $i++) {\n+    var_dump($a->callSelf());\n+}\n+var_dump($b->callSelf());\n+var_dump($b->callSelf());\n+var_dump($a->callSelf());\n+?>\n+--EXPECT--\n+string(8) \"parent A\"\n+string(8) \"parent A\"\n+string(8) \"parent A\"\n+string(8) \"parent A\"\n+string(8) \"parent B\"\n+string(8) \"parent B\"\n+string(8) \"parent A\"\n+string(6) \"self A\"\n+string(6) \"self A\"\n+string(6) \"self A\"\n+string(6) \"self A\"\n+string(6) \"self B\"\n+string(6) \"self B\"\n+string(6) \"self A\""},{"sha":"d8db1e6341ce0198be3f556a99da89c2445b6680","filename":"ext/opcache/tests/jit/gh23572_001.phpt","status":"added","additions":61,"deletions":0,"changes":61,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,61 @@\n+--TEST--\n+GH-23572: Tracing JIT calls an instance method statically from trait clones\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit=tracing\n+opcache.jit_buffer_size=16M\n+opcache.jit_hot_func=2\n+opcache.jit_max_polymorphic_calls=0\n+--FILE--\n+<?php\n+trait T {\n+    public function callSelf() {\n+        return self::method();\n+    }\n+}\n+\n+class A {\n+    use T;\n+\n+    public static function method() {\n+        return 'A';\n+    }\n+}\n+\n+class B {\n+    use T;\n+\n+    public function method() {\n+        var_dump($this);\n+        return 'B';\n+    }\n+}\n+\n+$a = new A;\n+$b = new B;\n+\n+for ($i = 0; $i < 4; $i++) var_dump($a->callSelf());\n+for ($i = 0; $i < 4; $i++) var_dump($b->callSelf());\n+var_dump($a->callSelf());\n+?>\n+--EXPECTF--\n+string(1) \"A\"\n+string(1) \"A\"\n+string(1) \"A\"\n+string(1) \"A\"\n+object(B)#%d (0) {\n+}\n+string(1) \"B\"\n+object(B)#%d (0) {\n+}\n+string(1) \"B\"\n+object(B)#%d (0) {\n+}\n+string(1) \"B\"\n+object(B)#%d (0) {\n+}\n+string(1) \"B\"\n+string(1) \"A\""},{"sha":"15f35e3afa0ecc1f7365e689b92a4d8731e87919","filename":"ext/opcache/tests/jit/gh23572_002.phpt","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,22 @@\n+--TEST--\n+GH-23572: Function JIT resolves self:: in trait methods to the trait\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=1205\n+opcache.jit_buffer_size=16M\n+--FILE--\n+<?php\n+trait T {\n+    public function outer() { return self::inner(); }\n+    public function inner() { return static::class; }\n+}\n+class B { use T; }\n+var_dump((new B)->outer(), (new B)->outer());\n+?>\n+--EXPECT--\n+string(1) \"B\"\n+string(1) \"B\""},{"sha":"69bdf71779f558387e3573cc0d6a4e873361a472","filename":"ext/opcache/tests/jit/gh23572_003.phpt","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_003.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_003.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_003.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,28 @@\n+--TEST--\n+GH-23572: Function JIT calls a class override of a static trait method via self::\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=1205\n+opcache.jit_buffer_size=16M\n+--FILE--\n+<?php\n+trait T {\n+    public function callMethod() { return self::method(); }\n+    public static function method() { return 'T'; }\n+}\n+class A {\n+    use T;\n+    public function method() {\n+        $a = 1; $b = 2; $c = 3; $d = 4; $e = 5; $f = 6; $g = 7; $h = 8;\n+        return get_class($this) . ($a + $b + $c + $d + $e + $f + $g + $h);\n+    }\n+}\n+var_dump((new A)->callMethod(), (new A)->callMethod());\n+?>\n+--EXPECT--\n+string(3) \"A36\"\n+string(3) \"A36\""},{"sha":"3e73ee4e35bd71424226c1d48a582a63959ed0ed","filename":"ext/opcache/tests/jit/gh23572_004.phpt","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_004.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_004.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh23572_004.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,26 @@\n+--TEST--\n+GH-23572: Tracing JIT infers parent:: static property type from the wrong trait clone\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=tracing\n+opcache.jit_buffer_size=16M\n+opcache.jit_hot_func=2\n+--FILE--\n+<?php\n+class ParentA { public static int $x = 42; }\n+class ParentB { public static string $x = \"str\"; }\n+trait T {\n+    public function get() { return parent::$x; }\n+}\n+class A extends ParentA { use T; }\n+class B extends ParentB { use T; }\n+var_dump((new A)->get(), (new A)->get(), (new B)->get());\n+?>\n+--EXPECT--\n+int(42)\n+int(42)\n+string(3) \"str\""},{"sha":"8c8d5725f614746487ae20419926ab1d87b0eb60","filename":"ext/opcache/tests/jit/gh24389.phpt","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24389.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24389.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24389.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,30 @@\n+--TEST--\n+GH-24389 (Tracing JIT: type guard on entry of an inlined call exits with an uninitialized opline)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit_buffer_size=64M\n+opcache.jit=tracing\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function right($x, $y) {\n+    $a = $x + $y;\n+    return $x - $y;\n+}\n+function driver($x, $y) {\n+    $xr = &$x;\n+    $yr = &$y;\n+    for ($i = 0; $i < 300; $i++) {\n+        $r = right($x, $y);\n+    }\n+    return $r;\n+}\n+var_dump(driver(3, 2));\n+var_dump(driver(3.5, 2.5));\n+?>\n+--EXPECT--\n+int(1)\n+float(1)"},{"sha":"0ad5696b208f4e798e083a6932b208667ef8c2d5","filename":"ext/opcache/tests/jit/gh24396.phpt","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24396.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24396.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24396.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,22 @@\n+--TEST--\n+GH-24396: Assertion failure in zend_jit_def_reg() \"reg forwarding\" with chained Pi nodes\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--FILE--\n+<?php\n+function f() {\n+    $i = 0;\n+    do {\n+        $i = ($i + 1) & 255;\n+    } while ($i < 2 || $i > 200);\n+    return $i;\n+}\n+var_dump(f());\n+?>\n+--EXPECT--\n+int(2)"},{"sha":"1ef87a66f3dafee1c2d49b305815fd342a568933","filename":"ext/opcache/tests/jit/gh24397.phpt","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24397.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24397.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24397.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,23 @@\n+--TEST--\n+GH-24397 (JIT: stale label operand on a MERGE reduced to BEGIN)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit_buffer_size=64M\n+opcache.jit=function\n+opcache.jit_debug=0x1000000\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function f() {\n+    foreach ([1, 2] as $v) {\n+        $c[] = $v;\n+    }\n+}\n+f();\n+echo \"Done\\n\";\n+?>\n+--EXPECTF--\n+%ADone"},{"sha":"948ac8f1b26101fc4caaad32df2732c506ebe384","filename":"ext/opcache/tests/jit/gh24398.phpt","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24398.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24398.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24398.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,36 @@\n+--TEST--\n+GH-24398: Function JIT level 1 crash on FETCH_OBJ_FUNC_ARG of a hooked property\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit_buffer_size=64M\n+opcache.jit=1201\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+\n+class C {\n+    public $prop {\n+        get => 5;\n+    }\n+}\n+\n+if (true) {\n+    function g($x) {\n+        return $x;\n+    }\n+}\n+\n+function f($o) {\n+    return g($o->prop);\n+}\n+\n+$c = new C();\n+var_dump(f($c));\n+var_dump(f($c));\n+\n+?>\n+--EXPECT--\n+int(5)\n+int(5)"},{"sha":"b8b0c0481c779f1325c28cecbfd922367181170c","filename":"ext/opcache/tests/jit/gh24398_002.phpt","status":"added","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24398_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24398_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24398_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,44 @@\n+--TEST--\n+GH-24398 (tracing): FETCH_OBJ_FUNC_ARG of a hooked property with unknown send mode\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit_buffer_size=64M\n+opcache.jit=tracing\n+opcache.jit_hot_loop=1\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+\n+class A {\n+    public $prop = 5;\n+}\n+\n+class B {\n+    public $prop {\n+        get => 5;\n+    }\n+}\n+\n+if (true) {\n+    function g($x) {\n+        return $x;\n+    }\n+}\n+\n+function f($o) {\n+    // The named argument leaves the send mode unknown to the tracing JIT,\n+    // so FETCH_OBJ_FUNC_ARG is executed by the VM handler.\n+    return g(x: $o->prop);\n+}\n+\n+$sum = 0;\n+foreach ([new A, new A, new A, new B, new B, new B] as $o) {\n+    $sum += f($o);\n+}\n+var_dump($sum);\n+\n+?>\n+--EXPECT--\n+int(30)"},{"sha":"cc60764759c4906bacf9c1a95da9fd0919fd3268","filename":"ext/opcache/tests/jit/gh24436.phpt","status":"added","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24436.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24436.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24436.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,38 @@\n+--TEST--\n+GH-24436 (Tracing JIT: wrong value of assignment to typed reference passed as argument)\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit=tracing\n+--FILE--\n+<?php\n+class Box {\n+    public $v = 1;\n+    public float $f = 1;\n+    public string $s = \"\";\n+}\n+\n+function sink($x) {\n+    return $x;\n+}\n+\n+function work(&$x, $y) {\n+    return sink($x = $y + 2);\n+}\n+\n+$o = new Box;\n+foreach (['v', 'v', 'v', 'f', 's'] as $p) {\n+    var_dump(work($o->$p, 3));\n+}\n+var_dump($o->f, $o->s);\n+?>\n+--EXPECT--\n+int(5)\n+int(5)\n+int(5)\n+float(5)\n+string(1) \"5\"\n+float(5)\n+string(1) \"5\""},{"sha":"43ab8f9a5bd39f8148153cd4d0dafff37cbe8459","filename":"ext/opcache/tests/jit/gh24438.phpt","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24438.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24438.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24438.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,40 @@\n+--TEST--\n+GH-24438 (Tracing JIT preserves indirect arguments on side-trace entry)\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit_buffer_size=64M\n+opcache.jit=tracing\n+opcache.jit_hot_loop=1\n+opcache.jit_hot_func=1\n+opcache.jit_hot_return=1\n+opcache.jit_hot_side_exit=1\n+opcache.jit_max_polymorphic_calls=0\n+--FILE--\n+<?php\n+function byVal($value) {\n+    $value = (int) $value + 1000;\n+    return $value;\n+}\n+\n+function byRef(&$value) {\n+    $value = (int) $value + 1;\n+    return $value;\n+}\n+\n+$fns = ['byVal', 'byRef'];\n+$arr = [10, 20];\n+for ($i = 0; $i < 120; $i++) {\n+    $f = $fns[$i % 2];\n+    $f($arr[1]);\n+    $f($arr[0]);\n+}\n+\n+var_dump($arr[0], $arr[1]);\n+?>\n+--EXPECT--\n+int(70)\n+int(80)"},{"sha":"f8cd56e5bec1d20a0cf77710ae43ddbc1474bbb0","filename":"ext/opcache/tests/jit/gh24988.phpt","status":"added","additions":47,"deletions":0,"changes":47,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24988.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fgh24988.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fgh24988.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,47 @@\n+--TEST--\n+GH-24988 (JIT: crash in cleanup_live_vars when % by zero throws mid-expression)\n+--CREDITS--\n+waroad\n+jorgsowa\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit_buffer_size=64M\n+opcache.jit=function\n+opcache.optimization_level=0\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+\n+class D {\n+    function self() { return $this; }\n+    function __destruct() { echo \"dtor\\n\"; }\n+}\n+\n+// Leaves a stale object in the frame slot deep() uses for its first temporary\n+function pollute($a, $b, $c) {\n+    return $a->self()->self();\n+}\n+\n+function deep(int $a, int $b, int $c) {\n+    $a &= 255;\n+    return ($a + 1) - ($b + $b + (($a + 1) % ($b % $c)));\n+}\n+\n+$o = new D;\n+var_dump(deep(15, 3, 7));\n+pollute($o, 1, 2);\n+try {\n+    deep(15, 3, 0);\n+} catch (DivisionByZeroError $e) {\n+    echo $e->getMessage(), \"\\n\";\n+}\n+echo \"end\\n\";\n+\n+?>\n+--EXPECT--\n+int(9)\n+Modulo by zero\n+end\n+dtor"},{"sha":"897c0377d6c347b687dd0eb0e6286150701c3ff4","filename":"ext/opcache/tests/jit/init_static_method_call_002.phpt","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Finit_static_method_call_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Finit_static_method_call_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Finit_static_method_call_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,32 @@\n+--TEST--\n+JIT INIT_STATIC_METHOD_CALL: self:: in an included file keeps the called scope of a static caller\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=tracing\n+opcache.jit_hot_loop=1\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+\n+class A {\n+    public static function who() {\n+        return static::class;\n+    }\n+\n+    public static function test() {\n+        include __DIR__ . '/init_static_method_call_002_include.inc';\n+    }\n+}\n+\n+class B extends A {}\n+\n+B::test();\n+\n+?>\n+--EXPECT--\n+B\n+B\n+B"},{"sha":"66ea277d2da9d1c9ec3396f2f65a0446df460443","filename":"ext/opcache/tests/jit/init_static_method_call_002_include.inc","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Finit_static_method_call_002_include.inc","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Finit_static_method_call_002_include.inc","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Finit_static_method_call_002_include.inc?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,4 @@\n+<?php\n+for ($i = 0; $i < 3; $i++) {\n+    echo self::who(), \"\\n\";\n+}"},{"sha":"42196d595c4c310ed40fd27374bc9f2634c5fea4","filename":"ext/opcache/tests/jit/loop_vm_interrupt_001.phpt","status":"added","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Floop_vm_interrupt_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Floop_vm_interrupt_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Floop_vm_interrupt_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,38 @@\n+--TEST--\n+Tracing JIT: register-allocated loop variable must survive a VM interrupt raised in the loop body\n+--DESCRIPTION--\n+Comparing two VmInterruptComparable objects sets EG(vm_interrupt) without a\n+PHP function call, so the JIT only notices the interrupt at the end of the\n+loop. Before handing control to the VM there, it has to write $s back to\n+memory, or the loop continues with a stale value.\n+\n+This only shows up if $s is kept in a callee-saved register across the\n+comparison, which is why it's an int: x86_64 has no callee-saved floating\n+point registers, so a float would always be spilled to memory first.\n+--EXTENSIONS--\n+opcache\n+zend_test\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit=tracing\n+opcache.jit_buffer_size=64M\n+opcache.jit_hot_loop=1\n+--FILE--\n+<?php\n+function sum(array $objs, VmInterruptComparable $t): int {\n+    $s = 0;\n+    foreach ($objs as $o) {\n+        $s += 3;\n+        // Only VmInterruptComparable's compare handler raises the interrupt.\n+        $r = $o == $t;\n+    }\n+    return $s;\n+}\n+\n+$objs = array_fill(0, 200, new stdClass);\n+$objs[150] = new VmInterruptComparable(0);\n+var_dump(sum($objs, new VmInterruptComparable(0)));\n+?>\n+--EXPECT--\n+int(600)"},{"sha":"7adfd0fdf8950c9524b3238f63493cedb4f7b0ec","filename":"ext/opcache/tests/jit/or_001.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2For_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2For_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2For_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT BW_OR: 001 (non-encodable AArch64 logical immediate, wrong result)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+opcache.jit_buffer_size=64M\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip: 64-bit only\"); ?>\n+--FILE--\n+<?php\n+function foo($x) { return $x | 0x5555555555555554; }\n+var_dump(foo(0));\n+?>\n+--EXPECT--\n+int(6148914691236517204)"},{"sha":"8c2b37af297d91c679560782ece5d2d3416e3162","filename":"ext/opcache/tests/jit/or_002.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2For_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2For_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2For_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT BW_OR: 002 (non-encodable AArch64 logical immediate, illegal instruction)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+opcache.jit_buffer_size=64M\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip: 64-bit only\"); ?>\n+--FILE--\n+<?php\n+function foo($x) { return $x | 0x200000003; }\n+var_dump(foo(0));\n+?>\n+--EXPECT--\n+int(8589934595)"},{"sha":"ac8718d7d20b2592d4407b88488e392632b0435b","filename":"ext/opcache/tests/jit/preload_restart_function_jit.phpt","status":"added","additions":83,"deletions":0,"changes":83,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fpreload_restart_function_jit.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fpreload_restart_function_jit.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fpreload_restart_function_jit.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,83 @@\n+--TEST--\n+Preloaded functions JIT-compiled on script load must survive an OPcache restart\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php\n+if (PHP_OS_FAMILY == 'Windows') die('skip Preloading is not supported on Windows');\n+if (ini_get('opcache.jit') === false) die('skip PHP is compiled without JIT');\n+if (!(opcache_get_status()['jit']['on'] ?? false)) die('skip JIT is not available');\n+?>\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit=disable\n+opcache.jit_buffer_size=16M\n+--CONFLICTS--\n+server\n+--FILE--\n+<?php\n+$dir = __DIR__ . '/preload_restart_function_jit';\n+@mkdir($dir);\n+\n+file_put_contents($dir . '/preload.php', <<<'PHP'\n+<?php\n+function preloaded_sum(int $n): int {\n+    $s = 0;\n+    for ($i = 0; $i < $n; $i++) {\n+        $s += ($i * 3) ^ ($i >> 2);\n+    }\n+    return $s;\n+}\n+function preloaded_str(string $x): string {\n+    return strrev($x) . strlen($x);\n+}\n+PHP);\n+\n+file_put_contents($dir . '/call.php', <<<'PHP'\n+<?php\n+echo preloaded_sum(1000), \" \", preloaded_str(\"hello\"), \"\\n\";\n+PHP);\n+\n+file_put_contents($dir . '/reset.php', <<<'PHP'\n+<?php\n+var_dump(opcache_reset());\n+PHP);\n+\n+/* Compiling a new script after the restart reuses the rewound JIT buffer */\n+$code = \"<?php\\n\";\n+for ($i = 0; $i < 200; $i++) {\n+    $code .= \"function f$i(int \\$n): int { \\$s = $i; for (\\$k = 0; \\$k < \\$n; \\$k++) { \\$s = (\\$s * 31 + \\$k) % 1000003; } return \\$s; }\\n\";\n+}\n+$code .= \"echo f0(10) + f199(10), \\\"\\\\n\\\";\\n\";\n+file_put_contents($dir . '/new.php', $code);\n+\n+include __DIR__ . '/../php_cli_server.inc';\n+\n+$ini = '-d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.jit=function -d opcache.jit_buffer_size=16M'\n+    . ' -d opcache.validate_timestamps=0 -d opcache.file_update_protection=0 -d opcache.preload_user=root'\n+    . ' -d opcache.preload=' . $dir . '/preload.php';\n+if (file_exists(ini_get('extension_dir') . '/opcache.' . PHP_SHLIB_SUFFIX)) {\n+    $ini .= ' -d zend_extension=opcache.' . PHP_SHLIB_SUFFIX;\n+}\n+php_cli_server_start($ini);\n+\n+$base = 'http://' . PHP_CLI_SERVER_ADDRESS . '/jit/preload_restart_function_jit/';\n+foreach (['call', 'reset', 'new', 'call', 'call'] as $script) {\n+    echo @file_get_contents($base . $script . '.php') ?: \"no response\\n\";\n+}\n+?>\n+--CLEAN--\n+<?php\n+$dir = __DIR__ . '/preload_restart_function_jit';\n+foreach (['preload', 'call', 'reset', 'new'] as $script) {\n+    @unlink(\"$dir/$script.php\");\n+}\n+@rmdir($dir);\n+?>\n+--EXPECT--\n+1502868 olleh5\n+bool(true)\n+1289143\n+1502868 olleh5\n+1502868 olleh5"},{"sha":"3a2f625eedd6ca2e9b7399bdf123a4cda627fd95","filename":"ext/opcache/tests/jit/preload_restart_hot_counters.phpt","status":"added","additions":77,"deletions":0,"changes":77,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fpreload_restart_hot_counters.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fpreload_restart_hot_counters.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fpreload_restart_hot_counters.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,77 @@\n+--TEST--\n+Preloaded functions JIT-compiled by hot counters must be JIT-compiled again after an OPcache restart\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php\n+if (PHP_OS_FAMILY == 'Windows') die('skip Preloading is not supported on Windows');\n+if (ini_get('opcache.jit') === false) die('skip PHP is compiled without JIT');\n+if (!(opcache_get_status()['jit']['on'] ?? false)) die('skip JIT is not available');\n+?>\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.jit=1235\n+opcache.jit_buffer_size=16M\n+--CONFLICTS--\n+server\n+--FILE--\n+<?php\n+$dir = __DIR__ . '/preload_restart_hot_counters';\n+@mkdir($dir);\n+\n+file_put_contents($dir . '/preload.php', <<<'PHP'\n+<?php\n+function preloaded_sum(int $n): int {\n+    $s = 0;\n+    for ($i = 0; $i < $n; $i++) {\n+        $s += ($i * 3) ^ ($i >> 2);\n+    }\n+    return $s;\n+}\n+PHP);\n+\n+/* A dynamic call keeps the function out of the call graph of the calling script */\n+file_put_contents($dir . '/call.php', <<<'PHP'\n+<?php\n+$f = 'preloaded_sum';\n+echo $f(1000), \"\\n\";\n+PHP);\n+\n+file_put_contents($dir . '/reset.php', <<<'PHP'\n+<?php\n+var_dump(opcache_get_status()['jit']['on']);\n+var_dump(opcache_reset());\n+PHP);\n+\n+include __DIR__ . '/../php_cli_server.inc';\n+\n+$ini = '-d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.jit=1235 -d opcache.jit_buffer_size=16M'\n+    . ' -d opcache.jit_hot_func=1 -d opcache.validate_timestamps=0 -d opcache.file_update_protection=0'\n+    . ' -d opcache.preload_user=root -d opcache.preload=' . $dir . '/preload.php';\n+$opcache = ini_get('extension_dir') . '/opcache.' . PHP_SHLIB_SUFFIX;\n+if (file_exists($opcache)) {\n+    $ini .= ' -d zend_extension=' . $opcache;\n+}\n+php_cli_server_start($ini);\n+\n+$base = 'http://' . PHP_CLI_SERVER_ADDRESS . '/jit/preload_restart_hot_counters/';\n+$context = stream_context_create(['http' => ['timeout' => 5]]);\n+foreach (['call', 'reset', 'call', 'call'] as $script) {\n+    echo @file_get_contents($base . $script . '.php', false, $context) ?: \"no response\\n\";\n+}\n+?>\n+--CLEAN--\n+<?php\n+$dir = __DIR__ . '/preload_restart_hot_counters';\n+foreach (['preload', 'call', 'reset'] as $script) {\n+    @unlink(\"$dir/$script.php\");\n+}\n+@rmdir($dir);\n+?>\n+--EXPECT--\n+1502868\n+bool(true)\n+bool(true)\n+1502868\n+1502868"},{"sha":"580a1134c22ea73839e69b6d3dabca55381c6672","filename":"ext/opcache/tests/jit/switch_002.phpt","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fswitch_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fswitch_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fswitch_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,27 @@\n+--TEST--\n+JIT SWITCH_STRING on a reference holding a non-string value\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=tracing\n+opcache.jit_hot_loop=1\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function test($a) {\n+    $n = 0;\n+    foreach ($a as &$x) {\n+        switch ($x) {\n+            case \"a\": case \"b\": $n++; break;\n+        }\n+    }\n+    return $n;\n+}\n+var_dump(test([\"a\"]));\n+var_dump(test([1]));\n+?>\n+--EXPECT--\n+int(1)\n+int(0)"},{"sha":"2a33f6dac45702e338f2a5aeb57e7a7db117ff50","filename":"ext/opcache/tests/jit/switch_003.phpt","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fswitch_003.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fswitch_003.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fswitch_003.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,26 @@\n+--TEST--\n+JIT SWITCH_STRING on a reference (function JIT)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+--EXTENSIONS--\n+opcache\n+--FILE--\n+<?php\n+function test($a) {\n+    $n = 0;\n+    foreach ($a as &$x) {\n+        switch ($x) {\n+            case \"a\": case \"b\": $n++; break;\n+        }\n+    }\n+    return $n;\n+}\n+var_dump(test([\"a\", \"b\", \"c\"]));\n+var_dump(test([1]));\n+?>\n+--EXPECT--\n+int(2)\n+int(0)"},{"sha":"ed9bef7e10eb363dded864007d16db1f8d0402cf","filename":"ext/opcache/tests/jit/tailcall_vm_interrupt_opline_001.phpt","status":"added","additions":39,"deletions":0,"changes":39,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Ftailcall_vm_interrupt_opline_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Ftailcall_vm_interrupt_opline_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Ftailcall_vm_interrupt_opline_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,39 @@\n+--TEST--\n+Tracing JIT: preserve the next opline when handling a VM interrupt\n+--DESCRIPTION--\n+The object comparison raises an interrupt; the observer INI setting installs\n+an interrupt callback without enabling observer events. While recording the\n+caller, the backward jump must save its target before the interrupt helper\n+reloads the opline. Otherwise it revisits the already executed call opcode,\n+whose pending call frame has been consumed.\n+\n+At the time of writing this was failing on the TAILCALL VM, but this should\n+pass on all VMs.\n+--EXTENSIONS--\n+opcache\n+zend_test\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=tracing\n+opcache.jit_buffer_size=64M\n+opcache.jit_hot_func=1\n+opcache.jit_hot_loop=1\n+zend_test.observer.set_vm_interrupt_on_begin=1\n+--FILE--\n+<?php\n+function trigger(VmInterruptComparable $left, VmInterruptComparable $right): void {\n+    // Raise an interrupt without an internal call that would handle it immediately.\n+    $result = $left == $right;\n+}\n+\n+$left = new VmInterruptComparable(1);\n+$right = new VmInterruptComparable(2);\n+foreach ([1, 2, 3] as $i) {\n+    trigger($left, $right);\n+}\n+echo \"Done\\n\";\n+?>\n+--EXPECT--\n+Done"},{"sha":"0e13b0ca3bbd2fc31a1cdc88c953f43fd629202f","filename":"ext/opcache/tests/jit/tailcall_vm_interrupt_opline_002.phpt","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Ftailcall_vm_interrupt_opline_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Ftailcall_vm_interrupt_opline_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Ftailcall_vm_interrupt_opline_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,29 @@\n+--TEST--\n+Function JIT: preserve the next opline when handling a VM interrupt\n+--DESCRIPTION--\n+The object comparison raises an interrupt while the minimal function JIT\n+executes a callable opcode handler. The interrupt helper must resume at the\n+branch target, not reload the saved comparison opcode. No interrupt callback\n+is installed, isolating the saved-opline bug from callback resume-tag handling.\n+--EXTENSIONS--\n+opcache\n+zend_test\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=1201\n+opcache.jit_buffer_size=64M\n+--FILE--\n+<?php\n+function compare($left, $right) {\n+    if ($left == $right) {\n+        return 11;\n+    }\n+    return 22;\n+}\n+\n+var_dump(compare(new VmInterruptComparable(1), new VmInterruptComparable(2)));\n+?>\n+--EXPECT--\n+int(22)"},{"sha":"cb9709d841bd9d39ae3586f85abe4d836822329d","filename":"ext/opcache/tests/jit/xor_004.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fxor_004.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fxor_004.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fxor_004.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT XOR: 004 (non-encodable AArch64 logical immediate, wrong result)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+opcache.jit_buffer_size=64M\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip: 64-bit only\"); ?>\n+--FILE--\n+<?php\n+function foo($x) { return $x ^ 0x5555555555555554; }\n+var_dump(foo(0));\n+?>\n+--EXPECT--\n+int(6148914691236517204)"},{"sha":"b0afa9f1da8ab7bba8fb0768f28ae39042b228db","filename":"ext/opcache/tests/jit/xor_005.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fxor_005.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fjit%2Fxor_005.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fjit%2Fxor_005.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+JIT XOR: 005 (non-encodable AArch64 logical immediate, illegal instruction)\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.file_update_protection=0\n+opcache.jit=function\n+opcache.jit_buffer_size=64M\n+--EXTENSIONS--\n+opcache\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip: 64-bit only\"); ?>\n+--FILE--\n+<?php\n+function foo($x) { return $x ^ 0x200000003; }\n+var_dump(foo(0));\n+?>\n+--EXPECT--\n+int(8589934595)"},{"sha":"a3222bcf4636a25321dbbc46669d3e8d25915bdf","filename":"ext/opcache/tests/opt/block_pass_fast_call_op2.phpt","status":"added","additions":45,"deletions":0,"changes":45,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fopt%2Fblock_pass_fast_call_op2.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fopt%2Fblock_pass_fast_call_op2.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fopt%2Fblock_pass_fast_call_op2.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,45 @@\n+--TEST--\n+Block pass must not remove the source of the ZEND_FAST_CALL OP2 return value\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+--FILE--\n+<?php\n+function test_scalar() {\n+    $x = 1;\n+    try {\n+        try {\n+            return true ? 1.5 : 2.5;\n+        } finally {\n+            undef_fn();\n+        }\n+    } catch (Throwable $e) {\n+        echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+    }\n+    return \"fallback\";\n+}\n+\n+function test_refcounted() {\n+    $x = 1;\n+    try {\n+        try {\n+            return true ? \"returned\" : \"other\";\n+        } finally {\n+            undef_fn();\n+        }\n+    } catch (Throwable $e) {\n+        echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+    }\n+    return \"fallback\";\n+}\n+\n+var_dump(test_scalar());\n+var_dump(test_refcounted());\n+?>\n+--EXPECT--\n+Error: Call to undefined function undef_fn()\n+string(8) \"fallback\"\n+Error: Call to undefined function undef_fn()\n+string(8) \"fallback\""},{"sha":"7a784c8a28c8d5e166136bf1a46b3e70f762f824","filename":"ext/opcache/tests/opt/gh25061.phpt","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fopt%2Fgh25061.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fopt%2Fgh25061.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fopt%2Fgh25061.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,43 @@\n+--TEST--\n+GH-25061 ($x = $x - 1 on null is optimized to PRE_DEC)\n+--EXTENSIONS--\n+opcache\n+--INI--\n+opcache.enable=1\n+opcache.enable_cli=1\n+opcache.optimization_level=-1\n+--FILE--\n+<?php\n+\n+function nullable(?int $x)\n+{\n+    $x = $x - 1;\n+    return $x;\n+}\n+\n+function undef()\n+{\n+    $x = $x - 1;\n+    return $x;\n+}\n+\n+function twice(?int $x)\n+{\n+    $x = $x - 1;\n+    $x = $x - 1;\n+    return $x;\n+}\n+\n+var_dump(nullable(null));\n+var_dump(nullable(5));\n+var_dump(undef());\n+var_dump(twice(null));\n+\n+?>\n+--EXPECTF--\n+int(-1)\n+int(4)\n+\n+Warning: Undefined variable $x in %s on line %d\n+int(-1)\n+int(-2)"},{"sha":"746f83c004360f89d4589e799a2e54398b6818a8","filename":"ext/opcache/tests/preload_008.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fpreload_008.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Ftests%2Fpreload_008.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Ftests%2Fpreload_008.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -15,6 +15,6 @@ if (PHP_OS_FAMILY == 'Windows') die('skip Preloading is not supported on Windows\n <?php\n var_dump(get_anon());\n ?>\n---EXPECT--\n-object(class@anonymous)#1 (0) {\n+--EXPECTF--\n+object(class@anonymous%0%s)#1 (0) {\n }"},{"sha":"aa8826e69f16c43d40874ade9d2121af499ededb","filename":"ext/opcache/zend_accelerator_module.c","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fzend_accelerator_module.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fzend_accelerator_module.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Fzend_accelerator_module.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -102,7 +102,12 @@ static ZEND_INI_MH(OnUpdateMemoryConsumption)\n \n static ZEND_INI_MH(OnUpdateInternedStringsBuffer)\n {\n-\tif (accel_startup_ok) {\n+\t/* Under ZTS, every thread started later re-applies the INI entries at\n+\t * ZEND_INI_STAGE_STARTUP to fill its own globals. Accepting that is safe: the\n+\t * value comes from the global INI directives, so it is the one OPcache was\n+\t * set up with. NTS does not have this problem: STARTUP handlers run before\n+\t * accel_startup_ok is set, and accel_shutdown() clears it again. */\n+\tif (accel_startup_ok && stage != ZEND_INI_STAGE_STARTUP) {\n \t\tif (strcmp(sapi_module.name, \"fpm-fcgi\") == 0) {\n \t\t\tzend_accel_error(ACCEL_LOG_WARNING, \"opcache.interned_strings_buffer cannot be changed when OPcache is already set up. Are you using php_admin_value[opcache.interned_strings_buffer] in an individual pool's configuration?\\n\");\n \t\t} else {"},{"sha":"1235b1fc89fab63a7d1f4d399123d7b17f14cf61","filename":"ext/opcache/zend_file_cache.c","status":"modified","additions":5,"deletions":20,"changes":25,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fzend_file_cache.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fzend_file_cache.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Fzend_file_cache.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -570,6 +570,10 @@ static void zend_file_cache_serialize_op_array(zend_op_array            *op_arra\n \t\t\t\t&& (opline-1)->opcode == ZEND_DECLARE_ATTRIBUTED_CONST\n \t\t\t) {\n \t\t\t\tzval *literal = RT_CONSTANT(opline, opline->op1);\n+#if ZEND_USE_ABS_CONST_ADDR\n+\t\t\t\tSERIALIZE_PTR(literal);\n+\t\t\t\tUNSERIALIZE_PTR(literal);\n+#endif\n \t\t\t\tSERIALIZE_ATTRIBUTES(Z_PTR_P(literal));\n \t\t\t}\n \n@@ -579,32 +583,13 @@ static void zend_file_cache_serialize_op_array(zend_op_array            *op_arra\n \t\t\t}\n \t\t\tif (opline->op2_type == IS_CONST) {\n \t\t\t\tSERIALIZE_PTR(opline->op2.zv);\n-\n-\t\t\t\t/* See GH-17733. Reset Z_EXTRA_P(op2) of ZEND_INIT_FCALL, which\n-\t\t\t\t * is an offset into the global function table, to avoid calling\n-\t\t\t\t * incorrect functions when environment changes. This, and the\n-\t\t\t\t * equivalent code below, can be removed once proper system ID\n-\t\t\t\t * validation is implemented. */\n-\t\t\t\tif (opline->opcode == ZEND_INIT_FCALL) {\n-\t\t\t\t\tzval *op2 = opline->op2.zv;\n-\t\t\t\t\tUNSERIALIZE_PTR(op2);\n-\t\t\t\t\tZ_EXTRA_P(op2) = 0;\n-\t\t\t\t\tZEND_VM_SET_OPCODE_HANDLER(opline);\n-\t\t\t\t}\n \t\t\t}\n #else\n \t\t\tif (opline->op1_type == IS_CONST) {\n \t\t\t\topline->op1.constant = RT_CONSTANT(opline, opline->op1) - literals;\n \t\t\t}\n \t\t\tif (opline->op2_type == IS_CONST) {\n-\t\t\t\tzval *op2 = RT_CONSTANT(opline, opline->op2);\n-\t\t\t\topline->op2.constant = op2 - literals;\n-\n-\t\t\t\t/* See GH-17733 and comment above. */\n-\t\t\t\tif (opline->opcode == ZEND_INIT_FCALL) {\n-\t\t\t\t\tZ_EXTRA_P(op2) = 0;\n-\t\t\t\t\tZEND_VM_SET_OPCODE_HANDLER(opline);\n-\t\t\t\t}\n+\t\t\t\topline->op2.constant = RT_CONSTANT(opline, opline->op2) - literals;\n \t\t\t}\n #endif\n #if ZEND_USE_ABS_JMP_ADDR"},{"sha":"052411a0eb00598e4a6a863633137019a5c3e312","filename":"ext/opcache/zend_persist.c","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fzend_persist.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopcache%2Fzend_persist.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopcache%2Fzend_persist.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -371,6 +371,7 @@ void zend_accel_pending_ce_cache_commit(void)\n \n \t\tZEND_ASSERT(!ZSTR_HAS_CE_CACHE(type_name));\n \t\tGC_SET_REFCOUNT(type_name, (uint32_t)Z_LVAL_P(zv));\n+\t\tZEND_ATOMIC_FENCE_RELEASE();\n \t\tGC_ADD_FLAGS(type_name, IS_STR_CLASS_NAME_MAP_PTR);\n \t} ZEND_HASH_FOREACH_END();\n "},{"sha":"d242df0bbba61206b0d59baacb77ff0df78ae15b","filename":"ext/openssl/openssl.c","status":"modified","additions":7,"deletions":6,"changes":13,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fopenssl.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fopenssl.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Fopenssl.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -1019,7 +1019,7 @@ PHP_FUNCTION(openssl_spki_new)\n \t}\n \n \tif (challenge) {\n-\t\tif (!ASN1_STRING_set(spki->spkac->challenge, challenge, (int)challenge_len)) {\n+\t\tif (!ASN1_STRING_set1_data(spki->spkac->challenge, (const unsigned char *) challenge, challenge_len)) {\n \t\t\tphp_openssl_store_errors();\n \t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to set challenge data\");\n \t\t\tgoto cleanup;\n@@ -1206,7 +1206,8 @@ PHP_FUNCTION(openssl_spki_export_challenge)\n \t\tgoto cleanup;\n \t}\n \n-\tRETVAL_STRING((const char *)ASN1_STRING_get0_data(spki->spkac->challenge));\n+\tRETVAL_STRINGL_FAST((const char *)ASN1_STRING_get0_data(spki->spkac->challenge),\n+\t\tASN1_STRING_get_length(spki->spkac->challenge));\n \tgoto cleanup;\n \n cleanup:\n@@ -3237,7 +3238,7 @@ PHP_FUNCTION(openssl_pkcs7_read)\n \n \t\t\tif (PEM_write_bio_X509(bio_out, ca) && BIO_get_mem_ptr(bio_out, &bio_buf) > 0) {\n \t\t\t\tZVAL_STRINGL(&zcert, bio_buf->data, bio_buf->length);\n-\t\t\t\tadd_index_zval(zout, i, &zcert);\n+\t\t\t\tadd_next_index_zval(zout, &zcert);\n \t\t\t}\n \t\t\t(void)BIO_reset(bio_out);\n \t\t}\n@@ -3255,7 +3256,7 @@ PHP_FUNCTION(openssl_pkcs7_read)\n \n \t\t\tif (PEM_write_bio_X509_CRL(bio_out, crl) && BIO_get_mem_ptr(bio_out, &bio_buf) > 0) {\n \t\t\t\tZVAL_STRINGL(&zcert, bio_buf->data, bio_buf->length);\n-\t\t\t\tadd_index_zval(zout, i, &zcert);\n+\t\t\t\tadd_next_index_zval(zout, &zcert);\n \t\t\t}\n \t\t\t(void)BIO_reset(bio_out);\n \t\t}\n@@ -3911,7 +3912,7 @@ PHP_FUNCTION(openssl_cms_read)\n \n \t\t\tif (PEM_write_bio_X509(bio_out, ca) && BIO_get_mem_ptr(bio_out, &bio_buf) > 0) {\n \t\t\t\tZVAL_STRINGL(&zcert, bio_buf->data, bio_buf->length);\n-\t\t\t\tadd_index_zval(zout, i, &zcert);\n+\t\t\t\tadd_next_index_zval(zout, &zcert);\n \t\t\t}\n \t\t\t(void)BIO_reset(bio_out);\n \t\t}\n@@ -3930,7 +3931,7 @@ PHP_FUNCTION(openssl_cms_read)\n \n \t\t\tif (PEM_write_bio_X509_CRL(bio_out, crl) && BIO_get_mem_ptr(bio_out, &bio_buf) > 0) {\n \t\t\t\tZVAL_STRINGL(&zcert, bio_buf->data, bio_buf->length);\n-\t\t\t\tadd_index_zval(zout, i, &zcert);\n+\t\t\t\tadd_next_index_zval(zout, &zcert);\n \t\t\t}\n \t\t\t(void)BIO_reset(bio_out);\n \t\t}"},{"sha":"995d836deead8a4dcff4d0045943c08f41e9baed","filename":"ext/openssl/openssl_backend_common.c","status":"modified","additions":13,"deletions":11,"changes":24,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fopenssl_backend_common.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fopenssl_backend_common.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Fopenssl_backend_common.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -72,7 +72,7 @@ void php_openssl_add_assoc_name_entry(zval * val, char * key, const X509_NAME *\n \t\t} else {\n \t\t\t/* ASN1_STRING_get0_data(3): Since this is an internal pointer it should not be freed or modified in any way */\n \t\t\tto_add = ASN1_STRING_get0_data(str);\n-\t\t\tto_add_len = ASN1_STRING_length(str);\n+\t\t\tto_add_len = ASN1_STRING_get_length(str);\n \t\t}\n \n \t\tif (to_add_len != -1) {\n@@ -107,7 +107,7 @@ void php_openssl_add_assoc_name_entry(zval * val, char * key, const X509_NAME *\n \n void php_openssl_add_assoc_asn1_string(zval * val, char * key, const ASN1_STRING * str)\n {\n-\tadd_assoc_stringl(val, key, (const char *)ASN1_STRING_get0_data(str), ASN1_STRING_length(str));\n+\tadd_assoc_stringl(val, key, (const char *)ASN1_STRING_get0_data(str), ASN1_STRING_get_length(str));\n }\n \n time_t php_openssl_asn1_time_to_time_t(ASN1_UTCTIME * timestr)\n@@ -123,6 +123,7 @@ time_t php_openssl_asn1_time_to_time_t(ASN1_UTCTIME * timestr)\n \tstruct tm thetime;\n \tchar * strbuf;\n \tchar * thestr;\n+\tconst char *timestr_data;\n \tlong gmadjust = 0;\n \tsize_t timestr_len;\n \n@@ -131,24 +132,25 @@ time_t php_openssl_asn1_time_to_time_t(ASN1_UTCTIME * timestr)\n \t\treturn (time_t)-1;\n \t}\n \n-\ttimestr_len = (size_t)ASN1_STRING_length(timestr);\n+\ttimestr_len = ASN1_STRING_get_length(timestr);\n+\ttimestr_data = timestr_len ? (const char *)ASN1_STRING_get0_data(timestr) : \"\";\n \n-\tif (timestr_len != strlen((const char *)ASN1_STRING_get0_data(timestr))) {\n+\tif (memchr(timestr_data, '\\0', timestr_len) != NULL) {\n \t\tphp_error_docref(NULL, E_WARNING, \"Illegal length in timestamp\");\n \t\treturn (time_t)-1;\n \t}\n \n \tif (timestr_len < 13) {\n-\t\tphp_error_docref(NULL, E_WARNING, \"Unable to parse time string %s correctly\", ASN1_STRING_get0_data(timestr));\n+\t\tphp_error_docref(NULL, E_WARNING, \"Unable to parse time string %.*s correctly\", (int)timestr_len, timestr_data);\n \t\treturn (time_t)-1;\n \t}\n \n \tif (ASN1_STRING_type(timestr) == V_ASN1_GENERALIZEDTIME && timestr_len < 15) {\n-\t\tphp_error_docref(NULL, E_WARNING, \"Unable to parse time string %s correctly\", ASN1_STRING_get0_data(timestr));\n+\t\tphp_error_docref(NULL, E_WARNING, \"Unable to parse time string %.*s correctly\", (int)timestr_len, timestr_data);\n \t\treturn (time_t)-1;\n \t}\n \n-\tstrbuf = estrdup((const char *)ASN1_STRING_get0_data(timestr));\n+\tstrbuf = estrndup(timestr_data, timestr_len);\n \n \tmemset(&thetime, 0, sizeof(thetime));\n \n@@ -636,7 +638,7 @@ int openssl_x509v3_subjectAltName(BIO *bio, PHP_OPENSSL_X509_EXTENSION *extensio\n \n \textension_data = X509_EXTENSION_get_data(extension);\n \tp = ASN1_STRING_get0_data(extension_data);\n-\tlength = ASN1_STRING_length(extension_data);\n+\tlength = ASN1_STRING_get_length(extension_data);\n \tif (method->it) {\n \t\tnames = (GENERAL_NAMES*) (ASN1_item_d2i(NULL, &p, length,\n \t\t\tASN1_ITEM_ptr(method->it)));\n@@ -658,19 +660,19 @@ int openssl_x509v3_subjectAltName(BIO *bio, PHP_OPENSSL_X509_EXTENSION *extensio\n \t\t\t\tBIO_puts(bio, \"email:\");\n \t\t\t\tas = name->d.rfc822Name;\n \t\t\t\tBIO_write(bio, ASN1_STRING_get0_data(as),\n-\t\t\t\t\tASN1_STRING_length(as));\n+\t\t\t\t\tASN1_STRING_get_length(as));\n \t\t\t\tbreak;\n \t\t\tcase GEN_DNS:\n \t\t\t\tBIO_puts(bio, \"DNS:\");\n \t\t\t\tas = name->d.dNSName;\n \t\t\t\tBIO_write(bio, ASN1_STRING_get0_data(as),\n-\t\t\t\t\tASN1_STRING_length(as));\n+\t\t\t\t\tASN1_STRING_get_length(as));\n \t\t\t\tbreak;\n \t\t\tcase GEN_URI:\n \t\t\t\tBIO_puts(bio, \"URI:\");\n \t\t\t\tas = name->d.uniformResourceIdentifier;\n \t\t\t\tBIO_write(bio, ASN1_STRING_get0_data(as),\n-\t\t\t\t\tASN1_STRING_length(as));\n+\t\t\t\t\tASN1_STRING_get_length(as));\n \t\t\t\tbreak;\n \t\t\tdefault:\n \t\t\t\t/* use builtin print for GEN_OTHERNAME, GEN_X400,"},{"sha":"364f27eec23e7f9adf49509dde75bc7cc5488af5","filename":"ext/openssl/php_openssl_backend.h","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fphp_openssl_backend.h","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fphp_openssl_backend.h","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Fphp_openssl_backend.h?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -35,6 +35,11 @@\n #include <openssl/pkcs12.h>\n #include <openssl/cms.h>\n \n+#if OPENSSL_VERSION_NUMBER < 0x40100000L\n+#define ASN1_STRING_set1_data(str, data, len) ASN1_STRING_set((str), (data), (int) (len))\n+#define ASN1_STRING_get_length(str) ((size_t) ASN1_STRING_length(str))\n+#endif\n+\n #if defined(OPENSSL_VERSION_MAJOR) && OPENSSL_VERSION_MAJOR >= 4\n typedef const X509_EXTENSION PHP_OPENSSL_X509_EXTENSION;\n #else"},{"sha":"9cc7e7597bdf228fd6f0a52f02abe5b6c400d028","filename":"ext/openssl/tests/gh24784.phpt","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fgh24784.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fgh24784.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Fgh24784.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,57 @@\n+--TEST--\n+GH-24784 (openssl_pkcs7_read()/openssl_cms_read() CRLs overwrite certificates)\n+--EXTENSIONS--\n+openssl\n+--FILE--\n+<?php\n+$pkcs7 = <<<'PEM'\n+-----BEGIN PKCS7-----\n+MIIEmAYJKoZIhvcNAQcCoIIEiTCCBIUCAQExADALBgkqhkiG9w0BBwGgggL/MIIC\n++zCCAeOgAwIBAgIUUEaeiRSbQNAJSjCJETx/k53qiDIwDQYJKoZIhvcNAQELBQAw\n+DDEKMAgGA1UEAwwBdDAgFw0yNjEwMjcxMjQ1MTRaGA8yMTI2MTAwMzEyNDUxNFow\n+DDEKMAgGA1UEAwwBdDCCASIwDQYJKoZIhvcNAQEBBQADggEPADCCAQoCggEBAIh+\n+9ye+esW5wXVu7ERwOEJMci0+Ivci+2uA6nxmDmJARJSGn4sqB6+g1MLMzfxcMECi\n+OKowxoWfmWvlluPCMrRI732tmAcXt+x1gdZlUrzvi/ul3SPxgIv/pqNZ2DxTlgpb\n+4cBooSFFKLUcHO5MrqXiDkL5MFLG6165N/OKBtI3ylu9pwgKOKGm0vIwanStMcpP\n+nBjpjJWLJpzQdUjbC7s9sV3iODM8qHC5izl5ueDY2d4NPutHJxE3olF5fad/IX4N\n+pbOVzVK2aIMVN9Q+nCoZlZtkg2B7RCL6WzVfxtmVout8ELAaHKKor5SZYuhOe7Rb\n+O5cebVYYkIZVXe8CPB0CAwEAAaNTMFEwHQYDVR0OBBYEFNGPW5eEb7Kz8RGrRP0d\n+1ABhu9xeMB8GA1UdIwQYMBaAFNGPW5eEb7Kz8RGrRP0d1ABhu9xeMA8GA1UdEwEB\n+/wQFMAMBAf8wDQYJKoZIhvcNAQELBQADggEBAFuyJeajbHMjr4KWDuAqAjS6y14p\n+IVi931dudVpqi5c8OOgOkX4eUF3Z5y9WkPozuYsx+u+pPs1iFVvzG13SjRqZu7tx\n+fyqIbZIy4VbWG2ZUTvVW34D5Y7Yj5FM9IeRyw2vuwL6NKw/6ENVIHJZRokHQ7zCQ\n+A9uBPt5rultYIsiRukaRgfu8P56wBXgAryN6bfWgNvFNwLwh9j8a/6tAsnoC0npS\n+MYiCowEXuROYmGvUPtZsv7Y8gspsbKgVBrOs8gqnCer4LXNVskQixfGQ8AyZNSSl\n+GwpkD7DIXaHg4V7upfnXcyY6HJgyG0i2oMCzlCpTRcf+OAK4KnRlowfCxoChggFq\n+MIIBZjBQAgEBMA0GCSqGSIb3DQEBCwUAMAwxCjAIBgNVBAMMAXQXDTI2MTAyNzEy\n+NDUxNFoYDzIxMjYxMDAzMTI0NTE0WqAOMAwwCgYDVR0UBAMCAQEwDQYJKoZIhvcN\n+AQELBQADggEBAHCQBFS6x6N9v5LA/zWtHY/ZRt3ZNWw9kh4QrjKZA+c2WN36WrIz\n+l65ApT2OOlF7PxHrLZXxDnBe/IxlotAOyChWemRBj0Tb6Rjl5ktKNnXUrmgpH4uB\n+m9dPNs/b2tlIoYECbwHKQcYRaGJE0/BxDRXkAq6fUoHJVH1zXLZOc+8IHeDnqThe\n+IxKcfS1JwUQ4Fjjd8Po1EA9puFqhWE2oxD1E4C4gaRul1gQXDcLFlqMM8zISRHEl\n+1IR6DCP25u9vzN2mxSGaeY1awDUeWopkz1d3PZgZRxqSh5ojqvYRC7oxHyhWqiut\n++RY+Dyn3ETAoatWiH2GOEnoLNZtVEK3C3UYxAA==\n+-----END PKCS7-----\n+PEM;\n+$cms = str_replace('PKCS7', 'CMS', $pkcs7);\n+\n+foreach (['openssl_pkcs7_read' => $pkcs7, 'openssl_cms_read' => $cms] as $func => $data) {\n+    echo $func, \"\\n\";\n+    var_dump($func($data, $result));\n+    var_dump(count($result));\n+    foreach ($result as $i => $pem) {\n+        echo $i, ': ', strtok($pem, \"\\n\"), \"\\n\";\n+    }\n+}\n+?>\n+--EXPECT--\n+openssl_pkcs7_read\n+bool(true)\n+int(2)\n+0: -----BEGIN CERTIFICATE-----\n+1: -----BEGIN X509 CRL-----\n+openssl_cms_read\n+bool(true)\n+int(2)\n+0: -----BEGIN CERTIFICATE-----\n+1: -----BEGIN X509 CRL-----"},{"sha":"d5eb8617cb1f96c22fca7f982f07450b7f3d4882","filename":"ext/openssl/tests/openssl_spki_export_challenge_binary.phpt","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fopenssl_spki_export_challenge_binary.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fopenssl_spki_export_challenge_binary.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Fopenssl_spki_export_challenge_binary.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,19 @@\n+--TEST--\n+openssl_spki_export_challenge() preserves empty challenges and embedded NUL bytes\n+--EXTENSIONS--\n+openssl\n+--FILE--\n+<?php\n+$key = openssl_pkey_get_private('file://' . __DIR__ . '/private_rsa_2048.key');\n+\n+foreach ([\"\", \"challenge\", \"\\0challenge\", \"challenge\\0\", \"left\\0right\"] as $challenge) {\n+    $spkac = openssl_spki_new($key, $challenge, OPENSSL_ALGO_SHA256);\n+    var_dump(openssl_spki_export_challenge(substr($spkac, 6)) === $challenge);\n+}\n+?>\n+--EXPECT--\n+bool(true)\n+bool(true)\n+bool(true)\n+bool(true)\n+bool(true)"},{"sha":"5c7512d73a35e951bc57ab899264399161c9f05d","filename":"ext/openssl/tests/session_resumption_get_cb_num_tickets_positive.phpt","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_resumption_get_cb_num_tickets_positive.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_resumption_get_cb_num_tickets_positive.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Fsession_resumption_get_cb_num_tickets_positive.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -16,6 +16,7 @@ $serverCode = <<<'CODE'\n     // Test with num_tickets = 3 (should issue 3 tickets)\n     $ctx = stream_context_create(['ssl' => [\n         'local_cert' => '%s',\n+        'session_id_context' => 'num-tickets-test',\n         'crypto_method' => STREAM_CRYPTO_METHOD_TLSv1_3_SERVER,\n         'num_tickets' => 3,  // Issue 3 tickets per connection\n     ]]);"},{"sha":"05476a6ae37544bbbc41c17b1c55432e22b0ed01","filename":"ext/openssl/tests/session_resumption_remove_cb_closed_listener.phpt","status":"added","additions":138,"deletions":0,"changes":138,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_resumption_remove_cb_closed_listener.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_resumption_remove_cb_closed_listener.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Fsession_resumption_remove_cb_closed_listener.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,138 @@\n+--TEST--\n+TLS session resumption - session_remove_cb with a closed listener stream\n+--EXTENSIONS--\n+openssl\n+--SKIPIF--\n+<?php\n+if (!function_exists(\"proc_open\")) die(\"skip no proc_open\");\n+if (substr(PHP_OS, 0, 3) == 'WIN') die(\"skip not reliable on Windows\");\n+?>\n+--FILE--\n+<?php\n+$certFile = __DIR__ . DIRECTORY_SEPARATOR . 'session_remove_cb_closed_listener.pem.tmp';\n+\n+/* A TCP proxy relays the handshake, then injects a bad record so the server\n+ * removes the cached session after the listener has been closed. */\n+\n+$serverCode = <<<'CODE'\n+    $flags = STREAM_SERVER_BIND|STREAM_SERVER_LISTEN;\n+    $ctx = stream_context_create(['ssl' => [\n+        'local_cert' => '%s',\n+        'verify_peer' => false,\n+        'no_ticket' => true,\n+        'session_cache' => true,\n+        'session_id_context' => 'app',\n+        'session_new_cb'    => function($stream, $session) {},\n+        'session_get_cb'    => function($stream, $sessionId) { return null; },\n+        'session_remove_cb' => function($stream, $sessionId) {},\n+    ]]);\n+\n+    $server = stream_socket_server('tls://127.0.0.1:0', $errno, $errstr, $flags, $ctx);\n+    phpt_notify_server_start($server);\n+\n+    // Handshake completes during accept, so the session is cached here.\n+    $client = @stream_socket_accept($server, 30);\n+\n+    // Free the listener while the accepted connection keeps the ctx alive.\n+    fclose($server);\n+    phpt_notify();\n+\n+    // Reuse the freed listener's memory to make a dangling access fault.\n+    $reuse = [];\n+    for ($i = 0; $i < 8; $i++) {\n+        $reuse[] = fopen('php://memory', 'r+');\n+    }\n+\n+    @fread($client, 1024);\n+    phpt_notify(message: \"server alive\");\n+    fclose($client);\n+CODE;\n+$serverCode = sprintf($serverCode, $certFile);\n+\n+$proxyCode = <<<'CODE'\n+    $flags = STREAM_SERVER_BIND|STREAM_SERVER_LISTEN;\n+    $proxy = stream_socket_server(\"tcp://127.0.0.1:0\", $errno, $errstr, $flags);\n+    phpt_notify_server_start($proxy);\n+\n+    $upstream = stream_socket_client(\"tcp://{{ ADDR }}\", $errno, $errstr, 30, STREAM_CLIENT_CONNECT);\n+    $conn = stream_socket_accept($proxy, 30);\n+    stream_set_blocking($upstream, false);\n+    stream_set_blocking($conn, false);\n+    stream_set_blocking(STDIN, false);\n+\n+    $injected = false;\n+    while (true) {\n+        $r = [$conn, $upstream, STDIN];\n+        $w = $e = [];\n+        if (@stream_select($r, $w, $e, 10) === false) {\n+            break;\n+        }\n+        foreach ($r as $s) {\n+            if ($s === STDIN) {\n+                if (fgets(STDIN) === false) {\n+                    break 2;\n+                }\n+                if (!$injected) {\n+                    $injected = true;\n+                    fwrite($upstream, \"\\x15\\x03\\x03\\x00\\x20\" . str_repeat(\"\\x41\", 0x20));\n+                }\n+            } elseif ($s === $conn) {\n+                $d = @fread($conn, 8192);\n+                if ($d === '' || $d === false) {\n+                    if (feof($conn)) break 2;\n+                } else {\n+                    @fwrite($upstream, $d);\n+                }\n+            } else {\n+                $d = @fread($upstream, 8192);\n+                if ($d === '' || $d === false) {\n+                    if (feof($upstream)) break 2;\n+                } else {\n+                    @fwrite($conn, $d);\n+                }\n+            }\n+        }\n+    }\n+    fclose($conn);\n+    fclose($upstream);\n+    fclose($proxy);\n+CODE;\n+\n+$clientCode = <<<'CODE'\n+    $flags = STREAM_CLIENT_CONNECT;\n+    $ctx = stream_context_create(['ssl' => [\n+        'verify_peer' => false,\n+        'verify_peer_name' => false,\n+    ]]);\n+\n+    $client = stream_socket_client(\"tls://{{ ADDR }}\", $errno, $errstr, 30, $flags, $ctx);\n+    if (!$client) {\n+        echo \"client connect failed: $errstr\\n\";\n+        phpt_notify('proxy');\n+        return;\n+    }\n+\n+    // Listener is closed; tell the proxy to inject the bad record.\n+    phpt_wait('server');\n+    phpt_notify('proxy');\n+\n+    echo trim(phpt_wait('server')) . \"\\n\";\n+    fclose($client);\n+CODE;\n+\n+include 'CertificateGenerator.inc';\n+$certificateGenerator = new CertificateGenerator();\n+$certificateGenerator->saveNewCertAsFileWithKey('session_remove_cb_closed_listener', $certFile);\n+\n+include 'ServerClientTestCase.inc';\n+ServerClientTestCase::getInstance()->run($clientCode, [\n+    'server' => $serverCode,\n+    'proxy'  => $proxyCode,\n+]);\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . DIRECTORY_SEPARATOR . 'session_remove_cb_closed_listener.pem.tmp');\n+?>\n+--EXPECT--\n+server alive"},{"sha":"f612fd5fbf9872793ab39a1d03d286e9f217399d","filename":"ext/openssl/tests/session_resumption_server_alpn_closed_parent.phpt","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_resumption_server_alpn_closed_parent.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_resumption_server_alpn_closed_parent.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Fsession_resumption_server_alpn_closed_parent.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,59 @@\n+--TEST--\n+Server ALPN selection on a stream seeded from a closed session stream\n+--EXTENSIONS--\n+openssl\n+--FILE--\n+<?php\n+$certFile = __DIR__ . DIRECTORY_SEPARATOR . 'session_resumption_server_alpn_closed_parent.pem.tmp';\n+include 'CertificateGenerator.inc';\n+(new CertificateGenerator())->saveNewCertAsFileWithKey('localhost', $certFile);\n+\n+$server = stream_socket_server('tcp://127.0.0.1:0');\n+$addr = stream_socket_get_name($server, false);\n+\n+$parentClient = stream_socket_client(\"tcp://$addr\");\n+$parent = stream_socket_accept($server);\n+stream_context_set_options($parent, ['ssl' => [\n+    'local_cert' => $certFile,\n+    'alpn_protocols' => 'h2,http/1.1',\n+]]);\n+stream_set_blocking($parent, false);\n+var_dump(stream_socket_enable_crypto($parent, true, STREAM_CRYPTO_METHOD_TLS_SERVER));\n+\n+$client = stream_socket_client(\"tcp://$addr\", $errno, $errstr, 5, STREAM_CLIENT_CONNECT,\n+    stream_context_create(['ssl' => [\n+        'verify_peer' => false,\n+        'verify_peer_name' => false,\n+        'alpn_protocols' => 'h2',\n+    ]]));\n+$child = stream_socket_accept($server);\n+stream_set_blocking($child, false);\n+var_dump(stream_socket_enable_crypto($child, true, STREAM_CRYPTO_METHOD_TLS_SERVER, $parent));\n+\n+fclose($parent);\n+fclose($parentClient);\n+\n+stream_set_blocking($client, false);\n+$clientDone = $childDone = 0;\n+for ($i = 0; $i < 1000 && ($clientDone !== true || $childDone !== true); $i++) {\n+    if ($clientDone !== true) {\n+        $clientDone = stream_socket_enable_crypto($client, true, STREAM_CRYPTO_METHOD_TLS_CLIENT);\n+    }\n+    if ($childDone !== true) {\n+        $childDone = stream_socket_enable_crypto($child, true, STREAM_CRYPTO_METHOD_TLS_SERVER);\n+    }\n+    usleep(1000);\n+}\n+var_dump($clientDone, $childDone);\n+var_dump(stream_get_meta_data($client)['crypto']['alpn_protocol']);\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . DIRECTORY_SEPARATOR . 'session_resumption_server_alpn_closed_parent.pem.tmp');\n+?>\n+--EXPECT--\n+int(0)\n+int(0)\n+bool(true)\n+bool(true)\n+string(2) \"h2\""},{"sha":"20084df4fb244ded66890c73b4b8aa90c4ff8ce9","filename":"ext/openssl/tests/session_unserialize_repeat.phpt","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_unserialize_repeat.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Fsession_unserialize_repeat.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Fsession_unserialize_repeat.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -13,6 +13,7 @@ $certFile = __DIR__ . DIRECTORY_SEPARATOR . 'session_unserialize_repeat.pem.tmp'\n $serverCode = <<<'CODE'\n     $serverCtx = stream_context_create(['ssl' => [\n         'local_cert' => '%s',\n+        'session_id_context' => 'unserialize-repeat-test',\n     ]]);\n \n     $server = stream_socket_server('tls://127.0.0.1:0', $errno, $errstr,"},{"sha":"48b7680fd4f282118eb04aba20f8d2dacea1d999","filename":"ext/openssl/tests/tls_psk_oversized_identity.phpt","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Ftls_psk_oversized_identity.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Ftests%2Ftls_psk_oversized_identity.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Ftests%2Ftls_psk_oversized_identity.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,55 @@\n+--TEST--\n+TLS PSK - oversized identity from an unserialized Psk is rejected\n+--EXTENSIONS--\n+openssl\n+--SKIPIF--\n+<?php\n+if (!function_exists(\"proc_open\")) die(\"skip no proc_open\");\n+if (OPENSSL_VERSION_NUMBER < 0x10101000) die(\"skip OpenSSL >= 1.1.1 required\");\n+?>\n+--FILE--\n+<?php\n+$serverCode = <<<'CODE'\n+    $serverCtx = stream_context_create(['ssl' => [\n+        'crypto_method' => STREAM_CRYPTO_METHOD_TLSv1_2_SERVER,\n+        'ciphers' => 'PSK',\n+        'psk_server_cb' => function ($stream, string $identity): ?Openssl\\Psk {\n+            return new Openssl\\Psk(str_repeat(\"\\x42\", 16));\n+        },\n+    ]]);\n+    $server = stream_socket_server('tls://127.0.0.1:0', $errno, $errstr,\n+        STREAM_SERVER_BIND | STREAM_SERVER_LISTEN, $serverCtx);\n+    phpt_notify_server_start($server);\n+    @stream_socket_accept($server, 3);\n+CODE;\n+\n+$clientCode = <<<'CODE'\n+    // unserialize bypasses the constructor length check, so the Psk carries a\n+    // 512-byte identity; the callback must reject it, not overflow the buffer.\n+    $identity = str_repeat('A', 512);\n+    $payload = sprintf('O:11:\"Openssl\\Psk\":2:{s:3:\"psk\";s:4:\"pass\";s:8:\"identity\";s:%d:\"%s\";}',\n+        strlen($identity), $identity);\n+\n+    $clientCtx = stream_context_create(['ssl' => [\n+        'crypto_method' => STREAM_CRYPTO_METHOD_TLSv1_2_CLIENT,\n+        'ciphers' => 'PSK',\n+        'verify_peer' => false,\n+        'verify_peer_name' => false,\n+        'psk_client_cb' => function ($stream) use ($payload): ?Openssl\\Psk {\n+            return unserialize($payload);\n+        },\n+    ]]);\n+    try {\n+        @stream_socket_client('tls://{{ ADDR }}', $errno, $errstr,\n+            30, STREAM_CLIENT_CONNECT, $clientCtx);\n+        echo \"no exception\\n\";\n+    } catch (ValueError $e) {\n+        echo \"caught: \", $e->getMessage(), \"\\n\";\n+    }\n+CODE;\n+\n+include __DIR__ . '/ServerClientTestCase.inc';\n+ServerClientTestCase::getInstance()->run($clientCode, $serverCode);\n+?>\n+--EXPECTF--\n+caught: PSK identity must be shorter than %d bytes"},{"sha":"15b7371f2c8e52d3fdb069576c681889bd8a9c22","filename":"ext/openssl/xp_ssl.c","status":"modified","additions":53,"deletions":12,"changes":65,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fxp_ssl.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fopenssl%2Fxp_ssl.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fopenssl%2Fxp_ssl.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -541,7 +541,7 @@ static bool php_openssl_matches_san_list(\n \t\t\t\t/* TODO: warn ? */\n \t\t\t\tcontinue;\n \t\t\t}\n-\t\t\tif ((size_t)ASN1_STRING_length(san->d.dNSName) != strlen((const char*)cert_name)) {\n+\t\t\tif (ASN1_STRING_get_length(san->d.dNSName) != strlen((const char*)cert_name)) {\n \t\t\t\tOPENSSL_free(cert_name);\n \t\t\t\t/* prevent null-byte poisoning*/\n \t\t\t\tcontinue;\n@@ -561,7 +561,7 @@ static bool php_openssl_matches_san_list(\n \t\t\t}\n \t\t\tOPENSSL_free(cert_name);\n \t\t} else if (san->type == GEN_IPADD) {\n-\t\t\tif (ASN1_STRING_length(san->d.iPAddress) == 4) {\n+\t\t\tif (ASN1_STRING_get_length(san->d.iPAddress) == 4) {\n \t\t\t\tsnprintf(ipbuffer, sizeof(ipbuffer), \"%d.%d.%d.%d\",\n \t\t\t\t\tASN1_STRING_get0_data(san->d.iPAddress)[0],\n \t\t\t\t\tASN1_STRING_get0_data(san->d.iPAddress)[1],\n@@ -575,7 +575,7 @@ static bool php_openssl_matches_san_list(\n \t\t\t\t}\n \t\t\t}\n #ifdef HAVE_IPV6_SAN\n-\t\t\telse if (ASN1_STRING_length(san->d.ip) == 16 && subject_name_is_ipv6) {\n+\t\t\telse if (ASN1_STRING_get_length(san->d.ip) == 16 && subject_name_is_ipv6) {\n \t\t\t\tipbuffer[0] = 0;\n \t\t\t\tEXPAND_IPV6_ADDRESS(ipbuffer, ASN1_STRING_get0_data(san->d.iPAddress));\n \t\t\t\tif (strcasecmp((const char*)subject_name_ipv6_expanded, (const char*)ipbuffer) == 0) {\n@@ -630,7 +630,7 @@ static bool php_openssl_matches_common_name(php_stream *stream, const X509 *peer\n \t\treturn false;\n \t}\n \tname_asn1 = X509_NAME_ENTRY_get_data(name_entry);\n-\tcert_name_len = ASN1_STRING_length(name_asn1);\n+\tcert_name_len = ASN1_STRING_get_length(name_asn1);\n \tcert_name = (unsigned char *) OPENSSL_strndup((const char *) ASN1_STRING_get0_data(name_asn1), cert_name_len);\n \tif (cert_name == NULL) {\n \t\tphp_stream_warn(stream, NetworkRecvFailed, \"Unable to locate peer certificate CN\");\n@@ -785,7 +785,8 @@ static int php_openssl_win_cert_verify_callback(X509_STORE_CTX *x509_store_ctx,\n \tbool is_self_signed = false;\n \n \n-\tstream = (php_stream*)arg;\n+\tSSL *ssl = X509_STORE_CTX_get_ex_data(x509_store_ctx, SSL_get_ex_data_X509_STORE_CTX_idx());\n+\tstream = (php_stream*)SSL_get_ex_data(ssl, php_openssl_get_ssl_stream_data_index());\n \tsslsock = (php_openssl_netstream_data_t*)stream->abstract;\n \n \t{ /* First convert the x509 struct back to a DER encoded buffer and let Windows decode it into a form it can work with */\n@@ -1020,7 +1021,7 @@ static zend_result php_openssl_enable_peer_verification(SSL_CTX *ctx, php_stream\n \t\t}\n \t} else {\n #ifdef PHP_WIN32\n-\t\tSSL_CTX_set_cert_verify_callback(ctx, php_openssl_win_cert_verify_callback, (void *)stream);\n+\t\tSSL_CTX_set_cert_verify_callback(ctx, php_openssl_win_cert_verify_callback, NULL);\n #else\n \t\tif (sslsock->is_client && !SSL_CTX_set_default_verify_paths(ctx)) {\n \t\t\tphp_stream_warn(stream, ProtocolError,\n@@ -1649,7 +1650,10 @@ static int php_openssl_server_alpn_callback(SSL *ssl_handle,\n \t\tconst unsigned char **out, unsigned char *outlen,\n \t\tconst unsigned char *in, unsigned int inlen, void *arg) /* {{{ */\n {\n-\tphp_openssl_netstream_data_t *sslsock = arg;\n+\tphp_stream *stream = (php_stream *)SSL_get_ex_data(ssl_handle, php_openssl_get_ssl_stream_data_index());\n+\tphp_openssl_netstream_data_t *sslsock = (php_openssl_netstream_data_t *)stream->abstract;\n+\n+\tZEND_ASSERT(sslsock->alpn_ctx.data != NULL);\n \n \tif (SSL_select_next_proto((unsigned char **)out, outlen, sslsock->alpn_ctx.data, sslsock->alpn_ctx.len, in, inlen) != OPENSSL_NPN_NEGOTIATED) {\n \t\treturn SSL_TLSEXT_ERR_NOACK;\n@@ -1772,8 +1776,6 @@ static unsigned int php_openssl_psk_client_cb(SSL *ssl, const char *hint,\n \t\tunsigned char *psk_out, unsigned int max_psk_len)\n {\n \t(void)hint; /* identity hint deliberately not exposed as it is useless */\n-\t(void)max_identity_len;\n-\t(void)max_psk_len;\n \n \tphp_stream *stream = (php_stream *)SSL_get_ex_data(ssl,\n \t\t\tphp_openssl_get_ssl_stream_data_index());\n@@ -1812,6 +1814,18 @@ static unsigned int php_openssl_psk_client_cb(SSL *ssl, const char *hint,\n \t\treturn 0;\n \t}\n \n+\t/* Returned lengths are untrusted, so bound them to the buffers. */\n+\tif (ZSTR_LEN(identity_str) >= max_identity_len) {\n+\t\tzend_value_error(\"PSK identity must be shorter than %u bytes\", max_identity_len);\n+\t\tzval_ptr_dtor(&result);\n+\t\treturn 0;\n+\t}\n+\tif (ZSTR_LEN(psk_str) > max_psk_len) {\n+\t\tzend_value_error(\"PSK key must not exceed %u bytes\", max_psk_len);\n+\t\tzval_ptr_dtor(&result);\n+\t\treturn 0;\n+\t}\n+\n \tmemcpy(identity_out, ZSTR_VAL(identity_str), ZSTR_LEN(identity_str));\n \tidentity_out[ZSTR_LEN(identity_str)] = '\\0';\n \tmemcpy(psk_out, ZSTR_VAL(psk_str), ZSTR_LEN(psk_str));\n@@ -1824,8 +1838,6 @@ static unsigned int php_openssl_psk_client_cb(SSL *ssl, const char *hint,\n static unsigned int php_openssl_psk_server_cb(SSL *ssl, const char *identity,\n \t\tunsigned char *psk_out, unsigned int max_psk_len)\n {\n-\t(void)max_psk_len;\n-\n \tphp_stream *stream = (php_stream *)SSL_get_ex_data(ssl,\n \t\t\tphp_openssl_get_ssl_stream_data_index());\n \tif (stream == NULL) {\n@@ -1865,6 +1877,13 @@ static unsigned int php_openssl_psk_server_cb(SSL *ssl, const char *identity,\n \t\treturn 0;\n \t}\n \n+\t/* Returned length is untrusted, so bound it to the buffer. */\n+\tif (ZSTR_LEN(psk_str) > max_psk_len) {\n+\t\tzend_value_error(\"PSK key must not exceed %u bytes\", max_psk_len);\n+\t\tzval_ptr_dtor(&result);\n+\t\treturn 0;\n+\t}\n+\n \tmemcpy(psk_out, ZSTR_VAL(psk_str), ZSTR_LEN(psk_str));\n \tunsigned int psk_len = (unsigned int)ZSTR_LEN(psk_str);\n \n@@ -1930,6 +1949,14 @@ static int php_openssl_psk_use_session_cb(SSL *ssl, const EVP_MD *md,\n \t\treturn 0;\n \t}\n \n+\t/* Returned length is untrusted, so bound it to the buffer. */\n+\tif (ZSTR_LEN(identity_str) > PHP_OPENSSL_PSK_MAX_IDENTITY_LEN) {\n+\t\tzend_value_error(\"PSK identity must not exceed %d bytes\", PHP_OPENSSL_PSK_MAX_IDENTITY_LEN);\n+\t\tSSL_SESSION_free(session);\n+\t\tzval_ptr_dtor(&result);\n+\t\treturn 0;\n+\t}\n+\n \t/* Identity buffer must outlive this callback. */\n \tif (sslsock->psk_identity_buf == NULL) {\n \t\tsslsock->psk_identity_buf = emalloc(PHP_OPENSSL_PSK_MAX_IDENTITY_LEN);\n@@ -2684,7 +2711,7 @@ static zend_result php_openssl_create_server_ctx(php_stream *stream,\n \t\t\t} else {\n \t\t\t\tsslsock->alpn_ctx.data = (unsigned char *) pestrndup((const char*)alpn, alpn_len, php_stream_is_persistent(stream));\n \t\t\t\tsslsock->alpn_ctx.len = alpn_len;\n-\t\t\t\tSSL_CTX_set_alpn_select_cb(sslsock->ctx, php_openssl_server_alpn_callback, sslsock);\n+\t\t\t\tSSL_CTX_set_alpn_select_cb(sslsock->ctx, php_openssl_server_alpn_callback, NULL);\n \t\t\t}\n \n \t\t\tefree(alpn);\n@@ -2777,6 +2804,16 @@ static zend_result php_openssl_setup_crypto(php_stream *stream,\n \t\t} else {\n \t\t\tSSL_CTX_up_ref(parent_sslsock->ctx);\n \t\t\tsslsock->ctx = parent_sslsock->ctx;\n+#ifdef HAVE_TLS_ALPN\n+\t\t\tif (parent_sslsock->alpn_ctx.data) {\n+\t\t\t\tif (sslsock->alpn_ctx.data) {\n+\t\t\t\t\tpefree(sslsock->alpn_ctx.data, php_stream_is_persistent(stream));\n+\t\t\t\t}\n+\t\t\t\tsslsock->alpn_ctx.data = (unsigned char *) pestrndup((const char *) parent_sslsock->alpn_ctx.data,\n+\t\t\t\t\tparent_sslsock->alpn_ctx.len, php_stream_is_persistent(stream));\n+\t\t\t\tsslsock->alpn_ctx.len = parent_sslsock->alpn_ctx.len;\n+\t\t\t}\n+#endif\n \t\t\tif (parent_sslsock->session_callbacks) {\n \t\t\t\tparent_sslsock->session_callbacks->refcount++;\n \t\t\t\tsslsock->session_callbacks = parent_sslsock->session_callbacks;\n@@ -3376,6 +3413,10 @@ static int php_openssl_sockop_close(php_stream *stream, int close_handle) /* {{{\n \t\t\tsslsock->ssl_handle = NULL;\n \t\t}\n \t\tif (sslsock->ctx) {\n+\t\t\t/* Clear the ctx stream pointer as the ctx may outlive this stream. */\n+\t\t\tif (SSL_CTX_get_ex_data(sslsock->ctx, php_openssl_get_ctx_stream_data_index()) == stream) {\n+\t\t\t\tSSL_CTX_set_ex_data(sslsock->ctx, php_openssl_get_ctx_stream_data_index(), NULL);\n+\t\t\t}\n \t\t\tSSL_CTX_free(sslsock->ctx);\n \t\t\tsslsock->ctx = NULL;\n \t\t}"},{"sha":"933e9c4ddc8121b3ca2d7329fee3698b502fa93d","filename":"ext/pcntl/pcntl.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpcntl%2Fpcntl.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpcntl%2Fpcntl.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpcntl%2Fpcntl.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -1803,7 +1803,7 @@ PHP_FUNCTION(pcntl_setcpuaffinity)\n \t\t\tif (Z_TYPE_P(ncpu) == IS_STRING) {\n \t\t\t\tzend_ulong tmp;\n \t\t\t\tif (!ZEND_HANDLE_NUMERIC(Z_STR_P(ncpu), tmp)) {\n-\t\t\t\t\tzend_argument_value_error(2, \"cpu id invalid value (%s)\", ZSTR_VAL(Z_STR_P(ncpu)));\n+\t\t\t\t\tzend_argument_value_error(2, \"cpu id invalid value (%pS)\", Z_STR_P(ncpu));\n \t\t\t\t\tPCNTL_CPU_DESTROY(mask);\n \t\t\t\t\tRETURN_THROWS();\n \t\t\t\t}"},{"sha":"9ccaebd5e8bb443c1cee4c7d06108598f6fc8106","filename":"ext/pdo/pdo_dbh.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo%2Fpdo_dbh.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo%2Fpdo_dbh.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo%2Fpdo_dbh.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -1606,7 +1606,7 @@ static void pdo_dbh_free_storage(zend_object *std)\n \t\tdbh->in_txn = false;\n \t}\n \n-\tif (dbh->is_persistent && dbh->driver_data && dbh->methods && dbh->methods->persistent_shutdown) {\n+\tif (dbh->is_persistent && dbh->refcount <= 2 && dbh->driver_data && dbh->methods && dbh->methods->persistent_shutdown) {\n \t\tdbh->methods->persistent_shutdown(dbh);\n \t}\n \tzend_object_std_dtor(std);"},{"sha":"7bf2c6812bfcf2c6f7ee1170dd59e87a65cfaae2","filename":"ext/pdo_firebird/firebird_statement.c","status":"modified","additions":8,"deletions":2,"changes":10,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_firebird%2Ffirebird_statement.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_firebird%2Ffirebird_statement.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_firebird%2Ffirebird_statement.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -332,9 +332,15 @@ static int pdo_firebird_stmt_describe(pdo_stmt_t *stmt, int colno) /* {{{ */\n static int pdo_firebird_stmt_get_column_meta(pdo_stmt_t *stmt, zend_long colno, zval *return_value)\n {\n \tpdo_firebird_stmt *S = (pdo_firebird_stmt *) stmt->driver_data;\n-\tXSQLVAR *var = &S->out_sqlda.sqlvar[colno];\n-\n+\tXSQLVAR *var;\n \tenum pdo_param_type param_type;\n+\n+\tif (colno >= stmt->column_count) {\n+\t\tZVAL_EMPTY_ARRAY(return_value);\n+\t\treturn 1;\n+\t}\n+\n+\tvar = &S->out_sqlda.sqlvar[colno];\n \tif (var->sqlscale < 0) {\n \t\tparam_type = PDO_PARAM_STR;\n \t} else {"},{"sha":"d0e9918322a255e46fc8414555cc25e030d27970","filename":"ext/pdo_firebird/tests/gh25006.phpt","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_firebird%2Ftests%2Fgh25006.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_firebird%2Ftests%2Fgh25006.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_firebird%2Ftests%2Fgh25006.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,73 @@\n+--TEST--\n+GH-25006 (PDO_Firebird::getColumnMeta() reads out of bounds for an out-of-range column index)\n+--EXTENSIONS--\n+pdo_firebird\n+--SKIPIF--\n+<?php\n+require 'skipif.inc';\n+?>\n+--XLEAK--\n+A bug in firebird causes a memory leak when calling `isc_attach_database()`.\n+See https://github.com/FirebirdSQL/firebird/issues/7849\n+--FILE--\n+<?php\n+require 'testdb.inc';\n+\n+$dbh = getDbConnection();\n+$dbh->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n+\n+$stmt = $dbh->prepare('SELECT 1 AS one, 2 AS two FROM RDB$DATABASE');\n+\n+echo \"before execute: \";\n+try {\n+    var_dump($stmt->getColumnMeta(2));\n+} catch (Throwable $e) {\n+    echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+\n+$stmt->execute();\n+\n+echo \"column 0: \";\n+$meta = $stmt->getColumnMeta(0);\n+echo $meta['name'], ' ', $meta['pdo_type'], \"\\n\";\n+\n+echo \"column 1: \";\n+$meta = $stmt->getColumnMeta(1);\n+echo $meta['name'], ' ', $meta['pdo_type'], \"\\n\";\n+\n+foreach ([2, 1000000] as $col) {\n+    echo \"column $col: \";\n+    try {\n+        var_dump($stmt->getColumnMeta($col));\n+    } catch (Throwable $e) {\n+        echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+    }\n+}\n+\n+echo \"no output columns: \";\n+$empty = $dbh->prepare('EXECUTE BLOCK AS BEGIN END');\n+echo $empty->columnCount(), ' ';\n+try {\n+    var_dump($empty->getColumnMeta(0));\n+} catch (Throwable $e) {\n+    echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+\n+echo \"negative: \";\n+try {\n+    var_dump($stmt->getColumnMeta(-1));\n+} catch (Throwable $e) {\n+    echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+\n+echo \"done\\n\";\n+?>\n+--EXPECT--\n+before execute: PDOException: SQLSTATE[07009]: Invalid descriptor index: invalid column index\n+column 0: ONE 1\n+column 1: TWO 1\n+column 2: PDOException: SQLSTATE[07009]: Invalid descriptor index: invalid column index\n+column 1000000: PDOException: SQLSTATE[07009]: Invalid descriptor index: invalid column index\n+no output columns: 0 PDOException: SQLSTATE[07009]: Invalid descriptor index: invalid column index\n+negative: ValueError: PDOStatement::getColumnMeta(): Argument #1 ($column) must be greater than or equal to 0\n+done"},{"sha":"20edb7f67339cab666fd484da55166b08c8c8b8e","filename":"ext/pdo_pgsql/pgsql_driver.c","status":"modified","additions":33,"deletions":5,"changes":38,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Fpgsql_driver.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Fpgsql_driver.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Fpgsql_driver.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -251,6 +251,11 @@ static void pgsql_handle_closer(pdo_dbh_t *dbh) /* {{{ */\n \t\t\tpefree(H->lob_streams, dbh->is_persistent);\n \t\t\tH->lob_streams = NULL;\n \t\t}\n+\t\tif (H->prepared_stmts) {\n+\t\t\tzend_hash_destroy(H->prepared_stmts);\n+\t\t\tpefree(H->prepared_stmts, 1);\n+\t\t\tH->prepared_stmts = NULL;\n+\t\t}\n \t\tpdo_pgsql_cleanup_notice_callback(H);\n \t\tif (H->server) {\n \t\t\tPQfinish(H->server);\n@@ -1398,12 +1403,31 @@ static void pdo_pgsql_request_shutdown(pdo_dbh_t *dbh)\n \tpdo_pgsql_db_handle *H = (pdo_pgsql_db_handle *)dbh->driver_data;\n \n \tif(H->server) {\n-\t\tres = PQexec(H->server, \"DISCARD ALL\");\n-\n-\t\tif(res) {\n+\t\tzend_string *name;\n+\n+\t\tZEND_HASH_MAP_FOREACH_STR_KEY(H->prepared_stmts, name) {\n+#ifndef HAVE_PQCLOSEPREPARED\n+\t\t\tchar *q;\n+\t\t\tspprintf(&q, 0, \"DEALLOCATE %s\", ZSTR_VAL(name));\n+\t\t\tres = PQexec(H->server, q);\n+\t\t\tefree(q);\n+#else\n+\t\t\tres = PQclosePrepared(H->server, ZSTR_VAL(name));\n+#endif\n \t\t\tPQclear(res);\n+\t\t} ZEND_HASH_FOREACH_END();\n+\t\tzend_hash_clean(H->prepared_stmts);\n+\n+\t\tres = PQexec(H->server, \"CLOSE ALL; SET SESSION AUTHORIZATION DEFAULT; RESET ALL; UNLISTEN *; \"\n+\t\t\t\"SELECT pg_advisory_unlock_all(); DISCARD TEMP; DISCARD SEQUENCES\");\n+\n+\t\tif (PQresultStatus(res) != PGRES_COMMAND_OK && PQstatus(H->server) == CONNECTION_OK) {\n+\t\t\tPQreset(H->server);\n \t\t}\n+\t\tPQclear(res);\n \t}\n+\n+\tpdo_pgsql_cleanup_notice_callback(H);\n }\n \n static bool pdo_pgsql_set_attr(pdo_dbh_t *dbh, zend_long attr, zval *val)\n@@ -1512,17 +1536,21 @@ static int pdo_pgsql_handle_factory(pdo_dbh_t *dbh, zval *driver_options) /* {{{\n \n \t/* support both full connection string & connection string + login and/or password */\n \tif (tmp_user) {\n-\t\tsmart_str_append_printf(&conn_str, \" user='%s'\", ZSTR_VAL(tmp_user));\n+\t\tsmart_str_append_printf(&conn_str, \" user='%pS'\", tmp_user);\n \t}\n \n \tif (tmp_pass) {\n-\t\tsmart_str_append_printf(&conn_str, \" password='%s'\", ZSTR_VAL(tmp_pass));\n+\t\tsmart_str_append_printf(&conn_str, \" password='%pS'\", tmp_pass);\n \t}\n \tsmart_str_0(&conn_str);\n \n \tH->server = PQconnectdb(ZSTR_VAL(conn_str.s));\n \tH->lob_streams = (HashTable *) pemalloc(sizeof(HashTable), dbh->is_persistent);\n \tzend_hash_init(H->lob_streams, 0, NULL, NULL, 1);\n+\tif (dbh->is_persistent) {\n+\t\tH->prepared_stmts = (HashTable *) pemalloc(sizeof(HashTable), 1);\n+\t\tzend_hash_init(H->prepared_stmts, 0, NULL, NULL, 1);\n+\t}\n \n \tif (tmp_user) {\n \t\tzend_string_release_ex(tmp_user, 0);"},{"sha":"de7d03bc726401b4e6347d4038bc39f4da155c3d","filename":"ext/pdo_pgsql/pgsql_statement.c","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Fpgsql_statement.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Fpgsql_statement.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Fpgsql_statement.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -190,9 +190,11 @@ static void pgsql_stmt_finish(pdo_pgsql_stmt *S, int fin_mode)\n \t\tres = PQclosePrepared(H->server, S->stmt_name);\n #endif\n \t\tif (res) {\n+\t\t\tif (H->prepared_stmts && PQresultStatus(res) == PGRES_COMMAND_OK) {\n+\t\t\t\tzend_hash_str_del(H->prepared_stmts, S->stmt_name, strlen(S->stmt_name));\n+\t\t\t}\n \t\t\tPQclear(res);\n \t\t}\n-\n \t\tS->is_prepared = false;\n \t}\n }\n@@ -339,6 +341,9 @@ static int pgsql_stmt_execute(pdo_stmt_t *stmt)\n \t\t\t\tcase PGRES_TUPLES_OK:\n \t\t\t\t\t/* it worked */\n \t\t\t\t\tS->is_prepared = true;\n+\t\t\t\t\tif (H->prepared_stmts) {\n+\t\t\t\t\t\tzend_hash_str_add_empty_element(H->prepared_stmts, S->stmt_name, strlen(S->stmt_name));\n+\t\t\t\t\t}\n \t\t\t\t\tPQclear(S->result);\n \t\t\t\t\tS->result = NULL;\n \t\t\t\t\tbreak;"},{"sha":"9ca729cd44a560468b43a7202df26f38f239c903","filename":"ext/pdo_pgsql/php_pdo_pgsql_int.h","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Fphp_pdo_pgsql_int.h","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Fphp_pdo_pgsql_int.h","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Fphp_pdo_pgsql_int.h?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -45,6 +45,7 @@ typedef struct {\n \tbool\t\temulate_prepares;\n \tbool\t\tdisable_prepares;\n \tHashTable       *lob_streams;\n+\tHashTable       *prepared_stmts;\n \tzend_fcall_info_cache *notice_callback;\n \tbool\t\tdefault_fetching_laziness;\n \tzend_long\tdefault_chunk_size;"},{"sha":"600a58f5123001221b153f3596dd792e88d672a3","filename":"ext/pdo_pgsql/tests/gh24461.phpt","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Ftests%2Fgh24461.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,40 @@\n+--TEST--\n+GH-24461 (Persistent connections: session reset keeps prepared statements)\n+--EXTENSIONS--\n+pdo_pgsql\n+--SKIPIF--\n+<?php\n+require __DIR__ . '/config.inc';\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+PDOTest::skip();\n+?>\n+--FILE--\n+<?php\n+putenv('PDOTEST_ATTR='.serialize([PDO::ATTR_PERSISTENT => true]));\n+\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+\n+$pdo1 = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+$pid1 = (int) $pdo1->query('SELECT pg_backend_pid()')->fetchColumn();\n+\n+$pdo1->exec(\"SET application_name = 'gh24461'\");\n+$pdo1->exec('CREATE TEMP TABLE gh24461_tmp (i int)');\n+$pdo1->exec('PREPARE gh24461_stmt AS SELECT 42');\n+\n+$pdo1 = null;\n+\n+$pdo2 = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+$pid2 = (int) $pdo2->query('SELECT pg_backend_pid()')->fetchColumn();\n+var_dump($pid1 === $pid2);\n+\n+var_dump($pdo2->query('SHOW application_name')->fetchColumn());\n+var_dump($pdo2->query(\"SELECT to_regclass('pg_temp.gh24461_tmp')\")->fetchColumn());\n+var_dump($pdo2->query('EXECUTE gh24461_stmt')->fetchColumn());\n+\n+$pdo2->exec('DEALLOCATE gh24461_stmt');\n+?>\n+--EXPECT--\n+bool(true)\n+string(0) \"\"\n+NULL\n+string(2) \"42\""},{"sha":"9c07b739b9b7d67b6d7a5b99783b798d5c663a95","filename":"ext/pdo_pgsql/tests/gh24461_aborted_transaction_close.phpt","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_aborted_transaction_close.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_aborted_transaction_close.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_aborted_transaction_close.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,40 @@\n+--TEST--\n+GH-24461 (Persistent connections: statements closed inside an aborted transaction are closed on reset)\n+--EXTENSIONS--\n+pdo_pgsql\n+--SKIPIF--\n+<?php\n+require __DIR__ . '/config.inc';\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+PDOTest::skip();\n+?>\n+--FILE--\n+<?php\n+putenv('PDOTEST_ATTR='.serialize([PDO::ATTR_PERSISTENT => true, PDO::ATTR_EMULATE_PREPARES => false]));\n+\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+\n+$pdo = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n+$pid1 = (int) $pdo->query('SELECT pg_backend_pid()')->fetchColumn();\n+$pdo->beginTransaction();\n+$stmt = $pdo->prepare(\"SELECT 'gh24461_aborted'\");\n+$stmt->execute();\n+try {\n+    $pdo->exec('SELECT 1/0');\n+} catch (PDOException $e) {\n+}\n+$stmt = null;\n+$pdo->rollBack();\n+$pdo = null;\n+\n+$pdo = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+$pid2 = (int) $pdo->query('SELECT pg_backend_pid()')->fetchColumn();\n+var_dump($pid1 === $pid2);\n+var_dump($pdo->query(\"SELECT count(*) FROM pg_prepared_statements WHERE statement = 'SELECT ''gh24461_aborted'''\")->fetchColumn());\n+?>\n+--CREDITS--\n+Artem Ukrainskiy\n+--EXPECT--\n+bool(true)\n+string(1) \"0\""},{"sha":"a418e3ad358f6bd8fb59984b9c0fc982d9c12f19","filename":"ext/pdo_pgsql/tests/gh24461_leftover_statement.phpt","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_leftover_statement.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_leftover_statement.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_leftover_statement.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,37 @@\n+--TEST--\n+GH-24461 (Persistent connections: statements outliving their PDO object are closed on reset)\n+--EXTENSIONS--\n+pdo_pgsql\n+--SKIPIF--\n+<?php\n+require __DIR__ . '/config.inc';\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+PDOTest::skip();\n+?>\n+--FILE--\n+<?php\n+putenv('PDOTEST_ATTR='.serialize([PDO::ATTR_PERSISTENT => true]));\n+\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+\n+class HoldingPDO extends PDO {\n+    public $stmt;\n+}\n+\n+$pdo1 = PDOTest::test_factory(__DIR__ . '/common.phpt', HoldingPDO::class);\n+$pid1 = (int) $pdo1->query('SELECT pg_backend_pid()')->fetchColumn();\n+$pdo1->stmt = $pdo1->prepare(\"SELECT 'gh24461'\");\n+$pdo1->stmt->execute();\n+\n+unset($pdo1);\n+var_dump(gc_collect_cycles() > 0);\n+\n+$pdo2 = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+$pid2 = (int) $pdo2->query('SELECT pg_backend_pid()')->fetchColumn();\n+var_dump($pid1 === $pid2);\n+var_dump($pdo2->query(\"SELECT count(*) FROM pg_prepared_statements WHERE statement = 'SELECT ''gh24461'''\")->fetchColumn());\n+?>\n+--EXPECT--\n+bool(true)\n+bool(true)\n+string(1) \"0\""},{"sha":"f341beecb0812a45206d2d974da1826dc8f03dc7","filename":"ext/pdo_pgsql/tests/gh24461_shared_connection.phpt","status":"added","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_shared_connection.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_shared_connection.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Ftests%2Fgh24461_shared_connection.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,46 @@\n+--TEST--\n+GH-24461 (Persistent connections: session state is not reset while another PDO object still uses the connection)\n+--EXTENSIONS--\n+pdo_pgsql\n+--SKIPIF--\n+<?php\n+require __DIR__ . '/config.inc';\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+PDOTest::skip();\n+?>\n+--FILE--\n+<?php\n+putenv('PDOTEST_ATTR='.serialize([PDO::ATTR_PERSISTENT => true]));\n+\n+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';\n+\n+$pdo1 = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+$pdo2 = PDOTest::test_factory(__DIR__ . '/common.phpt');\n+\n+$pid1 = (int) $pdo1->query('SELECT pg_backend_pid()')->fetchColumn();\n+$pid2 = (int) $pdo2->query('SELECT pg_backend_pid()')->fetchColumn();\n+var_dump($pid1 === $pid2);\n+\n+$pdo2->exec(\"SET application_name = 'gh24461'\");\n+$pdo2->exec('CREATE TEMP TABLE gh24461_shared (i int)');\n+$pdo2->query('SELECT pg_advisory_lock(24461)');\n+$stmt = $pdo2->prepare('SELECT 42');\n+$stmt->execute();\n+$stmt->closeCursor();\n+\n+$pdo1 = null;\n+\n+var_dump($pdo2->query('SHOW application_name')->fetchColumn());\n+var_dump($pdo2->query('SELECT count(*) FROM gh24461_shared')->fetchColumn());\n+var_dump($pdo2->query(\"SELECT count(*) FROM pg_locks WHERE locktype = 'advisory' AND objid = 24461 AND pid = pg_backend_pid()\")->fetchColumn());\n+$stmt->execute();\n+var_dump($stmt->fetchColumn());\n+\n+$pdo2->query('SELECT pg_advisory_unlock_all()');\n+?>\n+--EXPECT--\n+bool(true)\n+string(7) \"gh24461\"\n+string(1) \"0\"\n+string(1) \"1\"\n+string(2) \"42\""},{"sha":"15c1d6d694321b7114951392b08c443a90db2932","filename":"ext/pdo_pgsql/tests/pdopgsql_setNoticeCallback_persistent.phpt","status":"added","additions":49,"deletions":0,"changes":49,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fpdopgsql_setNoticeCallback_persistent.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_pgsql%2Ftests%2Fpdopgsql_setNoticeCallback_persistent.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_pgsql%2Ftests%2Fpdopgsql_setNoticeCallback_persistent.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,49 @@\n+--TEST--\n+Pdo\\Pgsql::setNoticeCallback() does not outlive the request on a persistent connection\n+--EXTENSIONS--\n+pdo\n+pdo_pgsql\n+--SKIPIF--\n+<?php\n+require __DIR__ . '/config.inc';\n+require dirname(__DIR__, 2) . '/pdo/tests/pdo_test.inc';\n+PDOTest::skip();\n+?>\n+--CONFLICTS--\n+server\n+--FILE--\n+<?php\n+require __DIR__ . '/config.inc';\n+include __DIR__ . '/../../../sapi/cli/tests/php_cli_server.inc';\n+\n+$code = '$db = new Pdo\\Pgsql(' . var_export($config['ENV']['PDOTEST_DSN'], true) . ', null, null, [PDO::ATTR_PERSISTENT => true]);' . <<<'PHP'\n+if (isset($_GET['set'])) {\n+    $db->setNoticeCallback(function ($message) {\n+        echo trim($message), \"\\n\";\n+    });\n+}\n+$db->exec(\"DO $$ BEGIN RAISE NOTICE 'request {$_GET['n']}'; END $$\");\n+echo \"request {$_GET['n']} done\\n\";\n+PHP;\n+\n+$args = ['-d', 'extension_dir=' . ini_get('extension_dir')];\n+foreach (['pdo', 'pdo_pgsql'] as $ext) {\n+    $args[] = '-d';\n+    $args[] = 'extension=' . (PHP_OS_FAMILY === 'Windows' ? 'php_' : '') . $ext . '.' . PHP_SHLIB_SUFFIX;\n+}\n+if (php_ini_loaded_file()) {\n+    $args[] = '-c';\n+    $args[] = php_ini_loaded_file();\n+}\n+php_cli_server_start($code, 'index.php', $args);\n+\n+echo file_get_contents('http://' . PHP_CLI_SERVER_ADDRESS . '/?n=1&set=1');\n+echo file_get_contents('http://' . PHP_CLI_SERVER_ADDRESS . '/?n=2');\n+echo file_get_contents('http://' . PHP_CLI_SERVER_ADDRESS . '/?n=3&set=1');\n+?>\n+--EXPECT--\n+NOTICE:  request 1\n+request 1 done\n+request 2 done\n+NOTICE:  request 3\n+request 3 done"},{"sha":"9c0a6be0bc09f2af884ce30afc8858d577414ad9","filename":"ext/pdo_sqlite/sqlite_driver.c","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Fsqlite_driver.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Fsqlite_driver.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_sqlite%2Fsqlite_driver.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -397,7 +397,11 @@ static int do_callback(zend_fcall_info_cache *fcc, int argc, sqlite3_value **arg\n \t\t/* get the value */\n \t\tswitch (sqlite3_value_type(argv[i])) {\n \t\t\tcase SQLITE_INTEGER:\n+#ifdef ZEND_ENABLE_ZVAL_LONG64\n+\t\t\t\tZVAL_LONG(&zargs[i + is_agg], sqlite3_value_int64(argv[i]));\n+#else\n \t\t\t\tZVAL_LONG(&zargs[i + is_agg], sqlite3_value_int(argv[i]));\n+#endif\n \t\t\t\tbreak;\n \n \t\t\tcase SQLITE_FLOAT:\n@@ -435,7 +439,11 @@ static int do_callback(zend_fcall_info_cache *fcc, int argc, sqlite3_value **arg\n \t\tif (!Z_ISUNDEF(retval)) {\n \t\t\tswitch (Z_TYPE(retval)) {\n \t\t\t\tcase IS_LONG:\n+#ifdef ZEND_ENABLE_ZVAL_LONG64\n+\t\t\t\t\tsqlite3_result_int64(context, Z_LVAL(retval));\n+#else\n \t\t\t\t\tsqlite3_result_int(context, Z_LVAL(retval));\n+#endif\n \t\t\t\t\tbreak;\n \n \t\t\t\tcase IS_NULL:"},{"sha":"0d088c99ce7aa8333b58a5ce02a04670341c9a7f","filename":"ext/pdo_sqlite/sqlite_statement.c","status":"modified","additions":2,"deletions":3,"changes":5,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Fsqlite_statement.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Fsqlite_statement.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_sqlite%2Fsqlite_statement.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -65,11 +65,10 @@ static int pdo_sqlite_stmt_execute(pdo_stmt_t *stmt)\n \t\t\treturn 1;\n \n \t\tcase SQLITE_ERROR:\n-\t\t\tsqlite3_reset(S->stmt);\n-\t\t\tZEND_FALLTHROUGH;\n \t\tcase SQLITE_MISUSE:\n \t\tcase SQLITE_BUSY:\n \t\tdefault:\n+\t\t\tsqlite3_reset(S->stmt);\n \t\t\tpdo_sqlite_error_stmt(stmt);\n \t\t\treturn 0;\n \t}\n@@ -118,7 +117,7 @@ static int pdo_sqlite_stmt_param_hook(pdo_stmt_t *stmt, struct pdo_bound_param_d\n \t\t\t\t\t\t\t}\n \t\t\t\t\t\t} else {\n \t\t\t\t\t\t\tconvert_to_long(parameter);\n-#if ZEND_LONG_MAX > 2147483647\n+#ifdef ZEND_ENABLE_ZVAL_LONG64\n \t\t\t\t\t\t\tif (SQLITE_OK == sqlite3_bind_int64(S->stmt, param->paramno + 1, Z_LVAL_P(parameter))) {\n \t\t\t\t\t\t\t\treturn 1;\n \t\t\t\t\t\t\t}"},{"sha":"89bfe35e74bc65142546bf6ef8468f827cd58989","filename":"ext/pdo_sqlite/tests/gh24990.phpt","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Ftests%2Fgh24990.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Ftests%2Fgh24990.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_sqlite%2Ftests%2Fgh24990.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,33 @@\n+--TEST--\n+GH-24990 (Statement unusable after a failed execute())\n+--EXTENSIONS--\n+pdo_sqlite\n+--FILE--\n+<?php\n+$db = new PDO('sqlite::memory:', options: [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);\n+$db->exec('CREATE TABLE test (k TEXT PRIMARY KEY NOT NULL)');\n+$db->exec(\"INSERT INTO test VALUES ('a')\");\n+\n+$stmt = $db->prepare('INSERT INTO test (k) VALUES (?)');\n+foreach (['a', 'b', 'b', 'c'] as $k) {\n+    try {\n+        var_dump($stmt->execute([$k]));\n+    } catch (PDOException $e) {\n+        echo $e->getMessage(), \"\\n\";\n+    }\n+}\n+var_dump($db->query('SELECT k FROM test ORDER BY k')->fetchAll(PDO::FETCH_COLUMN));\n+?>\n+--EXPECT--\n+SQLSTATE[23000]: Integrity constraint violation: 19 UNIQUE constraint failed: test.k\n+bool(true)\n+SQLSTATE[23000]: Integrity constraint violation: 19 UNIQUE constraint failed: test.k\n+bool(true)\n+array(3) {\n+  [0]=>\n+  string(1) \"a\"\n+  [1]=>\n+  string(1) \"b\"\n+  [2]=>\n+  string(1) \"c\"\n+}"},{"sha":"ab7231c953b8e9589b354249af301182d632a66b","filename":"ext/pdo_sqlite/tests/gh25021-udf.phpt","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Ftests%2Fgh25021-udf.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpdo_sqlite%2Ftests%2Fgh25021-udf.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpdo_sqlite%2Ftests%2Fgh25021-udf.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,29 @@\n+--TEST--\n+GH-25021 (UDF isn't using sqlite3_*_int64 API)\n+--EXTENSIONS--\n+pdo_sqlite\n+--FILE--\n+<?php\n+\n+$conn = new PDO('sqlite::memory:');\n+\n+$conn->sqliteCreateFunction('my_udf_pass_int', static fn(int $v): int => $v);\n+\n+foreach ([\n+    10,\n+    PHP_INT_MIN,\n+    PHP_INT_MAX,\n+] as $v) {\n+    $stmt = $conn->prepare('select my_udf_pass_int(:v)');\n+    $stmt->bindValue(':v', $v, PDO::PARAM_INT);\n+    $stmt->execute();\n+    $result = $stmt->fetch();\n+    \n+    var_dump($result[0] === $v);\n+}\n+?>\n+--EXPECTF--\n+Deprecated: Method PDO::sqliteCreateFunction() is deprecated since 8.5, use Pdo\\Sqlite::createFunction() instead in %s on line %d\n+bool(true)\n+bool(true)\n+bool(true)"},{"sha":"7582c8505721bf64781282b7abfd375da9376a2d","filename":"ext/pgsql/pgsql.c","status":"modified","additions":41,"deletions":41,"changes":82,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpgsql%2Fpgsql.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fpgsql%2Fpgsql.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fpgsql%2Fpgsql.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -329,7 +329,7 @@ static void _php_pgsql_notice_handler(void *l, const char *message)\n \n \tzend_string *trimmed_message = _php_pgsql_trim_message(message);\n \tif (PGG(log_notices)) {\n-\t\tphp_error_docref(NULL, E_NOTICE, \"%s\", ZSTR_VAL(trimmed_message));\n+\t\tphp_error_docref(NULL, E_NOTICE, \"%pS\", trimmed_message);\n \t}\n \n \tZVAL_STR(&tmp, trimmed_message);\n@@ -696,7 +696,7 @@ static void php_pgsql_do_connect(INTERNAL_FUNCTION_PARAMETERS, int persistent)\n \t\t\t\tif (pgsql) {\n \t\t\t\t\tPQfinish(pgsql);\n \t\t\t\t}\n-\t\t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to connect to PostgreSQL server: %s\", ZSTR_VAL(msgbuf));\n+\t\t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to connect to PostgreSQL server: %pS\", msgbuf);\n \t\t\t\tzend_string_release(msgbuf);\n \t\t\t\tgoto err;\n \t\t\t}\n@@ -782,7 +782,7 @@ static void php_pgsql_do_connect(INTERNAL_FUNCTION_PARAMETERS, int persistent)\n \t\t\t\tif (pgsql) {\n \t\t\t\t\tPQfinish(pgsql);\n \t\t\t\t}\n-\t\t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to connect to PostgreSQL server: %s\", ZSTR_VAL(msgbuf));\n+\t\t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to connect to PostgreSQL server: %pS\", msgbuf);\n \t\t\t\tzend_string_release(msgbuf);\n \t\t\t\tgoto err;\n \t\t\t}\n@@ -793,7 +793,7 @@ static void php_pgsql_do_connect(INTERNAL_FUNCTION_PARAMETERS, int persistent)\n \t\t\t\tif (pgsql) {\n \t\t\t\t\tPQfinish(pgsql);\n \t\t\t\t}\n-\t\t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to connect to PostgreSQL server: %s\", ZSTR_VAL(msgbuf));\n+\t\t\t\tphp_error_docref(NULL, E_WARNING, \"Unable to connect to PostgreSQL server: %pS\", msgbuf);\n \t\t\t\tzend_string_release(msgbuf);\n \t\t\t\tgoto err;\n \t\t\t}\n@@ -2134,8 +2134,8 @@ PHP_FUNCTION(pg_fetch_object)\n \n \tif (UNEXPECTED(!constructor && ctor_params && zend_hash_num_elements(ctor_params) > 0)) {\n \t\tzend_argument_value_error(4,\n-\t\t\t\"must be empty when the specified class (%s) does not have a constructor\",\n-\t\t\tZSTR_VAL(ce->name)\n+\t\t\t\"must be empty when the specified class (%pS) does not have a constructor\",\n+\t\t\tce->name\n \t\t);\n \t\tRETURN_THROWS();\n \t}\n@@ -2269,9 +2269,9 @@ static void php_pgsql_data_info(INTERNAL_FUNCTION_PARAMETERS, int entry_type, bo\n \n \tif (ZEND_NUM_ARGS() == 2) {\n \t\tif (nullable_row) {\n