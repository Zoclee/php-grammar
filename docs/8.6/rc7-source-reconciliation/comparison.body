.github.com/users/bwoebi/followers","following_url":"https://api.github.com/users/bwoebi/following{/other_user}","gists_url":"https://api.github.com/users/bwoebi/gists{/gist_id}","starred_url":"https://api.github.com/users/bwoebi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bwoebi/subscriptions","organizations_url":"https://api.github.com/users/bwoebi/orgs","repos_url":"https://api.github.com/users/bwoebi/repos","events_url":"https://api.github.com/users/bwoebi/events{/privacy}","received_events_url":"https://api.github.com/users/bwoebi/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"91dc887163795906f353fb82711e79417db015fa","url":"https://api.github.com/repos/php/php-src/commits/91dc887163795906f353fb82711e79417db015fa","html_url":"https://github.com/php/php-src/commit/91dc887163795906f353fb82711e79417db015fa"}]},{"sha":"9eae3ff58ca5152a75f0281f6100b4d3c1a1d866","node_id":"C_kwDOAB0LotoAKDllYWUzZmY1OGNhNTE1MmE3NWYwMjgxZjYxMDBiNGQzYzFhMWQ4NjY","commit":{"author":{"name":"Alexandre Rulleau","email":"55387832+Leiyks@users.noreply.github.com","date":"2026-10-30T14:35:02Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-30T14:35:02Z"},"message":"Load DECLARE_LAMBDA_FUNCTION cache slot once (#24598)\n\nopline->extended_value lives in the (opcache SHM) op_array, so another\nprocess may set it to -1 between the != -1 check and its reuse as a slot\noffset, which would then index the run-time cache out of bounds. Read it\nonce into a local; same for ZEND_CALLABLE_CONVERT.","tree":{"sha":"aadea04fca50e9bf426a9484652b4207b327c190","url":"https://api.github.com/repos/php/php-src/git/trees/aadea04fca50e9bf426a9484652b4207b327c190"},"url":"https://api.github.com/repos/php/php-src/git/commits/9eae3ff58ca5152a75f0281f6100b4d3c1a1d866","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq5KsWCRC1aQ7uu5UhlAAAC9sQACRvvwkdcMulZJNLanQIJDr1\n0B5ieLZE7GnVEoRTgOqgj/mE1P5hjb2xxsN1haOrBfQTdhZ5cAKJh3Q1H249SGFf\n/FVIVgBwOgAbSvbhaMYw6lQsbMoGnB7dhcGwu1Kl8a8fVKv2DBEoy3wybfRiUFer\n8Ivbzvk0XJB+v34AC3ExuXQ7g3+arfBkyN9fVbkWstKUVOl3wVBq5NMjUSVWh1bB\nSuDugQNMmDIyH77DW9VWIatRvsfP18SHhvN2XBYqel7eVU2cCb4sWFvo9trPfSSX\nOfbHRgSO+mn3XkXT+zKzTs99dJn3Z32nVyhoZl6z9MQwBZGngXH/ZdAoP3pshBKk\nvWFT2jXZOnNZARe8tm7Ffrb7E9q8F+9RQkaRy5wx7GXtwvf5Grad6ucLD6nPOMFA\nZiqwALbXfqGvHQlSnWop1qqrv/QuQP72OhtsJeZ8k0BgaWMWPOQISfAEZoRgETTQ\nL2musoI979TP7GxcU/0kfRr3GIc9WpmhHMeCtJg27xSbt/diCcas/1v14m6EV+5g\nALF2c2/za3FisFveaMD3Ld9y/V3vBE1xwKKx6llAGq8uOTFToBoy36bvPo2oynBo\nmpPsC/w23I1GxSPXhmzIrnlpcB3vKSNa1CEh7Fu1B4Q6CqVGl1rnbbXAwOrZh11H\nBH20kmSOR8pV4INprswE\n=oPcX\n-----END PGP SIGNATURE-----\n","payload":"tree aadea04fca50e9bf426a9484652b4207b327c190\nparent 8fc9e7c8e8f771ab55671cec00c4e468ec511efe\nauthor Alexandre Rulleau <55387832+Leiyks@users.noreply.github.com> 1793370902 +0100\ncommitter GitHub <noreply@github.com> 1793370902 +0100\n\nLoad DECLARE_LAMBDA_FUNCTION cache slot once (#24598)\n\nopline->extended_value lives in the (opcache SHM) op_array, so another\nprocess may set it to -1 between the != -1 check and its reuse as a slot\noffset, which would then index the run-time cache out of bounds. Read it\nonce into a local; same for ZEND_CALLABLE_CONVERT.","verified_at":"2026-10-30T14:35:03Z"}},"url":"https://api.github.com/repos/php/php-src/commits/9eae3ff58ca5152a75f0281f6100b4d3c1a1d866","html_url":"https://github.com/php/php-src/commit/9eae3ff58ca5152a75f0281f6100b4d3c1a1d866","comments_url":"https://api.github.com/repos/php/php-src/commits/9eae3ff58ca5152a75f0281f6100b4d3c1a1d866/comments","author":{"login":"Leiyks","id":55387832,"node_id":"MDQ6VXNlcjU1Mzg3ODMy","avatar_url":"https://avatars.githubusercontent.com/u/55387832?v=4","gravatar_id":"","url":"https://api.github.com/users/Leiyks","html_url":"https://github.com/Leiyks","followers_url":"https://api.github.com/users/Leiyks/followers","following_url":"https://api.github.com/users/Leiyks/following{/other_user}","gists_url":"https://api.github.com/users/Leiyks/gists{/gist_id}","starred_url":"https://api.github.com/users/Leiyks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Leiyks/subscriptions","organizations_url":"https://api.github.com/users/Leiyks/orgs","repos_url":"https://api.github.com/users/Leiyks/repos","events_url":"https://api.github.com/users/Leiyks/events{/privacy}","received_events_url":"https://api.github.com/users/Leiyks/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8fc9e7c8e8f771ab55671cec00c4e468ec511efe","url":"https://api.github.com/repos/php/php-src/commits/8fc9e7c8e8f771ab55671cec00c4e468ec511efe","html_url":"https://github.com/php/php-src/commit/8fc9e7c8e8f771ab55671cec00c4e468ec511efe"}]},{"sha":"5f4d73a697bf83ea9d25f542c3641e8b0c0951f8","node_id":"C_kwDOAB0LotoAKDVmNGQ3M2E2OTdiZjgzZWE5ZDI1ZjU0MmMzNjQxZThiMGMwOTUxZjg","commit":{"author":{"name":"Levi Morrison","email":"levi.morrison@datadoghq.com","date":"2026-10-30T14:46:22Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-30T14:46:22Z"},"message":"Fix potential infinite recursion in HYBRID/TAILCALL VMs (#25039)\n\nThe recursion will result in a stack overflow on HYBRID VMs and\ninfinite recursion in TAILCALL VMs.\n\nThe property that the VM makes guaranteed forward progress is useful\nfor testing but it's also helpful to guard against for edge cases in\nproduction as well.","tree":{"sha":"6bd951cebf7b49d1a7045813a1b68060902cde1e","url":"https://api.github.com/repos/php/php-src/git/trees/6bd951cebf7b49d1a7045813a1b68060902cde1e"},"url":"https://api.github.com/repos/php/php-src/git/commits/5f4d73a697bf83ea9d25f542c3641e8b0c0951f8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq5K2+CRC1aQ7uu5UhlAAAF9YQAI3fNUlGntHbLLddwpeA8lMO\nPAFgbGeQ60VlHx7G0QOP8PTLUiAXQZZgR8GupzRV04glqpkdMtWHaER4GZ4humfL\ncOLEfVXfRzBzJHfEYzCBbgMchtg0HT9uqYsKRhQAXaJ50GoAHRDNO3snBXm+wZJ5\n0qNTV7OOawIi5bZ0nIccHHS/+ucfX6QUtyjWxGDQkG6WfvMA/bb1d+XY+QX+DvJV\nt3esNHZ099umR7vCsUGM7+iCnlLyCiBVXpgvB/glLVmMeDMYNKvgOZ4wf8AWLyMI\ntnbK91SJE/VaqMqh+vpKHxxr0TAByUzccCxwLXaucRg6/BjmAobFvU8TJAKHUGXy\nkTnQgxYe3xbcBgGQFNGK5vOUgIGMH8EufR2397NeRI69P25J2MZUuqJbWJOJtfll\nm1U9tWp2bXqO6s1jIhR635yCZBd602x7Fwh3GVKgTyKhkwrBAenUCPcvt8RNYoCZ\nGVlPY4muWkE6CMAK4ohs6oaGEkqpZnW+GzZjl7/s9hLGUIWKnhAbfixiDTN2k9iE\n0DQIZ0s6yP7fCWH8LxSpByJp/+s7PJNhuBD+8LnSpSXR+0L1XI5GXUeMzSmWoTKL\nWwUeRpaxraZzRsS1xVkB5VYTGd97EQwfpArisH1v2Sfwdfd2tAlJ1fs+O5bMh1Lv\n/jYFTt3Vagdw/U3pJiuM\n=0FQf\n-----END PGP SIGNATURE-----\n","payload":"tree 6bd951cebf7b49d1a7045813a1b68060902cde1e\nparent 2b99297b76457100e1688e49697bb0e6a5124327\nauthor Levi Morrison <levi.morrison@datadoghq.com> 1793371582 -0600\ncommitter GitHub <noreply@github.com> 1793371582 +0100\n\nFix potential infinite recursion in HYBRID/TAILCALL VMs (#25039)\n\nThe recursion will result in a stack overflow on HYBRID VMs and\ninfinite recursion in TAILCALL VMs.\n\nThe property that the VM makes guaranteed forward progress is useful\nfor testing but it's also helpful to guard against for edge cases in\nproduction as well.","verified_at":"2026-10-30T14:46:22Z"}},"url":"https://api.github.com/repos/php/php-src/commits/5f4d73a697bf83ea9d25f542c3641e8b0c0951f8","html_url":"https://github.com/php/php-src/commit/5f4d73a697bf83ea9d25f542c3641e8b0c0951f8","comments_url":"https://api.github.com/repos/php/php-src/commits/5f4d73a697bf83ea9d25f542c3641e8b0c0951f8/comments","author":{"login":"morrisonlevi","id":253316,"node_id":"MDQ6VXNlcjI1MzMxNg==","avatar_url":"https://avatars.githubusercontent.com/u/253316?v=4","gravatar_id":"","url":"https://api.github.com/users/morrisonlevi","html_url":"https://github.com/morrisonlevi","followers_url":"https://api.github.com/users/morrisonlevi/followers","following_url":"https://api.github.com/users/morrisonlevi/following{/other_user}","gists_url":"https://api.github.com/users/morrisonlevi/gists{/gist_id}","starred_url":"https://api.github.com/users/morrisonlevi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/morrisonlevi/subscriptions","organizations_url":"https://api.github.com/users/morrisonlevi/orgs","repos_url":"https://api.github.com/users/morrisonlevi/repos","events_url":"https://api.github.com/users/morrisonlevi/events{/privacy}","received_events_url":"https://api.github.com/users/morrisonlevi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","star