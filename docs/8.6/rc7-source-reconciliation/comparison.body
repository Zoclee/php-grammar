che/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"89dc21ec6004fd7f689577190387a263b6e40e13","url":"https://api.github.com/repos/php/php-src/commits/89dc21ec6004fd7f689577190387a263b6e40e13","html_url":"https://github.com/php/php-src/commit/89dc21ec6004fd7f689577190387a263b6e40e13"},{"sha":"688a99a61db113f188993742cb4682f45cb3af68","url":"https://api.github.com/repos/php/php-src/commits/688a99a61db113f188993742cb4682f45cb3af68","html_url":"https://github.com/php/php-src/commit/688a99a61db113f188993742cb4682f45cb3af68"}]},{"sha":"2b99297b76457100e1688e49697bb0e6a5124327","node_id":"C_kwDOAB0LotoAKDJiOTkyOTdiNzY0NTcxMDBlMTY4OGU0OTY5N2JiMGU2YTUxMjQzMjc","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-10-19T12:26:05Z"},"committer":{"name":"Jakub Zelenka","email":"bukka@php.net","date":"2026-10-30T11:49:59Z"},"message":"ext/standard: Validate objects before queuing unserialize callbacks\n\nCheck the closing brace before queuing __unserialize() or __wakeup().\nIncomplete object records must use the same cleanup as invalid property\ndata, including destructor suppression. The __unserialize() data array of\na failed record now stays in the unserialize context until var_destroy()\ninstead of being released at once, so a destructor of a nested object\ncannot resolve a back-reference to an element the array already released.\n\nCloses GH-24433.","tree":{"sha":"433df822d9fbb75a21d9f60d0fdd77843729c44d","url":"https://api.github.com/repos/php/php-src/git/trees/433df822d9fbb75a21d9f60d0fdd77843729c44d"},"url":"https://api.github.com/repos/php/php-src/git/commits/2b99297b76457100e1688e49697bb0e6a5124327","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQTCjZN1dWA+tKu3JYYcB3ncXAqd5AUCauSEZwAKCRAcB3ncXAqd\n5AnmAQC4Ss7qWVN8MvFzkFHmEQuyU2BfmZjwS4BL/V70zFGUGwEAwLcF6Xe1EOO6\nWCV4UwZ1S7tppJL6RWx64mhNLaffJgM=\n=m4/Q\n-----END PGP SIGNATURE-----","payload":"tree 433df822d9fbb75a21d9f60d0fdd77843729c44d\nparent 38eabd0452df61e4d871f38e8afe2306490dd3b4\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1792412765 -0400\ncommitter Jakub Zelenka <bukka@php.net> 1793360999 +0100\n\next/standard: Validate objects before queuing unserialize callbacks\n\nCheck the closing brace before queuing __unserialize() or __wakeup().\nIncomplete object records must use the same cleanup as invalid property\ndata, including destructor suppression. The __unserialize() data array of\na failed record now stays in the unserialize context until var_destroy()\ninstead of being released at once, so a destructor of a nested object\ncannot resolve a back-reference to an element the array already released.\n\nCloses GH-24433.\n","verified_at":"2026-10-30T11:50:48Z"}},"url":"https://api.github.com/repos/php/php-src/com