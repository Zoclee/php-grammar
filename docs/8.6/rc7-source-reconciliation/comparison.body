ents_url":"https://api.github.com/users/devnexen/events{/privacy}","received_events_url":"https://api.github.com/users/devnexen/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"devnexen","id":4922778,"node_id":"MDQ6VXNlcjQ5MjI3Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/4922778?v=4","gravatar_id":"","url":"https://api.github.com/users/devnexen","html_url":"https://github.com/devnexen","followers_url":"https://api.github.com/users/devnexen/followers","following_url":"https://api.github.com/users/devnexen/following{/other_user}","gists_url":"https://api.github.com/users/devnexen/gists{/gist_id}","starred_url":"https://api.github.com/users/devnexen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/devnexen/subscriptions","organizations_url":"https://api.github.com/users/devnexen/orgs","repos_url":"https://api.github.com/users/devnexen/repos","events_url":"https://api.github.com/users/devnexen/events{/privacy}","received_events_url":"https://api.github.com/users/devnexen/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9bcb8487a7adf5a0d0a9852bac0bb78f69838a60","url":"https://api.github.com/repos/php/php-src/commits/9bcb8487a7adf5a0d0a9852bac0bb78f69838a60","html_url":"https://github.com/php/php-src/commit/9bcb8487a7adf5a0d0a9852bac0bb78f69838a60"},{"sha":"273f8dbe27579ae60a318694a3a20d94b4b8f502","url":"https://api.github.com/repos/php/php-src/commits/273f8dbe27579ae60a318694a3a20d94b4b8f502","html_url":"https://github.com/php/php-src/commit/273f8dbe27579ae60a318694a3a20d94b4b8f502"}]},{"sha":"78581318c408693bea892607958ff47c6a1ab509","node_id":"C_kwDOAB0LotoAKDc4NTgxMzE4YzQwODY5M2JlYTg5MjYwNzk1OGZmNDdjNmExYWI1MDk","commit":{"author":{"name":"lazerg","email":"lazerg2@gmail.com","date":"2026-11-02T19:25:20Z"},"committer":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-11-02T19:25:20Z"},"message":"Fix GH-24990: pdo_sqlite statement unusable after failed execute() (#24991)\n\nReset the SQLite statement after every failed step, including constraint\nfailures. Previously only SQLITE_ERROR triggered a reset, leaving a statement\nwhose first execute() failed unusable for a subsequent execute(). Add a\nregression test covering repeated failures and successful retries.\n\nCloses #24991","tree":{"sha":"d98d2680b819d6af5548cd10b24652bf3f55acc8","url":"https://api.github.com/repos/php/php-src/git/trees/d98d2680b819d6af5548cd10b24652bf3f55acc8"},"url":"https://api.github.com/repos/php/php-src/git/commits/78581318c408693bea892607958ff47c6a1ab509","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQJPBAABCAA5FiEEaDXx4YiBo+JEKqlm6j2Y1d107h8FAmro46AbFIAAAAAABAAO\nbWFudTIsMi41KzEuMTIsMiwxAAoJEOo9mNXddO4fl+UQAM5Psjzns8jtR1xUU/kR\nfhl8AnG1XglhclpQT90jvq3BTiXBRhEdPcLlv1abxUdyidCDr0m7VF21VnAi1Hn9\n33kjwt9jbKYomhAK8cddxY31sarHETWgrJnia7A/dzmd24eDlbVcZtzaRr59kHIy\neTXXk07rpes26US2CLSX3AwdQxekWFu36Hq5M1w3AmcZpktwln+Ol3bzApBWfQlo\nbbcIzn8hWIF+9IzR7YAXeYzcbwnnAbTb/PpmU5ktfbRuJW/bx4FmofRAY+s9aFPw\nYtD0oTq9CCObFDftmr02rWATy/jgCHjvtAZ175n3iJKcWzSwCNgD5jE4+ZdySqvE\neKfwEZP3jpyGIsPHwYLeGEUlLuIyGIOjWa4JzS/bkeC0fYPe1VMAfor1GevH3YBn\njik8nucLA/ha2nJJjpUrTVS9WZHgjc/GOKeParLbzp8tLmS7OuNbspgWrFGlSylq\nGqIAA6Y2VVFWdyu7cINyGq9ov5uTX0o0Lr6SaDfMbingdtMG6lwIt8ROwUR+gmhD\nSm6tr/7LH++DWfAouD6xMMLOkdY5Z+m4syyOySCIjHPVHdFwhBa7lMjAzs2t89iz\nu1XINwDcOgIW9RokX0JDfthMwadybF9zCAApzgJtlnFN6upNnRGc7lMfCRZFgF3K\n4K3S8CL7LmXfgcpbsJWLGJyb\n=w18U\n-----END PGP SIGNATURE-----","payload":"tree d98d2680b819d6af5548cd10b24652bf3f55acc8\nparent 07fc1f9d2f8da87519fcf955cef9ce23daf3944e\nauthor lazerg <lazerg2@gmail.com> 1793647520 +0800\ncommitter Weilin Du <weilindu@php.net> 1793647520 +0800\n\nFix GH-24990: pdo_sqlite statement unusable after failed execute() (#24991)\n\nReset the SQLite statement after every failed step, including constraint\nfailures. Previously only SQLITE_ERROR triggered a reset, leaving a statement\nwhose first execute() failed unusable for a subsequent execute(). Add a\nregression test covering repeated failures and successful retries.\n\nCloses #24991\n","verified_at":"2026-11-02T19:43:08Z"}},"url":"https://api.github.com/repos/php/php-src/commits/78581318c408693bea892607958ff47c6a1ab509","html_url":"https://github.com/php/php-src/commit/78581318c408693bea892607958ff47c6a1ab509","comments_url":"https://api.github.com/repos/php/php-src/commits/78581318c408693bea892607958ff47c6a1ab509/comments","author":{"login":"lazerg","id":20501725,"node_id":"MDQ6VXNlcjIwNTAxNzI1","avatar_url":"https://avatars.githubusercontent.com/u/20501725?v=4","gravatar_id":"","url":"https://api.github.com/users/lazerg","html_url":"https://github.com/lazerg","followers_url":"https://api.github.com/users/lazerg/followers","following_url":"https://api.github.com/users/lazerg/following{/other_user}","gists_url":"https://api.github.com/users/lazerg/gists{/gist_id}","starred_url":"https://api.github.com/users/lazerg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lazerg/subscriptions","organizations_url":"https://api.github.com/users/lazerg/orgs","repos_url":"https://api.github.com/users/lazerg/repos","events_url":"https://api.github.com/users/lazerg/events{/privacy}","received_events_url":"https://api.github.com/users/lazerg/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starr