n":false},"parents":[{"sha":"86780e22e84122b58f1904ca93b6c0cba5bb8a7d","url":"https://api.github.com/repos/php/php-src/commits/86780e22e84122b58f1904ca93b6c0cba5bb8a7d","html_url":"https://github.com/php/php-src/commit/86780e22e84122b58f1904ca93b6c0cba5bb8a7d"},{"sha":"a10fdef0a55c53b0c27cf101421b8c178a88e0ed","url":"https://api.github.com/repos/php/php-src/commits/a10fdef0a55c53b0c27cf101421b8c178a88e0ed","html_url":"https://github.com/php/php-src/commit/a10fdef0a55c53b0c27cf101421b8c178a88e0ed"}]},{"sha":"083e1a6d79d8e913cec95f251c3c830709f5da92","node_id":"C_kwDOAB0LotoAKDA4M2UxYTZkNzlkOGU5MTNjZWM5NWYyNTFjM2M4MzA3MDlmNWRhOTI","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-10-29T19:22:47Z"},"committer":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-10-30T00:15:38Z"},"message":"ext/odbc: Fix double free on parameter description failure\n\nRegister the result before describing its parameters, so its destructor\ncan remove the correct connection entry on every failure path. Release it\nthrough odbc_result_free() when SQLDescribeParam() fails instead of freeing\nparam_info separately and leaving it to be freed again by the destructor.\n\nFixes GH-25036\nCloses GH-25044","tree":{"sha":"49b5107a1444c9817265cbf8ff99e2defa2a0f01","url":"https://api.github.com/repos/php/php-src/git/trees/49b5107a1444c9817265cbf8ff99e2defa2a0f01"},"url":"https://api.github.com/repos/php/php-src/git/commits/083e1a6d79d8e913cec95f251c3c830709f5da92","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgdYhKZ4kd7+tlpRbDZ0aP7UxDG4\ndIRutl3Ksx2/yts4sAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQG9IAI6tZy47nAcDEVtXH3ULoN8fyhHzbitCIaRi+ZTDz3gihRz/rXShDNBUTBpz8p\nrLgmYslnDP51jz6SGDRgw=\n-----END SSH SIGNATURE-----","payload":"tree 49b5107a1444c9817265cbf8ff99e2defa2a0f01\nparent 5577b0b54006c02cfcbfa4f1e29a57eeb95922e2\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1793301767 -0400\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793319338 -0400\n\next/odbc: Fix double free on parameter description failure\n\nRegister the result before describing its parameters, so its destructor\ncan remove the correct connection entry on every failure path. Release it\nthrough odbc_result_free() when SQLDescribeParam() fails instead of freeing\nparam_info separately and leaving it to be freed again by the destructor.\n\nFixes GH-25036\nCloses GH-25044\n","verified_at":"2026-10-30T00:16:37Z"}},"url":"https://api.github.com/repos/php/php-src/commits/083e1a6d79d8e913cec95f251c3c830709f5da92","html_url":"https://github.com/php/php-src/commit/083e1a6d79d8e913cec95f251c3c830709f5da92","comments_url":"https://api.github.com/repos/php/php-src/commits/083e1a6d79d8e913cec95f251c3c830709f5da92/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/ilia