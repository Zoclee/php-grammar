ithub.com/repos/php/php-src/git/commits/63045d5b99161c8bacb7267117602cff7bfa1c20","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/php/php-src/commits/63045d5b99161c8bacb7267117602cff7bfa1c20","html_url":"https://github.com/php/php-src/commit/63045d5b99161c8bacb7267117602cff7bfa1c20","comments_url":"https://api.github.com/repos/php/php-src/commits/63045d5b99161c8bacb7267117602cff7bfa1c20/comments","author":{"login":"bwoebi","id":3154871,"node_id":"MDQ6VXNlcjMxNTQ4NzE=","avatar_url":"https://avatars.githubusercontent.com/u/3154871?v=4","gravatar_id":"","url":"https://api.github.com/users/bwoebi","html_url":"https://github.com/bwoebi","followers_url":"https://api.github.com/users/bwoebi/followers","following_url":"https://api.github.com/users/bwoebi/following{/other_user}","gists_url":"https://api.github.com/users/bwoebi/gists{/gist_id}","starred_url":"https://api.github.com/users/bwoebi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bwoebi/subscriptions","organizations_url":"https://api.github.com/users/bwoebi/orgs","repos_url":"https://api.github.com/users/bwoebi/repos","events_url":"https://api.github.com/users/bwoebi/events{/privacy}","received_events_url":"https://api.github.com/users/bwoebi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"bwoebi","id":3154871,"node_id":"MDQ6VXNlcjMxNTQ4NzE=","avatar_url":"https://avatars.githubusercontent.com/u/3154871?v=4","gravatar_id":"","url":"https://api.github.com/users/bwoebi","html_url":"https://github.com/bwoebi","followers_url":"https://api.github.com/users/bwoebi/followers","following_url":"https://api.github.com/users/bwoebi/following{/other_user}","gists_url":"https://api.github.com/users/bwoebi/gists{/gist_id}","starred_url":"https://api.github.com/users/bwoebi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bwoebi/subscriptions","organizations_url":"https://api.github.com/users/bwoebi/orgs","repos_url":"https://api.github.com/users/bwoebi/repos","events_url":"https://api.github.com/users/bwoebi/events{/privacy}","received_events_url":"https://api.github.com/users/bwoebi/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fba362b1961088ea58261ed4287788282c5db8dd","url":"https://api.github.com/repos/php/php-src/commits/fba362b1961088ea58261ed4287788282c5db8dd","html_url":"https://github.com/php/php-src/commit/fba362b1961088ea58261ed4287788282c5db8dd"}]},{"sha":"8d63e87a496b8430a36f10b12e294639f4b3c590","node_id":"C_kwDOAB0LotoAKDhkNjNlODdhNDk2Yjg0MzBhMzZmMTBiMTJlMjk0NjM5ZjRiM2M1OTA","commit":{"author":{"name":"Raphael Paez","email":"paezraphael@gmail.com","date":"2026-10-29T23:25:10Z"},"committer":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-10-30T17:54:35Z"},"message":"Fix GH-8469: Phar::decompressFiles() keeps compressed contents (#25045)\n\nPhar::decompressFiles() and Phar::compressFiles() only changed the\ncompression flags of the entries. phar_flush() then read the entry\ncontents from the archive as they were stored, so the old compressed\nbytes were written out as the new contents.\n\nDecompress entries whose compression changes before updating the flags,\nso phar_flush() writes the real contents with the new compression.\nSkip directory entries, which have no contents to decompress.\n\nCo-authored-by: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>\n\nCloses #25045","tree":{"sha":"66c5f2c5548af1367bfdf1f0d89d6ce810162a1e","url":"https://api.github.com/repos/php/php-src/git/trees/66c5f2c5548af1367bfdf1f0d89d6ce810162a1e"},"url":"https://api.github.com/repos/php/php-src/git/commits/8d63e87a496b8430a36f10b12e294639f4b3c590","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQJPBAABCAA5FiEEaDXx4YiBo+JEKqlm6j2Y1d107h8FAmrk2dwbFIAAAAAABAAO\nbWFudTIsMi41KzEuMTIsMiwxAAoJEOo9mNXddO4frq4P/19oUt4UNP/E3T9/Wtsz\noMUG0mVii4PAEiz6NfL/SSOHbOyxUdmb5cECSYczaDpNW8fx4/jAGI8+fNlfzFfp\nVSjK4Ji2Nj/lw7GKl6QPlMabFBMruyYhVykT2f17bg1tPJ0ECmLgrU4AIvoXSU7X\nKfKnCk+mUtutsi7UzPoR+AHbM1b80j2KzqLnf1t/pegK9NVtDt5sYB7JJymTClgf\nH+urigUZCqBYT7m6o5mlF6u2fpQUwUgc4XV8TN6ABmboIWtER2MErZxMmZz5s1zG\nPTRcReTd1fN+WuPpIx8rFF0bw4yRGCR30Jzrg0pAKYTkR7xTzPK/DKG7SxIpMKXl\nCF7Os86yqmH7R0smfFCIwekQ4mHliW9rwl5PluNujVIN+EpEwKxOrUyBz0pDSOIB\nXYJMpIe3DIKeSHa/XFkvmJnKCETyC83F9n0hBlnpKoP2yJkjiDrxX+lKKWMF5wxI\nBHYoFnlRvaL4aZ+fn59MwQnJB6CjJKfTqH9FdQ9Ri2HzImPl5O3gJ8AJFGi3ZqF7\np/swlxKyffZp9RxczrjMyS72tQDZc86+VvBptYvnEPsEiXm+bfvhNo/hSToPYwDt\ncudEJnlLag1HmKNQNN9xqJNddxbpIcXGcjWmAOqS3EH1kMfTMfBm9PuNDFuTwlOT\nIAinLEuHT3BaipdT+bc36jxI\n=XPHa\n-----END PGP SIGNATURE-----","payload":"tree 66c5f2c5548af1367bfdf1f0d89d6ce810162a1e\nparent 5f4d73a697bf83ea9d25f542c3641e8b0c0951f8\nauthor Raphael Paez <paezraphael@gmail.com> 1793316310 +0000\ncommitter Weilin Du <weilindu@php.net> 1793382875 +0800\n\nFix GH-8469: Phar::decompressFiles() keeps compressed contents (#25045)\n\nPhar::decompressFiles() and Phar::compressFiles() only changed the\ncompression flags of the entries. phar_flush() then read the entry\ncontents from the archive as they were stored, so the old compressed\nbytes were written out as the new contents.\n\nDecompress entries whose compression changes before updating the flags,\nso phar_flush() writes the real contents with the new compression.\nSkip directory entries, which have no contents to decompress.\n\nCo-authored-by: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>\n\nCloses #25045\n","verified_at":"2026-10-30T18:03:36Z"}},"url":"https://api.github.com/repos/php/php-src/commits/8d63e87a496b8430a36f10b12e294639f4b3c590","html_url":"https://github.com/php/php-src/commit/8d63e87a496b8430a36f10b12e294639f4b3c590","comments_url":"https://api.github.com/repos/php/php-src/commits/8d63e87a496b8430a36f10b12e294639f4b3c590/comments","author":{"login":"paezraphael","id":1521457,"node_id":"MDQ6VXNlcjE1MjE0NTc=","avatar_url":"https://avatars.githubusercontent.com/u/1521457?v=4","gravatar_id":"","url":"https://api.github.com/users/paezraphael","html_url":"https://github.com/paezraphael","followers_url":"https://api.github.com/users/paezraphael/followers","following_url":"https://api.github.com/users/paezraphael/following{/other_user}","gists_url":"https://api.github.com/users/paezraphael/gists{/gist_id}","starred_url":"https://api.github.com/users/paezraphael/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/paezraphael/subscriptions","organizations_url":"https://api.github.com/users/paezraphael/orgs","repos_url":"https://api.github.com/users/paezraphael/repos","events_url":"https://api.github.com/users/paezraphael/events{/privacy}","received_events_url":"https://api.github.com/users/paezraphael/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5f4d7