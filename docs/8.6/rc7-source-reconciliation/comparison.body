"}},"url":"https://api.github.com/repos/php/php-src/commits/1e760d19649253f739fd223310c8da7888266b40","html_url":"https://github.com/php/php-src/commit/1e760d19649253f739fd223310c8da7888266b40","comments_url":"https://api.github.com/repos/php/php-src/commits/1e760d19649253f739fd223310c8da7888266b40/comments","author":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f2fbe476d3bffd794864262403abc482cccf9de6","url":"https://api.github.com/repos/php/php-src/commits/f2fbe476d3bffd794864262403abc482cccf9de6","html_url":"https://github.com/php/php-src/commit/f2fbe476d3bffd794864262403abc482cccf9de6"},{"sha":"722feedf42d9dcd049afd1db0ae631b74635e290","url":"https://api.github.com/repos/php/php-src/commits/722feedf42d9dcd049afd1db0ae631b74635e290","html_url":"https://github.com/php/php-src/commit/722feedf42d9dcd049afd1db0ae631b74635e290"}]},{"sha":"2c4fdd71b3f94828402a7b90666357ce41090e3e","node_id":"C_kwDOAB0LotoAKDJjNGZkZDcxYjNmOTQ4Mjg0MDJhN2I5MDY2NjM1N2NlNDEwOTBlM2U","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-10-28T18:26:57Z"},"committer":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-02T12:32:49Z"},"message":"ext/com_dotnet: Fix GH-25008 event source typelib crash\n\nphp_com_locate_typeinfo() stored the default source IID and called\nITypeLib_GetTypeInfoOfGuid() on a NULL typelib. Resolve the source\ninterface from the coclass instead: IProvideClassInfo2::GetClassInfo()\nreturns it, and GetRefTypeInfo() on the implemented interface with that\nIID follows references into other type libraries. A source that is not a\ndispinterface still raises \"Type kind must be dispatchable\";\nphp_com_process_typeinfo() returned true after that error, so\ncom_event_sink() walked an uninitialized name map. It now returns false.\n\nFixes GH-25008\nCloses GH-25020","tree":{"sha":"038ce7b16d39583d82e82027dd21361fc673f95f","url":"https://api.github.com/repos/php/php-src/git/trees/038ce7b16d39583d82e82027dd21361fc673f95f"},"url":"https://api.github.com/repos/php/php-src/git/commits/2c4fdd71b3f94828402a7b90666357ce41090e3e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgdYhKZ4kd7+tlpRbDZ0aP7UxDG4\ndIRutl3Ksx2/yts4sAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQHCY4TVXwgp1l2psJ2SK2Fk0N4XA4sPjcfekWYacfPjRXqs7/eRKdmW+wb4KX47VXN\n2Aiqbn8sIyM6O41htMxQg=\n-----END SSH SIGNATURE-----","payload":"tree 038ce7b16d39583d82e82027dd21361fc673f95f\nparent 2ff2085fa4583244fc6b3ff3596707453dca1b3c\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1793212017 -0400\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793622769 -0500\n\next/com_dotnet: Fix GH-25008 event source typelib crash\n\nphp_com_locate_typeinfo() stored the default source IID and called\nITypeLib_GetTypeInfoOfGuid() on a NULL typelib. Resolve the source\ninterface from the coclass instead: IProvideClassInfo2::GetClassInfo()\nreturns it, and GetRefTypeInfo() on the implemented interface with that\nIID follows references into other type libraries. A source that is not a\ndispinterface still raises \"Type kind must be dispatchable\";\nphp_com_process_typeinfo() returned true after that error, so\ncom_event_sink() walked an uninitialized name map. It now returns false.\n\nFixes GH-25008\nCloses GH-25020\n","verified_at":"2026-11-02T12:34:05Z"}},"url":"https://api.github.com/repos/php/php-src/commits/2c4fdd71b3f94828402a7b90666357ce41090e3e","html_url":"https://github.com/php/php-src/commit/2c4fdd71b3f94828402a7b90666357ce41090e3e","comments_url":"https://api.github.com/repos/php/php-src/commits/2c4fdd71b3f94828402a7b90666357ce41090e3e/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https