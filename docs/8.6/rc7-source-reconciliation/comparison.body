s","author":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"198bce1e6baa0499f6dd6b334b5ed664c1964a05","url":"https://api.github.com/repos/php/php-src/commits/198bce1e6baa0499f6dd6b334b5ed664c1964a05","html_url":"https://github.com/php/php-src/commit/198bce1e6baa0499f6dd6b334b5ed664c1964a05"},{"sha":"de0e21c7128271ba64410b76bf52150eade4b4f9","url":"https://api.github.com/repos/php/php-src/commits/de0e21c7128271ba64410b76bf52150eade4b4f9","html_url":"https://github.com/php/php-src/commit/de0e21c7128271ba64410b76bf52150eade4b4f9"}]},{"sha":"6e6ec4b267e728874098c1e7a9908130eb000c1a","node_id":"C_kwDOAB0LotoAKDZlNmVjNGIyNjdlNzI4ODc0MDk4YzFlN2E5OTA4MTMwZWIwMDBjMWE","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-09-25T04:03:04Z"},"committer":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-02T19:53:57Z"},"message":"ext/pdo_pgsql: Clear the notice callback when a persistent handle is released\n\nPdo\\Pgsql::setNoticeCallback() stores a request-allocated fcall cache on the\ndriver handle. A persistent handle outlives the request, so the next request\non the same connection uses freed memory as soon as it receives a notice or\nsets a new callback. Drop the callback from the persistent_shutdown hook,\nwhich pdo_sqlite also uses for its user functions, once the last object of\nthe request releases the handle.\n\nCloses GH-25156","tree":{"sha":"4b762f263625158cfa9032859ea3beb055871152","url":"https://api.github.com/repos/php/php-src/git/trees/4b762f263625158cfa9032859ea3beb055871152"},"url":"https://api.github.com/repos/php/php-src/git/commits/6e6ec4b267e728874098c1e7a9908130eb000c1a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgdYhKZ4kd7+tlpRbDZ0aP7UxDG4\ndIRutl3Ksx2/yts4sAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQOYAGwJCr1EKjsOmg1rc8nxZu9B7S9shm9qhb1KyMiRrC+WxaanKLYOfEfqNF9jYtn\nmdVJxsIy4A+5WZjS9igg0=\n-----END SSH SIGNATURE-----","payload":"tree 4b762f263625158cfa9032859ea3beb055871152\nparent 78581318c408693bea892607958ff47c6a1ab509\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1790308984 -0400\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793649237 -0500\n\next/pdo_pgsql: Clear the notice callback when a persistent handle is released\n\nPdo\\Pgsql::setNoticeCallback() stores a request-allocated fcall cache on the\ndriver handle. A persistent handle outlives the request, so the next request\non the same connection uses freed memory as soon as it receives a notice or\nsets a new callback. Drop the callback from the persistent_shutdown hook,\nwhich pdo_sqlite also uses for its user functions, once the last object of\nthe request releases the handle.\n\nCloses GH-25156\n","verified_at":"2026-11-02T20:04:29Z"}},"url":"https://api.github.com/repos/php/php-src/commits/6e6ec4b267e728874098c1e7a9908130eb000c1a","html_url":"https://github.com/php/php-src/commit/6e6ec4b267e728874098c1e7a9908130eb000c1a","comments_url":"https://api.github.com/repos/php/php-src/commits/6e6ec4b267e728874098c1e7a9908130eb000c1a/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"iliaal","id":158724,"node_id"