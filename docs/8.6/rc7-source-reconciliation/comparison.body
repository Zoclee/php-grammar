    steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: Update clang\n@@ -394,7 +394,7 @@ jobs:\n     timeout-minutes: 180\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: Create MSSQL container\n@@ -444,7 +444,7 @@ jobs:\n       USE_TRACKED_ALLOC: 1\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: apt\n@@ -656,7 +656,7 @@ jobs:\n     timeout-minutes: 180\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: Create MSSQL container\n@@ -720,7 +720,7 @@ jobs:\n     timeout-minutes: 180\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: apt\n@@ -812,7 +812,7 @@ jobs:\n     timeout-minutes: 180\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: apt\n@@ -866,7 +866,7 @@ jobs:\n       - name: git config\n         run: git config --global core.autocrlf false && git config --global core.eol lf\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: Setup\n@@ -885,7 +885,7 @@ jobs:\n     timeout-minutes: 50\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n       - name: FreeBSD\n@@ -916,7 +916,7 @@ jobs:\n     timeout-minutes: 50\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           ref: ${{ fromJson(inputs.branch).ref }}\n           fetch-depth: 0\n@@ -979,7 +979,7 @@ jobs:\n           mysql -uroot -proot -e \"CREATE USER 'wordpress'@'localhost' IDENTIFIED BY 'wordpress'; FLUSH PRIVILEGES;\"\n           mysql -uroot -proot -e \"GRANT ALL PRIVILEGES ON *.* TO 'wordpress'@'localhost' WITH GRANT OPTION;\"\n       - name: git checkout benchmarking-data\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         with:\n           repository: php/benchmarking-data\n           ssh-key: ${{ secrets.BENCHMARKING_DATA_DEPLOY_KEY }}"},{"sha":"4128a854b525afa4a0c705df023ccf312660979c","filename":".github/workflows/test.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/.github%2Fworkflows%2Ftest.yml","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/.github%2Fworkflows%2Ftest.yml","contents_url":"https://api.github.com/repos/php/php-src/contents/.github%2Fworkflows%2Ftest.yml?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -41,7 +41,7 @@ jobs:\n       all_variations: ${{ steps.set-matrix.outputs.all_variations }}\n       branches: ${{ steps.set-matrix.outputs.branches }}\n     steps:\n-      - uses: actions/checkout@v6\n+      - uses: actions/checkout@v7\n         with:\n           # When running nightly, set fetch-depth to 0 to clone the full\n           # repository including all branches. This is required to find the"},{"sha":"844267544608325ac00d0aa79743c9e76b2ab3ad","filename":".github/workflows/unit-tests.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/.github%2Fworkflows%2Funit-tests.yml","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/.github%2Fworkflows%2Funit-tests.yml","contents_url":"https://api.github.com/repos/php/php-src/contents/.github%2Fworkflows%2Funit-tests.yml?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -39,7 +39,7 @@ jobs:\n     timeout-minutes: 20\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n         \n       - name: Install dependencies\n         run: |"},{"sha":"502e923fa9b0f289a563ccfa2df3b4ea6718fe53","filename":".github/workflows/verify-bundled-files.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/.github%2Fworkflows%2Fverify-bundled-files.yml","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/.github%2Fworkflows%2Fverify-bundled-files.yml","contents_url":"https://api.github.com/repos/php/php-src/contents/.github%2Fworkflows%2Fverify-bundled-files.yml?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -24,7 +24,7 @@ jobs:\n     runs-on: ubuntu-24.04\n     steps:\n       - name: git checkout\n-        uses: actions/checkout@v6\n+        uses: actions/checkout@v7\n \n       - name: Detect changed files\n         if: ${{ github.event_name == 'push' || github.event_name == 'pull_request' }}"},{"sha":"456bc575fb2b7e0a6b9f99bbf828577484715644","filename":".gitignore","status":"modified","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/.gitignore","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/.gitignore","contents_url":"https://api.github.com/repos/php/php-src/contents/.gitignore?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -127,7 +127,6 @@ config.h.in\n # ------------------------------------------------------------------------------\n /ext/phar/phar.phar\n /ext/phar/phar.php\n-/pear/install-pear-nozlib.phar\n /sapi/cgi/php-cgi\n /sapi/fpm/php-fpm\n /sapi/phpdbg/phpdbg"},{"sha":"2e2cedb40fe773500184a77b293f4ec7d001acb3","filename":"NEWS","status":"modified","additions":310,"deletions":1,"changes":311,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/NEWS","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/NEWS","contents_url":"https://api.github.com/repos/php/php-src/contents/NEWS?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -1,6 +1,305 @@\n PHP                                                                        NEWS\n |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||\n-?? ??? ????, PHP 8.6.0RC4\n+12 Nov 2026, PHP 8.6.0RC7\n+\n+- Core:\n+  . Fixed array_map() optimization not resolving the function name of an FCC.\n+    (ChrisAbner)\n+\n+- OpenSSL:\n+  . Fixed use-after-free in TLS server ALPN and Windows certificate checks\n+    when the session stream passed to stream_socket_enable_crypto() is closed\n+    before the handshake. (Ilia Alshanetsky)\n+\n+12 Nov 2026, PHP 8.6.0RC6\n+\n+- Core:\n+  . Fix potential ABI incompatibility when adding fields in patches by adding\n+    padding to globals. (ilutov)\n+\n+- Date:\n+  . Update timelib to 2026.03 (Derick)\n+\n+- Fileinfo:\n+  . Fixed bug GH-25051 (TrueType fonts detected as application/octet-stream\n+    since libmagic 5.48). (Weilin Du)\n+  . Fixed incorrect MIME type detection for HWPX files. (Weilin Du)\n+\n+- Streams:\n+  . Fixed use-after-free of the previous request's default stream context when\n+    a stream error is raised during request startup, such as when a POST body\n+    cannot be buffered to a temporary file. (Go Kudo)\n+\n+05 Nov 2026, PHP 8.6.0RC5\n+\n+- Core:\n+  . Fix function and constant imports in compile_to_ast and add support\n+    for grouping. (Klaas Skelte van der Werf)\n+  . Fixed bug GH-24668 (zend_set_local_var() leaks the previous value of an\n+    existing CV). (yasu20200121web-prog, lazerg)\n+  . Fixed unmapping of an unrelated range when the aligned chunk mmap fails\n+    (Marti2203).\n+  . Fixed bug GH-25023 (ZEND_CONTAINER_OF() fails to compile with -std=c11).\n+    (lazerg)\n+  . Fixed bug GH-25007 (Partial function application: named args in a constant\n+    expression cause out-of-bounds write in zp_compile()). (lazerg)\n+  . Fixed AST printing dropping final on class constants and properties, and\n+    abstract on properties. (Jorg Sowa)\n+  . Fixed AST export of readonly anonymous classes dropping the readonly\n+    modifier. (Jorg Sowa)\n+  . Fixed memory leak of a duplicate named argument in new in initializer.\n+    (Jorg Sowa)\n+  . Fixed bug GH-25061 ($x = $x - 1 on null is optimized to PRE_DEC).\n+    (Lazizbek Ergashev)\n+  . Fixed bug GH-23911 (Don't use static closure cache when called_scope\n+    diverges). (Roman Ondráček)\n+  . Fixed first-class callables to static methods in trait constant\n+    expressions resolving to the method of the first using class and\n+    bypassing visibility checks. (Jorg Sowa)\n+\n+- CLI:\n+  . Fixed bug GH-24697 (PHP_HTTP_PARSER_STRICT build option doesn't work).\n+    (ndossche, devnexen)\n+  . Fixed bug GH-9670 (List -C and -q in the CLI help). (Juan Versolato Lopes)\n+\n+- COM:\n+  . Fixed bug GH-25008 (com_event_sink() and com_print_typeinfo() crash\n+    resolving an event source with no loaded typelib). (Ilia Alshanetsky)\n+\n+- Curl:\n+  . Fix use-after-free of CURLOPT_STDERR stream on cloned curl handle.\n+    (lacatoire)\n+  . Fix UAF on clone due to callback data pointer mismatch. (ndossche)\n+\n+- DBA:\n+  . Fixed bug GH-24641 (ndbm backend never checks dbm_open() return value,\n+    NULL deref on first use after a failed open). (Girgias)\n+\n+- DOM:\n+  . Fixed a use-after-free when reflected attribute setters replace an\n+    attribute whose child still has a live wrapper. (Jakub Zelenka)\n+  . Fix error paths in dom_xml_serializing_a_document_node(). (ndossche)\n+\n+- FFI:\n+  . Fixed bug GH-24582 (Memory leaks in ext/ffi parser when finalize_type()\n+    bails out). (matyapiro31, David Carlier)\n+\n+- FPM:\n+  . Fixed crash and stack memory disclosure in the worker output logging with\n+    a pool name longer than the message prefix buffer or log_limit.\n+    (Martin Mirchev)\n+  . Fixed bug GH-24046 (FPM worker stdio pipe fd closed twice when a child\n+    process outlives the worker, breaking a later worker's stdio).\n+    (Ian P. Christian, ndossche)\n+  . Fixed memory leaks of the _GET string on the status page error and HEAD\n+    request paths. (Marcel Hernandez)\n+  . Fixed use-after-free of the scoreboard copy when logging invalid status\n+    values. (Marcel Hernandez)\n+  . Fixed null pointer dereference in fpm_get_status() when the scoreboard\n+    copy fails. (Marcel Hernandez)\n+\n+- GD:\n+  . Fixed imagetruecolortopalette() error message. (Marc Bennewitz)\n+\n+- Hash:\n+  . Fix GOST and Snefru digests of 512 MiB or more. (Martin Mirchev)\n+\n+- Intl:\n+  . Fixed IntlDateFormatter parse functions truncating an $offset below\n+    INT_MIN. (Marc Bennewitz)\n+\n+- JSON:\n+  . Fixed json_encode() leaving the recursion guard set on objects with hooked\n+    properties after running out of memory while escaping a property name.\n+    (adapik)\n+  . Fixed json_encode() silently narrowing $depth values outside the int range,\n+    which wrapped to an unrelated depth. (cuishuang)\n+  . Fixed json_encode() continuing to encode after an array or object key\n+    failed to encode. (Ilia Alshanetsky)\n+\n+- LDAP:\n+  . Fix crash in ldap_exop_sync() when $response_data is omitted. (lacatoire)\n+\n+- MBString:\n+  . Fixed negative mbstring.regex_stack_limit and mbstring.regex_retry_limit\n+    on 32bit platforms. (Marc Bennewitz)\n+\n+- MySQLnd:\n+  . Fixed bug GH-24609 (OK packets without an info message rejected on x32\n+    builds). (lazerg)\n+\n+- ODBC:\n+  . Fixed bug GH-25036 (odbc_prepare() corrupts the heap when the driver\n+    cannot describe a parameter). (Ilia Alshanetsky)\n+\n+- Opcache:\n+  . Fixed bug GH-24397 (Assertion failure when dumping JIT IR).\n+    (Ilia Alshanetsky)\n+  . Fixed tracing JIT returning a wrapped integer instead of a float on\n+    integer overflow after an integer was compared with a float or\n+    numeric-string literal. (Ilia Alshanetsky)\n+  . Fixed use-after-free in JIT ASSIGN_DIM_OP when concatenating into an\n+    empty array element. (jorgsowa)\n+  . Fixed bug GH-24396 (Assertion failure in zend_jit_def_reg() \"reg forwarding\"\n+    with chained Pi nodes). (ndossche)\n+  . Fixed JIT treating an array as packed after a string key write turned it\n+    into a hash. (jorgsowa)\n+  . Fixed bug GH-24436 (Tracing JIT: keep the SEND_VAL type guard after\n+    assigning to a reference). (waroad)\n+  . Fixed bug GH-24745 (File cache loses attributes on constants on 32-bit\n+    builds). (Yannick Decat, Lazizbek Ergashev)\n+  . Fixed bug GH-17733 (System entropy does not take into account function\n+    order, resulting in wrong functions possibly called\n+    in different configurations). (ndossche)\n+  . Fixed bug GH-24438 (Preserve indirect types in JIT side traces). (aasul)\n+  . Fixed bug GH-24577 (CE-cache flag on interned class name visible before\n+    map_ptr offset). (prateekbhujel)\n+  . Fixed tracing JIT losing register-allocated CVs when an interrupt is\n+    handled at the end of a loop trace. (Levi Morrison)\n+  . Fixed bug GH-24675 (function with >~1.7 MB of machine code corrupts JIT\n+    buffer accounting). (ndossche)\n+  . Call orig_post_shutdown_cb(). (ndossche)\n+  . Fixed JIT segfault on switch over a string reference holding a\n+    non-string value. (jorgsowa)\n+  . Fixed AArch64 JIT encoding of invalid logical immediates. (jorgsowa)\n+  . Fixed JIT crashes when handling a VM interrupt with a stale saved opline\n+    in the tailcall VM. (Levi Morrison)\n+  . Fixed function JIT misinterpreting VM-enter results after an interrupt\n+    callback in the CALL and TAILCALL VMs. (Levi Morrison)\n+  . Fixed unsound shift_left_overflows range when shift wraps. (mkrishna793)\n+  . Fixed bug GH-23572 (Tracing JIT calls the wrong method for self::/parent::\n+    static calls in trait methods shared by several classes). (jorgsowa,\n+    mgoulart)\n+  . Fix block pass dropping ZEND_FAST_CALL OP2 definition. (Mrmaxmeier)\n+  . Fixed bug GH-23626 (orphaned temporaries cause leaks and assertions).\n+    (ndossche, khaledalam)\n+  . Fix preloaded functions JIT-compiled on load being overwritten\n+    after restart. (Pavel Gushcha)\n+  . Fix opcache.interned_strings_buffer being 0 in threads started later (ZTS).\n+    (Pavel Gushcha)\n+  . Fixed potential infinite recursion/hang (HYBRID/TAILCALL respectively)\n+    when zend_interrupt_function resets EG(vm_interrupt).  (Levi Morrison)\n+  . Fix JIT losing the called scope of self::/parent:: calls in included files.\n+    (ndossche)\n+  . Fixed preloaded functions not JIT-compiled again after OPcache restart.\n+    (Jorg Sowa)\n+  . Fixed bug GH-24988 (Incorrect opcode range check causes bugs with exceptions in\n+    function JIT). (ndossche, Jorg Sowa)\n+  . Fix opcache phar check. (ndossche)\n+\n+- OpenSSL:\n+  . Fixed build with OpenSSL 4.1. (Weilin Du)\n+  . Fixed bug GH-24784 (openssl_pkcs7_read() and openssl_cms_read() overwrite\n+    certificates with CRLs). (Alexander Danilov)\n+  . Fixed use-after-free in the TLS session remove callback when the listener\n+    stream is closed while a shared context is still in use. (Jakub Zelenka)\n+  . Fixed heap buffer overflow in TLS PSK callbacks. (Jakub Zelenka)\n+\n+- PDO_Firebird:\n+  . Fixed bug GH-25006 (getColumnMeta() reads out of bounds for an\n+    out-of-range column index). (Ilia Alshanetsky)\n+\n+- PDO_PGSQL:\n+  . Fixed bug GH-24461 (DISCARD ALL on persistent connection cleanup drops\n+    PgBouncer's prepared statements). (David Carlier, Artem Ukrainskiy)\n+  . Fixed a use-after-free when a persistent connection receives a notice\n+    after the request that called Pdo\\Pgsql::setNoticeCallback() has ended.\n+    (Ilia Alshanetsky)\n+\n+- PDO_SQLite:\n+  . Fixed bug GH-24990 (Statement unusable after a failed execute()). (lazerg)\n+\n+- Phar:\n+  . Fixed bug GH-25093 (Phar::webPhar() redirect reads past the request URI).\n+    (lazerg)\n+  . Fixed bug GH-25089 (Heap buffer over-read via crafted alias size in\n+    zip-based phar). (Lazizbek Ergashev)\n+  . Fixed bug GH-8469 (Phar::decompressFiles() and Phar::compressFiles() retain\n+    compressed contents after changing compression). (Raphael Paez)\n+  . Fixed bug GH-24740 (Oversized tar metadata exhausts the memory limit).\n+    (Lazizbek Ergashev)\n+  . Fixed bug GH-25090 (UAF in phar rename() of an entry with metadata).\n+    (Lazizbek Ergashev)\n+  . Fixed bug GH-25091 (UAF in phar rename() when source and destination\n+    are equal). (Lazizbek Ergashev)\n+  . Fixed bug GH-25092 (Double free in Phar::copy() on link and\n+    mounted entries). (Lazizbek Ergashev)\n+  . Fixed bug GH-24531 (Crash when modifying a zip-based phar whose file was\n+    renamed). (Ilia Alshanetsky)\n+  . Fixed Phar::buildFromIterator() accepting a negative getMTime() on 32bit\n+    platforms. (Marc Bennewitz)\n+\n+- Reflection:\n+  . Fixed bug GH-21768 (Assertion failure in ReflectionProperty::isReadable()\n+    and isWritable() on internal virtual properties). (David Carlier)\n+\n+- SAPI:\n+  . Fixed infinite loop in sapi_header_op() for headers of 4 GiB or more.\n+    (Martin Mirchev)\n+\n+- Session:\n+  . Validate whole session ID instead of stopping at the first NUL byte.\n+    (Sjoerd Langkemper)\n+\n+- Sodium:\n+  . Pass sodium_crypto_xof_*() state via objects instead of by-ref strings.\n+    (timwolla)\n+\n+- SPL:\n+  . Fixed bug GH-24264 (Unwind/GracefulExit discarded in spl_iterators.c).\n+    (Lazizbek Ergashev)\n+\n+- Sockets:\n+  . Fixed bug GH-24748 (socket_set_option() crashes with declared object\n+    properties). (Lazizbek Ergashev)\n+\n+- Standard:\n+  . Fixed bug GH-25086 (Io\\Poll kqueue backend leaks memory on every\n+    Watcher::modifyEvents() call). (Lazizbek Ergashev, Jakub Zelenka)\n+  . Fixed Io\\Poll WSAPoll backend accepting handles that are not sockets, which\n+    were then silently dropped by wait(). Adding them now fails with\n+    ERROR_NOSUPPORT. (Nicolas Grekas)\n+  . Fixed memory leaks in checkdnsrr() and dns_check_record() on Windows.\n+    (Ilia Alshanetsky)\n+  . Fixed __unserialize() and __wakeup() being called for objects with a missing\n+    closing brace. (Ilia Alshanetsky)\n+  . Fixed bug GH-24308 (Request shutdown calls closelog() even when syslog\n+    was not opened by PHP). (lazerg)\n+  . Fixed bug GH-24552 (Case-insensitive substr_compare(), ksort() and\n+    krsort() are still locale-dependent). (Lazizbek Ergashev, Jon Surrell)\n+  . Fix use-after-free in Randomizer::shuffleArray() when the engine throws.\n+    (Marti2203)\n+\n+- Streams:\n+  . Fixed bug GH-24506 (stream_select() leaks a stream-error operation level\n+    on its FD_SETSIZE failure path). (azjezz)\n+  . Fixed bug GH-24508 (HTTP wrapper leaks the dechunk filter when header\n+    parsing fails after Transfer-Encoding). (bercedev)\n+  . Fixed bug GH-24509 (HTTP wrapper leaks Location buffer on empty\n+    Location header). (bercedev)\n+  . Fix out-of-bounds reads parsing ftp:// wrapper server replies.\n+    (Alejandro Pacheco)\n+\n+- URI:\n+  . Upgrade to uriparser 1.0.3. (CVE-2026-48841) (Sebastian Pipping, timwolla)\n+\n+- Windows:\n+  . Fixed bug GH-25009 (GetConsoleTitleW() buffer size passed in bytes).\n+    (Lazizbek Ergashev)\n+  . Fixed sapi_windows_cp_set() and sapi_windows_cp_conv() accepting a negative\n+    codepage on 32bit platforms. (Marc Bennewitz)\n+\n+- Zip:\n+  . Reject broken libzip versions 1.3.1, 1.7.0 and 1.12.0 during Windows\n+    configuration. (Weilin Du)\n+  . Excluded libzip 1.12.0 due to a regression preventing additions and\n+    replacements in torrentzip archives. (Weilin Du)\n+\n+- Zlib:\n+  . Fixed bug GH-24533 (zlib.lib could not be found because zlib 1.3.2\n+    CMake build does not emit it). (Lazizbek Ergashev)\n+\n+21 Oct 2026, PHP 8.6.0RC4\n \n - Core:\n   . Fixed GHSA-w8hw-w9fx-j79w, GHSA-6wmf-4rv5-p3rp (Avoid state corruption via\n@@ -42,6 +341,8 @@ PHP                                                                        NEWS\n \n - MBString:\n   . Fixed bug GH-23958 (truncated encoding names resolving to full names). (Kamil Tekiela)\n+  . Fixed out-of-bounds read in php_mb_rfc1867_getword() on a multibyte lead\n+    byte at the end of a multipart field name. (Jorg Sowa)\n \n - MySQLnd:\n   . Fixed bug GH-24293 (Segfault on connect with an empty password to a\n@@ -72,6 +373,10 @@ PHP                                                                        NEWS\n     reference check). (ndossche)\n   . Fixed bug GH-24437 (JIT: Fix OP_DATA read from an unwritten slot in\n     zend_jit_assign_dim_op()). (waroad)\n+  . Fixed bug GH-24398 (JIT: minimal JIT segfault when a hooked property is\n+    passed to a run-time-resolved function). (waroad)\n+  . Fixed bug GH-24389 (Tracing JIT: type guard on entry of an inlined call\n+    exits with an uninitialized opline). (waroad)\n \n - PDO:\n   . Fixed invalid ATTR_ORACLE_NULLS values being accepted and truncated.\n@@ -119,6 +424,8 @@ PHP                                                                        NEWS\n     Windows). (Nicolas Grekas)\n   . Fixed glob() not negating bracket expressions that start with \"^\".\n     (Nicolas Grekas)\n+  . Fixed bug GH-24605 (var_export() crashes on deeply nested arrays and\n+    objects). (Labish Bardiya)\n \n - Tidy:\n   . Fixed tidy_repair_string(), tidy_repair_file(), tidy::repairString() and\n@@ -314,6 +621,8 @@ PHP                                                                        NEWS\n     (Nicolas Grekas)\n   . Fixed convert.quoted-printable-decode decoding lowercase hex digits to\n     the wrong byte. (Ilia Alshanetsky)\n+  . Fixed bug GH-23948 (Io\\Poll: data buffered by the stream layer is not\n+    reported). (Jakub Zelenka)\n \n - Tidy:\n   . Fixed a use-after-free when a tidyNode is used after its document is"},{"sha":"3fe0fe1116384ae3b9b1436f104d4e8564a73daa","filename":"UPGRADING","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/UPGRADING","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/UPGRADING","contents_url":"https://api.github.com/repos/php/php-src/contents/UPGRADING?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -915,6 +915,12 @@ PHP 8.6 UPGRADE NOTES\n   . enum: Snmp\\Output\n   . enum: Snmp\\StringOutput\n \n+- Sodium:\n+  . SodiumCryptoXofShake128State\n+  . SodiumCryptoXofShake256State\n+  . SodiumCryptoXofTurboshake128State\n+  . SodiumCryptoXofTurboshake256State\n+\n - Standard:\n   . enum SortDirection\n     RFC: https://wiki.php.net/rfc/sort_direction_enum\n@@ -960,6 +966,7 @@ PHP 8.6 UPGRADE NOTES\n - Fileinfo:\n   . Upgraded to file 5.48.\n     Custom compiled magic databases from older file versions must be regenerated.\n+  . TrueType fonts are now detected as font/ttf instead of font/sfnt.\n \n - Hash:\n   . The bundled version of xxHash was upgraded to 0.8.2."},{"sha":"0601994479e6312023cc1e36ff6b8cc9d6b1f72b","filename":"Zend/Optimizer/block_pass.c","status":"modified","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fblock_pass.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fblock_pass.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2FOptimizer%2Fblock_pass.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -352,6 +352,18 @@ static void zend_optimize_block(zend_basic_block *block, zend_op_array *op_array\n \t\t\t\t}\n \t\t\t\tbreak;\n \n+\t\t\tcase ZEND_FAST_CALL:\n+\t\t\t\tif (opline->op2_type & (IS_TMP_VAR|IS_VAR)) {\n+\t\t\t\t\t/* OP2 holds the pending return value. A TMP normally has a single\n+\t\t\t\t\t * consumer, but FAST_CALL does not consume it:\n+\t\t\t\t\t * the RETURN behind it is the consumer, and\n+\t\t\t\t\t * zend_dispatch_try_catch_finally_helper() destroys the value\n+\t\t\t\t\t * through OP2 if the finally block throws. Propagating the source\n+\t\t\t\t\t * into the RETURN therefore must not remove it. */\n+\t\t\t\t\tTsource[VAR_NUM(opline->op2.var)] = NULL;\n+\t\t\t\t}\n+\t\t\t\tbreak;\n+\n \t\t\tcase ZEND_SWITCH_LONG:\n \t\t\tcase ZEND_SWITCH_STRING:\n \t\t\tcase ZEND_MATCH:"},{"sha":"6ed7e870da61afdbd28a9fe6a0e8814a2be30a3c","filename":"Zend/Optimizer/compact_literals.c","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fcompact_literals.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fcompact_literals.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2FOptimizer%2Fcompact_literals.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -757,12 +757,17 @@ void zend_optimizer_compact_literals(zend_op_array *op_array, zend_optimizer_ctx\n \t\t\t\t\t}\n \t\t\t\t\tbreak;\n \t\t\t\tcase ZEND_CALLABLE_CONVERT:\n-\t\t\t\tcase ZEND_DECLARE_LAMBDA_FUNCTION:\n \t\t\t\t\tif (opline->extended_value != (uint32_t)-1) {\n \t\t\t\t\t\topline->extended_value = cache_size;\n \t\t\t\t\t\tcache_size += sizeof(void *);\n \t\t\t\t\t}\n \t\t\t\t\tbreak;\n+\t\t\t\tcase ZEND_DECLARE_LAMBDA_FUNCTION:\n+\t\t\t\t\tif (opline->extended_value != (uint32_t)-1) {\n+\t\t\t\t\t\topline->extended_value = cache_size;\n+\t\t\t\t\t\tcache_size += 2 * sizeof(void *);\n+\t\t\t\t\t}\n+\t\t\t\t\tbreak;\n \t\t\t\tcase ZEND_CALLABLE_CONVERT_PARTIAL:\n \t\t\t\t\topline->extended_value = cache_size | (opline->extended_value & ZEND_PARTIAL_FLAGS);\n \t\t\t\t\tcache_size += 2 * sizeof(void *);"},{"sha":"93dae48a03ef45ffa086ab04a227015b478ae9a6","filename":"Zend/Optimizer/dfa_pass.c","status":"modified","additions":4,"deletions":2,"changes":6,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fdfa_pass.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fdfa_pass.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2FOptimizer%2Fdfa_pass.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -1382,7 +1382,8 @@ void zend_dfa_optimize_op_array(zend_op_array *op_array, zend_optimizer_ctx *ctx\n \t\t\t\t\t && Z_TYPE_P(CT_CONSTANT_EX(op_array, op_array->opcodes[op_2].op2.constant)) == IS_LONG\n \t\t\t\t\t && Z_LVAL_P(CT_CONSTANT_EX(op_array, op_array->opcodes[op_2].op2.constant)) == 1\n \t\t\t\t\t && ssa->ops[op_2].op1_use >= 0\n-\t\t\t\t\t && !(ssa->var_info[ssa->ops[op_2].op1_use].type & (MAY_BE_FALSE|MAY_BE_TRUE|MAY_BE_STRING|MAY_BE_ARRAY|MAY_BE_OBJECT|MAY_BE_RESOURCE|MAY_BE_REF))) {\n+\t\t\t\t\t /* MAY_BE_UNDEF|MAY_BE_NULL is excluded because of the currently inconsistent behaviour, revisit in PHP 9 once it is fixed */\n+\t\t\t\t\t && !(ssa->var_info[ssa->ops[op_2].op1_use].type & (MAY_BE_UNDEF|MAY_BE_NULL|MAY_BE_FALSE|MAY_BE_TRUE|MAY_BE_STRING|MAY_BE_ARRAY|MAY_BE_OBJECT|MAY_BE_RESOURCE|MAY_BE_REF))) {\n \n \t\t\t\t\t\top_array->opcodes[op_2].opcode = ZEND_PRE_DEC;\n \t\t\t\t\t\tSET_UNUSED(op_array->opcodes[op_2].op2);\n@@ -1536,7 +1537,8 @@ void zend_dfa_optimize_op_array(zend_op_array *op_array, zend_optimizer_ctx *ctx\n \t\t\t\t\t\t && Z_TYPE_P(CT_CONSTANT_EX(op_array, op_array->opcodes[op_2].op2.constant)) == IS_LONG\n \t\t\t\t\t\t && Z_LVAL_P(CT_CONSTANT_EX(op_array, op_array->opcodes[op_2].op2.constant)) == 1\n \t\t\t\t\t\t && ssa->ops[op_2].op1_use >= 0\n-\t\t\t\t\t\t && !(ssa->var_info[ssa->ops[op_2].op1_use].type & (MAY_BE_FALSE|MAY_BE_TRUE|MAY_BE_STRING|MAY_BE_ARRAY|MAY_BE_OBJECT|MAY_BE_RESOURCE|MAY_BE_REF))) {\n+\t\t\t\t\t\t /* MAY_BE_UNDEF|MAY_BE_NULL is excluded because of the currently inconsistent behaviour, revisit in PHP 9 once it is fixed */\n+\t\t\t\t\t\t && !(ssa->var_info[ssa->ops[op_2].op1_use].type & (MAY_BE_UNDEF|MAY_BE_NULL|MAY_BE_FALSE|MAY_BE_TRUE|MAY_BE_STRING|MAY_BE_ARRAY|MAY_BE_OBJECT|MAY_BE_RESOURCE|MAY_BE_REF))) {\n \n \t\t\t\t\t\t\top_array->opcodes[op_2].opcode = ZEND_PRE_DEC;\n \t\t\t\t\t\t\tSET_UNUSED(op_array->opcodes[op_2].op2);"},{"sha":"25376de43adab9f2ff4e893bd7cd81ac722dcf37","filename":"Zend/Optimizer/zend_inference.c","status":"modified","additions":14,"deletions":6,"changes":20,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fzend_inference.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fzend_inference.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2FOptimizer%2Fzend_inference.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -760,12 +760,14 @@ static inline zend_long safe_shift_left(zend_long n, zend_long s) {\n }\n \n static inline bool shift_left_overflows(zend_long n, zend_long s) {\n-\t/* This considers shifts that shift in the sign bit to be overflowing as well */\n-\tif (n >= 0) {\n-\t\treturn s >= SIZEOF_ZEND_LONG * 8 - 1 || safe_shift_left(n, s) < n;\n-\t} else {\n-\t\treturn s >= SIZEOF_ZEND_LONG * 8 || safe_shift_left(n, s) > n;\n+\tif (UNEXPECTED((zend_ulong)s >= SIZEOF_ZEND_LONG * 8)) {\n+\t\treturn true;\n+\t}\n+\tif (UNEXPECTED(s == SIZEOF_ZEND_LONG * 8 - 1)) {\n+\t\treturn n != 0 && n != -1;\n \t}\n+\tzend_long shifted = (zend_long)((zend_ulong)n << (zend_ulong)s);\n+\treturn (shifted >> s) != n;\n }\n \n /* If b does not divide a exactly, return the two adjacent values between which the real result\n@@ -2221,6 +2223,9 @@ static uint32_t assign_dim_array_result_type(\n \t\t\tif (dim_type & (MAY_BE_UNDEF|MAY_BE_NULL)) {\n \t\t\t\ttmp |= MAY_BE_ARRAY_KEY_STRING;\n \t\t\t}\n+\t\t\tif ((tmp & MAY_BE_ARRAY_KEY_STRING) && MAY_BE_PACKED(arr_type)) {\n+\t\t\t\ttmp |= MAY_BE_ARRAY_NUMERIC_HASH;\n+\t\t\t}\n \t\t}\n \t}\n \t/* Only add value type if we have a key type. It might be that the key type is illegal\n@@ -2459,7 +2464,7 @@ static const zend_property_info *zend_fetch_static_prop_info(const zend_script *\n \tconst zend_property_info *prop_info = NULL;\n \tif (opline->op1_type == IS_CONST) {\n \t\tconst zend_class_entry *ce = NULL;\n-\t\tif (opline->op2_type == IS_UNUSED) {\n+\t\tif (opline->op2_type == IS_UNUSED && !(op_array->fn_flags & ZEND_ACC_TRAIT_CLONE)) {\n \t\t\tuint32_t fetch_type = opline->op2.num & ZEND_FETCH_CLASS_MASK;\n \t\t\tswitch (fetch_type) {\n \t\t\t\tcase ZEND_FETCH_CLASS_SELF:\n@@ -3616,6 +3621,9 @@ static zend_always_inline zend_result _zend_update_type_info(\n \t\t\t\t\t\tif (t2 & (MAY_BE_UNDEF | MAY_BE_NULL)) {\n \t\t\t\t\t\t\tkey_type |= MAY_BE_ARRAY_KEY_STRING;\n \t\t\t\t\t\t}\n+\t\t\t\t\t\tif ((key_type & MAY_BE_ARRAY_KEY_STRING) && MAY_BE_PACKED(t1)) {\n+\t\t\t\t\t\t\tkey_type |= MAY_BE_ARRAY_NUMERIC_HASH;\n+\t\t\t\t\t\t}\n \t\t\t\t\t}\n \t\t\t\t} else if (opline->opcode == ZEND_FETCH_DIM_UNSET) {\n \t\t\t\t\tif (t1 & MAY_BE_ARRAY) {"},{"sha":"93706a8a0d4ccf2f82969a15f180ee123cf2f888","filename":"Zend/Optimizer/zend_optimizer.c","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fzend_optimizer.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2FOptimizer%2Fzend_optimizer.c","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2FOptimizer%2Fzend_optimizer.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -846,6 +846,7 @@ zend_class_entry *zend_optimizer_get_class_entry_from_op1(\n \t\t\treturn zend_optimizer_get_class_entry(script, op_array, Z_STR_P(op1 + 1));\n \t\t}\n \t} else if (opline->op1_type == IS_UNUSED && op_array->scope\n+\t\t\t&& !(op_array->fn_flags & ZEND_ACC_TRAIT_CLONE)\n \t\t\t&& !(op_array->scope->ce_flags & ZEND_ACC_TRAIT)\n \t\t\t&& ((opline->op1.num & ZEND_FETCH_CLASS_MASK) == ZEND_FETCH_CLASS_SELF\n \t\t\t\t|| ((opline->op1.num & ZEND_FETCH_CLASS_MASK) == ZEND_FETCH_CLASS_STATIC\n@@ -1345,7 +1346,7 @@ static void zend_redo_pass_two_ex(zend_op_array *op_array, const zend_ssa *ssa)\n \twhile (opline < end) {\n \t\tconst zend_ssa_op *ssa_op = &ssa->ops[opline - op_array->opcodes];\n \t\tuint32_t op1_info = opline->op1_type == IS_UNUSED ? 0 : (OP1_INFO() & (MAY_BE_UNDEF|MAY_BE_ANY|MAY_BE_REF|MAY_BE_ARRAY_OF_ANY|MAY_BE_ARRAY_KEY_ANY));\n-\t\tuint32_t op2_info = opline->op1_type == IS_UNUSED ? 0 : (OP2_INFO() & (MAY_BE_UNDEF|MAY_BE_ANY|MAY_BE_REF|MAY_BE_ARRAY_OF_ANY|MAY_BE_ARRAY_KEY_ANY));\n+\t\tuint32_t op2_info = opline->op2_type == IS_UNUSED ? 0 : (OP2_INFO() & (MAY_BE_UNDEF|MAY_BE_ANY|MAY_BE_REF|MAY_BE_ARRAY_OF_ANY|MAY_BE_ARRAY_KEY_ANY));\n \t\tuint32_t res_info =\n \t\t\t(opline->opcode == ZEND_PRE_INC ||\n \t\t\t opline->opcode == ZEND_PRE_DEC ||"},{"sha":"74bf25518e4cb310ae8533a039ff1a0eec1db6cc","filename":"Zend/tests/anon/012.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fanon%2F012.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fanon%2F012.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fanon%2F012.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -4,8 +4,8 @@ Ensure correct unmangling of private property names for anonymous class instance\n <?php\n var_dump(new class { private $foo; });\n ?>\n---EXPECT--\n-object(class@anonymous)#1 (1) {\n+--EXPECTF--\n+object(class@anonymous%0%s)#1 (1) {\n   [\"foo\":\"class@anonymous\":private]=>\n   NULL\n }"},{"sha":"298ae7837428cb4bebf4f6057d0087bc405c4bd0","filename":"Zend/tests/anon/013.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fanon%2F013.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fanon%2F013.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fanon%2F013.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -10,6 +10,6 @@ $foo = function() {\n $closure = Closure::bind($foo, $class, $class);\n var_dump($closure());\n ?>\n---EXPECT--\n-object(class@anonymous)#1 (0) {\n+--EXPECTF--\n+object(class@anonymous%0%s)#1 (0) {\n }"},{"sha":"b90fb7a8d6f901208f4b223214b7da8bf083331c","filename":"Zend/tests/anon/gh15994.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fanon%2Fgh15994.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fanon%2Fgh15994.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fanon%2Fgh15994.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -10,4 +10,4 @@ abstract class ParentClass {\n $o = new class extends ParentClass {};\n ?>\n --EXPECTF--\n-Fatal error: Class ParentClass@anonymous must implement 1 abstract method (ParentClass::f) in %sgh15994.php on line 7\n+Fatal error: Class ParentClass@anonymous%0%s must implement 1 abstract method (ParentClass::f) in %sgh15994.php on line 7"},{"sha":"ae9ea191dacbcbb746d8fcd22d406ec153ba8e78","filename":"Zend/tests/array_map_foreach_optimization_function_name.phpt","status":"added","additions":127,"deletions":0,"changes":127,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Farray_map_foreach_optimization_function_name.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Farray_map_foreach_optimization_function_name.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Farray_map_foreach_optimization_function_name.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,127 @@\n+--TEST--\n+array_map(): foreach optimization resolves the function name of an FCC\n+--FILE--\n+<?php\n+\n+namespace {\n+    function label($x) { return \"global:$x\"; }\n+    function only_global($x) { return \"only_global:$x\"; }\n+}\n+\n+namespace Lib {\n+    function fmt($x) { return \"Lib\\\\fmt:$x\"; }\n+}\n+\n+namespace App {\n+    function label($x) { return \"App\\\\label:$x\"; }\n+    function strtoupper($x) { return \"App\\\\strtoupper:$x\"; }\n+    function pad($x, $y) { return \"App\\\\pad:$x$y\"; }\n+\n+    use function Lib\\fmt;\n+    use function App\\label as lbl;\n+\n+    echo \"namespaced function:\\n\";\n+    var_dump(\\array_map(label(...), [1]));\n+    echo \"namespaced function shadowing an internal one:\\n\";\n+    var_dump(\\array_map(strtoupper(...), ['a']));\n+    echo \"use function:\\n\";\n+    var_dump(\\array_map(fmt(...), [2]));\n+    echo \"use function with alias:\\n\";\n+    var_dump(\\array_map(lbl(...), [3]));\n+    echo \"namespace-relative name:\\n\";\n+    var_dump(\\array_map(namespace\\label(...), [4]));\n+    echo \"fully qualified name:\\n\";\n+    var_dump(\\array_map(\\label(...), [5]));\n+    echo \"fallback to the global function:\\n\";\n+    var_dump(\\array_map(only_global(...), [6]));\n+    echo \"fallback to an internal function:\\n\";\n+    var_dump(\\array_map(ucfirst(...), ['b']));\n+    echo \"partial application:\\n\";\n+    var_dump(\\array_map(pad(?, '!'), [7]));\n+\n+    if (true) {\n+        function declared_at_runtime($x) { return \"App\\\\declared_at_runtime:$x\"; }\n+    }\n+    echo \"function declared at runtime:\\n\";\n+    var_dump(\\array_map(declared_at_runtime(...), [8]));\n+}\n+\n+namespace {\n+    use function Lib\\fmt;\n+    use function Lib\\fmt as libfmt;\n+\n+    echo \"global namespace, use function:\\n\";\n+    var_dump(array_map(fmt(...), [9]));\n+    echo \"global namespace, use function with alias:\\n\";\n+    var_dump(array_map(libfmt(...), [10]));\n+    echo \"global namespace, unqualified:\\n\";\n+    var_dump(array_map(label(...), [11]));\n+}\n+\n+?>\n+--EXPECT--\n+namespaced function:\n+array(1) {\n+  [0]=>\n+  string(11) \"App\\label:1\"\n+}\n+namespaced function shadowing an internal one:\n+array(1) {\n+  [0]=>\n+  string(16) \"App\\strtoupper:a\"\n+}\n+use function:\n+array(1) {\n+  [0]=>\n+  string(9) \"Lib\\fmt:2\"\n+}\n+use function with alias:\n+array(1) {\n+  [0]=>\n+  string(11) \"App\\label:3\"\n+}\n+namespace-relative name:\n+array(1) {\n+  [0]=>\n+  string(11) \"App\\label:4\"\n+}\n+fully qualified name:\n+array(1) {\n+  [0]=>\n+  string(8) \"global:5\"\n+}\n+fallback to the global function:\n+array(1) {\n+  [0]=>\n+  string(13) \"only_global:6\"\n+}\n+fallback to an internal function:\n+array(1) {\n+  [0]=>\n+  string(1) \"B\"\n+}\n+partial application:\n+array(1) {\n+  [0]=>\n+  string(10) \"App\\pad:7!\"\n+}\n+function declared at runtime:\n+array(1) {\n+  [0]=>\n+  string(25) \"App\\declared_at_runtime:8\"\n+}\n+global namespace, use function:\n+array(1) {\n+  [0]=>\n+  string(9) \"Lib\\fmt:9\"\n+}\n+global namespace, use function with alias:\n+array(1) {\n+  [0]=>\n+  string(10) \"Lib\\fmt:10\"\n+}\n+global namespace, unqualified:\n+array(1) {\n+  [0]=>\n+  string(9) \"global:11\"\n+}"},{"sha":"5dd87976faf5aee83ebbe35f8bd0b35aeefd9d66","filename":"Zend/tests/assert/expect_final_abstract_modifiers.phpt","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fassert%2Fexpect_final_abstract_modifiers.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fassert%2Fexpect_final_abstract_modifiers.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fassert%2Fexpect_final_abstract_modifiers.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,36 @@\n+--TEST--\n+AST printing of final and abstract modifiers on class constants and properties\n+--INI--\n+zend.assertions=1\n+--FILE--\n+<?php\n+\n+try {\n+    assert(false && new class {\n+        final public const A = 1;\n+        final protected const int B = 2;\n+        final public $a;\n+        final public static $b;\n+        final public readonly int $c;\n+        abstract public $d { get; }\n+        abstract protected private(set) int $e { set; }\n+    });\n+} catch (AssertionError $e) {\n+    echo $e->getMessage(), \"\\n\";\n+}\n+\n+?>\n+--EXPECT--\n+assert(false && new class {\n+    public final const A = 1;\n+    protected final const int B = 2;\n+    public final $a;\n+    public static final $b;\n+    public final readonly int $c;\n+    public abstract $d {\n+        get;\n+    }\n+    protected private(set) abstract int $e {\n+        set;\n+    }\n+})"},{"sha":"5944475ffc4e6111802328f3e4741761370afe7b","filename":"Zend/tests/assert/expect_readonly_anon_class.phpt","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fassert%2Fexpect_readonly_anon_class.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fassert%2Fexpect_readonly_anon_class.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fassert%2Fexpect_readonly_anon_class.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,22 @@\n+--TEST--\n+AST export of readonly anonymous class\n+--INI--\n+zend.assertions=1\n+--FILE--\n+<?php\n+try {\n+    assert(false && new readonly class {});\n+} catch (AssertionError $e) {\n+    echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+try {\n+    assert(false && new #[A] readonly class(1) {});\n+} catch (AssertionError $e) {\n+    echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+?>\n+--EXPECT--\n+AssertionError: assert(false && new readonly class {\n+})\n+AssertionError: assert(false && new #[A] readonly class(1) {\n+})"},{"sha":"f0a8e9c6dd9180d9bedf5e2256e3538688a75369","filename":"Zend/tests/attributes/override/constants/anon_failure.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fattributes%2Foverride%2Fconstants%2Fanon_failure.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fattributes%2Foverride%2Fconstants%2Fanon_failure.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fattributes%2Foverride%2Fconstants%2Fanon_failure.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -12,4 +12,4 @@ echo \"Done\";\n \n ?>\n --EXPECTF--\n-Fatal error: class@anonymous::C has #[\\Override] attribute, but no matching parent constant exists in %s on line %d\n+Fatal error: class@anonymous%0%s::C has #[\\Override] attribute, but no matching parent constant exists in %s on line %d"},{"sha":"0157f290638bc50a4bb4419ce39cfdc5e8d6bf99","filename":"Zend/tests/attributes/override/properties_16.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fattributes%2Foverride%2Fproperties_16.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fattributes%2Foverride%2Fproperties_16.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fattributes%2Foverride%2Fproperties_16.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -18,4 +18,4 @@ echo \"Done\";\n \n ?>\n --EXPECTF--\n-Fatal error: I@anonymous::$c has #[\\Override] attribute, but no matching parent property exists in %s on line %d\n+Fatal error: I@anonymous%0%s::$c has #[\\Override] attribute, but no matching parent property exists in %s on line %d"},{"sha":"d546332c79f4de31619acdbb9620cb9921e446eb","filename":"Zend/tests/bug72598.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fbug72598.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fbug72598.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fbug72598.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -18,9 +18,9 @@ new class {\n ?>\n --EXPECTF--\n Warning: ref(): Argument #1 ($ref) must be passed by reference, value given in %s on line %d\n-object(class@anonymous)#1 (0) {\n+object(class@anonymous%0%s)#1 (0) {\n }\n \n Warning: ref(): Argument #1 ($ref) must be passed by reference, value given in %s on line %d\n-object(class@anonymous)#1 (0) {\n+object(class@anonymous%0%s)#1 (0) {\n }"},{"sha":"08f735607880e667185c12a3cfe0478fd3e78db3","filename":"Zend/tests/bug73816.phpt","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fbug73816.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fbug73816.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fbug73816.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -13,12 +13,12 @@ var_dump(anon());\n var_dump(anon());\n \n ?>\n---EXPECT--\n-object(class@anonymous)#1 (1) {\n+--EXPECTF--\n+object(class@anonymous%0%s)#1 (1) {\n   [\"prop1\":\"class@anonymous\":private]=>\n   NULL\n }\n-object(class@anonymous)#1 (1) {\n+object(class@anonymous%0%s)#1 (1) {\n   [\"prop2\":\"class@anonymous\":private]=>\n   NULL\n }"},{"sha":"d522a9e8cbbce471a0a21244d5a424aa636ce438","filename":"Zend/tests/closures/gh23911.phpt","status":"added","additions":86,"deletions":0,"changes":86,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fclosures%2Fgh23911.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fclosures%2Fgh23911.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fclosures%2Fgh23911.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,86 @@\n+--TEST--\n+GH-23911: Cached static closure keeps static:: of the first called class\n+--CREDITS--\n+Sander Muller (SanderMuller)\n+--FILE--\n+<?php\n+\n+class A {\n+    public static function name(): string {\n+        return (static fn () => static::class)();\n+    }\n+\n+    public static function create(): static {\n+        return (static fn () => new static())();\n+    }\n+\n+    public function calledClass(): string {\n+        return (static function () {\n+            return get_called_class();\n+        })();\n+    }\n+}\n+class B extends A {}\n+class C extends A {}\n+\n+var_dump(B::name(), C::name(), B::name(), A::name());\n+var_dump(B::create()::class, C::create()::class);\n+var_dump((new B)->calledClass(), (new C)->calledClass());\n+\n+function f() {\n+    return static fn () => 42;\n+}\n+var_dump(f() === f());\n+var_dump(B::name(...) !== C::name(...));\n+\n+trait T {\n+    public static function names(): array {\n+        return (static fn () => [self::class, static::class])();\n+    }\n+}\n+class U1 { use T; }\n+class U2 { use T; }\n+class U3 extends U1 {}\n+var_dump(U1::names(), U2::names(), U3::names());\n+\n+class N {\n+    public static function nested(): string {\n+        return (static fn () => (static fn () => static::class)())();\n+    }\n+}\n+class N2 extends N {}\n+var_dump(N::nested(), N2::nested(), N::nested());\n+\n+?>\n+--EXPECT--\n+string(1) \"B\"\n+string(1) \"C\"\n+string(1) \"B\"\n+string(1) \"A\"\n+string(1) \"B\"\n+string(1) \"C\"\n+string(1) \"B\"\n+string(1) \"C\"\n+bool(true)\n+bool(true)\n+array(2) {\n+  [0]=>\n+  string(2) \"U1\"\n+  [1]=>\n+  string(2) \"U1\"\n+}\n+array(2) {\n+  [0]=>\n+  string(2) \"U2\"\n+  [1]=>\n+  string(2) \"U2\"\n+}\n+array(2) {\n+  [0]=>\n+  string(2) \"U1\"\n+  [1]=>\n+  string(2) \"U3\"\n+}\n+string(1) \"N\"\n+string(2) \"N2\"\n+string(1) \"N\""},{"sha":"197f594f68817c64a241bec24f83511a45047daf","filename":"Zend/tests/constexpr/new_anon_class.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fconstexpr%2Fnew_anon_class.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fconstexpr%2Fnew_anon_class.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fconstexpr%2Fnew_anon_class.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -8,6 +8,6 @@ static $x = new class {};\n var_dump($x);\n \n ?>\n---EXPECT--\n-object(class@anonymous)#1 (0) {\n+--EXPECTF--\n+object(class@anonymous%0%s)#1 (0) {\n }"},{"sha":"244b670ab1c6087b40171c0a7ad885e4238c1440","filename":"Zend/tests/constexpr/new_named_params_duplicate_leak.phpt","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fconstexpr%2Fnew_named_params_duplicate_leak.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fconstexpr%2Fnew_named_params_duplicate_leak.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fconstexpr%2Fnew_named_params_duplicate_leak.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,21 @@\n+--TEST--\n+Duplicate named param in new in const expr does not leak the argument\n+--FILE--\n+<?php\n+\n+class D {}\n+class C {\n+    public function __construct(public $a) {}\n+}\n+\n+function f($x = new C(a: new D, a: new D)) {}\n+\n+try {\n+    f();\n+} catch (Error $e) {\n+    echo $e::class, \": \", $e->getMessage(), \"\\n\";\n+}\n+\n+?>\n+--EXPECT--\n+Error: Named parameter $a overwrites previous argument"},{"sha":"9eba6af552ee618d1143586307ff8d7d1dce6086","filename":"Zend/tests/dynamic_prop_deprecation_002.phpt","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fdynamic_prop_deprecation_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fdynamic_prop_deprecation_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fdynamic_prop_deprecation_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -13,6 +13,6 @@ try {\n \techo $ex::class, ': ', $ex->getMessage(), \"\\n\";\n }\n ?>\n---EXPECT--\n-Err: Creation of dynamic property class@anonymous::$y is deprecated\n-Error: Cannot create dynamic property class@anonymous::$y\n+--EXPECTF--\n+Err: Creation of dynamic property class@anonymous%0%s::$y is deprecated\n+Error: Cannot create dynamic property class@anonymous%0%s::$y"},{"sha":"d4eed32fc624ccfc95fe178418c0ecbc08ffe35b","filename":"Zend/tests/fibers/gh24265-001.phpt","status":"added","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffibers%2Fgh24265-001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffibers%2Fgh24265-001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffibers%2Fgh24265-001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,24 @@\n+--TEST--\n+GH-24265 (exit() in a finally block of a destroyed fiber is discarded)\n+--CREDITS--\n+iluuu1994\n+--FILE--\n+<?php\n+\n+$fiber = new Fiber(function () {\n+    try {\n+        Fiber::suspend();\n+    } finally {\n+        exit(1);\n+    }\n+});\n+\n+$fiber->start();\n+echo \"Before destroy\", PHP_EOL;\n+unset($fiber);\n+\n+echo \"Not reached\", PHP_EOL;\n+\n+?>\n+--EXPECT--\n+Before destroy"},{"sha":"2a794bc3d02fbe44e44da0d29b5f84fa583a0a53","filename":"Zend/tests/fibers/gh24265-002.phpt","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffibers%2Fgh24265-002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffibers%2Fgh24265-002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffibers%2Fgh24265-002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,30 @@\n+--TEST--\n+GH-24265 (exit() in a destroyed fiber is discarded while an exception is pending)\n+--FILE--\n+<?php\n+\n+function test() {\n+    $fiber = new Fiber(function () {\n+        try {\n+            Fiber::suspend();\n+        } finally {\n+            exit(1);\n+        }\n+    });\n+\n+    $fiber->start();\n+    echo \"Before destroy\", PHP_EOL;\n+    throw new Exception(\"pending\");\n+}\n+\n+try {\n+    test();\n+} catch (Exception $e) {\n+    echo $e::class, ': ', $e->getMessage(), PHP_EOL;\n+}\n+\n+echo \"Not reached\", PHP_EOL;\n+\n+?>\n+--EXPECT--\n+Before destroy"},{"sha":"8199b47afa970197f30ee1cd6803af8da2d90e58","filename":"Zend/tests/first_class_callable/constexpr/trait_scope_001.phpt","status":"added","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,18 @@\n+--TEST--\n+FCC for self:: static method in trait default argument is resolved per using class\n+--FILE--\n+<?php\n+\n+trait T {\n+    public static function make($f = self::who(...)) { return $f(); }\n+}\n+class A { use T; public static function who() { return 'A'; } }\n+class B { use T; public static function who() { return 'B'; } }\n+\n+echo A::make(), PHP_EOL;\n+echo B::make(), PHP_EOL;\n+\n+?>\n+--EXPECT--\n+A\n+B"},{"sha":"5390f6337a522683379cc93f85564fa82d981262","filename":"Zend/tests/first_class_callable/constexpr/trait_scope_002.phpt","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,20 @@\n+--TEST--\n+FCC for parent:: static method in trait default argument is resolved per using class\n+--FILE--\n+<?php\n+\n+class P1 { public static function who() { return 'P1'; } }\n+class P2 { public static function who() { return 'P2'; } }\n+trait T {\n+    public static function make($f = parent::who(...)) { return $f(); }\n+}\n+class A extends P1 { use T; }\n+class B extends P2 { use T; }\n+\n+echo A::make(), PHP_EOL;\n+echo B::make(), PHP_EOL;\n+\n+?>\n+--EXPECT--\n+P1\n+P2"},{"sha":"ae63777392ba610f039eeae4f401a9ab44982e2f","filename":"Zend/tests/first_class_callable/constexpr/trait_scope_003.phpt","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_003.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_003.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_003.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,23 @@\n+--TEST--\n+FCC for self:: static method in trait constant and property default is resolved per using class\n+--FILE--\n+<?php\n+\n+trait T {\n+    const C = self::who(...);\n+    public $p = self::who(...);\n+}\n+class A { use T; public static function who() { return 'A'; } }\n+class B { use T; public static function who() { return 'B'; } }\n+\n+echo (A::C)(), PHP_EOL;\n+echo (B::C)(), PHP_EOL;\n+echo ((new A)->p)(), PHP_EOL;\n+echo ((new B)->p)(), PHP_EOL;\n+\n+?>\n+--EXPECT--\n+A\n+B\n+A\n+B"},{"sha":"da1608e2d9181a898c01ed90ec964aff95311473","filename":"Zend/tests/first_class_callable/constexpr/trait_scope_004.phpt","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_004.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_004.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_004.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,22 @@\n+--TEST--\n+FCC for self:: private static method in trait default argument does not leak to other using classes\n+--FILE--\n+<?php\n+\n+trait T {\n+    public static function make($f = self::who(...)) { return $f(); }\n+}\n+class A { use T; private static function who() { return 'A'; } }\n+class B { use T; }\n+\n+echo A::make(), PHP_EOL;\n+try {\n+    B::make();\n+} catch (Error $e) {\n+    echo $e::class, \": \", $e->getMessage(), PHP_EOL;\n+}\n+\n+?>\n+--EXPECT--\n+A\n+Error: Call to undefined method B::who()"},{"sha":"50382a4499394bd8d171326fb789af953c3f8f87","filename":"Zend/tests/first_class_callable/constexpr/trait_scope_005.phpt","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_005.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_005.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_005.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,22 @@\n+--TEST--\n+FCC for named class private static method in trait default argument checks visibility per using class\n+--FILE--\n+<?php\n+\n+trait T {\n+    public static function make($f = A::who(...)) { return $f(); }\n+}\n+class A { use T; private static function who() { return 'A'; } }\n+class B { use T; }\n+\n+echo A::make(), PHP_EOL;\n+try {\n+    B::make();\n+} catch (Error $e) {\n+    echo $e::class, \": \", $e->getMessage(), PHP_EOL;\n+}\n+\n+?>\n+--EXPECT--\n+A\n+Error: Call to private method A::who() from scope B"},{"sha":"4ffb56841caa31591d5f40ad1027d946a3c574cf","filename":"Zend/tests/first_class_callable/constexpr/trait_scope_006.phpt","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_006.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_006.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ffirst_class_callable%2Fconstexpr%2Ftrait_scope_006.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,20 @@\n+--TEST--\n+FCC for named class public static method in trait default argument is shared across using classes\n+--FILE--\n+<?php\n+\n+trait T {\n+    public static function make($f = A::who(...)) { return $f(); }\n+}\n+class A { use T; public static function who() { return 'A'; } }\n+class B { use T; }\n+\n+echo A::make(), PHP_EOL;\n+echo B::make(), PHP_EOL;\n+echo A::make(), PHP_EOL;\n+\n+?>\n+--EXPECT--\n+A\n+A\n+A"},{"sha":"2d658948a4e059201409b697ffd70efec1b5016c","filename":"Zend/tests/gh19304.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fgh19304.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fgh19304.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fgh19304.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -14,5 +14,5 @@ try {\n }\n \n ?>\n---EXPECT--\n-TypeError: Cannot assign int to property class@anonymous::$v of type self\n+--EXPECTF--\n+TypeError: Cannot assign int to property class@anonymous%0%s::$v of type self"},{"sha":"02b12b3e70aeffff3d89d4bbdf2334beee0dccbb","filename":"Zend/tests/gh24989.phpt","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fgh24989.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fgh24989.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fgh24989.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,29 @@\n+--TEST--\n+GH-24989 (Use-after-free in GC when an exception is thrown)\n+--CREDITS--\n+vi3tL0u1s\n+--FILE--\n+<?php\n+class D { function __destruct() { gc_collect_cycles(); } }\n+\n+function loop_var() {\n+    foreach (range(1, 2) as $v) {\n+        $x = [new D, throw new Exception('loop')];\n+    }\n+}\n+\n+function tmp_var() {\n+    $x = [range(1, 2), [new D, throw new Exception('tmp')]];\n+}\n+\n+foreach (['loop_var', 'tmp_var'] as $f) {\n+    try {\n+        $f();\n+    } catch (Exception $e) {\n+        echo $e::class, ': ', $e->getMessage(), PHP_EOL;\n+    }\n+}\n+?>\n+--EXPECT--\n+Exception: loop\n+Exception: tmp"},{"sha":"5d3d317e806ecea4cf0bbee89361705395106ea5","filename":"Zend/tests/gh24989_uncaught.phpt","status":"added","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fgh24989_uncaught.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fgh24989_uncaught.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fgh24989_uncaught.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,16 @@\n+--TEST--\n+GH-24989 (Use-after-free in GC when an exception is thrown, uncaught)\n+--CREDITS--\n+vi3tL0u1s\n+--FILE--\n+<?php\n+class D { function __destruct() { gc_collect_cycles(); } }\n+foreach (range(1, 2) as $v) {\n+    $x = [new D, throw new Exception];\n+}\n+?>\n+--EXPECTF--\n+Fatal error: Uncaught Exception in %s:%d\n+Stack trace:\n+#0 {main}\n+  thrown in %s on line %d"},{"sha":"99899a6157780a29d458b98f2bdef978b7afaa61","filename":"Zend/tests/partial_application/gh25007.phpt","status":"added","additions":31,"deletions":0,"changes":31,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fpartial_application%2Fgh25007.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fpartial_application%2Fgh25007.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fpartial_application%2Fgh25007.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,31 @@\n+--TEST--\n+GH-25007 (PFA in constexpr: named args before a named placeholder)\n+--FILE--\n+<?php\n+\n+function f($a, $b = 2, $c = 3) {\n+    var_dump(func_get_args());\n+}\n+\n+const C1 = f(a: 1, b: ?);\n+const C2 = f(a: 1, c: ?, b: ?);\n+\n+(C1)(4);\n+(C2)(5, 6);\n+\n+?>\n+--EXPECT--\n+array(2) {\n+  [0]=>\n+  int(1)\n+  [1]=>\n+  int(4)\n+}\n+array(3) {\n+  [0]=>\n+  int(1)\n+  [1]=>\n+  int(6)\n+  [2]=>\n+  int(5)\n+}"},{"sha":"9a7de941bf43479776a1f5fbb975befba44de2db","filename":"Zend/tests/partial_application/static_pfa_004.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fpartial_application%2Fstatic_pfa_004.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fpartial_application%2Fstatic_pfa_004.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fpartial_application%2Fstatic_pfa_004.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -39,6 +39,6 @@ Closure [ <user> function {closure:pfa:%s:13} ] {\n \n Error: Using $this when not in object context\n # Re-bound PFA\n-object(class@anonymous)#3 (0) {\n+object(class@anonymous%0%s)#3 (0) {\n }\n bool(true)"},{"sha":"683814387f4d6d7f22580f233fc0d4ebd710e6df","filename":"Zend/tests/property_hooks/oss_fuzz_403308724.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fproperty_hooks%2Foss_fuzz_403308724.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fproperty_hooks%2Foss_fuzz_403308724.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fproperty_hooks%2Foss_fuzz_403308724.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -19,10 +19,10 @@ $y = $test->y;\n var_dump($y);\n var_dump($y[0]->inner);\n ?>\n---EXPECT--\n+--EXPECTF--\n array(2) {\n   [0]=>\n-  object(class@anonymous)#2 (0) {\n+  object(class@anonymous%0%s)#2 (0) {\n   }\n   [1]=>\n   int(1)"},{"sha":"2b2fe82804c3ec39ce8ce772ac53d6b04297b856","filename":"Zend/tests/readonly_classes/gh10377_1.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Freadonly_classes%2Fgh10377_1.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Freadonly_classes%2Fgh10377_1.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Freadonly_classes%2Fgh10377_1.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -12,4 +12,4 @@ $readonly_anon = new #[AllowDynamicProperties] readonly class {\n \n ?>\n --EXPECTF--\n-Fatal error: Cannot apply #[\\AllowDynamicProperties] to readonly class class@anonymous in %s on line %d\n+Fatal error: Cannot apply #[\\AllowDynamicProperties] to readonly class class@anonymous%0%s in %s on line %d"},{"sha":"fb016393a8344daea8584084db8d88f2aa63edaa","filename":"Zend/tests/shift_left_overflow_range.phpt","status":"added","additions":51,"deletions":0,"changes":51,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fshift_left_overflow_range.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Fshift_left_overflow_range.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Fshift_left_overflow_range.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,51 @@\n+--TEST--\n+Too narrow range inferred for SL when the shift wraps\n+--SKIPIF--\n+<?php if (PHP_INT_SIZE != 8) die(\"skip 64-bit only\"); ?>\n+--FILE--\n+<?php\n+/* $i is inferred as RANGE[1..5]. Shifting it by 62 wraps for every $i >= 2,\n+ * so the result range may not be derived from the two endpoints: both of them\n+ * happen to yield 1 << 62, while the values in between do not. */\n+function shift_positive(): array {\n+    $out = [];\n+    for ($i = 1; $i <= 5; $i++) {\n+        $out[] = $i << 62;\n+    }\n+    return $out;\n+}\n+\n+/* Likewise for RANGE[-3..-1] shifted by 63: both endpoints yield LONG_MIN,\n+ * but -2 << 63 is 0. */\n+function shift_negative(): array {\n+    $out = [];\n+    for ($i = -1; $i >= -3; $i--) {\n+        $out[] = $i << 63;\n+    }\n+    return $out;\n+}\n+\n+var_dump(shift_positive());\n+var_dump(shift_negative());\n+?>\n+--EXPECT--\n+array(5) {\n+  [0]=>\n+  int(4611686018427387904)\n+  [1]=>\n+  int(-9223372036854775808)\n+  [2]=>\n+  int(-4611686018427387904)\n+  [3]=>\n+  int(0)\n+  [4]=>\n+  int(4611686018427387904)\n+}\n+array(3) {\n+  [0]=>\n+  int(-9223372036854775808)\n+  [1]=>\n+  int(0)\n+  [2]=>\n+  int(-9223372036854775808)\n+}"},{"sha":"742f7f369390dfc1c6cfcfbd96370107a597836b","filename":"Zend/tests/temporary_cleaning/temporary_cleaning_013.phpt","status":"modified","additions":6,"deletions":6,"changes":12,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftemporary_cleaning%2Ftemporary_cleaning_013.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftemporary_cleaning%2Ftemporary_cleaning_013.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftemporary_cleaning%2Ftemporary_cleaning_013.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -284,27 +284,27 @@ caught Exception 3\n caught Exception 4\n caught Exception 5\n \n-Deprecated: Creation of dynamic property class@anonymous::$foo is deprecated in %s on line %d\n+Deprecated: Creation of dynamic property class@anonymous%0%s::$foo is deprecated in %s on line %d\n caught Exception 6\n caught Exception 7\n caught Exception 8\n caught Exception 9\n caught Exception 10\n \n-Deprecated: Creation of dynamic property class@anonymous::$foo is deprecated in %s on line %d\n+Deprecated: Creation of dynamic property class@anonymous%0%s::$foo is deprecated in %s on line %d\n caught Exception 11\n \n-Deprecated: Creation of dynamic property class@anonymous::$foo is deprecated in %s on line %d\n+Deprecated: Creation of dynamic property class@anonymous%0%s::$foo is deprecated in %s on line %d\n caught Exception 12\n caught Exception 13\n \n-Deprecated: Creation of dynamic property class@anonymous::$foo is deprecated in %s on line %d\n+Deprecated: Creation of dynamic property class@anonymous%0%s::$foo is deprecated in %s on line %d\n caught Exception 14\n \n-Notice: Indirect modification of overloaded element of ArrayAccess@anonymous has no effect in %s on line %d\n+Notice: Indirect modification of overloaded element of ArrayAccess@anonymous%0%s has no effect in %s on line %d\n caught Exception 15\n \n-Notice: Indirect modification of overloaded element of ArrayAccess@anonymous has no effect in %s on line %d\n+Notice: Indirect modification of overloaded element of ArrayAccess@anonymous%0%s has no effect in %s on line %d\n caught Exception 16\n caught Exception 17\n caught Exception 18"},{"sha":"1dfd3db00590cb83d884c6f92d260761cfca1e10","filename":"Zend/tests/try/finally_interrupt_after_return.phpt","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,42 @@\n+--TEST--\n+VM interrupt throwing at the end of a finally block after \"return\" in the try block\n+--DESCRIPTION--\n+\"return\" inside a try block runs the finally block with FAST_CALL, and FAST_RET\n+then jumps back to the RETURN, which is inside the try block. An interrupt that\n+throws as the finally block ends belongs to the finally block: it must not run\n+the finally block again, and it discards the pending return value.\n+--EXTENSIONS--\n+zend_test\n+--INI--\n+zend_test.observer.enabled=1\n+zend_test.observer.show_output=0\n+zend_test.observer.observe_function_names=release\n+zend_test.observer.set_vm_interrupt_on_end=1\n+--FILE--\n+<?php\n+$runs = 0;\n+\n+function release() {\n+    global $runs;\n+    $runs++;\n+}\n+\n+function test() {\n+    try {\n+        return str_repeat('a', 3);\n+    } finally {\n+        release();\n+    }\n+}\n+\n+try {\n+    $result = test();\n+    echo \"test() returned $result\\n\";\n+} catch (Exception $e) {\n+    echo get_class($e), ': ', $e->getMessage(), \"\\n\";\n+}\n+echo \"finally ran $runs time(s)\\n\";\n+?>\n+--EXPECT--\n+Exception: VM interrupt\n+finally ran 1 time(s)"},{"sha":"da5c64bae3c6cf26ae77b62917c61b09d2fc44b3","filename":"Zend/tests/try/finally_interrupt_after_return_generator.phpt","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return_generator.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return_generator.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return_generator.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,43 @@\n+--TEST--\n+VM interrupt throwing at the end of a generator's finally block after \"return\" in the try block\n+--EXTENSIONS--\n+zend_test\n+--INI--\n+zend_test.observer.enabled=1\n+zend_test.observer.show_output=0\n+zend_test.observer.observe_function_names=release\n+zend_test.observer.set_vm_interrupt_on_end=1\n+--FILE--\n+<?php\n+$runs = 0;\n+\n+function release() {\n+    global $runs;\n+    $runs++;\n+}\n+\n+function gen() {\n+    try {\n+        yield 1;\n+        return str_repeat('a', 3);\n+    } finally {\n+        release();\n+    }\n+}\n+\n+$gen = gen();\n+try {\n+    echo \"yielded \", $gen->current(), \"\\n\";\n+    $gen->next();\n+    echo \"gen() returned \", $gen->getReturn(), \"\\n\";\n+} catch (Exception $e) {\n+    echo get_class($e), ': ', $e->getMessage(), \"\\n\";\n+}\n+var_dump($gen->valid());\n+echo \"finally ran $runs time(s)\\n\";\n+?>\n+--EXPECT--\n+yielded 1\n+Exception: VM interrupt\n+bool(false)\n+finally ran 1 time(s)"},{"sha":"f4a2d09c0771ba050c2b81a634740d3b88811128","filename":"Zend/tests/try/finally_interrupt_after_return_nested.phpt","status":"added","additions":47,"deletions":0,"changes":47,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return_nested.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return_nested.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftry%2Ffinally_interrupt_after_return_nested.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,47 @@\n+--TEST--\n+VM interrupt throwing at the end of nested finally blocks after \"return\" in the try block\n+--DESCRIPTION--\n+The inner finally block's FAST_RET jumps to the outer FAST_CALL, which is inside\n+the inner try block. An interrupt that throws there must not run the inner\n+finally block again, but the outer finally block still runs.\n+--EXTENSIONS--\n+zend_test\n+--INI--\n+zend_test.observer.enabled=1\n+zend_test.observer.show_output=0\n+zend_test.observer.observe_function_names=release\n+zend_test.observer.set_vm_interrupt_on_end=1\n+--FILE--\n+<?php\n+$runs = [];\n+\n+function release($name) {\n+    global $runs;\n+    $runs[] = $name;\n+}\n+\n+function test() {\n+    try {\n+        try {\n+            return str_repeat('a', 3);\n+        } finally {\n+            release('inner');\n+        }\n+    } finally {\n+        release('outer');\n+    }\n+}\n+\n+try {\n+    $result = test();\n+    echo \"test() returned $result\\n\";\n+} catch (Exception $e) {\n+    echo get_class($e), ': ', $e->getMessage(), \"\\n\";\n+    echo 'previous: ', get_class($e->getPrevious()), ': ', $e->getPrevious()->getMessage(), \"\\n\";\n+}\n+echo implode(', ', $runs), \"\\n\";\n+?>\n+--EXPECT--\n+Exception: VM interrupt\n+previous: Exception: VM interrupt\n+inner, outer"},{"sha":"d6136642b24075da1ded2e1cedd0e18c835a220d","filename":"Zend/tests/type_declarations/typed_properties_001.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_001.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_001.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_001.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -21,7 +21,7 @@ var_dump(new class(1, 2.2, true, [\"four\"], new stdClass) {\n });\n ?>\n --EXPECTF--\n-object(class@anonymous)#%d (6) {\n+object(class@anonymous%0%s)#%d (6) {\n   [\"int\"]=>\n   int(1)\n   [\"float\"]=>"},{"sha":"0527902b9f676339dd93a0ef264eb9075bf4a878","filename":"Zend/tests/type_declarations/typed_properties_002.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_002.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_002.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_002.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -9,7 +9,7 @@ $thing = new class() {\n var_dump($thing->int);\n ?>\n --EXPECTF--\n-Fatal error: Uncaught Error: Typed property class@anonymous::$int must not be accessed before initialization in %s:%d\n+Fatal error: Uncaught Error: Typed property class@anonymous%0%s::$int must not be accessed before initialization in %s:%d\n Stack trace:\n #0 {main}\n   thrown in %s on line 6"},{"sha":"99c452934bcf7f88ea2fe645fdc022749d2e1cae","filename":"Zend/tests/type_declarations/typed_properties_003.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_003.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_003.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_003.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -9,7 +9,7 @@ $thing = new class() {\n $var = &$thing->int;\n ?>\n --EXPECTF--\n-Fatal error: Uncaught Error: Cannot access uninitialized non-nullable property class@anonymous::$int by reference in %s:%d\n+Fatal error: Uncaught Error: Cannot access uninitialized non-nullable property class@anonymous%0%s::$int by reference in %s:%d\n Stack trace:\n #0 {main}\n   thrown in %s on line %d"},{"sha":"86a5260f0ed47c8c6476dd55c0ce7cb5e3fadf0d","filename":"Zend/tests/type_declarations/typed_properties_004.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_004.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_004.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_004.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -11,7 +11,7 @@ new class(\"PHP 7 is better than you, and it knows it ...\") {\n };\n ?>\n --EXPECTF--\n-Fatal error: Uncaught TypeError: Cannot assign string to property class@anonymous::$int of type int in %s:%d\n+Fatal error: Uncaught TypeError: Cannot assign string to property class@anonymous%0%s::$int of type int in %s:%d\n Stack trace:\n #0 %s(%d): class@anonymous->__construct('PHP 7 is better...')\n #1 {main}"},{"sha":"e92ec7256ca87f9d1cdc925c63322f5ee35bde00","filename":"Zend/tests/type_declarations/typed_properties_005.phpt","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_005.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_005.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/Zend%2Ftests%2Ftype_declarations%2Ftyped_properties_005.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -13,7 +13,7 @@ new class(new Dummy) {\n };\n ?>\n