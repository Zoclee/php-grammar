ions_url":"https://api.github.com/users/DanielEScherzer/subscriptions","organizations_url":"https://api.github.com/users/DanielEScherzer/orgs","repos_url":"https://api.github.com/users/DanielEScherzer/repos","events_url":"https://api.github.com/users/DanielEScherzer/events{/privacy}","received_events_url":"https://api.github.com/users/DanielEScherzer/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"172335ff1eddb4448992988ec558ad5d959970d2","url":"https://api.github.com/repos/php/php-src/commits/172335ff1eddb4448992988ec558ad5d959970d2","html_url":"https://github.com/php/php-src/commit/172335ff1eddb4448992988ec558ad5d959970d2"}]},{"sha":"1ef1dd53bb11dbdc5a65f79d3dd1144cc38c4008","node_id":"C_kwDOAB0LotoAKDFlZjFkZDUzYmIxMWRiZGM1YTY1Zjc5ZDNkZDExNDRjYzM4YzQwMDg","commit":{"author":{"name":"cuishuang","email":"imcusg@gmail.com","date":"2026-10-30T21:23:55Z"},"committer":{"name":"Jakub Zelenka","email":"bukka@php.net","date":"2026-10-30T21:23:55Z"},"message":"Fix json_encode() depth range check before narrowing\n\njson_encode() accepts $depth as a zend_long but stores it in the\nencoder's int max_depth field. On 64-bit builds, values outside the int\nrange were silently narrowed, so a too large depth could wrap to a small\none and a too small depth could wrap to INT_MAX.\n\nCheck the value with ZEND_LONG_EXCEEDS_INT() and throw a ValueError when\nit cannot be represented as an int.\n\nCloses GH-23589","tree":{"sha":"d2f3f950d7960d4cd8ccf98e23dfb2189aff4006","url":"https://api.github.com/repos/php/php-src/git/trees/d2f3f950d7960d4cd8ccf98e23dfb2189aff4006"},"url":"https://api.github.com/repos/php/php-src/git/commits/1ef1dd53bb11dbdc5a65f79d3dd1144cc38c4008","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQTCjZN1dWA+tKu3JYYcB3ncXAqd5AUCauUK6wAKCRAcB3ncXAqd\n5LVbAP0fBNSCK6EcVcmsxNjMVsQlO105pQqx/P//e5zUA555SwD9HFyqzn04yhuh\nd6j2Qdqn33DQ6UpzUeDFdxxYed0q4gg=\n=6BKs\n-----END PGP SIGNATURE-----","payload":"tree d2f3f950d7960d4cd8ccf98e23dfb2189aff4006\nparent 56bd75634f931745f35bbbde52aa92e319557ca1\nauthor cuishuang <imcusg@gmail.com> 1793395435 +0100\ncommitter Jakub Zelenka <bukka@php.net> 1793395435 +0100\n\nFix json_encode() depth range check before narrowing\n\njson_encode() accepts $depth as a zend_long but stores it in the\nencoder's int max_depth field. On 64-bit builds, values outside the int\nrange were silently narrowed, so a too large depth could wrap to a small\none and a too small depth could wrap to INT_MAX.\n\nCheck the value with ZEND_LONG_EXCEEDS_INT() and throw a ValueError when\nit cannot be represented as an int.\n\nCloses GH-23589\n","verified_at":"2026-10-30T21:27:47Z"}},"url":"https://api.github.com/repos/php/php-src/commits/1ef1dd53bb11dbdc5a65f79d3dd1144cc38c4008","html_url":"https://github.com/php/php-src/commit/1ef1dd53bb11dbdc5a65f79d3dd1144cc38c4008","comments_url":"https://api.github.com/repos/php/php-src/commits/1ef1dd53bb11dbdc5a65f79d3dd1144cc38c4008/comments","author":{"login":"cuishuang","id":15921519,"node_id":"MDQ6VXNlcjE1OTIxNTE5","avatar_url":"https://avatars.githubusercontent.com/u/15921519?v=4","gravatar_id":"","url":"https://api.github.com/users/cuishuang","html_url":"https://github.com/cuishuang","followers_url":"https://api.github.com/users/cuishuang/followers","following_url":"https://api.github.com/users/cuishuang/following{/other_user}","gists_url":"https://api.github.com/users/cuishuang/gists{/gist_id}","starred_url":"https://api.github.com/users/cuishuang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cuishuang/subscriptions","organizations_url":"https://api.github.com/users/cuishuang/orgs","repos_url":"https://api.github.com/users/cuishuang/repos","events_url":"https://api.github.com/users/cuishuang/events{/privacy}","received_events_url":"https://api.github.com/users/cuishuang/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users/bukka/following{/other_user}","gists_url":"https://api.github.com/users/bukka/gists{/gist_id}","starred_url":"https://api.github.com/users/bukka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bukka/subscriptions","organizations_url":"https://api.github.com/users/bukka/orgs","repos_url":"https://api.github.com/users/bukka/repos","events_url":"https://api.github.com/users/bukka/events{/privacy}","received_events_url":"https://api.github.com/users/bukka/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"56bd75634f931745f35bbbde52aa92e319557ca1","url":"https://api.github.com/repos/php/php-src/commits/56bd75634f931745