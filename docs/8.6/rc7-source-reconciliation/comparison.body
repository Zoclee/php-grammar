 Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-02T12:32:51Z"},"committer":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-02T12:32:52Z"},"message":"Merge branch 'PHP-8.5' into PHP-8.6\n\n* PHP-8.5:\n  ext/com_dotnet: Fix GH-25008 event source typelib crash","tree":{"sha":"5f6c7269c8414d98af059b5e32b28412e7378fb3","url":"https://api.github.com/repos/php/php-src/git/trees/5f6c7269c8414d98af059b5e32b28412e7378fb3"},"url":"https://api.github.com/repos/php/php-src/git/commits/da9c8bdaeb2b53cd959642a7a66e75a80e4c2539","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgdYhKZ4kd7+tlpRbDZ0aP7UxDG4\ndIRutl3Ksx2/yts4sAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQNPD7/sqUCJPR3srldaLy3184IFQTF5d4CPuK5Hg4Yrt3mR8xHhCNfhqsURMkCFd/i\n/krOUbxrrl9KGp8c+UnQQ=\n-----END SSH SIGNATURE-----","payload":"tree 5f6c7269c8414d98af059b5e32b28412e7378fb3\nparent 1e760d19649253f739fd223310c8da7888266b40\nparent e29d731c8f45c8aba7e3bc40083878807ba6d492\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1793622771 -0500\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793622772 -0500\n\nMerge branch 'PHP-8.5' into PHP-8.6\n\n* PHP-8.5:\n  ext/com_dotnet: Fix GH-25008 event source typelib crash\n","verified_at":"2026-11-02T12:34:05Z"}},"url":"https://api.github.com/repos/php/php-src/commits/da9c8bdaeb2b53cd959642a7a66e75a80e4c2539","html_url":"https://github.com/php/php-src/commit/da9c8bdaeb2b53cd959642a7a66e75a80e4c2539","comments_url":"https://api.github.com/repos/php/php-src/commits/da9c8bdaeb2b53cd959642a7a66e75a80e4c2539/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1e760d19649253f739fd223310c8da7888266b40","url":"https://api.github.com/repos/php/php-src/commits/1e760d19649253f739fd223310c8da7888266b40","html_url":"https://github.com/php/php-src/commit/1e760d19649253f739fd223310c8da7888266b40"},{"sha":"e29d731c8f45c8aba7e3bc40083878807ba6d492","url":"https://api.github.com/repos/php/php-src/commits/e29d731c8f45c8aba7e3bc40083878807ba6d492","html_url":"https://github.com/php/php-src/commit/e29d731c8f45c8aba7e3bc40083878807ba6d492"}]},{"sha":"e46e742f45e66cd4c6379160e3d378062a2e2b4f","node_id":"C_kwDOAB0LotoAKGU0NmU3NDJmNDVlNjZjZDRjNjM3OTE2MGUzZDM3ODA2MmEyZTJiNGY","commit":{"author":{"name":"Roman Ondráček","email":"mail@romanondracek.cz","date":"2026-10-05T19:24:44Z"},"committer":{"name":"Ilija Tovilo","email":"ilija.tovilo@me.com","date":"2026-11-02T15:07:30Z"},"message":"Don't use static closure cache when called_scope diverges\n\nThe stateless closure cache in ZEND_DECLARE_LAMBDA_FUNCTION stored a single\nclosure per opline. Since the op_array and its cache slot is shared by all\nsubclasses, the closure created for the first called scope was returned for\nevery other called scope, breaking static::, new static() and\nget_called_class().\n\nStore the called scope alongside the cached closure and only reuse the closure\nfor a matching called scope.\n\nFixes GH-23911\nCloses GH-24143\n\nSigned-off-by: Roman Ondráček <mail@romanondracek.cz>","tree":{"sha":"acd1c68ce4e3c79eced1c908f1e6bfca5d3c8c1c","url":"https://api.github.com/repos/php/php-src/git/trees/acd1c68ce4e3c79eced1c908f1e6bfca5d3c8c1c"},"url":"https://api.github.com/repos/php/php-src/git/commits/e46e742f45e66cd4c6379160e3d378062a2e2b4f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQRe5cb47pnpW7+0wP5QUMZr/NEBWgUCauinMwAKCRBQUMZr/NEB\nWt2MAQDU3QxZRmmgQpnBSjaXolP46ZOmfKvqWAa8/3N9g2gaQAEAy8HzfTuVon5I\nKajxpw+we5QC3DiagE3BAWEN63BhCQg=\n=5v6x\n-----END PGP SIGNATURE-----","payload":"tree acd1c68ce4e3c79eced1c908f1e6bfca5d3c8c1c\nparent da9c8bdaeb2b53cd959642a7a66e75a80e4c2539\nauthor Roman Ondráček <mail@romanondracek.cz> 1791228284 +0200\ncommitter Ilija Tovilo <ilija.tovilo@me.com> 1793632050 +0100\n\nDon't use static closure cache when called_scope diverges\n\nThe stateless closure cache in ZEND_DECLARE_LAMBDA_FUNCTION stored a single\nclosure per opline. Since the op_array and its cache slot is shared by all\nsubclasses, the closure created for the first called scope was returned for\nevery other called scope, breaking static::, new static() and\nget_called_class().\n\nStore the called scope alongside the cached closure and only reuse the closure\nfor a matching called scope.\n\nFixes GH-23911\nCloses GH-24143\n\nSigned-off-by: Roman Ondráček <mail@romanondracek.cz>\n","verified_at":"2026-11-02T15:18:36Z"}},"url":"https://api.github.com/repos/php/php-src/commits/e46e742f45e66cd4c6379160e3d378062a2e2b4f","html_url":"https://github.com/php/php-src/commit/e46e742f45e66cd4c6379160e3d378062a2e2b4f","comments_url":"https://api.github.com/repos/php/php-src/commits/e46e742f45e66cd4c6379160e3d378062a2e2b4f/comments","author":{"login":"Roman3349","id":4655467,"node_id":"MDQ6VXNlcjQ2NTU0Njc=","avatar_url":"https://avatars.githubusercontent.com/u/4655467?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman3349","html_url":"https://github.com/Roman3349","followers_url":"https://api.github.com/users/Roman3349/followers","following_url":"https://api.github.com/users/Roman3349/following{/other_user}","gists_url":"https://api.github.com/users/Roman3349/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman3349/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman3349/subscriptions","organizations_url":"https://api.github.com/users/Roman3349/orgs","repos_url":"https://api.github.com/users/Roman3349/repos","events_url":"https://api.github.com/users/Roman3349/events{/privacy}","received_events_url":"https://api.github.com/users/Roman3349/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"iluuu1994","id":1752683,"node_id":"MDQ6VXNlcjE3NTI2ODM=","avatar_url":"https://avatars.githubusercontent.com/u/1752683?v=4","gravatar_id":"","url":"https://api.github.com/users/iluuu1994","html_url":"https://github.com/iluuu1994","followers_url":"https://api.github.com/users/iluuu1994/followers","following_url":"https://api.github.com/users/iluuu1994/following{/other_user}","gists_url":"https://api.github.com/users/iluuu1994/gists{/gist_id}","starred_url":"https://api.github.com/users/iluuu1994/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iluuu1994/subscriptions","organizations_url":"https://api.github.com/users/iluuu1994/orgs","repos_url":"https://api.github.com/users/iluuu1994/repos","events_url":"https://api.github.com/users/iluuu1994/events{/privacy}","received_events_url":"https://api.github.com/users/iluuu1994/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"da9c8bdaeb2b53cd959642a7a66e75a80e4c2539","url":"https://api.github.com/repos/php/php-src/commits/da9c8bdaeb2b53cd959642a7a66e75a80e4c2539","html_url":"https://github.com/php/php-src/commit/da9c8bdaeb2b53cd959642a7a66e75a80e4c2539"}]},{"sha":"2f404e73fc7bd8d7d112dfbc0df9eaedb832fd03","node_id":"C_kwDOAB0LotoAKDJmNDA0ZTczZmM3YmQ4ZDdkMTEyZGZiYzBkZjllYWVkYjgzMmZkMDM","commit":{"author":{"name":"Marc Bennewitz","email":"marc-mabe@users.noreply.github.com","date":"2026-11-02T15:32:07Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-02T15:32:07Z"},"message":"Fix ZEND_LONG_UINT_OVFL() accepting negative values on 32-bit platforms (#24778)\n\nWhere zend_long is not wider than an int, ZEND_LONG_UINT_OVFL() was\ndefined as 0, so a negative value passed the check there, while it is\nrejected where zend_long is wider. Keep checking the lower bound on these\nplatforms too.\n\nThis affects mbstring.regex_stack_limit, mbstring.regex_retry_limit and\nthe codepage of sapi_windows_cp_set() and sapi_windows_cp_conv().","tree":{"sha":"b0559045a88f1ea933c1d63e1cf6bd54ea115ffb","url":"https://api.github.com/repos/php/php-src/git/trees/b0559045a88f1ea933c1d63e1cf6bd54ea115ffb"},"url":"https://api.github.com/repos/php/php-src/git/commits/2f404e73fc7bd8d7d112dfbc0df9eaedb832fd03","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq6Kz3CRC1aQ7uu5UhlAAAscIQAFNfktPizYYw8EHwoPYkLXH1\n4RLc/qzkctBhATe1SQ55jxsv7UukRTUp/euIe15nj1ceGcodewndJqn1jPucH+rK\nMVJKmHiZqy2oaktqxR1Q5JkqmVaWizKk+dVkTpbRoyRYEIwF/5f4wZR4pMoS/FYT\nZMu9erLCCDVpWID7lswpNtua85Jw2x6UhUGHkGEGlaiszrwmd3jXfG12wvQIkXQw\nRduzC4bLB5DDJiRgTbqhljRmklm0YId6BXOFtGZoQS8JYfbpLbphsg4Pz6mjAoAW\nJ9TmTn35ZcIKzSS5EcC+uy3ICvT//faY33KEF+ZmR1BjecR3eL+Pka13fC4RMUsu\nflhbArfKvMP1vGoQ6bixZaJ2P2Uiriuue6JA6IP5WJxcX85dwkCdfCgT8GC0bHk4\nwATOB4bwwtQ97KkthXqEZd8XnJ9ITim2C18Adyl+jBC47wh5nuR7TPrVOgCUwzzH\n5ZbzdtsANVdggvlif5twYVUXmv3OzWYdjtitIwkr/Xe0sZG0b/CtpkACpByByIOe\nctoDrDpyyqzgz08zMQ4hXmVpii0DFexf2jVlfLo3QrRy2B+WURj+h7Hir9BNdAQW\nspLETEkO2Y5a0Dl4MH7iaqzVNJXUTe4bRm6SbY4ULo7YzEMLt4bHyAJTN9Qw3CLW\n4obqUejvi21QGxHiM1wz\n=rp2E\n-----END PGP SIGNATURE-----\n","payload":"tree b0559045a88f1ea933c1d63e1cf6bd54ea115ffb\nparent 2c4fdd71b3f94828402a7b90666357ce41090e3e\nauthor Marc Bennewitz <marc-mabe@users.noreply.github.com> 1793633527 +0100\ncommitter GitHub <noreply@github.com> 1793633527 +0100\n\nFix ZEND_LONG_UINT_OVFL() accepting negative values on 32-bit platforms (#24778)\n\nWhere zend_long is not wider than an int, ZEND_LONG_UINT_OVFL() was\ndefined as 0, so a negative value passed the check there, while it is\nrejected where zend_long is wider. Keep checking the lower bound on these\nplatforms too.\n\nThis affects mbstring.regex_stack_limit, mbstring.regex_retry_limit and\nthe codepage of sapi_windows_cp_set() and sapi_windows_cp_conv().","verified_at":"2026-11-02T15:32:08Z"}},"url":"https://api.github.com/repos/php/php-src/commits/2f404e73fc7bd8d7d112dfbc0df9eaedb832fd03","html_url":"https://github.com/php/php-src/commit/2f404e73fc7bd8d7d112dfbc0df9eaedb832fd03","comments_url":"https://api.github.com/repos/php/php-src/commits/2f404e73fc7bd8d7d112dfbc0df9eaedb832fd03/comments","author":{"login":"marc-mabe","id":302689,"node_id":"MDQ6VXNlcjMwMjY4OQ==","avatar_url":"https://avatars.githubusercontent.com/u/302689?v=4","gravatar_id":"","url":"https://api.github.com/users/marc-mabe","html_url":"https://github.com/marc-mabe","followers_url":"https://api.github.com/users/marc-mabe/followers","following_url":"https://api.github.com/users/marc-mabe/following{/other_user}","gists_url":"https://api.github.com/users/marc-mabe/gists{/gist_id}","starred_url":"https://api.github.com/users/marc-mabe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marc-mabe/subscriptions","organizations_url":"https://api.github.com/users/marc-mabe/orgs","repos_url":"https://api.github.com/users/marc-mabe/repos","events_url":"https://api.github.com/users/marc-mabe/events{/privacy}","received_events_url":"https://api.github.com/users/marc-mabe/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2c4fdd71b3f94828402a7b90666357ce41090e3e","url":"https://api.github.com/repos/php/php-src/commits/2c4fdd71b3f94828402a7b90666357ce41090e3e","html_url":"https://github.com/php/php-src/commit/2c4fdd71b3f94828402a7b90666357ce41090e3e"}]},{"sha":"19346fa2f5e135a5b78659