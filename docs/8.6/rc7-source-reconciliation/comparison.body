https://github.com/php/php-src/commit/5d0ccdb6f74df918ff1b2a58afc8ae64be468524"}]},{"sha":"fd996798308e5bfb8ed0b7a115924038f76b7687","node_id":"C_kwDOAB0LotoAKGZkOTk2Nzk4MzA4ZTViZmI4ZWQwYjdhMTE1OTI0MDM4Zjc2Yjc2ODc","commit":{"author":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-11-03T06:40:59Z"},"committer":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-11-03T06:46:06Z"},"message":"ext/openssl: Restore OpenSSL 4.x compatibility on PHP 8.4 (#25140)\n\nBackport OpenSSL 4 compatibility and the 4.1 ASN.1 API updates from\nPHP 8.6. Preserve raw common-name matching, keep the TLS and certificate\ntests compatible with OpenSSL 4, and cover binary SPKI challenges.\n\nCloses #25140\n\nCo-authored-by: Shivam Mathur <shivam_jpr@hotmail.com>\nCo-authored-by: Sam James <sam@gentoo.org>","tree":{"sha":"b82af1ee2fee74bab47b863db2707d28eaf2372b","url":"https://api.github.com/repos/php/php-src/git/trees/b82af1ee2fee74bab47b863db2707d28eaf2372b"},"url":"https://api.github.com/repos/php/php-src/git/commits/fd996798308e5bfb8ed0b7a115924038f76b7687","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQJPBAABCAA5FiEEaDXx4YiBo+JEKqlm6j2Y1d107h8FAmrpgy4bFIAAAAAABAAO\nbWFudTIsMi41KzEuMTIsMiwxAAoJEOo9mNXddO4fO0sP/3w+otPNTn3M9ba6oy3s\nvHAfVUVSDAMwZ1SgUaqZsaLj1KmjolXrjTFLb+coX2O7jDGCGgur9tBw8HugT7zW\n27Y+KU7hsR8o337JnO64gPvQXLaOVmddSJGCjnM+YyqbwFwLY/wP/shTiCIJi42F\nqu0YA1AMKSZlqe80twCHUelrgmIs0bByq8GJ9Yq1Fv/6c/L5morKJtvM8P3SJQPx\nofG+Y0Zing8nWVWUBLz89m/JiKyNecjNYTlV+8g3lPVTvEbesKmHEzIyDTbj2STQ\ntOvmQ3krmf3YTFJSas8Xg72Q53fVLFil2kVdHMWfJ2xE6MEKztqw89pEO7hbm6L3\nFxWhbEvBuI2r/sHHeN2AJx2FYI7YZ3i575bmwwU4azGFacmjGpGL63AWSp9iCMB6\n0jawLvdJ9jBGBUeyrSNyw6GEHKx9wDyOHUE2bZB7fTEmT6zSUcMTjhRB0xjfwnHJ\nClhX/s8qmdUsU2woKK5ukbA1UZToVZdU0gdfYg1FSMMzUx4H41hO6J7d2MAzHENM\nMAjf2NqYWK6PjYXg/lPz3TbD11P4Z6GhkHmQH+KHJrhY7oPNt/oJsvZa4fMAS7aY\nXyxv8/gUIo3X0HDZzY2d6je1qlO/94QJ1wItDDciEOni5CNHXikevU8twAkwLBUY\nwsPxuNfEX8U5pmOR8yuW3x