,"html_url":"https://github.com/php/php-src/commit/96cbae8f88e1d56bda11eaf2505564a0cedf45ec"},{"sha":"9ea04a23aafe1bc8100686d4704a238e76bdadd8","url":"https://api.github.com/repos/php/php-src/commits/9ea04a23aafe1bc8100686d4704a238e76bdadd8","html_url":"https://github.com/php/php-src/commit/9ea04a23aafe1bc8100686d4704a238e76bdadd8"}]},{"sha":"7091e5b029f24b7d091dee73432c2cca260a90fe","node_id":"C_kwDOAB0LotoAKDcwOTFlNWIwMjlmMjRiN2QwOTFkZWU3MzQzMmMyY2NhMjYwYTkwZmU","commit":{"author":{"name":"Kévin Dunglas","email":"kevin@dunglas.dev","date":"2026-11-01T16:35:44Z"},"committer":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-11-01T16:35:44Z"},"message":"Fix free of uninitialized date last_errors after a failed request startup (#25127)\n\nIn ZTS builds, date globals are allocated per thread, but last_errors\nwas only initialized in RINIT. If the first request fails before module\nactivation, the post-deactivate hook can free an uninitialized pointer.\nInitialize last_errors in GINIT alongside the other pointers.\n\nCloses #25127","tree":{"sha":"9a6991efbc9108887c78420a8eb9f438d69df3d4","url":"https://api.github.com/repos/php/php-src/git/trees/9a6991efbc9108887c78420a8eb9f438d69df3d4"},"url":"https://api.github.com/repos/php/php-src/git/commits/7091e5b029f24b7d091dee73432c2cca260a90fe","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/php/php-src/commits/7091e5b029f24b7d091dee73432c2cca260a90fe","html_url":"https://github.com/php/php-src/commit/7091e5b029f24b7d091dee73432c2cca260a90fe","comments_url":"https://api.github.com/repos/php/php-src/commits/7091e5b029f24b7d091dee73432c2cca260a90fe/comments","author":{"login":"dunglas","id":57224,"node_id":"MDQ6VXNlcjU3MjI0","avatar_url":"https://avatars.githubusercontent.com/u/57224?v=4","gravatar_id":"","url":"https://api.github.com/users/dunglas","html_url":"https://github.com/dunglas","followers_url":"htt