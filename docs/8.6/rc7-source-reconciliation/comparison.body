":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e229eeac907f40227587b281f8ba5c90302955fc","url":"https://api.github.com/repos/php/php-src/commits/e229eeac907f40227587b281f8ba5c90302955fc","html_url":"https://github.com/php/php-src/commit/e229eeac907f40227587b281f8ba5c90302955fc"},{"sha":"de12c867eb248ad4c48fa83a9daa6a78e92818e9","url":"https://api.github.com/repos/php/php-src/commits/de12c867eb248ad4c48fa83a9daa6a78e92818e9","html_url":"https://github.com/php/php-src/commit/de12c867eb248ad4c48fa83a9daa6a78e92818e9"}]},{"sha":"53681619e957d79c9770d7b2a9e0452c3bf16275","node_id":"C_kwDOAB0LotoAKDUzNjgxNjE5ZTk1N2Q3OWM5NzcwZDdiMmE5ZTA0NTJjM2JmMTYyNzU","commit":{"author":{"name":"David Carlier","email":"devnexen@gmail.com","date":"2026-11-03T19:26:35Z"},"committer":{"name":"David Carlier","email":"devnexen@gmail.com","date":"2026-11-03T19:26:35Z"},"message":"sapi/cli: php_cli_server_client_save_header() crash on repeated headers\n\nThe merged value was not marked persistent local, which tripped the\nZEND_RC_DEBUG assertions, and the second value leaked. Spellings differing\nonly by case also left headers_original_case pointing at the value freed by\nthe headers update. Each table now owns a reference to the value it holds.\n\nClose GH-25142","tree":{"sha":"e7084023c08bb288a736a19dc2c6c0c4aef5007c","url":"https://api.github.com/repos/php/php-src/git/trees/e7084023c08bb288a736a19dc2c6c0c4aef5007c"},"url":"https://api.github.com/repos/php/php-src/git/commits/53681619e957d79c9770d7b2a9e0452c3bf16275","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQGzBAABCgAdFiEE2uPA2CxuntXfTtGCHhkLTi6CjtcFAmrqNWsACgkQHhkLTi6C\njtcLjwv+PTu0MdZa6BfEVZ1VqZxUtqrdTQQyg5IAMlFg5LBbk4XWX8kLl6i4bHD6\nUHgTyraip1I3xeseGNeMS/fnYrb2e3OprMcVSnNV5Ss8A2uLO4G5X10iLYTmJ/sq\nBUfBGTxQyQhPhxFZQtjRO7CM4e8Efaqmjh5HhcYI9Ye/4DNxQ+aTOSyw3nZBxYOJ\n89SGxLgGV8RpY+1I0qfZwlara1esUx5qAQMlz1qvce3IFSKpmKd6STEDOYCnupo5\n133OJoXM/qAmJI6Qlnt2khljD0FezSMKytbgOtP/4pAcnYeR79IWGE+vDBrTAUf0\nPxCEm3xwyxS0YM6vPMfrnj1j0Pz/miTBM+R+rLnK5PCiFxIufxQM5KH6aXzNMMgk\nzJxN2p1ueVGEQJQRSmhABZZUQc9f+fVcZWF2O1LCUzEWRdWU7wdO5u71KqtcQlCx\nEcVrflSP+NypKYbGPoiHz2e6u4ZcKU49BKxikMSOT2M7mi3dh+a/ivLBu8U5Ct60\nvv0Sswtt\n=fv+W\n-----END PGP SIGNATURE-----","payload":"tree e7084023c08bb288a736a19dc2c6c0c4aef5007c\nparent 601e215ddc3f293feb1b86f6e6810d940737c5fb\nauthor David Carlier <devnexen@gmail.com> 1793733995 +0000\ncommitter David Carlier <devnexen@gmail.com> 1793733995 +0000\n\nsapi/cli: php_cli_server_client_save_header() crash on repeated headers\n\nThe merged value was not marked persistent local, which tripped the\nZEND_RC_DEBUG assertions, and the second value leaked. Spellings differing\nonly by case also left headers_original_case pointing at the value freed by\nthe headers update. Each table now owns a reference to the value it holds.\n\nClose GH-25142\n","verified_at":"2026-11-03T19:27:27Z"}},"url":"https://api.github.com/repos/php/php-src/commits/53681619e957d79c9770d7b2a9e0452c3bf16275","html_url":"https://github.com/php/php-src/commit/53681619e957d79c9770d7b2a9e0452c3bf16275","comments_url":"https://api.github.com/repos/php/p