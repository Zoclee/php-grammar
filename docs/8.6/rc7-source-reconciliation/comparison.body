hp-src/commit/d6bb264d4b46d3b86e73b9a096369616cc3421c3","comments_url":"https://api.github.com/repos/php/php-src/commits/d6bb264d4b46d3b86e73b9a096369616cc3421c3/comments","author":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users/bukka/following{/other_user}","gists_url":"https://api.github.com/users/bukka/gists{/gist_id}","starred_url":"https://api.github.com/users/bukka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bukka/subscriptions","organizations_url":"https://api.github.com/users/bukka/orgs","repos_url":"https://api.github.com/users/bukka/repos","events_url":"https://api.github.com/users/bukka/events{/privacy}","received_events_url":"https://api.github.com/users/bukka/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users/bukka/following{/other_user}","gists_url":"https://api.github.com/users/bukka/gists{/gist_id}","starred_url":"https://api.github.com/users/bukka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bukka/subscriptions","organizations_url":"https://api.github.com/users/bukka/orgs","repos_url":"https://api.github.com/users/bukka/repos","events_url":"https://api.github.com/users/bukka/events{/privacy}","received_events_url":"https://api.github.com/users/bukka/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7dc666cf4f3b7e790a0bb3948b7fac2400f6eb21","url":"https://api.github.com/repos/php/php-src/commits/7dc666cf4f3b7e790a0bb3948b7fac2400f6eb21","html_url":"https://github.com/php/php-src/commit/7dc666cf4f3b7e790a0bb3948b7fac2400f6eb21"},{"sha":"3323b8db05d51899069b7b715e10da6fc1da29d5","url":"https://api.github.com/repos/php/php-src/commits/3323b8db05d51899069b7b715e10da6fc1da29d5","html_url":"https://github.com/php/php-src/commit/3323b8db05d51899069b7b715e10da6fc1da29d5"}]},{"sha":"f752eddff8a46c2281bc8bae70ce3a83a5b38b4c","node_id":"C_kwDOAB0LotoAKGY3NTJlZGRmZjhhNDZjMjI4MWJjOGJhZTcwY2UzYTgzYTViMzhiNGM","commit":{"author":{"name":"David Carlier","email":"devnexen@gmail.com","date":"2026-10-30T12:07:42Z"},"committer":{"name":"David Carlier","email":"devnexen@gmail.com","date":"2026-10-30T12:07:42Z"},"message":"Fix GH-21768: Reflection assertion failure on internal virtual properties\n\nReflectionProperty::isReadable() and isWritable() asserted prop->hooks\nbeing set whenever ZEND_ACC_VIRTUAL is set. Internal classes such as\nDOMDocument declare virtual properties backed by the object read/write\nhandlers without hooks, tripping the assertion. Virtual properties that\nalso carry ZEND_ACC_READONLY are reported as not writable.\n\nAssertion introduced in e4f727d61eb.\n\nClose GH-21769","tree":{"sha":"95fb21d8df1a38d911ecd245076ebaf31dc9cd1a","url":"https://api.github.com/repos/php/php-src/git/trees/95fb21d8df1a38d911ecd245076ebaf31dc9cd1a"},"url":"https://api.github.com/repos/php/php-src/git/commits/f752eddff8a46c2281bc8bae70ce3a83a5b38b4c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQGzBAABCgAdFiEE2uPA2CxuntXfTtGCHhkLTi6CjtcFAmrkiI4ACgkQHhkLTi6C\njteiYAv+Mj0r5dBjNzC6maj63c7DCt6poZpTGzIe6CakoNL91Z1eeMAI3NUuwUif\nQrN1DzB7c98ztme/wHQel4HhqXpHA/uRPOUsEKekAu348oCnuB2QggJ30QRYzl5C\nR+DGeCn84812sykZQTTCNuv2gdaSI4umtXPBJ8rSegTkaQ7BAFQPDq50BZqBFRab\n/2jBod8NJAqwbg1p/6XpJct+Fjyc6pfdZNeqI8ytL9pqRyd6tDXuANha4vWDcrqx\n5ZVQgXFKxTLgvTn/cCwbmvPpyDA+qRpRM/N4Ct8QcXOctrCZHWziMi15BwdiZp/G\nc95SN+3+Qk1PrkTFfsuzV8aE787mUZXp63aXyah2raltgly9K1R4gO4NOy4R7pC0\nHrug52s0vV0YV/97QsBhICR0mtv9BC3E+CZ+lcO7cVuuyYHD9rCXkIOTWgZNCvqN\n5pkaPXMQzC6/7pQP+jUtMFQqK7Z2n10urBt6igGEVx+6eOJo3ATnWRdhHjugv4MS\nAop7ic4Z\n=HPQY\n-----END PGP SIGNATURE-----","payload":"tree 95fb21d8df1a38d911ecd245076ebaf31dc9cd1a\nparent d6bb264d4b46d3b86e73b9a096369616cc3421c3\nauthor David Carlier <devnexen@gmail.com> 1793362062 +0000\ncommitter David Carlier <devnexen@gmail.com> 1793362062 +0000\n\nFix GH-21768: Reflection assertion failure on internal virtual properties\n\nReflectionProperty::isReadable() and isWritable() asserted prop->hooks\nbeing set whenever ZEND_ACC_VIRTUAL is set. Internal classes such as\nDOMDocument declare virtual properties backed by the object read/write\nhandlers without hooks, tripping the assertion. Virtual properties that\nalso carry ZEND_ACC_READONLY are reported as not writable.\n\nAssertion introduced in e4f727d61eb.\n\nClose GH-21769\n","verified_at":"2026-10-30T12:09:43Z"}},"url":"https://api.github.com/repos/php/php-src/commits/f752eddff8a46c2281bc8bae70ce3a83a5b38b4c","html_url":"https://github.com/php/php-src/commit/f752eddff8a46c2281bc8bae70ce3a83a5b38b4c","comments_url":"https://api.github.com/repos/php/php-src/commits/f752eddff8a46c2281bc8bae70ce3a83a5b38b4c/comments","author":{"login":"devnexen","id":4922778,"node_id":"MDQ6VXNlcjQ5MjI3Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/4922778?v=4","gravatar_id":"","url":"https://api.github.com/users/devnexen","html_url":"https://github.com/devnexen","followers_url":"https://api.github.com/users/devnexen/followers","following_url":"https://api.github.com/users/devnexen/following{/other_user}","gists_url":"https://api.github.com/users/devnexen/gists{/gist_id}","starred_url":"https://api.github.com/users/devnexen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/devnexen/subscriptions","organizations_u