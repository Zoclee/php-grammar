\t\t\tgoto cleanup;\n \t\t\t}\n \t\t\tsmart_str_appends(&querystr, tmp);\n@@ -5645,7 +5645,7 @@ PHP_PGSQL_API zend_result php_pgsql_insert(PGconn *pg_link, const zend_string *t\n \t\t\t\t\tchar *tmp = safe_emalloc(Z_STRLEN_P(val), 2, 1);\n \t\t\t\t\tsize_t new_len = PQescapeStringConn(pg_link, tmp, Z_STRVAL_P(val), Z_STRLEN_P(val), &error);\n \t\t\t\t\tif (error) {\n-\t\t\t\t\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to escape field '%s' value\", ZSTR_VAL(fld));\n+\t\t\t\t\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to escape field '%pS' value\", fld);\n \t\t\t\t\t\tefree(tmp);\n \t\t\t\t\t\tgoto cleanup;\n \t\t\t\t\t}\n@@ -5807,7 +5807,7 @@ static inline int build_assignment_string(PGconn *pg_link, smart_str *querystr,\n \t\tif (opt & PGSQL_DML_ESCAPE) {\n \t\t\tchar *tmp = PQescapeIdentifier(pg_link, ZSTR_VAL(fld), ZSTR_LEN(fld));\n \t\t\tif (tmp == NULL) {\n-\t\t\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to escape field '%s'\", ZSTR_VAL(fld));\n+\t\t\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to escape field '%pS'\", fld);\n \t\t\t\treturn -1;\n \t\t\t}\n \t\t\tsmart_str_appends(querystr, tmp);\n@@ -5829,7 +5829,7 @@ static inline int build_assignment_string(PGconn *pg_link, smart_str *querystr,\n \t\t\t\t\tchar *tmp = (char *)safe_emalloc(Z_STRLEN_P(val), 2, 1);\n \t\t\t\t\tsize_t new_len = PQescapeStringConn(pg_link, tmp, Z_STRVAL_P(val), Z_STRLEN_P(val), &error);\n \t\t\t\t\tif (error) {\n-\t\t\t\t\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to escape field '%s' value\", ZSTR_VAL(fld));\n+\t\t\t\t\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to escape field '%pS' value\", fld);\n \t\t\t\t\t\tefree(tmp);\n \t\t\t\t\t\treturn -1;\n \t\t\t\t\t}\n@@ -6173,7 +6173,7 @@ PHP_PGSQL_API zend_result php_pgsql_select(PGconn *pg_link, const zend_string *t\n \t\tphp_pgsql_result2array(pg_result, ret_array, result_type);\n \t\tret = SUCCESS;\n \t} else {\n-\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to execute '%s'\", ZSTR_VAL(querystr.s));\n+\t\tphp_error_docref(NULL, E_NOTICE, \"Failed to execute '%pS'\", querystr.s);\n \t}\n \tPQclear(pg_result);\n "},{"sha":"9d3bd842cb72c63adf149ffb7beee6bbf9959100","filename":"ext/phar/phar_object.c","status":"modified","additions":60,"deletions":5,"changes":65,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Fphar_object.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Fphar_object.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Fphar_object.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -766,7 +766,7 @@ PHP_METHOD(Phar, webPhar)\n \t\t\tsapi_header_op(SAPI_HEADER_REPLACE, &ctr);\n \n \t\t\tif (not_cgi) {\n-\t\t\t\ttmp = strstr(path_info, basename) + fname_len;\n+\t\t\t\ttmp = strstr(path_info, basename) + (fname_len - (basename - fname));\n \t\t\t\tsa = *tmp;\n \t\t\t\t*tmp = '\\0';\n \t\t\t}\n@@ -3095,7 +3095,7 @@ static int phar_set_compression(zval *zv, void *argument) /* {{{ */\n \tphar_entry_info *entry = (phar_entry_info *)Z_PTR_P(zv);\n \tuint32_t compress = *(uint32_t *)argument;\n \n-\tif (entry->is_deleted) {\n+\tif (entry->is_deleted || (entry->flags & PHAR_ENT_COMPRESSION_MASK) == compress) {\n \t\treturn ZEND_HASH_APPLY_KEEP;\n \t}\n \n@@ -3107,6 +3107,30 @@ static int phar_set_compression(zval *zv, void *argument) /* {{{ */\n }\n /* }}} */\n \n+typedef struct {\n+\tuint32_t compress;\n+\tchar *error;\n+} phar_compression_args;\n+\n+static int phar_decompress_for_compression_change(zval *zv, void *argument) /* {{{ */\n+{\n+\tphar_entry_info *entry = (phar_entry_info *)Z_PTR_P(zv);\n+\tphar_compression_args *args = (phar_compression_args *)argument;\n+\tuint32_t current = entry->flags & PHAR_ENT_COMPRESSION_MASK;\n+\n+\tif (entry->is_deleted || entry->is_dir || !current || current == args->compress) {\n+\t\treturn ZEND_HASH_APPLY_KEEP;\n+\t}\n+\n+\t/* phar_flush() would otherwise copy the old compressed bytes as the new contents */\n+\tif (FAILURE == phar_open_entry_fp(entry, &args->error, 0)) {\n+\t\treturn ZEND_HASH_APPLY_STOP;\n+\t}\n+\n+\treturn ZEND_HASH_APPLY_KEEP;\n+}\n+/* }}} */\n+\n static int phar_test_compression(zval *zv, void *argument) /* {{{ */\n {\n \tconst phar_entry_info *entry = Z_PTR_P(zv);\n@@ -3133,9 +3157,18 @@ static int phar_test_compression(zval *zv, void *argument) /* {{{ */\n }\n /* }}} */\n \n-static void pharobj_set_compression(HashTable *manifest, uint32_t compress) /* {{{ */\n+static zend_result pharobj_set_compression(HashTable *manifest, uint32_t compress, char **error) /* {{{ */\n {\n+\tphar_compression_args args = { .compress = compress, .error = NULL };\n+\n+\tzend_hash_apply_with_argument(manifest, phar_decompress_for_compression_change, &args);\n+\tif (args.error) {\n+\t\t*error = args.error;\n+\t\treturn FAILURE;\n+\t}\n+\n \tzend_hash_apply_with_argument(manifest, phar_set_compression, &compress);\n+\treturn SUCCESS;\n }\n /* }}} */\n \n@@ -3326,7 +3359,11 @@ PHP_METHOD(Phar, compressFiles)\n \t\tzend_throw_exception_ex(phar_ce_PharException, 0, \"phar \\\"%pS\\\" is persistent, unable to copy on write\", phar_obj->archive->fname);\n \t\tRETURN_THROWS();\n \t}\n-\tpharobj_set_compression(&phar_obj->archive->manifest, flags);\n+\tif (FAILURE == pharobj_set_compression(&phar_obj->archive->manifest, flags, &error)) {\n+\t\tzend_throw_exception_ex(spl_ce_BadMethodCallException, 0, \"%s\", error);\n+\t\tefree(error);\n+\t\tRETURN_THROWS();\n+\t}\n \tphar_obj->archive->is_modified = 1;\n \tphar_flush(phar_obj->archive, &error);\n \n@@ -3365,7 +3402,11 @@ PHP_METHOD(Phar, decompressFiles)\n \t\t\tzend_throw_exception_ex(phar_ce_PharException, 0, \"phar \\\"%pS\\\" is persistent, unable to copy on write\", phar_obj->archive->fname);\n \t\t\tRETURN_THROWS();\n \t\t}\n-\t\tpharobj_set_compression(&phar_obj->archive->manifest, PHAR_ENT_COMPRESSED_NONE);\n+\t\tif (FAILURE == pharobj_set_compression(&phar_obj->archive->manifest, PHAR_ENT_COMPRESSED_NONE, &error)) {\n+\t\t\tzend_throw_exception_ex(spl_ce_BadMethodCallException, 0, \"%s\", error);\n+\t\t\tefree(error);\n+\t\t\tRETURN_THROWS();\n+\t\t}\n \t}\n \n \tphar_obj->archive->is_modified = 1;\n@@ -3453,9 +3494,23 @@ PHP_METHOD(Phar, copy)\n \tnewentry.filename = zend_string_copy(new_file);\n \tnewentry.fp_refcount = 0;\n \n+\tif (newentry.symlink) {\n+\t\tnewentry.symlink = zend_string_copy(newentry.symlink);\n+\t}\n+\n+\tif (newentry.tmp) {\n+\t\tnewentry.tmp = estrdup(newentry.tmp);\n+\t}\n+\n \tif (oldentry->fp_type != PHAR_FP) {\n \t\tif (FAILURE == phar_copy_entry_fp(oldentry, &newentry, &error)) {\n \t\t\tzend_string_release(newentry.filename);\n+\t\t\tif (newentry.symlink) {\n+\t\t\t\tzend_string_release(newentry.symlink);\n+\t\t\t}\n+\t\t\tif (newentry.tmp) {\n+\t\t\t\tefree(newentry.tmp);\n+\t\t\t}\n \t\t\tphp_stream_close(newentry.fp);\n \t\t\tzend_throw_exception_ex(phar_ce_PharException, 0, \"%s\", error);\n \t\t\tefree(error);"},{"sha":"86ec22e719fe89dc01a5a1cdb807f54e4f4fe2f4","filename":"ext/phar/stream.c","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Fstream.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Fstream.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Fstream.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -865,6 +865,11 @@ static int phar_wrapper_rename(php_stream_wrapper *wrapper, const char *url_from\n \t\t\t\turl_from, url_to);\n \t\t\treturn 0;\n \t\t}\n+\t\tif (zend_string_equals(resource_from->path, resource_to->path)) {\n+\t\t\tphp_url_free(resource_from);\n+\t\t\tphp_url_free(resource_to);\n+\t\t\treturn 1;\n+\t\t}\n \t\t/* transfer all data over to the new entry */\n \t\tmemcpy((void *) &new, (void *) entry, sizeof(phar_entry_info));\n \t\t/* mark the old one for deletion */\n@@ -873,6 +878,7 @@ static int phar_wrapper_rename(php_stream_wrapper *wrapper, const char *url_from\n \t\tZVAL_UNDEF(&entry->metadata_tracker.val);\n \t\tentry->symlink = NULL;\n \t\tentry->tmp = NULL;\n+\t\tentry->metadata_tracker.str = NULL;\n \t\tsource = entry;\n \n \t\t/* add to the manifest, and then store the pointer to the new guy in entry"},{"sha":"ae1a6e46c0961882f4aca48986cd5bedb96f17d5","filename":"ext/phar/tar.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftar.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftar.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftar.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -602,7 +602,7 @@ zend_result phar_parse_tarfile(\n \t\t}\n \n \t\tif (zend_string_starts_with_literal(entry.filename, \".phar/.metadata\")) {\n-\t\t\tif (FAILURE == phar_tar_process_metadata(newentry, fp)) {\n+\t\t\tif (size > totalsize || FAILURE == phar_tar_process_metadata(newentry, fp)) {\n \t\t\t\tif (error) {\n \t\t\t\t\tspprintf(error, 4096, \"phar error: tar-based phar \\\"%s\\\" has invalid metadata in magic file \\\"%s\\\"\", fname, ZSTR_VAL(entry.filename));\n \t\t\t\t}"},{"sha":"315705781647818f5cbbb2377d1f1db8795a4562","filename":"ext/phar/tests/buildFromIterator_user_overrides/getMTime_negative.phpt","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2FbuildFromIterator_user_overrides%2FgetMTime_negative.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2FbuildFromIterator_user_overrides%2FgetMTime_negative.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2FbuildFromIterator_user_overrides%2FgetMTime_negative.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,53 @@\n+--TEST--\n+buildFromIterator with user overrides - negative getMTime()\n+--EXTENSIONS--\n+phar\n+--INI--\n+phar.readonly=0\n+phar.require_hash=0\n+--FILE--\n+<?php\n+\n+class MySplFileInfo extends SplFileInfo {\n+    public function getMTime(): int|false {\n+        echo \"[MTime]\\n\";\n+        return -1;\n+    }\n+}\n+\n+class MyIterator extends RecursiveDirectoryIterator {\n+    public function current(): SplFileInfo {\n+        return new MySplFileInfo(parent::current()->getPathname());\n+    }\n+}\n+\n+$workdir = __DIR__.'/getMTime_negative';\n+mkdir($workdir . '/content', recursive: true);\n+file_put_contents($workdir . '/content/hello.txt', \"Hello world.\");\n+\n+try {\n+    $phar = new \\Phar($workdir . \"/test.phar\");\n+    $phar->startBuffering();\n+    $phar->buildFromIterator(\n+        new RecursiveIteratorIterator(\n+            new MyIterator($workdir . '/content', FilesystemIterator::SKIP_DOTS)\n+        ),\n+        $workdir\n+    );\n+    $phar->stopBuffering();\n+} catch (Throwable $e) {\n+    echo $e::class, ': ', $e->getMessage(), \"\\n\";\n+}\n+\n+?>\n+--CLEAN--\n+<?php\n+$workdir = __DIR__.'/getMTime_negative';\n+@unlink($workdir . '/content/hello.txt');\n+@unlink($workdir . '/test.phar');\n+@rmdir($workdir . '/content');\n+@rmdir($workdir);\n+?>\n+--EXPECTF--\n+[MTime]\n+BadMethodCallException: Entry content%chello.txt cannot be created: timestamp is limited to 32-bit"},{"sha":"4860e5abfe5e4974205407feb0dc8ebf3bccf891","filename":"ext/phar/tests/gh25090.phpt","status":"added","additions":25,"deletions":0,"changes":25,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25090.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25090.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fgh25090.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,25 @@\n+--TEST--\n+GH-25090 (Use-after-free in phar_wrapper_rename() with entry metadata)\n+--EXTENSIONS--\n+phar\n+--INI--\n+phar.readonly=0\n+--FILE--\n+<?php\n+$fname = __DIR__ . '/gh25090.phar';\n+$phar = new Phar($fname);\n+$phar['a'] = 'x';\n+$phar['a']->setMetadata(['k' => 'v']);\n+rename('phar://' . $fname . '/a', 'phar://' . $fname . '/b');\n+$phar['c'] = 'y';\n+var_dump($phar['b']->getMetadata());\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh25090.phar');\n+?>\n+--EXPECT--\n+array(1) {\n+  [\"k\"]=>\n+  string(1) \"v\"\n+}"},{"sha":"3df6c7940ebaad2c32955d9c4f57b1f2a5e1d8a2","filename":"ext/phar/tests/gh25091.phpt","status":"added","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25091.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25091.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fgh25091.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,24 @@\n+--TEST--\n+GH-25091: Use-after-free in rename() when source and destination are the same entry\n+--EXTENSIONS--\n+phar\n+--INI--\n+phar.readonly=0\n+--FILE--\n+<?php\n+$fname = __DIR__ . '/gh25091.phar';\n+\n+$phar = new Phar($fname);\n+$phar['a'] = 'contents';\n+unset($phar);\n+\n+var_dump(rename('phar://' . $fname . '/a', 'phar://' . $fname . '/a'));\n+var_dump(file_get_contents('phar://' . $fname . '/a'));\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh25091.phar');\n+?>\n+--EXPECT--\n+bool(true)\n+string(8) \"contents\""},{"sha":"604094d76362f66a1cd37abb5d51836f9209d652","filename":"ext/phar/tests/gh25092.phpt","status":"added","additions":62,"deletions":0,"changes":62,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25092.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25092.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fgh25092.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,62 @@\n+--TEST--\n+GH-25092 (Double free in Phar::copy() on link and mounted entries)\n+--EXTENSIONS--\n+phar\n+--INI--\n+phar.readonly=0\n+--FILE--\n+<?php\n+function tar_symlink($name, $target) {\n+    $h  = str_pad($name, 100, \"\\0\");\n+    $h .= \"0000777\\0\";\n+    $h .= \"0000000\\0\";\n+    $h .= \"0000000\\0\";\n+    $h .= \"00000000000\\0\";\n+    $h .= \"00000000000\\0\";\n+    $h .= str_repeat(' ', 8);\n+    $h .= '2';\n+    $h .= str_pad($target, 100, \"\\0\");\n+    $h .= \"ustar\\0\" . \"00\";\n+    $h  = str_pad($h, 512, \"\\0\");\n+\n+    $sum = 0;\n+    for ($i = 0; $i < 512; $i++) {\n+        $sum += ord($h[$i]);\n+    }\n+    return substr_replace($h, sprintf(\"%06o\\0 \", $sum), 148, 8);\n+}\n+\n+$tar = __DIR__ . '/gh25092.tar';\n+file_put_contents($tar, tar_symlink('l', 'a') . str_repeat(\"\\0\", 1024));\n+\n+$t = new PharData($tar);\n+$t->copy('l', 'l2');\n+unset($t);\n+\n+$t = new PharData($tar);\n+var_dump(isset($t['l']), isset($t['l2']));\n+unset($t);\n+\n+$phar = __DIR__ . '/gh25092.phar';\n+file_put_contents(__DIR__ . '/gh25092.txt', 'hello');\n+\n+$p = new Phar($phar);\n+$p->addFromString('x.txt', 'x');\n+$p->setStub('<?php __HALT_COMPILER(); ?>');\n+unset($p);\n+\n+$p = new Phar($phar);\n+Phar::mount('phar://' . $phar . '/m.txt', __DIR__ . '/gh25092.txt');\n+$p->copy('m.txt', 'c.txt');\n+var_dump(isset($p['c.txt']));\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh25092.tar');\n+@unlink(__DIR__ . '/gh25092.phar');\n+@unlink(__DIR__ . '/gh25092.txt');\n+?>\n+--EXPECT--\n+bool(true)\n+bool(true)\n+bool(true)"},{"sha":"442a95e63c7a5300d771e48187d0e244974a917f","filename":"ext/phar/tests/gh25093.phpt","status":"added","additions":47,"deletions":0,"changes":47,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25093.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh25093.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fgh25093.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,47 @@\n+--TEST--\n+GH-25093: Phar::webPhar() redirect reads past the request URI\n+--EXTENSIONS--\n+phar\n+--SKIPIF--\n+<?php\n+if (!file_exists(__DIR__ . \"/../../../sapi/cli/tests/php_cli_server.inc\")) {\n+    echo \"skip sapi/cli/tests/php_cli_server.inc required but not found\";\n+}\n+?>\n+--CONFLICTS--\n+server\n+--INI--\n+phar.readonly=0\n+phar.require_hash=0\n+--FILE--\n+<?php\n+include __DIR__ . \"/../../../sapi/cli/tests/php_cli_server.inc\";\n+\n+$args = [\"-d\", \"extension_dir=\" . ini_get(\"extension_dir\"), \"-d\", \"extension=\" . (substr(PHP_OS, 0, 3) == \"WIN\" ? \"php_\" : \"\") . \"phar.\" . PHP_SHLIB_SUFFIX];\n+if (php_ini_loaded_file()) {\n+  $args[] = \"-c\";\n+  $args[] = php_ini_loaded_file();\n+}\n+$info = php_cli_server_start('include __DIR__ . \"/gh25093.phar\";', 'router.php', $args);\n+\n+$phar = new Phar($info->docRoot . '/gh25093.phar');\n+$phar->addFromString('index.php', '<?php echo \"index\\n\";');\n+$phar->setStub('<?php\n+Phar::webPhar(null, \"index.php\", null, [], function ($path) {\n+    return \"/\";\n+});\n+__HALT_COMPILER(); ?>');\n+unset($phar);\n+\n+$context = stream_context_create(['http' => ['follow_location' => 0]]);\n+$uri = '/gh25093.phar/' . str_repeat('a', strlen($info->docRoot) + 32);\n+file_get_contents('http://' . PHP_CLI_SERVER_ADDRESS . $uri, false, $context);\n+\n+foreach (http_get_last_response_headers() as $header) {\n+    if (str_starts_with($header, 'Location: ')) {\n+        echo $header, \"\\n\";\n+    }\n+}\n+?>\n+--EXPECT--\n+Location: /gh25093.phar/index.php"},{"sha":"ca34dca256ccacdc48b45312fd737ad86eae5ccc","filename":"ext/phar/tests/gh8469.phpt","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh8469.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fgh8469.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fgh8469.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,59 @@\n+--TEST--\n+GH-8469 (Phar::decompressFiles() and Phar::compressFiles() keep the old compressed contents)\n+--EXTENSIONS--\n+phar\n+zlib\n+bz2\n+--INI--\n+phar.require_hash=0\n+phar.readonly=0\n+--FILE--\n+<?php\n+$contents = str_repeat('four score and seven years ago ', 10);\n+\n+foreach (['phar', 'phar.zip'] as $ext) {\n+    $fname = __DIR__ . \"/gh8469.$ext\";\n+    $phar = new Phar($fname);\n+    $phar['a.txt'] = $contents;\n+    $phar['b.txt'] = 'our fathers';\n+    $phar->addEmptyDir('dir');\n+\n+    $phar->compressFiles(Phar::GZ);\n+    $phar->compressFiles(Phar::BZ2);\n+    var_dump($phar['a.txt']->isCompressed(Phar::BZ2));\n+    var_dump($phar['a.txt']->getContent() === $contents);\n+\n+    var_dump($phar->decompressFiles());\n+    var_dump($phar['a.txt']->isCompressed());\n+    var_dump($phar['a.txt']->getContent() === $contents);\n+    var_dump($phar['b.txt']->getContent());\n+    unset($phar);\n+\n+    $phar = new Phar($fname);\n+    var_dump($phar['a.txt']->getContent() === $contents);\n+    var_dump(file_get_contents(\"phar://$fname/b.txt\"));\n+    unset($phar);\n+}\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh8469.phar');\n+@unlink(__DIR__ . '/gh8469.phar.zip');\n+?>\n+--EXPECT--\n+bool(true)\n+bool(true)\n+bool(true)\n+bool(false)\n+bool(true)\n+string(11) \"our fathers\"\n+bool(true)\n+string(11) \"our fathers\"\n+bool(true)\n+bool(true)\n+bool(true)\n+bool(false)\n+bool(true)\n+string(11) \"our fathers\"\n+bool(true)\n+string(11) \"our fathers\""},{"sha":"e42a38567d109355251b9f6a7d9183c108a3ff95","filename":"ext/phar/tests/tar/gh24740.phpt","status":"added","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Ftar%2Fgh24740.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Ftar%2Fgh24740.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Ftar%2Fgh24740.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,44 @@\n+--TEST--\n+GH-24740 (Unbounded size of .phar/.metadata* entry in TAR phar)\n+--EXTENSIONS--\n+phar\n+--INI--\n+memory_limit=16M\n+--FILE--\n+<?php\n+function tar_header(string $name, int $size): string\n+{\n+    $header = str_repeat(\"\\0\", 512);\n+    $header = substr_replace($header, $name, 0, strlen($name));\n+    $header = substr_replace($header, sprintf(\"%07o\\0\", 0644), 100, 8);\n+    $header = substr_replace($header, sprintf(\"%07o\\0\", 0), 108, 8);\n+    $header = substr_replace($header, sprintf(\"%07o\\0\", 0), 116, 8);\n+    $header = substr_replace($header, sprintf(\"%011o\\0\", $size), 124, 12);\n+    $header = substr_replace($header, sprintf(\"%011o\\0\", 1700000000), 136, 12);\n+    $header[156] = '0';\n+    $header = substr_replace($header, \"ustar\\0\", 257, 6);\n+    $header = substr_replace($header, \"00\", 263, 2);\n+\n+    $checksum = 0;\n+    for ($i = 0; $i < 512; $i++) {\n+        $checksum += ($i >= 148 && $i < 156) ? 0x20 : ord($header[$i]);\n+    }\n+\n+    return substr_replace($header, sprintf(\"%06o\\0 \", $checksum), 148, 8);\n+}\n+\n+$fname = __DIR__ . '/gh24740.tar';\n+file_put_contents($fname, tar_header('.phar/.metadata.bin', 0x7FFFFE00) . str_repeat(\"\\0\", 1024));\n+\n+try {\n+    new PharData($fname);\n+} catch (UnexpectedValueException $e) {\n+    echo $e->getMessage(), \"\\n\";\n+}\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh24740.tar');\n+?>\n+--EXPECTF--\n+phar error: tar-based phar \"%sgh24740.tar\" has invalid metadata in magic file \".phar/.metadata.bin\""},{"sha":"44f9e17360608d2247413c84114d4da65aec6b7a","filename":"ext/phar/tests/zip/gh24531.phpt","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fzip%2Fgh24531.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fzip%2Fgh24531.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fzip%2Fgh24531.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,32 @@\n+--TEST--\n+GH-24531 (NULL pointer dereference when flushing a zip-based phar whose file was renamed)\n+--EXTENSIONS--\n+phar\n+--INI--\n+phar.readonly=0\n+phar.require_hash=0\n+--FILE--\n+<?php\n+$source = __DIR__ . '/gh24531.phar.zip';\n+$target = __DIR__ . '/gh24531-renamed.phar.zip';\n+\n+$phar = new Phar($source);\n+$phar->addFromString('first', 'first');\n+unset($phar);\n+\n+rename($source, $target);\n+\n+try {\n+    $phar = new Phar($source);\n+    $phar->addFromString('second', 'second');\n+} catch (PharException $e) {\n+    echo $e::class, \": \", $e->getMessage(), PHP_EOL;\n+}\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh24531.phar.zip');\n+@unlink(__DIR__ . '/gh24531-renamed.phar.zip');\n+?>\n+--EXPECTF--\n+PharException: phar zip flush of \"%sgh24531.phar.zip\" failed: unable to copy contents of file \"first\" while creating zip-based phar \"%sgh24531.phar.zip\""},{"sha":"ec68c035f0c4c0f513c23bb0aded88593a258cfd","filename":"ext/phar/tests/zip/gh25089.phpt","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fzip%2Fgh25089.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Ftests%2Fzip%2Fgh25089.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Ftests%2Fzip%2Fgh25089.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,35 @@\n+--TEST--\n+GH-25089 (Heap buffer over-read via crafted alias size in zip-based phar)\n+--EXTENSIONS--\n+phar\n+zlib\n+--FILE--\n+<?php\n+$name = '.phar/alias.txt';\n+$alias = 'ABCD';\n+$data = gzdeflate($alias);\n+$crc = crc32($alias);\n+$claimed = 0x1000;\n+\n+$local = \"PK\\x03\\x04\"\n+    . pack('vvvvvVVVvv', 20, 0, 8, 0, 0,\n+        $crc, strlen($data), $claimed, strlen($name), 0)\n+    . $name . $data;\n+$central = \"PK\\x01\\x02\"\n+    . pack('vvvvvvVVVvvvvvVV', 20, 20, 0, 8, 0, 0,\n+        $crc, strlen($data), $claimed, strlen($name), 0, 0, 0, 0, 0, 0)\n+    . $name;\n+$end = \"PK\\x05\\x06\"\n+    . pack('vvvvVVv', 0, 0, 1, 1, strlen($central), strlen($local), 0);\n+\n+file_put_contents(__DIR__ . '/gh25089.zip', $local . $central . $end);\n+\n+$phar = new PharData(__DIR__ . '/gh25089.zip');\n+var_dump($phar->getAlias());\n+?>\n+--CLEAN--\n+<?php\n+@unlink(__DIR__ . '/gh25089.zip');\n+?>\n+--EXPECT--\n+string(4) \"ABCD\""},{"sha":"13c34d8a3b0f84513aa62fa7b288e8f1663dbe04","filename":"ext/phar/zip.c","status":"modified","additions":3,"deletions":2,"changes":5,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Fzip.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fphar%2Fzip.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fphar%2Fzip.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -645,7 +645,6 @@ zend_result phar_parse_zipfile(\n \t\t\tzend_off_t restore_pos = php_stream_tell(fp);\n \t\t\tphp_stream_seek(fp, entry.offset, SEEK_SET);\n \n-\t\t\tmydata->alias_len = entry.uncompressed_filesize;\n \t\t\tif (entry.flags & PHAR_ENT_COMPRESSED_GZ) {\n \t\t\t\tfilter = php_stream_filter_create(\"zlib.inflate\", NULL, php_stream_is_persistent(fp));\n \n@@ -732,6 +731,8 @@ zend_result phar_parse_zipfile(\n \t\t\t\t}\n \t\t\t}\n \n+\t\t\tmydata->alias_len = entry.uncompressed_filesize;\n+\n \t\t\t/* return to central directory parsing */\n \t\t\tphp_stream_seek(fp, restore_pos, SEEK_SET);\n \t\t}\n@@ -1151,7 +1152,7 @@ static int phar_zip_changed_apply_int(phar_entry_info *entry, void *arg) /* {{{\n \t\t\t}\n \t\t}\n \n-\t\tif (!entry->is_dir && entry->compressed_filesize && SUCCESS != php_stream_copy_to_stream_ex(p->old, p->filefp, entry->compressed_filesize, NULL)) {\n+\t\tif (!entry->is_dir && entry->compressed_filesize && (!p->old || SUCCESS != php_stream_copy_to_stream_ex(p->old, p->filefp, entry->compressed_filesize, NULL))) {\n \t\t\tspprintf(p->error, 0, \"unable to copy contents of file \\\"%s\\\" while creating zip-based phar \\\"%s\\\"\", ZSTR_VAL(entry->filename), ZSTR_VAL(entry->phar->fname));\n \t\t\treturn ZEND_HASH_APPLY_STOP;\n \t\t}"},{"sha":"b7c0a3b416a2947d4a3d2cb9a467f683e512345e","filename":"ext/random/tests/03_randomizer/methods/shuffleArray_engine_throws_with_holes.phpt","status":"added","additions":61,"deletions":0,"changes":61,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Frandom%2Ftests%2F03_randomizer%2Fmethods%2FshuffleArray_engine_throws_with_holes.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Frandom%2Ftests%2F03_randomizer%2Fmethods%2FshuffleArray_engine_throws_with_holes.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Frandom%2Ftests%2F03_randomizer%2Fmethods%2FshuffleArray_engine_throws_with_holes.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,61 @@\n+--TEST--\n+Random: Randomizer: shuffleArray(): Engine throwing on an array with holes\n+--FILE--\n+<?php\n+\n+use Random\\Engine;\n+use Random\\Randomizer;\n+\n+final class ThrowingEngine implements Engine\n+{\n+    public function __construct(private int $calls) {}\n+\n+    public function generate(): string\n+    {\n+        if ($this->calls-- <= 0) {\n+            throw new Exception('Error');\n+        }\n+\n+        return \"\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\";\n+    }\n+}\n+\n+foreach ([0, 1] as $calls) {\n+    $array = [new stdClass, new stdClass, new stdClass, new stdClass];\n+    unset($array[1]);\n+\n+    try {\n+        (new Randomizer(new ThrowingEngine($calls)))->shuffleArray($array);\n+    } catch (Exception $e) {\n+        echo $e->getMessage(), PHP_EOL;\n+    }\n+\n+    var_dump($array);\n+}\n+\n+?>\n+--EXPECTF--\n+Error\n+array(3) {\n+  [0]=>\n+  object(stdClass)#%d (0) {\n+  }\n+  [2]=>\n+  object(stdClass)#%d (0) {\n+  }\n+  [3]=>\n+  object(stdClass)#%d (0) {\n+  }\n+}\n+Error\n+array(3) {\n+  [0]=>\n+  object(stdClass)#%d (0) {\n+  }\n+  [2]=>\n+  object(stdClass)#%d (0) {\n+  }\n+  [3]=>\n+  object(stdClass)#%d (0) {\n+  }\n+}"},{"sha":"5bdd5e18bf222ff09e28d69c6f8beac2e05c59d8","filename":"ext/reflection/php_reflection.c","status":"modified","additions":21,"deletions":17,"changes":38,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Freflection%2Fphp_reflection.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Freflection%2Fphp_reflection.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Freflection%2Fphp_reflection.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -6742,8 +6742,7 @@ ZEND_METHOD(ReflectionProperty, isReadable)\n \t\tRETURN_FALSE;\n \t}\n \n-\tif (prop->flags & ZEND_ACC_VIRTUAL) {\n-\t\tZEND_ASSERT(prop->hooks);\n+\tif ((prop->flags & ZEND_ACC_VIRTUAL) && prop->hooks) {\n \t\tif (!prop->hooks[ZEND_PROPERTY_HOOK_GET]) {\n \t\t\tRETURN_FALSE;\n \t\t}\n@@ -6835,26 +6834,31 @@ ZEND_METHOD(ReflectionProperty, isWritable)\n \t\tRETURN_FALSE;\n \t}\n \n-\tif (prop->flags & ZEND_ACC_VIRTUAL) {\n-\t\tZEND_ASSERT(prop->hooks);\n+\tif ((prop->flags & ZEND_ACC_VIRTUAL) && prop->hooks) {\n \t\tif (!prop->hooks[ZEND_PROPERTY_HOOK_SET]) {\n \t\t\tRETURN_FALSE;\n \t\t}\n-\t} else if (obj && (prop->flags & ZEND_ACC_READONLY)) {\n+\t} else if (prop->flags & ZEND_ACC_VIRTUAL) {\n+\t\tif (prop->flags & ZEND_ACC_READONLY) {\n+\t\t\tRETURN_FALSE;\n+\t\t}\n+\t} else if ((prop->flags & ZEND_ACC_READONLY)) {\n+\t\tif (obj) {\n retry:;\n-\t\tzval *prop_val = OBJ_PROP(obj, prop->offset);\n-\t\tif (Z_TYPE_P(prop_val) == IS_UNDEF\n-\t\t\t&& zend_lazy_object_must_init(obj)\n-\t\t\t&& (Z_PROP_FLAG_P(prop_val) & IS_PROP_LAZY)\n-\t\t) {\n-\t\t\tobj = zend_lazy_object_init(obj);\n-\t\t\tif (!obj) {\n-\t\t\t\tRETURN_THROWS();\n+\t\t\tzval *prop_val = OBJ_PROP(obj, prop->offset);\n+\t\t\tif (Z_TYPE_P(prop_val) == IS_UNDEF\n+\t\t\t\t&& zend_lazy_object_must_init(obj)\n+\t\t\t\t&& (Z_PROP_FLAG_P(prop_val) & IS_PROP_LAZY)\n+\t\t\t) {\n+\t\t\t\tobj = zend_lazy_object_init(obj);\n+\t\t\t\tif (!obj) {\n+\t\t\t\t\tRETURN_THROWS();\n+\t\t\t\t}\n+\t\t\t\tgoto retry;\n+\t\t\t}\n+\t\t\tif (Z_TYPE_P(prop_val) != IS_UNDEF && !(Z_PROP_FLAG_P(prop_val) & IS_PROP_REINITABLE)) {\n+\t\t\t\tRETURN_FALSE;\n \t\t\t}\n-\t\t\tgoto retry;\n-\t\t}\n-\t\tif (Z_TYPE_P(prop_val) != IS_UNDEF && !(Z_PROP_FLAG_P(prop_val) & IS_PROP_REINITABLE)) {\n-\t\t\tRETURN_FALSE;\n \t\t}\n \t}\n "},{"sha":"b541c483e99f297fe6d4ef855bc215bd1641e464","filename":"ext/reflection/tests/ReflectionGenerator_basic.phpt","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Freflection%2Ftests%2FReflectionGenerator_basic.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Freflection%2Ftests%2FReflectionGenerator_basic.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Freflection%2Ftests%2FReflectionGenerator_basic.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -59,7 +59,7 @@ array(2) {\n     [\"class\"]=>\n     string(%d) \"class@anonymous%s\"\n     [\"object\"]=>\n-    object(class@anonymous)#%d (0) {\n+    object(class@anonymous%0%s)#%d (0) {\n     }\n     [\"type\"]=>\n     string(2) \"->\"\n@@ -80,7 +80,7 @@ object(ReflectionMethod)#8 (2) {\n   [\"class\"]=>\n   string(%d) \"class@anonymous%s\"\n }\n-object(class@anonymous)#1 (0) {\n+object(class@anonymous%0%s)#1 (0) {\n }\n object(Generator)#%d (1) {\n   [\"function\"]=>"},{"sha":"eabc7f89f12396a267e48d70fdb30ed1f05f1952","filename":"ext/reflection/tests/gh21768.phpt","status":"added","additions":60,"deletions":0,"changes":60,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Freflection%2Ftests%2Fgh21768.phpt","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Freflection%2Ftests%2Fgh21768.phpt","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Freflection%2Ftests%2Fgh21768.phpt?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -0,0 +1,60 @@\n+--TEST--\n+GH-21768: Assertion failure in ReflectionProperty::is{Readable,Writable}() on internal virtual properties\n+--EXTENSIONS--\n+dom\n+--FILE--\n+<?php\n+\n+$rc = new ReflectionClass('DOMDocument');\n+foreach ($rc->getProperties() as $rp) {\n+    if (!$rp->isVirtual()) {\n+        continue;\n+    }\n+    echo $rp->getName(), ': readable=', var_export($rp->isReadable(null), true),\n+        ', writable=', var_export($rp->isWritable(null), true), PHP_EOL;\n+}\n+echo \"done\", PHP_EOL;\n+\n+?>\n+--EXPECT--\n+nodeName: readable=true, writable=false\n+nodeValue: readable=true, writable=true\n+nodeType: readable=true, writable=false\n+parentNode: readable=true, writable=false\n+parentElement: readable=true, writable=false\n+childNodes: readable=true, writable=false\n+firstChild: readable=true, writable=false\n+lastChild: readable=true, writable=false\n+previousSibling: readable=true, writable=false\n+nextSibling: readable=true, writable=false\n+attributes: readable=true, writable=false\n+isConnected: readable=true, writable=false\n+ownerDocument: readable=true, writable=false\n+namespaceURI: readable=true, writable=false\n+prefix: readable=true, writable=true\n+localName: readable=true, writable=false\n+baseURI: readable=true, writable=false\n+textContent: readable=true, writable=true\n+doctype: readable=true, writable=false\n+implementation: readable=true, writable=false\n+documentElement: readable=true, writable=false\n+actualEncoding: readable=true, writable=false\n+encoding: readable=true, writable=true\n+xmlEncoding: readable=true, writable=false\n+standalone: readable=true, writable=true\n+xmlStandalone: readable=true, writable=true\n+version: readable=true, writable=true\n+xmlVersion: readable=true, writable=true\n+strictErrorChecking: readable=true, writable=true\n+documentURI: readable=true, writable=true\n+config: readable=true, writable=false\n+formatOutput: readable=true, writable=true\n+validateOnParse: readable=true, writable=true\n+resolveExternals: readable=true, writable=true\n+preserveWhiteSpace: readable=true, writable=true\n+recover: readable=true, writable=true\n+substituteEntities: readable=true, writable=true\n+firstElementChild: readable=true, writable=false\n+lastElementChild: readable=true, writable=false\n+childElementCount: readable=true, writable=false\n+done"},{"sha":"9b5b8f331dc7b202e9ff23dbe6251041b10bd11e","filename":"ext/session/mod_files.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fsession%2Fmod_files.c","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fsession%2Fmod_files.c","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fsession%2Fmod_files.c?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -162,7 +162,7 @@ static void ps_files_open(ps_files *data, /* const */ zend_string *key)\n \n \t\tps_files_close(data);\n \n-\t\tif (php_session_valid_key(ZSTR_VAL(key)) == FAILURE) {\n+\t\tif (php_session_valid_key_ex(key) == FAILURE) {\n \t\t\tphp_error_docref(NULL, E_WARNING, \"Session ID is too long or contains illegal characters. Only the A-Z, a-z, 0-9, \\\"-\\\", and \\\",\\\" characters are allowed\");\n \t\t\treturn;\n \t\t}"},{"sha":"ee36eb291e529cdeb227fa9ce8a2153678092f57","filename":"ext/session/php_session.h","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/php/php-src/blob/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fsession%2Fphp_session.h","raw_url":"https://github.com/php/php-src/raw/b63cd83da3279445ca4a913f03186141f5c3466e/ext%2Fsession%2Fphp_session.h","contents_url":"https://api.github.com/repos/php/php-src/contents/ext%2Fsession%2Fphp_session.h?ref=b63cd83da3279445ca4a913f03186141f5c3466e","patch":"@@ -252,6 +252,7 @@ PHPAPI const ps_module *_php_find_ps_module(const char *name);\n PHPAPI const ps_serializer *_php_find_ps_serializer(const char *name);\n \n PHPAPI zend_result php_session_valid_key(const char *key);\n+zend_result php_session_valid_key_ex(const zend_string *key);\n PHPAPI zend_result php_session_reset_id(void);\n \n /* Do not use a return statement in `code` because that may leak memory."}]}