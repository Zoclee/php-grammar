4f94484dea7867a219d3d808bf4982a86b407cb"},"url":"https://api.github.com/repos/php/php-src/git/commits/a7a49e039d756d9d336b770316c282d02db08980","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQ9DfdEemyeZbWie5HRzUrZbcKICAUCauTxKAAKCRDRzUrZbcKI\nCLE5AP4uJpS9NPaKw4e9+otaWO+hs1yd2NqZ7AYLxxzF7V2MJwD9HeaKUzXGWcsD\n1frtMrKQ+vYeTEplULeImEDNTsG/uwk=\n=eiAi\n-----END PGP SIGNATURE-----","payload":"tree 14f94484dea7867a219d3d808bf4982a86b407cb\nparent 2a326cad23211bfb6138e965e417d6cd5aa870b9\nauthor ndossche <7771979+ndossche@users.noreply.github.com> 1793303730 +0100\ncommitter ndossche <7771979+ndossche@users.noreply.github.com> 1793388839 +0100\n\nFix JIT losing the called scope of self::/parent:: calls in included files\n\nFile/eval code take This from the existing frame's scope,\nso This may be a class instead of an object.\n\nCloses GH-25041.\n","verified_at":"2026-10-30T19:34:39Z"}},"url":"https://api.github.com/repos/php/php-src/commits/a7a49e039d756d9d336b770316c282d02db08980","html_url":"https://github.com/php/php-src/commit/a7a49e039d756d9d336b770316c282d02db08980","comments_url":"https://api.github.com/repos/php/php-src/commits/a7a49e039d756d9d336b770316c282d02db08980/comments","author":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossc