=4","gravatar_id":"","url":"https://api.github.com/users/DanielEScherzer","html_url":"https://github.com/DanielEScherzer","followers_url":"https://api.github.com/users/DanielEScherzer/followers","following_url":"https://api.github.com/users/DanielEScherzer/following{/other_user}","gists_url":"https://api.github.com/users/DanielEScherzer/gists{/gist_id}","starred_url":"https://api.github.com/users/DanielEScherzer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DanielEScherzer/subscriptions","organizations_url":"https://api.github.com/users/DanielEScherzer/orgs","repos_url":"https://api.github.com/users/DanielEScherzer/repos","events_url":"https://api.github.com/users/DanielEScherzer/events{/privacy}","received_events_url":"https://api.github.com/users/DanielEScherzer/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"627edcec45c84dc4e5e9eabeee28ecacb5fdf835","url":"https://api.github.com/repos/php/php-src/commits/627edcec45c84dc4e5e9eabeee28ecacb5fdf835","html_url":"https://github.com/php/php-src/commit/627edcec45c84dc4e5e9eabeee28ecacb5fdf835"}]},{"sha":"56bd75634f931745f35bbbde52aa92e319557ca1","node_id":"C_kwDOAB0LotoAKDU2YmQ3NTYzNGY5MzE3NDVmMzViYmJkZTUyYWE5MmUzMTk1NTdjYTE","commit":{"author":{"name":"lacatoire","email":"la.catoire@gmail.com","date":"2026-08-16T17:29:18Z"},"committer":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-10-30T20:07:37Z"},"message":"ext/ldap: fix crash in ldap_exop_sync() when $response_data is omitted\n\nldap_exop_sync() always takes the synchronous branch of php_ldap_exop(),\nwhich assigns $response_data unconditionally. When the argument is not\npassed, retdata is NULL and ZEND_TRY_ASSIGN_REF_STRINGL()/\nZEND_TRY_ASSIGN_REF_EMPTY_STRING() dereference it, so any successful\nldap_exop_sync($ldap, $oid) call segfaults. Guard the assignment the way\nthe $response_oid one already is.\n\nCloses GH-23339.","tree":{"sha":"21ac13ba08d3ac237c25672c1eaf7bdf23bad4f4","url":"https://api.github.com/repos/php/php-src/git/trees/21ac13ba08d3ac237c25672c1eaf7bdf23bad4f4"},"url":"https://api.github.com/repos/php/php-src/git/commits/56bd75634f931745f35bbbde52aa92e319557ca1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQ9DfdEemyeZbWie5HRzUrZbcKICAUCauT5DwAKCRDRzUrZbcKI\nCApQAQDa1ZEMUrvfDmL7Z/QlVV3M18Nnkcp7pHYMdd+BU3R77gEA2/iVktNG/hXz\n91qCbPsgNlw+DebjlldJ3vvGY8Lj+gM=\n=Blp2\n-----END PGP SIGNATURE-----","payload":"tree 21ac13ba08d3ac237c25672c1eaf7bdf23bad4f4\nparent 7dd0cebbc88f1cfceb599c303a7cba293de18b82\nauthor lacatoire <la.catoire@gmail.com> 1786901358 +0200\ncommitter ndossche <7771979+ndossche@users.noreply.github.com> 1793390857 +0100\n\next/ldap: fix crash in ldap_exop_sync() when $response_data is omitted\n\nldap_exop_sync() always takes the synchronous branch of php_ldap_exop(),\nwhich assigns $response_data unconditionally. When the argument is not\npassed, retdata is NULL and ZEND_TRY_ASSIGN_REF_STRINGL()/\nZEND_TRY_ASSIGN_REF_EMPTY_STRING() dereference it, so any successful\nldap_exop_sync($ldap, $oid) call segfaults. Guard the assignment the way\nthe $response_oid one already is.\n\nCloses GH-23339.\n","verified_at":"2026-10-30T20:08:43Z"}},"url":"https://api.github.com/repos/php/php-src/commits/56bd75634f931745f35bbbde52aa92e319557ca1","html_url":"https://github.com/php/php-src/commit/56bd75634f931745f35bbbde52aa92e319557ca1","comments_url":"https://api.github.com/repos/php/php-src/commits/56bd75634f931745f35bbbde52aa92e319557ca1/comments","author":{"login":"lacatoire","id":20201470,"node_id":"MDQ6VXNlcjIwMjAxNDcw","avatar_url":"https://avatars.githubusercontent.com/u/20201470?v=4","gravatar_id":"","url":"https://api.github.com/users/lacatoire","html_url":"https://github.com/lacatoire","followers_url":"https://api.github.com/users/lacatoire/followers","following_url":"https://api.github.com/users/lacatoire/following{/other_user}","gists_url":"https://api.github.com/users/lacatoire/gists{/gist_id}","starred_url":"https://api.github.com/users/lacatoire/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lacatoire/subscriptions","organizations_url":"https://api.github.com/users/lacatoire/orgs","repos_url":"https://api.github.com/users/lacatoire/repos","events_url":"https://api.github.com/users/lacatoire/events{/privacy}","received_events_url":"https://api.github.com/users/lacatoire/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"ht