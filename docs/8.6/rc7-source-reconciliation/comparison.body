ollowers","following_url":"https://api.github.com/users/svpernova09/following{/other_user}","gists_url":"https://api.github.com/users/svpernova09/gists{/gist_id}","starred_url":"https://api.github.com/users/svpernova09/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/svpernova09/subscriptions","organizations_url":"https://api.github.com/users/svpernova09/orgs","repos_url":"https://api.github.com/users/svpernova09/repos","events_url":"https://api.github.com/users/svpernova09/events{/privacy}","received_events_url":"https://api.github.com/users/svpernova09/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"svpernova09","id":967362,"node_id":"MDQ6VXNlcjk2NzM2Mg==","avatar_url":"https://avatars.githubusercontent.com/u/967362?v=4","gravatar_id":"","url":"https://api.github.com/users/svpernova09","html_url":"https://github.com/svpernova09","followers_url":"https://api.github.com/users/svpernova09/followers","following_url":"https://api.github.com/users/svpernova09/following{/other_user}","gists_url":"https://api.github.com/users/svpernova09/gists{/gist_id}","starred_url":"https://api.github.com/users/svpernova09/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/svpernova09/subscriptions","organizations_url":"https://api.github.com/users/svpernova09/orgs","repos_url":"https://api.github.com/users/svpernova09/repos","events_url":"https://api.github.com/users/svpernova09/events{/privacy}","received_events_url":"https://api.github.com/users/svpernova09/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"934feaa36a85d264ffda6a15edc195c7c4a42e69","url":"https://api.github.com/repos/php/php-src/commits/934feaa36a85d264ffda6a15edc195c7c4a42e69","html_url":"https://github.com/php/php-src/commit/934feaa36a85d264ffda6a15edc195c7c4a42e69"}]},{"sha":"33e562e1404cd1d141931e44bb15d14a9e9b2eba","node_id":"C_kwDOAB0LotoAKDMzZTU2MmUxNDA0Y2QxZDE0MTkzMWU0NGJiMTVkMTRhOWU5YjJlYmE","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-04T23:29:54Z"},"committer":{"name":"Jakub Zelenka","email":"bukka@php.net","date":"2026-11-11T17:49:07Z"},"message":"ext/openssl: Fix shared SSL_CTX callbacks reading a freed session stream\n\nSince b1242c32bca a server stream seeded from a session stream shares the\nparent's SSL_CTX. Two callbacks on that context were registered with the\nparent's stream as their argument: the ALPN select callback and, on Windows\nwithout a CA file, the certificate verify callback. Closing the parent\nbefore the child completed its handshake left them reading freed memory, and\nthe child silently negotiated no ALPN protocol. Look up the handshake's own\nstream from the SSL ex_data, as verify_callback and the SNI callback do, and\ngive the child its own copy of the ALPN protocol list.\n\nCloses GH-25211","tree":{"sha":"e80d7d89646450c0f64e7f61788b3dc73356eefe","url":"https://api.github.com/repos/php/php-src/git/trees/e80d7d89646450c0f64e7f61788b3dc73356eefe"},"url":"https://api.github.com/repos/php/php-src/git/commits/33e562e1404cd1d141931e44bb15d14a9e9b2eba","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQTCjZN1dWA+tKu3JYYcB3ncXAqd5AUCavSqkwAKCRAcB3ncXAqd\n5HCYAP9Jm4+Z6dE1Iz/UgfcEkfPjDS+AWlvPtmwMoAnVZGg2RwEAnJbS3WFdYDcN\nB5Q3OVsa3oHoBdXUg8F8RtwnPuVzsAI=\n=QFYe\n-----END PGP SIGNATURE-----","payload":"tree e80d7d89646450c0f64e7f61788b3dc73356eefe\nparent 93aa71b4a62e1d082e831f209fd9132e3dd52b65\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1793834994 -0500\ncommitter Jakub Zelenka <bukka@php.net> 1794419347 +0100\n\next/openssl: Fix shared SSL_CTX callbacks reading a freed session stream\n\nSince b1242c32bca a server stream seeded from a session stream shares the\nparent's SSL_CTX. Two callbacks on that context were registered with the\nparent's stream as their argument: the ALPN select callback and, on Windows\nwithout a CA file, the certificate verify callback. Closing the parent\nbefore the child completed its handshake left them reading freed memory, and\nthe child silently negotiated no ALPN protocol. Look up the handshake's own\nstream from the SSL ex_data, as verify_callback and the SNI callback do, and\ngive the child its own copy of the ALPN protocol list.\n\nCloses GH-25211\n","verified_at":"2026-11-11T17:49:20Z"}},"url":"https://api.github.com/repos/php/php-src/commits/33e562e1404cd1d141931e44bb15d14a9e9b2eba","html_url":"https://github.com/php/php-src/commit/33e562e1404cd1d141931e44bb15d14a9e9b2eba","comments_url":"https://api.github.com/repos/php/php-src/commits/33e562e1404cd1d141931e44bb15d14a9e9b2eba/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"bukka","id":137594,"node_id":"MDQ6VXNlcjEzNzU5NA==","avatar_url":"https://avatars.githubusercontent.com/u/137594?v=4","gravatar_id":"","url":"https://api.github.com/users/bukka","html_url":"https://github.com/bukka","followers_url":"https://api.github.com/users/bukka/followers","following_url":"https://api.github.com/users