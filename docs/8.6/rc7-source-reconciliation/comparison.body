:"User","user_view_type":"public","site_admin":false},"committer":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bbb21f0336a1b4a50cd57e55c81f0d328f55f6b2","url":"https://api.github.com/repos/php/php-src/commits/bbb21f0336a1b4a50cd57e55c81f0d328f55f6b2","html_url":"https://github.com/php/php-src/commit/bbb21f0336a1b4a50cd57e55c81f0d328f55f6b2"},{"sha":"7c0b41ed3ef7636c7e302e1326015fc2c6047f5d","url":"https://api.github.com/repos/php/php-src/commits/7c0b41ed3ef7636c7e302e1326015fc2c6047f5d","html_url":"https://github.com/php/php-src/commit/7c0b41ed3ef7636c7e302e1326015fc2c6047f5d"}]},{"sha":"dc5acdb60e04f44c5ef38d32eabf1a90da243289","node_id":"C_kwDOAB0LotoAKGRjNWFjZGI2MGUwNGY0NGM1ZWYzOGQzMmVhYmYxYTkwZGEyNDMyODk","commit":{"author":{"name":"Shivam Mathur","email":"shivam_jpr@hotmail.com","date":"2026-11-01T15:40:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-01T15:40:10Z"},"message":"Fix linking ext/curl against OpenSSL (#13262) (#25129)\n\nThis is backport for 8.3 of b222c020bfa876ae1cea87406beb8af0b53f0fab\nthat originally targeted only 8.4+. This is however a bug fix.\n\nFollowing 68f6ab711323678382d2746e57358d3f57a3446b, the ext/curl doesn't\nneed to be linked against OpenSSL anymore, if curl_version_info_data\nssl_version is OpenSSL/1.1 or later.\n\nWith OpenSSL 3 and later the check for old SSL crypto locking callbacks\nwas detected here.\n\nThis also uses a common PHP_SETUP_OPENSSL macro for checking OpenSSL and\nsyncs the minimum OpenSSL version (currently 1.0.2 or later) across the\nPHP build system.\n\n(cherry picked from commit ae92b85572ac9a5f14103cdedbf6448f9e8db09d)\n\nCo-authored-by: Peter Kokot <peterkokot@gmail.com>","tree":{"sha":"d9cea0ef02ba7bdbcd6f6bd35501c49b5c7728aa","url":"https://api.github.com/repos/php/php-src/git/trees/d9cea0ef02ba7bdbcd6f6bd35501c49b5c7728aa"},"url":"https://api.github.com/repos/php/php-src/git/commits/dc5acdb60e04f44c5ef38d32eabf1a90da243289","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq511aCRC1aQ7uu5UhlAAAtiYQAI8pLCo23XmHYwDsyeo7CWsO\nxFUZmOfZz94vLzgYQCcibDR4Od9IaoOjHPTDA+dYOAFRyWCJX9HDRPAJtaYkt36b\nv4PVd2u+tGEAXOmxS4C/bT/YKIhkZyN0RUqFqHXgmMBpsqJHKOgTkdVpAwK7hgIA\nFDsI9B+zauuF/NgjkUddxGmTzoQOOJbRHilvNZXCgd1cQCB0u7qqPCS6ONu3CYIP\nn2dH1uHxL/846CTZKQ9CeYPCyHYyzK8DNejiZgFfO7BA9qX0XX+MhFRQSLs7KFu7\nNhsD/mL8ut7hrXLKJ7t5mlM4zA7DtyPzGtm/yY7ZX8kwYPlFguouyZ8j9AltsTLl\nzghGzsFFbv+4RPwwbe+h1PwDRzm2RAGsXclHFad5gyKer9YqKekfKy6cJJrrcfB7\nhMHRNw4hbNRdQ+4aFX0IEVseFmfaUhoGe5Ad7505wbnTKbH8mPmHLmIgcOPVxuY9\nRJ9iKFggWvxE5KR+cAqwvECeqBRgdFYMkFvsu3W5ZkKZhs5hgTUJRIPWH6Zp2MCO\nWckabfJinrsvRL1SUdPN3b25RHp05FXEBtpg0nWYmRZK6eU4wg4KmK2IV82PCn0k\nHucwPOQdvCVo7jBKs68FhD1a67PCHwbAp/NL+BtDsgs81ZTnxfFwY1Fgy3BcpQqX\n+zb9A0h4cUkzxh8wD4Ir\n=VviS\n-----END PGP SIGNATURE-----\n","payload":"tree d9cea0ef02ba7bdbcd6f6bd35501c49b5c7728aa\nparent 084271b8fd895b8cdfdcb9552bdd3575e94e65bf\nauthor Shivam Mathur <shivam_jpr@hotmail.com> 1793547610 +0530\ncommitter GitHub <noreply@github.com> 1793547610 +0530\n\nFix linking ext/curl against OpenSSL (#13262) (#25129)\n\nThis is backport for 8.3 of b222c020bfa876ae1cea87406beb8af0b53f0fab\nthat originally targeted only 8.4+. This is however a bug fix.\n\nFollowing 68f6ab711323678382d2746e57358d3f57a3446b, the ext/curl doesn't\nneed to be linked against OpenSSL anymore, if curl_version_info_data\nssl_version is OpenSSL/1.1 or later.\n\nWith OpenSSL 3 and later the check for old SSL crypto locking callbacks\nwas detected here.\n\nThis also uses a common PHP_SETUP_OPENSSL macro for checking OpenSSL and\nsyncs the minimum OpenSSL version (currently 1.0.2 or later) across the\nPHP build system.\n\n(cherry picked from commit ae92b85572ac9a5f14103cdedbf6448f9e8db09d)\n\nCo-authored-by: Peter Kokot <peterkokot@gmail.com>","verified_at":"2026-11-01T15:40:10Z"}},"url":"https://api.github.com/repos/php/php-src/commits/dc5acdb60e04f44c5ef38d32eabf1a90da243289","html_url":"https://github.com/php/php-src/commit/dc5acdb60e04f44c5ef38d32eabf1a90da243289","comments_url":"https://api.github.com/repos/php/php-src/commits/dc5acdb60e04f44c5ef38d32eabf1a90da243289/comments","author":{"login":"shivammathur","id":1571086,"node_id":"MDQ6VXNlcjE1NzEwODY=","avatar_url":"https://avatars.githubusercontent.com/u/1571086?v=4","gravatar_id":"","url":"https://api.github.com/users/shivammathur","html_url":"https://github.com/shivammathur","followers_url":"https://api.github.com/users/shivammathur/followers","following_url":"https://api.github.com/users/shivammathur/following{/other_user}","gists_url":"https://api.github.com/users/shivammathur/gists{/gist_id}","starred_url":"https://api.github.com/users/shivammathur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shivammathur/subscriptions","organizations_url":"https://api.github.com/users/shivammathur/orgs","repos_url":"https://api.github.com/users/shivammathur/repos","events_url":"https://api.github.com/users/shivammathur/events{/privacy}","received_events_url":"https://api.github.com/users/shivammathur/received_events","t