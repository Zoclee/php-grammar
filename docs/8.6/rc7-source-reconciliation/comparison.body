ia Alshanetsky <ilia@ilia.ws> 1793484172 -0400\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793484173 -0400\n\nMerge branch 'PHP-8.5' into PHP-8.6\n\n* PHP-8.5:\n  ext/json: Stop encoding after a key fails to encode\n","verified_at":"2026-10-31T22:04:59Z"}},"url":"https://api.github.com/repos/php/php-src/commits/2e166e15edcbf6eca44ee6551454c91eebe81879","html_url":"https://github.com/php/php-src/commit/2e166e15edcbf6eca44ee6551454c91eebe81879","comments_url":"https://api.github.com/repos/php/php-src/commits/2e166e15edcbf6eca44ee6551454c91eebe81879/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a80bf61b611594f303b76800d6362f92522427dd","url":"https://api.github.com/repos/php/php-src/commits/a80bf61b611594f303b76800d6362f92522427dd","html_url":"https://github.com/php/php-src/commit/a80bf61b611594f303b76800d6362f92522427dd"},{"sha":"e1e07b9d03ba044f7ec68ec5a5177eb7dc1807ef","url":"https://api.github.com/repos/php/php-src/commits/e1e07b9d03ba044f7ec68ec5a5177eb7dc1807ef","html_url":"https://github.com/php/php-src/commit/e1e07b9d03ba044f7ec68ec5a5177eb7dc1807ef"}]},{"sha":"bc3a830f946d2871742f1cacaf1d0504c012110e","node_id":"C_kwDOAB0LotoAKGJjM2E4MzBmOTQ2ZDI4NzE3NDJmMWNhY2FmMWQwNTA0YzAxMjExMGU","commit":{"author":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-10-30T20:22:03Z"},"committer":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-10-31T23:10:56Z"},"message":"Fix GH-24988: Incorrect opcode range check causes bugs with exceptions in function JIT\n\n`range->var` is a byte offset, but `var_num` is an index, so we have to\nconvert the index to the byte offset using `EX_NUM_TO_VAR()`.\nThis matches `cleanup_live_vars()` code.\n\nCloses GH-25070.\n\nCo-authored-by: Jorg Sowa <jorg.sowa@gmail.com>","tree":{"sha":"c46262e860e84a7dbc3fadd724ae4ab192b17fc3","url":"https://api.github.com/repos/php/php-src/git/trees/c46262e860e84a7dbc3fadd724ae4ab192b17fc3"},"url":"https://api.github.com/repos/php/php-src/git/commits/bc3a830f946d2871742f1cacaf1d0504c012110e","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQ9DfdEemyeZbWie5HRzUrZbcKICAUCauZ1hgAKCRDRzUrZbcKI\nCJ5eAP44rm+m209TgOmBZqUyx0McaLGVbk4DXXm03fyW4eZffgD+MCL3s6MbjlnE\nJlk+T9gEStrnibCYzvWZB7J9JkyTWw4=\n=mzWi\n-----END PGP SIGNATURE-----","payload":"tree c46262e860e84a7dbc3fadd724ae4ab192b17fc3\nparent de6ffebd1a2a0145be891263432f34d237c609e3\nauthor ndossche <7771979+ndossche@users.noreply.github.com> 1793391723 +0100\ncommitter ndossche <7771979+ndossche@users.noreply.github.com> 1793488256 +0100\n\nFix GH-24988: Incorrect opcode range check causes bugs with exceptions in function JIT\n\n`range->var` is a byte offset, but `var_num` is an index, so we have to\nconvert the index to the byte offset using `EX_NUM_TO_VAR()`.\nThis matches `cleanup_live_vars()` code.\n\nCloses GH-25070.\n\nCo-authored-by: Jorg Sowa <jorg.sowa@gmail.com>\n","verified_at":"2026-10-31T23:12:09Z"}},"url":"https://api.github.com/repos/php/php-src/commits/bc3a830f946d2871742f1cacaf1d0504c012110e","html_url":"https://github.com/php/php-src/commit/bc3a830f946d2871742f1cacaf1d0504c012110e","comments_url":"https://api.github.com/repos/php/php-src/commits/bc3a830f946d2871742f1cacaf1d0504c012110e/comments","author":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche