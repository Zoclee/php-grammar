.5:\n  Fix linking ext/curl against OpenSSL (#13262) (#25129)\n","verified_at":"2026-11-01T15:42:16Z"}},"url":"https://api.github.com/repos/php/php-src/commits/0cf82508009a874f4b034ea4fb74d1e09682945b","html_url":"https://github.com/php/php-src/commit/0cf82508009a874f4b034ea4fb74d1e09682945b","comments_url":"https://api.github.com/repos/php/php-src/commits/0cf82508009a874f4b034ea4fb74d1e09682945b/comments","author":{"login":"shivammathur","id":1571086,"node_id":"MDQ6VXNlcjE1NzEwODY=","avatar_url":"https://avatars.githubusercontent.com/u/1571086?v=4","gravatar_id":"","url":"https://api.github.com/users/shivammathur","html_url":"https://github.com/shivammathur","followers_url":"https://api.github.com/users/shivammathur/followers","following_url":"https://api.github.com/users/shivammathur/following{/other_user}","gists_url":"https://api.github.com/users/shivammathur/gists{/gist_id}","starred_url":"https://api.github.com/users/shivammathur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shivammathur/subscriptions","organizations_url":"https://api.github.com/users/shivammathur/orgs","repos_url":"https://api.github.com/users/shivammathur/repos","events_url":"https://api.github.com/users/shivammathur/events{/privacy}","received_events_url":"https://api.github.com/users/shivammathur/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"shivammathur","id":1571086,"node_id":"MDQ6VXNlcjE1NzEwODY=","avatar_url":"https://avatars.githubusercontent.com/u/1571086?v=4","gravatar_id":"","url":"https://api.github.com/users/shivammathur","html_url":"https://github.com/shivammathur","followers_url":"https://api.github.com/users/shivammathur/followers","following_url":"https://api.github.com/users/shivammathur/following{/other_user}","gists_url":"https://api.github.com/users/shivammathur/gists{/gist_id}","starred_url":"https://api.github.com/users/shivammathur/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shivammathur/subscriptions","organizations_url":"https://api.github.com/users/shivammathur/orgs","repos_url":"https://api.github.com/users/shivammathur/repos","events_url":"https://api.github.com/users/shivammathur/events{/privacy}","received_events_url":"https://api.github.com/users/shivammathur/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0f5866cf14b22e31f540b81a00a5a13e02d58e50","url":"https://api.github.com/repos/php/php-src/commits/0f5866cf14b22e31f540b81a00a5a13e02d58e50","html_url":"https://github.com/php/php-src/commit/0f5866cf14b22e31f540b81a00a5a13e02d58e50"},{"sha":"dfaf9bf5c440dacb7698d0f5d1ef293d676bdec9","url":"https://api.github.com/repos/php/php-src/commits/dfaf9bf5c440dacb7698d0f5d1ef293d676bdec9","html_url":"https://github.com/php/php-src/commit/dfaf9bf5c440dacb7698d0f5d1ef293d676bdec9"}]},{"sha":"96cbae8f88e1d56bda11eaf2505564a0cedf45ec","node_id":"C_kwDOAB0LotoAKDk2Y2JhZThmODhlMWQ1NmJkYTExZWFmMjUwNTU2NGEwY2VkZjQ1ZWM","commit":{"author":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-01T16:03:58Z"},"committer":{"name":"Ilia Alshanetsky","email":"ilia@ilia.ws","date":"2026-11-01T16:03:58Z"},"message":"ext/session: Skip session lock test on Solaris\n\nSolaris has no flock(), and the fcntl() emulation takes per-process locks\nand needs a writable descriptor for LOCK_EX, so the test cannot observe the\nsession file lock from the same process.","tree":{"sha":"018055f7a5773d30069f6244a47214127da06681","url":"https://api.github.com/repos/php/php-src/git/trees/018055f7a5773d30069f6244a47214127da06681"},"url":"https://api.github.com/repos/php/php-src/git/commits/96cbae8f88e1d56bda11eaf2505564a0cedf45ec","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgdYhKZ4kd7+tlpRbDZ0aP7UxDG4\ndIRutl3Ksx2/yts4sAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQApln6PFyPSe9ssMIsqXZU4fA9KSL27mAg+sMgL7svIG6kBpHUW4ELQgtxmrGP6v9a\nrT54LQ9d8MBHBcGVCgkg4=\n-----END SSH SIGNATURE-----","payload":"tree 018055f7a5773d30069f6244a47214127da06681\nparent 0cf82508009a874f4b034ea4fb74d1e09682945b\nauthor Ilia Alshanetsky <ilia@ilia.ws> 1793549038 -0500\ncommitter Ilia Alshanetsky <ilia@ilia.ws> 1793549038 -0500\n\next/session: Skip session lock test on Solaris\n\nSolaris has no flock(), and the fcntl() emulation takes per-process locks\nand needs a writable descriptor for LOCK_EX, so the test cannot observe the\nsession file lock from the same process.\n","verified_at":"2026-11-01T16:08:21Z"}},"url":"https://api.github.com/repos/php/php-src/commits/96cbae8f88e1d56bda11eaf2505564a0cedf45ec","html_url":"https://github.com/php/php-src/commit/96cbae8f88e1d56bda11eaf2505564a0cedf45ec","comments_url":"https://api.github.com/repos/php/php-src/commits/96cbae8f88e1d56bda11eaf2505564a0cedf45ec/comments","author":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"iliaal","id":158724,"node_id":"MDQ6VXNlcjE1ODcyNA==","avatar_url":"https://avatars.githubusercontent.com/u/158724?v=4","gravatar_id":"","url":"https://api.github.com/users/iliaal","html_url":"https://github.com/iliaal","followers_url":"https://api.github.com/users/iliaal/followers","following_url":"https://api.github.com/users/iliaal/following{/other_user}","gists_url":"https://api.github.com/users/iliaal/gists{/gist_id}","starred_url":"https://api.github.com/users/iliaal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iliaal/subscriptions","organizations_url":"https://api.github.com/users/iliaal/orgs","repos_url":"https://api.github.com/users/iliaal/repos","events_url":"https://api.github.com/users/iliaal/events{/privacy}","received_events_url":"https://api.github.com/users/iliaal/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0cf82508009a874f4b034ea4fb74d1e09682945b","url":"https://api.github.com/repos/php/php-src/commits/0cf82508009a874f4b034ea4fb74d1e09682945b","html_url":"https://github.com/php/php-src/commit/0cf82508009a874f4b034ea4fb74d1e09682945b"}]},{"sha":"cbd65db2af75931436f49b947ec8ccc37e5c5313","node_id":"C_kwDOAB0LotoAKGNiZDY1ZGIyYWY3NTkzMTQzNmY0OWI5NDdlYzhjY2MzN2U1YzUzMTM","commit":{"author":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-11-01T14:04:16Z"},"committer":{"name":"ndossche","email":"7771979+ndossche@users.noreply.github.com","date":"2026-11-01T16:28:40Z"},"message":"Fix opcache phar check\n\nThis is the cause of the flaky nightly failures on PPC for `issue0149.phpt`.\nOn slow machines, enough time passes that request 2/3 are served from\nopcache rather than from the disk.\nIf we set `opcache.file_update_protection=0`, then the failure\nreproduces predictably.\nThe root cause is that the phar check in opcache only checks if the\nfilename ends in `.phar` whereas ext/phar checks whether `.phar` is\nanywhere in the filename. This difference causes requests from the cache\nto not execute the stub, and therefore not execute the `Phar::mount()`\ncall in the test, and therefore fail the expectation.\n\nCloses GH-25128.","tree":{"sha":"5ed5da1012106c00661f681ce7ad389b4fb4be60","url":"https://api.github.com/repos/php/php-src/git/trees/5ed5da1012106c00661f681ce7ad389b4fb4be60"},"url":"https://api.github.com/repos/php/php-src/git/commits/cbd65db2af75931436f49b947ec8ccc37e5c5313","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQ9DfdEemyeZbWie5HRzUrZbcKICAUCaudowAAKCRDRzUrZbcKI\nCGKwAQCSnDaUrPVYyL8kv4cCEfsxOl5u+w5HA/KY0YF+Lyn63wD8DFsoiTxOhaHh\nQwd8oWJEesWYy0v8GPnHNjX0K1XAVAU=\n=RTpU\n-----END PGP SIGNATURE-----","payload":"tree 5ed5da1012106c00661f681ce7ad389b4fb4be60\nparent 8ee6865074bc889dc5ae348631f24d5e67c40d7f\nauthor ndossche <7771979+ndossche@users.noreply.github.com> 1793541856 +0100\ncommitter ndossche <7771979+ndossche@users.noreply.github.com> 1793550520 +0100\n\nFix opcache phar check\n\nThis is the cause of the flaky nightly failures on PPC for `issue0149.phpt`.\nOn slow machines, enough time passes that request 2/3 are served from\nopcache rather than from the disk.\nIf we set `opcache.file_update_protection=0`, then the failure\nreproduces predictably.\nThe root cause is that the phar check in opcache only checks if the\nfilename ends in `.phar` whereas ext/phar checks whether `.phar` is\nanywhere in the filename. This difference causes requests from the cache\nto not execute the stub, and therefore not execute the `Phar::mount()`\ncall in the test, and therefore fail the expectation.\n\nCloses GH-25128.\n","verified_at":"2026-11-01T16:30:28Z"}},"url":"https://api.github.com/repos/php/php-src/commits/cbd65db2af75931436f49b947ec8ccc37e5c5313","html_url":"https://github.com/php/php-src/commit/cbd65db2af75931436f49b947ec8ccc37e5c5313","comments_url":"https://api.github.com/repos/php/php-src/commits/cbd65db2af75931436f49b947ec8ccc37e5c5313/comments","author":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ndossche","id":7771979,"node_id":"MDQ6VXNlcjc3NzE5Nzk=","avatar_url":"https://avatars.githubusercontent.com/u/7771979?v=4","gravatar_id":"","url":"https://api.github.com/users/ndossche","html_url":"https://github.com/ndossche","followers_url":"https://api.github.com/users/ndossche/followers","following_url":"https://api.github.com/users/ndossche/following{/other_user}","gists_url":"https://api.github.com/users/ndossche/gists{/gist_id}","starred_url":"https://api.github.com/users/ndossche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndossche/subscriptions","organizations_url":"https://api.github.com/users/ndossche/orgs","repos_url":"https://api.github.com/users/ndossche/repos","events_url":"https://api.github.com/users/ndossche/events{/privacy}","received_events_url":"https://api.github.com/users/ndossche/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8ee6865074bc889dc5ae348631f24d5e67c40d7f","url":"https://api.github.com/repos/php/php-src/commits/8ee6865074bc889dc5ae348631f24d5e67c40d7f","html_url":"https://github.com/php/php-src/commit/8ee6865074