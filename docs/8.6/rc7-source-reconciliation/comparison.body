GIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQBaJXemkdREdU3puaRNP8wvFqZtQUCavLKdQAKCRCRNP8wvFqZ\ntbIFAP9svrUX8Y1Cv06spPKHfV/k9L/svszn/A6PZ0MFRHTX6AD+KxO2X8yybTQO\nXwLApfNo8dFxipx431IlOHc+08dZ2QQ=\n=fpNq\n-----END PGP SIGNATURE-----","payload":"tree fb45db069d1ab84d94d19780ee8c997f805d01eb\nparent 6f161fa8fac851caee4514107477df8e829f47c8\nauthor Matteo Beccati <mbeccati@php.net> 1794296426 +0100\ncommitter Matteo Beccati <mbeccati@php.net> 1794296426 +0100\n\n[ci skip] Update news\n","verified_at":"2026-11-10T10:41:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/4eb137603df93155c56c1c9edc55ab4c63947140","html_url":"https://github.com/php/php-src/commit/4eb137603df93155c56c1c9edc55ab4c63947140","comments_url":"https://api.github.com/repos/php/php-src/commits/4eb137603df93155c56c1c9edc55ab4c63947140/comments","author":{"login":"mbeccati","id":282388,"node_id":"MDQ6VXNlcjI4MjM4OA==","avatar_url":"https://avatars.githubusercontent.com/u/282388?v=4","gravatar_id":"","url":"https://api.github.com/users/mbeccati","html_url":"https://github.com/mbeccati","followers_url":"https://api.github.com/users/mbeccati/followers","following_url":"https://api.github.com/users/mbeccati/following{/other_user}","gists_url":"https://api.github.com/users/mbeccati/gists{/gist_id}","starred_url":"https://api.github.com/users/mbeccati/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbeccati/subscriptions","organizations_url":"https://api.github.com/users/mbeccati/orgs","repos_url":"https://api.github.com/users/mbeccati/repos","events_url":"https://api.github.com/users/mbeccati/events{/privacy}","received_events_url":"https://api.github.com/users/mbeccati/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mbeccati","id":282388,"node_id":"MDQ6VXNlcjI4MjM4OA==","avatar_url":"https://avatars.githubusercontent.com/u/282388?v=4","gravatar_id":"","url":"https://api.github.com/users/mbeccati","html_url":"https://github.com/mbeccati","followers_url":"https://api.github.com/users/mbeccati/followers","following_url":"https://api.github.com/users/mbeccati/following{/other_user}","gists_url":"https://api.github.com/users/mbeccati/gists{/gist_id}","starred_url":"https://api.github.com/users/mbeccati/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbeccati/subscriptions","organizations_url":"https://api.github.com/users/mbeccati/orgs","repos_url":"https://api.github.com/users/mbeccati/repos","events_url":"https://api.github.com/users/mbeccati/events{/privacy}","received_events_url":"https://api.github.com/users/mbeccati/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"6f161fa8fac851caee4514107477df8e829f47c8","url":"https://api.github.com/repos/php/php-src/commits/6f161fa8fac851caee4514107477df8e829f47c8","html_url":"https://github.com/php/php-src/commit/6f161fa8fac851caee4514107477df8e829f47c8"}]},{"sha":"23b66be337057b03cbd2c27d53002028e6898cfa","node_id":"C_kwDOAB0LotoAKDIzYjY2YmUzMzcwNTdiMDNjYmQyYzI3ZDUzMDAyMDI4ZTY4OThjZmE","commit":{"author":{"name":"Gina Peter Banyard","email":"girgias@php.net","date":"2026-11-10T00:57:59Z"},"committer":{"name":"Matteo Beccati","email":"mbeccati@php.net","date":"2026-11-10T07:43:11Z"},"message":"Zend: follow-up for GH-22145. Fix zend_fcc_closure_equals_ex() implementation (#24007)\n\nThis is effectively a follow-up to #22145 to properly fix #22118 with internal functions.\n\nIt turns out that to prevent memory leaks for fake closures of internal functions, the zif_handler is changed to `zend_closure_internal_handler` and the true zif_handler is stored in the `orig_internal_handler` field of the zend_closure struct.\n\nSo `return func1->internal_function.handler == func2->internal_function.handler;` could never return true for internal functions.\n\nWe need to keep `zend_fcc_closure_equals_ex()` as the ABI is frozen, but it probably makes sense to clean this all up in master.","tree":{"sha":"168682c5e69af61c4f31af7522f4b68a7c22199a","url":"https://api.github.com/repos/php/php-src/git/trees/168682c5e69af61c4f31af7522f4b68a7c22199a"},"url":"https://api.github.com/repos/php/php-src/git/commits/23b66be337057b03cbd2c27d53002028e6898cfa","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQBaJXemkdREdU3puaRNP8wvFqZtQUCavLLDwAKCRCRNP8wvFqZ\ntUTLAQCYuJv5jNrPSVfhtenZb4tqct6pGG6eXTiJle4fKB6d3gEAo+aV1JYZmmaG\nCCFuaCkf+Dc0twqc/+KvWin8UQTPEQE=\n=bKCP\n-----END PGP SIGNATURE-----","payload":"tree 168682c5e69af61c4f31af7522f4b68a7c22199a\nparent 4eb137603df93155c56c1c9edc55ab4c63947140\nauthor Gina Peter Banyard <girgias@php.net> 1794272279 +0000\ncommitter Matteo Beccati <mbeccati@php.net> 1794296591 +0100\n\nZend: follow-up for GH-22145. Fix zend_fcc_closure_equals_ex() implementation (#24007)\n\nThis is effectively a follow-up to #22145 to properly fix #22118 with internal functions.\n\nIt turns out that to prevent memory leaks for fake closures of internal functions, the zif_handler is changed to `zend_closure_internal_handler` and the true zif_handler is stored in the `orig_internal_handler` field of the zend_closure struct.\n\nSo `return func1->internal_function.handler == func2->internal_function.handler;` could never return true for internal functions.\n\nWe need to keep `zend_fcc_closure_equals_ex()` as the ABI is frozen, but it probably makes sense to clean this all up in master.","verified_at":"2026-11-10T10:41:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/23b66be337057b03cbd2c27d53002028e6898cfa","html_url":"https://github.com/php/php-src/commit/23b66be337057b03cbd2c27d53002028e6898cfa","comments_url":"https://api.github.com/repos/php/php-src/commits/23b66be337057b03cbd2c27d53002028e6898cfa/comments","author":{"login":"Girgias","id":7906688,"node_id":"MDQ6VXNlcjc5MDY2ODg=","avatar_url":"https://avatars.githubusercontent.com/u/7906688?v=4","gravatar_id":"","url":"https://api.github.com/users/Girgias","html_url":"https://github.com/Girgias","followers_url":"https://api.github.com/users/Girgias/followers","following_url":"https://api.github.com/users/Girgias/following{/other_user}","gists_url":"https://api.github.com/users/Girgias/gists{/gist_id}","starred_url":"https://api.github.com/users/Girgias/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Girgias/subscriptions","organizations_url":"https://api.github.com/users/Girgias/orgs","repos_url":"https://api.github.com/users/Girgias/repos","events_url":"https://api.github.com/users/Girgias/events{/privacy}","received_events_url":"https://api.github.com/users/Girgias/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mbeccati","id":282388,"node_id":"MDQ6VXNlcjI4MjM4OA==","avatar_url":"https://avatars.githubusercontent.com/u/282388?v=4","gravatar_id":"","url":"https://api.github.com/users/mbeccati","html_url":"https://github.com/mbeccati","followers_url":"https://api.github.com/users/mbeccati/followers","following_url":"https://api.github.com/users/mbeccati/following{/other_user}","gists_url":"https://api.github.com/users/mbeccati/gists{/gist_id}","starred_url":"https://api.github.com/users/mbeccati/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbeccati/subscriptions","organizations_url":"https://api.github.com/users/mbeccati/orgs","repos_url":"https://api.github.com/users/mbeccati/repos","events_url":"https://api.github.com/users/mbeccati/events{/privacy}","received_events_url":"https://api.github.com/users/mbeccati/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4eb137603df93155c56c1c9edc55ab4c63947140","url":"https://api.github.com/repos/php/php-src/commits/4eb137603df93155c56c1c9edc55ab4c63947140","html_url":"https://github.com/php/php-src/commit/4eb137603df93155c56c1c9edc55ab4c63947140"}]},{"sha":"906d31024bed0cacc8f9f2beba4ab50ab2b7615a","node_id":"C_kwDOAB0LotoAKDkwNmQzMTAyNGJlZDBjYWNjOGY5ZjJiZWJhNGFiNTBhYjJiNzYxNWE","commit":{"author":{"name":"Go Kudo","email":"zeriyoshi@gmail.com","date":"2026-11-10T06:41:34Z"},"committer":{"name":"Matteo Beccati","email":"mbeccati@php.net","date":"2026-11-10T10:38:45Z"},"message":"8.6: Fix UAF of the default stream context in the stream error code (#25321)\n\n* Fix use of the freed default stream context by the stream error code\n\nFG(default_context) is a request resource that zend_close_rsrc_list()\nfrees at request shutdown, but the pointer is only reset in the RINIT of\next/standard. php_stream_error_operation_end() falls back to\nFG(default_context) when no context is given, and\nsapi_read_standard_form_data() buffers the POST body before RINIT, so when\nthe temporary file for a body over 16 KiB cannot be created, the error\npath reads the previous request's freed context.\n\nClear FG(default_context) when its resource is destroyed.","tree":{"sha":"7bd656985c0d2deb7a89275540b90217d557ebe3","url":"https://api.github.com/repos/php/php-src/git/trees/7bd656985c0d2deb7a89275540b90217d557ebe3"},"url":"https://api.github.com/repos/php/php-src/git/commits/906d31024bed0cacc8f9f2beba4ab50ab2b7615a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQBaJXemkdREdU3puaRNP8wvFqZtQUCavL0PwAKCRCRNP8wvFqZ\nte+rAQD8B1ioYko5ZtwDv/F6g0R+4bhaUrWX+HfB0j1f3aljNwEAqDZgZYp3fG/m\nmDvMGt3VDPMH7BybjFeHQAa4e0LmJgo=\n=Cd5n\n-----END PGP SIGNATURE-----","payload":"tree 7bd656985c0d2deb7a89275540b90217d557ebe3\nparent 23b66be337057b03cbd2c27d53002028e6898cfa\nauthor Go Kudo <zeriyoshi@gmail.com> 1794292894 +0900\ncommitter Matteo Beccati <mbeccati@php.net> 1794307125 +0100\n\n8.6: Fix UAF of the default stream context in the stream error code (#25321)\n\n* Fix use of the freed default stream context by the stream error code\n\nFG(default_context) is a request resource that zend_close_rsrc_list()\nfrees at request shutdown, but the pointer is only reset in the RINIT of\next/standard. php_stream_error_operation_end() falls back to\nFG(default_context) when no context is given, and\nsapi_read_standard_form_data() buffers the POST body before RINIT, so when\nthe temporary file for a body over 16 KiB cannot be created, the error\npath reads the previous request's freed context.\n\nClear FG(default_context) when its resource is destroyed.\n","verified_at":"2026-11-10T10:41:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/906d31024bed0cacc8f9f2beba4ab50ab2b7615a","html_url":"https://github.com/php/php-src/commit/906d31024bed0cacc8f9f2beba4ab50ab2b7615a","comments_url":"https://api.github.com/repos/php/php-src/commits/906d31024bed0cacc8f9f2beba4ab50ab2b7615a/comments","author":{"login":"zeriyoshi","id":10289597,"node_id":"MDQ6VXNlcjEwMjg5NTk3","avatar_url":"https://avatars.githubusercontent.com/u/10289597?v=4","gravatar_id":"","url":"https://api.github.com/users/zeriyoshi","html_url":"https://github.com/zeriyoshi","followers_url":"https://api.github.com/users/zeriyoshi/followers","following_url":"https://api.github.com/users/zeriyoshi/following{/other_user}","gists_url":"https://api.github.com/users/zeriyoshi/gists{/gist_id}","starred_url":"https://api.github.com/users/zeriyoshi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeriyoshi/subscriptions","organizations_url":"https://api.github.com/users/zeriyoshi/orgs","repos_url":"https://api.github.com/users/zeriyoshi/repos","events_url":"https://api.github.com/users/zeriyoshi/events{/privacy}","received_events_url":"https://api.github.com/users/zeriyoshi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mbeccati","id":282388,"node_id":"MDQ6VXNlcjI4MjM4OA==","avatar_url":"https://avatars.githubusercontent.com/u/282388?v=4","gravatar_id":"","url":"https://api.github.com/users/mbeccati","html_url":"https://github.com/mbeccati","followers_url":"https://api.github.com/users/mbeccati/followers","following_url":"https://api.github.com/users/mbeccati/following{/other_user}","gists_url":"https://api.github.com/users/mbeccati/gists{/gist_id}","starred_url":"https://api.github.com/users/mbeccati/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbeccati/subscriptions","organizations_url":"https://api.github.com/users/mbeccati/orgs","repos_url":"https://api.github.com/users/mbeccati/repos","events_url":"https://api.github.com/users/mbeccati/events{/privacy}","received_events_url":"https://api.github.com/users/mbeccati/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"23b66be337057b03cbd2c27d53002028e6898cfa","url":"https://api.github.com/repos/php/php-src/commits/23b66be337057b03cbd2c27d53002028e6898cfa","html_url":"https://github.com/php/php-src/commit/23b66be337057b03cbd2c27d53002028e6898cfa"}]},{"sha":"7b110646ef9de7af67c93f324e6fbcce8442b948","node_id":"C_kwDOAB0LotoAKDdiMTEwNjQ2ZWY5ZGU3YWY2N2M5M2YzMjRlNmZiY2NlODQ0MmI5NDg","commit":{"author":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-11-10T07:47:16Z"},"committer":{"name":"Matteo Beccati","email":"mbeccati@php.net","date":"2026-11-10T10:39:36Z"},"message":"ext/fileinfo: Fix HWPX misidentification as OOXML (#25105)\n\nFollow-up #25051. I find another regression in this upgrade. The OOXML magic rule can match .png or .md filenames later in an HWPX archive which means finfo can identify it as application/octet-stream instead of application/x-hwp+zip.","tree":{"sha":"2589d2dbed9061b5190031de18b622cf423cca33","url":"https://api.github.com/repos/php/php-src/git/trees/2589d2dbed9061b5190031de18b622cf423cca33"},"url":"https://api.github.com/repos/php/php-src/git/commits/7b110646ef9de7af67c93f324e6fbcce8442b948","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQBaJXemkdREdU3puaRNP8wvFqZtQUCavL0agAKCRCRNP8wvFqZ\nteWJAP904d7oj1es/EgDr5liRugiwI6sc7Gir1E5FJiLxJD+GQD+N/ymy8Co+FVQ\nIYBaDSR8suc7Ja1d4cnwR/FTCR8HlAI=\n=Lf/c\n-----END PGP SIGNATURE-----","payload":"tree 2589d2dbed9061b5190031de18b622cf423cca33\nparent 906d31024bed0cacc8f9f2beba4ab50ab2b7615a\nauthor Weilin Du <weilindu@php.net> 1794296836 +0800\ncommitter Matteo Beccati <mbeccati@php.net> 1794307176 +0100\n\next/fileinfo: Fix HWPX misidentification as OOXML (#25105)\n\nFollow-up #25051. I find another regression in this upgrade. The OOXML magic rule can match .png or .md filenames later in an HWPX archive which means finfo can identify it as application/octet-stream instead of application/x-hwp+zip.\n","verified_at":"2026-11-10T10:41:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/7b110646ef9de7af67c93f324e6fbcce8442b948","html_url":"https://github.com/php/php-src/commit/7b110646ef9de7af67c93f324e6fbcce8442b948","comments_url":"https://api.github.com/repos/php/php-src/commits/7b110646ef9de7af67c93f324e6fbcce8442b948/comments","author":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mbeccati","id":282388,"node_id":"MDQ6VXNlcjI4MjM4OA==","avatar_url":"https://avatars.githubusercontent.com/u/282388?v=4","gravatar_id":"","url":"https://api.github.com/users/mbeccati","html_url":"https://github.com/mbeccati","followers_url":"https://api.github.com/users/mbeccati/followers","following_url":"https://api.github.com/users/mbeccati/following{/other_user}","gists_url":"https://api.github.com/users/mbeccati/gists{/gist_id}","starred_url":"https://api.github.com/users/mbeccati/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbeccati/subscriptions","organizations_url":"https://api.github.com/users/mbeccati/orgs","repos_url":"https://api.github.com/users/mbeccati/repos","events_url":"https://api.github.com/users/mbeccati/events{/privacy}","received_events_url":"https://api.github.com/users/mbeccati/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"906d31024bed0cacc8f9f2beba4ab50ab2b7615a","url":"https://api.github.com/repos/php/php-src/commits/906d31024bed0cacc8f9f2beba4ab50ab2b7615a","html_url":"https://github.com/php/php-src/commit/906d31024bed0cacc8f9f2beba4ab50ab2b7615a"}]},{"sha":"83fde6b4cb3b99caa8f89f584e5fecea07cd172a","node_id":"C_kwDOAB0LotoAKDgzZmRlNmI0Y2IzYjk5Y2FhOGY4OWY1ODRlNWZlY2VhMDdjZDE3MmE","commit":{"author":{"name":"Weilin Du","email":"weilindu@php.net","date":"2026-11-10T08:14:24Z"},"committer":{"name":"Matteo Beccati","email":"mbeccati@php.net","date":"2026-11-10T10:40:01Z"},"message":"Fix GH-25051: Restore TrueType font MIME detection (#25063)\n\nBackport https://github.com/file/file/commit/ba72caa54b","tree":{"sha":"5863f61c79d858c83691cd67b13a9a90087297f6","url":"https://api.github.com/repos/php/php-src/git/trees/5863f61c79d858c83691cd67b13a9a90087297f6"},"url":"https://api.github.com/repos/php/php-src/git/commits/83fde6b4cb3b99caa8f89f584e5fecea07cd172a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQBaJXemkdREdU3puaRNP8wvFqZtQUCavL0gwAKCRCRNP8wvFqZ\ntbCCAQCXcD5yyAWNaBqRqILu4xlPGBVmdth0ZG3cU7gCsvXADQD/WNhEYxtPiQpF\nj4vmQbrEq48uhsNBJUSHobXdClPFuwk=\n=rP4+\n-----END PGP SIGNATURE-----","payload":"tree 5863f61c79d858c83691cd67b13a9a90087297f6\nparent 7b110646ef9de7af67c93f324e6fbcce8442b948\nauthor Weilin Du <weilindu@php.net> 1794298464 +0800\ncommitter Matteo Beccati <mbeccati@php.net> 1794307201 +0100\n\nFix GH-25051: Restore TrueType font MIME detection (#25063)\n\nBackport https://github.com/file/file/commit/ba72caa54b\n","verified_at":"2026-11-10T10:41:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/83fde6b4cb3b99caa8f89f584e5fecea07cd172a","html_url":"https://github.com/php/php-src/commit/83fde6b4cb3b99caa8f89f584e5fecea07cd172a","comments_url":"https://api.github.com/repos/php/php-src/commits/83fde6b4cb3b99caa8f89f584e5fecea07cd172a/comments","author":{"login":"LamentXU123","id":108666168,"node_id":"U_kgDOBnodOA","avatar_url":"https://avatars.githubusercontent.com/u/108666168?v=4","gravatar_id":"","url":"https://api.github.com/users/LamentXU123","html_url":"https://github.com/LamentXU123","followers_url":"https://api.github.com/users/LamentXU123/followers","following_url":"https://api.github.com/users/LamentXU123/following{/other_user}","gists_url":"https://api.github.com/users/LamentXU123/gists{/gist_id}","starred_url":"https://api.github.com/users/LamentXU123/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LamentXU123/subscriptions","organizations_url":"https://api.github.com/users/LamentXU123/orgs","repos_url":"https://api.github.com/users/LamentXU123/repos","events_url":"https://api.github.com/users/LamentXU123/events{/privacy}","received_events_url":"https://api.github.com/users/LamentXU123/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"mbeccati","id":282388,"node_id":"MDQ6VXNlcjI4MjM4OA==","avatar_url":"https://avatars.githubusercontent.com/u/282388?v=4","gravatar_id":"","url":"https://api.github.com/users/mbeccati","html_url":"https://github.com/mbeccati","followers_url":"https://api.github.com/users/mbeccati/followers","following_url":"https://api.github.com/users/mbeccati/following{/other_user}","gists_url":"https://api.github.com/users/mbeccati/gists{/gist_id}","starred_url":"https://api.github.com/users/mbeccati/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mbeccati/subscriptions","organizations_url":"https://api.github.com/users/mbeccati/orgs","repos_url":"https://api.github.com/users/mbeccati/repos","events_url":"https://api.github.com/users/mbeccati/events{/privacy}","received_events_url":"https://api.github.com/users/mbeccati/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7b110646ef9de7af67c93f324e6fbcce8442b948","url":"https://api.github.com/repos/php/php-src/commits/7b110646ef9de7af67c93f324e6fbcce8442b948","html_url":"https://github.com/php/php-src/commit/7b110646ef9de7af67c93f324e6fbcce8442b948"}]},{"sha":"e76d6cb9591f3d72a45557cf2e0da972a4b1b6a6","node_id":"C_kwDOAB0LotoAKGU3NmQ2Y2I5NTkxZjNkNzJhNDU1NTdjZjJlMGRhOTcyYTRiMWI2YTY","commit":{"author":{"name":"Dhrupo Nil","email":"dhrupo@gmail.com","date":"2026-10-31T03:59:28Z"},"committer":{"name":"Matteo Beccati","email":"mbeccati@php.net","date":"2026-11-10T10:41:39Z"},"message":"UPGRADING: Note the TrueType font MIME type change in fileinfo (#25073)\n\nFollowing the file 5.48 update and the fix in GH-25063, fileinfo reports\nTrueType fonts as font/ttf rather than the font/sfnt used in PHP 8.5\nand earlier.\n\nDocument this in the PHP 8.6 upgrade notes so applications with MIME\ntype allow-lists, including WordPress font uploads, can account for\nthe changed value.\n\nCloses #25073","tree":{"sha":"a840582ae227dbc01e14f8785f0120f79a7792b9","url":"https://api.github.com/repos/php/php-src/git/trees/a840582ae227dbc01e14f8785f0120f79a7792b9"},"url":"https://api.github.com/repos/php/php-src/git/commits/e76d6cb9591f3d72a45557cf2e0da972a4b1b6a6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQQBaJXemkdREdU3puaRNP8wvFqZtQUCavL04wAKCRCRNP8wvFqZ\ntbt6AP4zYMPm0aF1K1f4M5bXjLEd02DpuhFm1tXFHHkZiDCMlwD8Dhu31dFv3dXh\nUN9xGDVHsVYwJvWs6ydEgPelYtBsrwk=\n=03TJ\n-----END PGP SIGNATURE-----","payload":"tree a840582ae227dbc01e14f8785f0120f79a7792b9\nparent 83fde6b4cb3b99caa8f89f584e5fecea07cd172a\nauthor Dhrupo Nil <dhrupo@gmail.com> 1793419168 +0000\ncommitter Matteo Beccati <mbeccati@php.net> 1794307299 +0100\n\nUPGRADING: Note the TrueType font MIME type change in fileinfo (#25073)\n\nFollowing the file 5.48 update and the fix in GH-25063, fileinfo reports\nTrueType fonts as font/ttf rather than the font/sfnt used in PHP 8.5\nand earlier.\n\nDocument this in the PHP 8.6 upgrade notes so applications with MIME\ntype allow-lists, including WordPress font uploads, can account for\nthe changed value.\n\nCloses #25073\n","verified_at":"2026-11-10T10:41:57Z"}},"url":"https://api.github.com/repos/php/php-src/commits/e76d6cb9591f3d72a45557cf2e0da972a4b1b6a6","html_url":"https://github.com/php/php-src/commit/e76d6cb9591f3d72a45557cf2e0da972a4b1b6a6","comments_url":"https://api.github.com/repos/php/php-src/commits/e76d6cb9591f3d72a45557cf2e0da972a4b1b6a6/comments","author":{"login":"dhrupo","id":46154646,"node_id":"MDQ6VXNlcjQ2MTU0NjQ2","avatar_url":"https://avatars.githubusercontent.com/u/46154646?v=4","gravatar_id":"","url":"https://api.github.com/users/dhrupo","html_url":"https://github.com/dhrupo","followers_url":"https://api.github.com/users/dhrupo/followers","following_url":"https://api.github.com/users/dhrupo/following{/other_user}","gists_url":"https://api.github.com/users/dhrupo/gists{/gist_id}","starred_url":"https://api.github.com/users/dhrupo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhrupo/subscriptions","organizati