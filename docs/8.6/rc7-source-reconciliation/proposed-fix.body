{"sha":"5089bcc83c8193e6a965dd1579767b1d503401ba","node_id":"C_kwDOVcLWR9oAKDUwODliY2M4M2M4MTkzZTZhOTY1ZGQxNTc5NzY3YjFkNTAzNDAxYmE","commit":{"author":{"name":"ChrisAbner","email":"chrisabner@hotmail.com","date":"2026-10-29T23:49:57Z"},"committer":{"name":"ChrisAbner","email":"chrisabner@hotmail.com","date":"2026-11-03T22:25:58Z"},"message":"Fix GH-24792: Assignment-result writes compile but fail with invalid opcode\n\nSince the VAR|TMP overhaul, zend_compile_var_inner() compiles assignment\nexpressions for any fetch type, so using an assignment as the container of\na write (e.g. ($a = [1])[0] = 2, unset(($a = [1])[0])) emitted a write\nfetch on a TMP operand, which has no handler.\n\nOnly compile assignments in write context when they are passed by\nreference, which is the case the overhaul needed (f([&$x] = $arr)).\nOtherwise fall through to the \"Cannot use temporary expression in write\ncontext\" compile error, as in PHP 8.5.","tree":{"sha":"ba33734001ed5a1701d1078ad2c14370f2836028","url":"https://api.github.com/repos/ChrisAbner/php-src/git/trees/ba33734001ed5a1701d1078ad2c14370f2836028"},"url":"https://api.github.com/repos/ChrisAbner/php-src/git/commits/5089bcc83c8193e6a965dd1579767b1d503401ba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ChrisAbner/php-src/commits/5089bcc83c8193e6a965dd1579767b1d503401ba","html_url":"https://github.com/ChrisAbner/php-src/commit/5089bcc83c8193e6a965dd1579767b1d503401ba","comments_url":"https://api.github.com/repos/ChrisAbner/php-src/commits/5089bcc83c8193e6a965dd1579767b1d503401ba/comments","author":{"login":"ChrisAbner","id":48162172,"node_id":"MDQ6VXNlcjQ4MTYyMTcy","avatar_url":"https://avatars.githubusercontent.com/u/48162172?v=4","gravatar_id":"","url":"https://api.github.com/users/ChrisAbner","html_url":"https://github.com/ChrisAbner","followers_url":"https://api.github.com/users/ChrisAbner/followers","following_url":"https://api.github.com/users/ChrisAbner/following{/other_user}","gists_url":"https://api.github.com/users/ChrisAbner/gists{/gist_id}","starred_url":"https://api.github.com/users/ChrisAbner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChrisAbner/subscriptions","organizations_url":"https://api.github.com/users/ChrisAbner/orgs","repos_url":"https://api.github.com/users/ChrisAbner/repos","events_url":"https://api.github.com/users/ChrisAbner/events{/privacy}","received_events_url":"https://api.github.com/users/ChrisAbner/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ChrisAbner","id":48162172,"node_id":"MDQ6VXNlcjQ4MTYyMTcy","avatar_url":"https://avatars.githubusercontent.com/u/48162172?v=4","gravatar_id":"","url":"https://api.github.com/users/ChrisAbner","html_url":"https://github.com/ChrisAbner","followers_url":"https://api.github.com/users/ChrisAbner/followers","following_url":"https://api.github.com/users/ChrisAbner/following{/other_user}","gists_url":"https://api.github.com/users/ChrisAbner/gists{/gist_id}","starred_url":"https://api.github.com/users/ChrisAbner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChrisAbner/subscriptions","organizations_url":"https://api.github.com/users/ChrisAbner/orgs","repos_url":"https://api.github.com/users/ChrisAbner/repos","events_url":"https://api.github.com/users/ChrisAbner/events{/privacy}","received_events_url":"https://api.github.com/users/ChrisAbner/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3fd74fcba6b6a90766c700039c3b69982037a5cd","url":"https://api.github.com/repos/ChrisAbner/php-src/commits/3fd74fcba6b6a90766c700039c3b69982037a5cd","html_url":"https://github.com/ChrisAbner/php-src/commit/3fd74fcba6b6a90766c700039c3b69982037a5cd"}],"stats":{"total":120,"additions":116,"deletions":4},"files":[{"sha":"4d483c63131d7e8597b592253f1e599d5efd75c0","filename":"NEWS","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/NEWS","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/NEWS","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/NEWS?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -2,6 +2,10 @@ PHP                                                                        NEWS\n |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||\n ?? ??? ????, PHP 8.6.1\n \n+- Core:\n+  . Fixed bug GH-24792 (Assignment-result writes compile but fail with invalid\n+    opcode). (ChrisAbner)\n+\n - Opcache:\n   . Fixed bug GH-22216 (spurious opcache.memory_consumption warning on each new\n     ZTS thread; the directive is also reported as 0 in worker threads)."},{"sha":"60019796d9ebb7cc286c3b9c844ddfa7c4466387","filename":"Zend/tests/gh24792.phpt","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,35 @@\n+--TEST--\n+GH-24792: Assignment results can still be read and passed by reference\n+--FILE--\n+<?php\n+function f(&$x) {\n+    $x[] = 9;\n+}\n+\n+$arr = [[1]];\n+f([&$x] = $arr);\n+var_dump($arr[1]);\n+\n+$b = [1];\n+f($a =& $b);\n+var_dump($b[1]);\n+\n+var_dump(($v = ['k' => 'v'])['k'], $v);\n+var_dump(isset(($w = [1])[0]), ($w = [1])[5] ?? 'default', empty(($w = [1])[0]));\n+\n+$o = new stdClass;\n+$o->p = [1];\n+var_dump(($c = $o)->p[0]);\n+?>\n+--EXPECT--\n+int(9)\n+int(9)\n+string(1) \"v\"\n+array(1) {\n+  [\"k\"]=>\n+  string(1) \"v\"\n+}\n+bool(true)\n+string(7) \"default\"\n+bool(false)\n+int(1)"},{"sha":"b024bb1bd34f02480c1ab269c556529f6ff8dbc5","filename":"Zend/tests/gh24792_001.phpt","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_001.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_001.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_001.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,8 @@\n+--TEST--\n+GH-24792: Dimension write on an assignment result\n+--FILE--\n+<?php\n+($a = [1])[0] = 2;\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"21eb2597d2bb0d778a94feda981d89654d0bf5a7","filename":"Zend/tests/gh24792_002.phpt","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_002.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_002.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_002.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,8 @@\n+--TEST--\n+GH-24792: Property write on an assignment result\n+--FILE--\n+<?php\n+($a = new stdClass)->p = 1;\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"28e2d7b0527511091a6be8cf924f7ce753b9e7e4","filename":"Zend/tests/gh24792_003.phpt","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_003.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_003.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_003.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,8 @@\n+--TEST--\n+GH-24792: Compound assignment on a dimension of an assignment result\n+--FILE--\n+<?php\n+($a = [1])[0] += 2;\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"7ab7792aa991a14b714bd71d098529a050c93dde","filename":"Zend/tests/gh24792_004.phpt","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_004.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_004.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_004.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,8 @@\n+--TEST--\n+GH-24792: Unset of a dimension of an assignment result\n+--FILE--\n+<?php\n+unset(($a = [1])[0]);\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"82b476498ea5642b0b494367dc72e3e3a7208ebc","filename":"Zend/tests/gh24792_005.phpt","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_005.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_005.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_005.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,8 @@\n+--TEST--\n+GH-24792: Reference to a dimension of an assignment result\n+--FILE--\n+<?php\n+$r = &($a = [1])[0];\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"d6d9773598a690ac9f1ef73245eda95edb04e279","filename":"Zend/tests/gh24792_006.phpt","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_006.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_006.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_006.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,9 @@\n+--TEST--\n+GH-24792: Dimension of an assignment result passed by reference\n+--FILE--\n+<?php\n+function f(&$x) {}\n+f(($a = [1])[0]);\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"45f13732ceacd479768dc15aa11e621bebbfb7fa","filename":"Zend/tests/gh24792_007.phpt","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_007.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_007.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_007.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,9 @@\n+--TEST--\n+GH-24792: Dimension write on a by-reference assignment result\n+--FILE--\n+<?php\n+$b = [1];\n+($a =& $b)[0] = 2;\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"1a26caf224c33ff7420299625624e3145e9220f3","filename":"Zend/tests/gh24792_008.phpt","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_008.phpt","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Ftests%2Fgh24792_008.phpt","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Ftests%2Fgh24792_008.phpt?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -0,0 +1,9 @@\n+--TEST--\n+GH-24792: Dimension write on the result of a destructuring assignment with references\n+--FILE--\n+<?php\n+$arr = [[1]];\n+([&$x] = $arr)[0] = 5;\n+?>\n+--EXPECTF--\n+Fatal error: Cannot use temporary expression in write context in %s on line %d"},{"sha":"fa49b3a20d2f8800fee49b11a7a8ea5f0ecd035b","filename":"Zend/zend_compile.c","status":"modified","additions":10,"deletions":4,"changes":14,"blob_url":"https://github.com/ChrisAbner/php-src/blob/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Fzend_compile.c","raw_url":"https://github.com/ChrisAbner/php-src/raw/5089bcc83c8193e6a965dd1579767b1d503401ba/Zend%2Fzend_compile.c","contents_url":"https://api.github.com/repos/ChrisAbner/php-src/contents/Zend%2Fzend_compile.c?ref=5089bcc83c8193e6a965dd1579767b1d503401ba","patch":"@@ -12798,11 +12798,17 @@ static zend_op *zend_compile_var_inner(znode *result, zend_ast *ast, uint32_t ty\n \t\t\t*result = *zend_ast_get_znode(ast);\n \t\t\treturn NULL;\n \t\tcase ZEND_AST_ASSIGN_REF:\n-\t\t\tzend_compile_assign_ref(result, ast, type);\n-\t\t\treturn NULL;\n \t\tcase ZEND_AST_ASSIGN:\n-\t\t\tzend_compile_assign(result, ast, false, type);\n-\t\t\treturn NULL;\n+\t\t\t/* Assignment results may only be passed by reference, not written to. */\n+\t\t\tif (by_ref || (type != BP_VAR_W && type != BP_VAR_RW && type != BP_VAR_UNSET)) {\n+\t\t\t\tif (ast->kind == ZEND_AST_ASSIGN_REF) {\n+\t\t\t\t\tzend_compile_assign_ref(result, ast, type);\n+\t\t\t\t} else {\n+\t\t\t\t\tzend_compile_assign(result, ast, false, type);\n+\t\t\t\t}\n+\t\t\t\treturn NULL;\n+\t\t\t}\n+\t\t\tZEND_FALLTHROUGH;\n \t\tdefault:\n \t\t\tif (type == BP_VAR_W || type == BP_VAR_RW || type == BP_VAR_UNSET) {\n \t\t\t\tzend_error_noreturn(E_COMPILE_ERROR,"}]}