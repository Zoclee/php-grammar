[{"sha":"5089bcc83c8193e6a965dd1579767b1d503401ba","node_id":"C_kwDOVcLWR9oAKDUwODliY2M4M2M4MTkzZTZhOTY1ZGQxNTc5NzY3YjFkNTAzNDAxYmE","commit":{"author":{"name":"ChrisAbner","email":"chrisabner@hotmail.com","date":"2026-10-29T23:49:57Z"},"committer":{"name":"ChrisAbner","email":"chrisabner@hotmail.com","date":"2026-11-03T22:25:58Z"},"message":"Fix GH-24792: Assignment-result writes compile but fail with invalid opcode\n\nSince the VAR|TMP overhaul, zend_compile_var_inner() compiles assignment\nexpressions for any fetch type, so using an assignment as the container of\na write (e.g. ($a = [1])[0] = 2, unset(($a = [1])[0])) emitted a write\nfetch on a TMP operand, which has no handler.\n\nOnly compile assignments in write context when they are passed by\nreference, which is the case the overhaul needed (f([&$x] = $arr)).\nOtherwise fall through to the \"Cannot use temporary expression in write\ncontext\" compile error, as in PHP 8.5.","tree":{"sha":"ba33734001ed5a1701d1078ad2c14370f2836028","url":"https://api.github.com/repos/php/php-src/git/trees/ba33734001ed5a1701d1078ad2c14370f2836028"},"url":"https://api.github.com/repos/php/php-src/git/commits/5089bcc83c8193e6a965dd1579767b1d503401ba","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/php/php-src/commits/5089bcc83c8193e6a965dd1579767b1d503401ba","html_url":"https://github.com/php/php-src/commit/5089bcc83c8193e6a965dd1579767b1d503401ba","comments_url":"https://api.github.com/repos/php/php-src/commits/5089bcc83c8193e6a965dd1579767b1d503401ba/comments","author":{"login":"ChrisAbner","id":48162172,"node_id":"MDQ6VXNlcjQ4MTYyMTcy","avatar_url":"https://avatars.githubusercontent.com/u/48162172?v=4","gravatar_id":"","url":"https://api.github.com/users/ChrisAbner","html_url":"https://github.com/ChrisAbner","followers_url":"https://api.github.com/users/ChrisAbner/followers","following_url":"https://api.github.com/users/ChrisAbner/following{/other_user}","gists_url":"https://api.github.com/users/ChrisAbner/gists{/gist_id}","starred_url":"https://api.github.com/users/ChrisAbner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChrisAbner/subscriptions","organizations_url":"https://api.github.com/users/ChrisAbner/orgs","repos_url":"https://api.github.com/users/ChrisAbner/repos","events_url":"https://api.github.com/users/ChrisAbner/events{/privacy}","received_events_url":"https://api.github.com/users/ChrisAbner/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ChrisAbner","id":48162172,"node_id":"MDQ6VXNlcjQ4MTYyMTcy","avatar_url":"https://avatars.githubusercontent.com/u/48162172?v=4","gravatar_id":"","url":"https://api.github.com/users/ChrisAbner","html_url":"https://github.com/ChrisAbner","followers_url":"https://api.github.com/users/ChrisAbner/followers","following_url":"https://api.github.com/users/ChrisAbner/following{/other_user}","gists_url":"https://api.github.com/users/ChrisAbner/gists{/gist_id}","starred_url":"https://api.github.com/users/ChrisAbner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChrisAbner/subscriptions","organizations_url":"https://api.github.com/users/ChrisAbner/orgs","repos_url":"https://api.github.com/users/ChrisAbner/repos","events_url":"https://api.github.com/users/ChrisAbner/events{/privacy}","received_events_url":"https://api.github.com/users/ChrisAbner/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3fd74fcba6b6a90766c700039c3b69982037a5cd","url":"https://api.github.com/repos/php/php-src/commits/3fd74fcba6b6a90766c700039c3b69982037a5cd","html_url":"https://github.com/php/php-src/commit/3fd74fcba6b6a90766c700039c3b69982037a5cd"}]}]