diff --git a/Zend/tests/vm_interrupt_rearm.phpt b/Zend/tests/vm_interrupt_rearm.phpt
new file mode 100644
index 0000000000..605cb59086
--- /dev/null
+++ b/Zend/tests/vm_interrupt_rearm.phpt
@@ -0,0 +1,26 @@
+--TEST--
+VM interrupt re-armed by the interrupt handler must not stop execution from making progress
+--DESCRIPTION--
+zend_test.rearm_vm_interrupt installs a zend_interrupt_function that sets
+EG(vm_interrupt) again every time it runs, so an interrupt is always pending.
+After handling an interrupt the VM has to run the next opline before it checks
+the flag again, otherwise it calls the handler forever (or recurses until the
+stack overflows).
+--EXTENSIONS--
+zend_test
+--INI--
+zend_test.rearm_vm_interrupt=1
+--FILE--
+<?php
+function inc(int $x): int {
+    return $x + 1;
+}
+
+$n = 0;
+for ($i = 0; $i < 1000; $i++) {
+    $n = inc($n);
+}
+var_dump($n);
+?>
+--EXPECT--
+int(1000)
diff --git a/Zend/tests/zend_mm_chunk_alloc_mmap_failure.phpt b/Zend/tests/zend_mm_chunk_alloc_mmap_failure.phpt
new file mode 100644
index 0000000000..b137f25620
--- /dev/null
+++ b/Zend/tests/zend_mm_chunk_alloc_mmap_failure.phpt
@@ -0,0 +1,32 @@
+--TEST--
+Failed retry mmap() in zend_mm_chunk_alloc_int() must not unmap an unrelated range
+--EXTENSIONS--
+posix
+--SKIPIF--
+<?php
+if (PHP_OS_FAMILY !== 'Linux') die('skip Linux only');
+if (PHP_INT_SIZE != 8) die('skip this test is for 64bit platforms only');
+if (getenv('USE_ZEND_ALLOC') === '0') die('skip Zend MM disabled');
+$maps = @file_get_contents('/proc/self/maps');
+if ($maps === false) die('skip /proc/self/maps not available');
+if (!preg_match('/^([0-9a-f]+)-[0-9a-f]+ r-xp /m', $maps, $m) || hexdec($m[1]) > 0x40000000) {
+    die('skip only for non-PIE builds');
+}
+?>
+--INI--
+memory_limit=-1
+--FILE--
+<?php
+// A huge block whose size equals the start of the executable mapping. If the
+// first mmap() is not 2 MiB aligned and the retry fails under RLIMIT_AS, the
+// missing NULL check used to unmap [size, size + 2 MiB - 4 KiB), i.e. our text.
+preg_match('/^([0-9a-f]+)-[0-9a-f]+ r-xp /m', file_get_contents('/proc/self/maps'), $m);
+$size = hexdec($m[1]);
+preg_match('/VmSize:\s+(\d+)/', file_get_contents('/proc/self/status'), $m);
+// Room for the first mmap() of $size bytes, not for the aligned retry.
+var_dump(posix_setrlimit(POSIX_RLIMIT_AS, $m[1] * 1024 + $size + 1024 * 1024, POSIX_RLIMIT_INFINITY));
+$s = str_repeat('A', $size - 4096);
+echo "allocation succeeded\n";
+?>
+--EXPECTREGEX--
+bool\(true\)\s+(.*Out of memory|allocation succeeded)\s*
