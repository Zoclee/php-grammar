diff --git a/Zend/tests/try/finally_interrupt_after_return.phpt b/Zend/tests/try/finally_interrupt_after_return.phpt
new file mode 100644
index 0000000000..1dfd3db005
--- /dev/null
+++ b/Zend/tests/try/finally_interrupt_after_return.phpt
@@ -0,0 +1,42 @@
+--TEST--
+VM interrupt throwing at the end of a finally block after "return" in the try block
+--DESCRIPTION--
+"return" inside a try block runs the finally block with FAST_CALL, and FAST_RET
+then jumps back to the RETURN, which is inside the try block. An interrupt that
+throws as the finally block ends belongs to the finally block: it must not run
+the finally block again, and it discards the pending return value.
+--EXTENSIONS--
+zend_test
+--INI--
+zend_test.observer.enabled=1
+zend_test.observer.show_output=0
+zend_test.observer.observe_function_names=release
+zend_test.observer.set_vm_interrupt_on_end=1
+--FILE--
+<?php
+$runs = 0;
+
+function release() {
+    global $runs;
+    $runs++;
+}
+
+function test() {
+    try {
+        return str_repeat('a', 3);
+    } finally {
+        release();
+    }
+}
+
+try {
+    $result = test();
+    echo "test() returned $result\n";
+} catch (Exception $e) {
+    echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+echo "finally ran $runs time(s)\n";
+?>
+--EXPECT--
+Exception: VM interrupt
+finally ran 1 time(s)
diff --git a/Zend/tests/try/finally_interrupt_after_return_generator.phpt b/Zend/tests/try/finally_interrupt_after_return_generator.phpt
new file mode 100644
index 0000000000..da5c64bae3
--- /dev/null
+++ b/Zend/tests/try/finally_interrupt_after_return_generator.phpt
@@ -0,0 +1,43 @@
+--TEST--
+VM interrupt throwing at the end of a generator's finally block after "return" in the try block
+--EXTENSIONS--
+zend_test
+--INI--
+zend_test.observer.enabled=1
+zend_test.observer.show_output=0
+zend_test.observer.observe_function_names=release
+zend_test.observer.set_vm_interrupt_on_end=1
+--FILE--
+<?php
+$runs = 0;
+
+function release() {
+    global $runs;
+    $runs++;
+}
+
+function gen() {
+    try {
+        yield 1;
+        return str_repeat('a', 3);
+    } finally {
+        release();
+    }
+}
+
+$gen = gen();
+try {
+    echo "yielded ", $gen->current(), "\n";
+    $gen->next();
+    echo "gen() returned ", $gen->getReturn(), "\n";
+} catch (Exception $e) {
+    echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+var_dump($gen->valid());
+echo "finally ran $runs time(s)\n";
+?>
+--EXPECT--
+yielded 1
+Exception: VM interrupt
+bool(false)
+finally ran 1 time(s)
diff --git a/Zend/tests/try/finally_interrupt_after_return_nested.phpt b/Zend/tests/try/finally_interrupt_after_return_nested.phpt
new file mode 100644
index 0000000000..f4a2d09c07
--- /dev/null
+++ b/Zend/tests/try/finally_interrupt_after_return_nested.phpt
@@ -0,0 +1,47 @@
+--TEST--
+VM interrupt throwing at the end of nested finally blocks after "return" in the try block
+--DESCRIPTION--
+The inner finally block's FAST_RET jumps to the outer FAST_CALL, which is inside
+the inner try block. An interrupt that throws there must not run the inner
+finally block again, but the outer finally block still runs.
+--EXTENSIONS--
+zend_test
+--INI--
+zend_test.observer.enabled=1
+zend_test.observer.show_output=0
+zend_test.observer.observe_function_names=release
+zend_test.observer.set_vm_interrupt_on_end=1
+--FILE--
+<?php
+$runs = [];
+
+function release($name) {
+    global $runs;
+    $runs[] = $name;
+}
+
+function test() {
+    try {
+        try {
+            return str_repeat('a', 3);
+        } finally {
+            release('inner');
+        }
+    } finally {
+        release('outer');
+    }
+}
+
+try {
+    $result = test();
+    echo "test() returned $result\n";
+} catch (Exception $e) {
+    echo get_class($e), ': ', $e->getMessage(), "\n";
+    echo 'previous: ', get_class($e->getPrevious()), ': ', $e->getPrevious()->getMessage(), "\n";
+}
+echo implode(', ', $runs), "\n";
+?>
+--EXPECT--
+Exception: VM interrupt
+previous: Exception: VM interrupt
+inner, outer
