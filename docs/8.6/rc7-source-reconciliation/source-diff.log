+--TEST--
+GH-24265 (exit() in a finally block of a destroyed fiber is discarded)
+--CREDITS--
+iluuu1994
+--FILE--
+<?php
+
+$fiber = new Fiber(function () {
+    try {
+        Fiber::suspend();
+    } finally {
+        exit(1);
+    }
+});
+
+$fiber->start();
+echo "Before destroy", PHP_EOL;
+unset($fiber);
+
+echo "Not reached", PHP_EOL;
+
+?>
+--EXPECT--
+Before destroy
diff --git a/Zend/tests/fibers/gh24265-002.phpt b/Zend/tests/fibers/gh24265-002.phpt
new file mode 100644
index 0000000000..2a794bc3d0
--- /dev/null
+++ b/Zend/tests/fibers/gh24265-002.phpt
@@ -0,0 +1,30 @@
+--TEST--
+GH-24265 (exit() in a destroyed fiber is discarded while an exception is pending)
+--FILE--
+<?php
+
+function test() {
+    $fiber = new Fiber(function () {
+        try {
+            Fiber::suspend();
+        } finally {
+            exit(1);
+        }
+    });
+
+    $fiber->start();
+    echo "Before destroy", PHP_EOL;
+    throw new Exception("pending");
+}
+
+try {
+    test();
+} catch (Exception $e) {
+    echo $e::class, ': ', $e->getMessage(), PHP_EOL;
+}
+
+echo "Not reached", PHP_EOL;
+
+?>
+--EXPECT--
+Before destroy
