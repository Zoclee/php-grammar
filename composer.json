{
    "name": "php-grammar/php-grammar",
    "description": "Versioned EBNF grammars and human-readable specifications for PHP language syntax.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PhpGrammar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpGrammar\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "grammar:coverage": "php bin/grammar-coverage.php",
        "lexer:coverage": "php bin/lexer-coverage.php",
        "conformance:phase6": "php tools/php85-phase6.php",
        "conformance:interpolation": "php tools/php85-interpolation-binding.php --check",
        "conformance:diagnostics": "php tools/php85-diagnostic-witnesses.php --check",
        "certification:check": "python tools/php85-certification.py --check",
        "release:check": "python tools/grammar-release.py"
    }
}
